{
  "name": "droideck-windows-launcher",
  "version": "0.1.0",
  "description": "DroidDeck's native Windows game library and launcher",
  "author": "DroidDeck contributors",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "dev.droiddeck.launcher.windows",
    "productName": "DroidDeck Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
