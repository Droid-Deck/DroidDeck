+}
+static void dd_ctrace(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void dd_ctrace(const char *fmt, ...) {
+    FILE *f = dd_ctrace_file();
+    if (!f) return;
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    fprintf(f, "%lld ", (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec);
+    va_list ap; va_start(ap, fmt); vfprintf(f, fmt, ap); va_end(ap);
+    fputc('\n', f);
+    static unsigned n; if ((++n % 64) == 0) fflush(f);
+}
