+#include <cstdarg>
+static FILE *dd_trace_file()
+{
+	static FILE *f = []() -> FILE * {
+		const char *path = getenv( "DD_FRAMETRACE" );
+		return path && *path ? fopen( path, "w" ) : nullptr;
+	}();
+	return f;
+}
+static void dd_trace( const char *fmt, ... )
+{
+	FILE *f = dd_trace_file();
+	if ( !f ) return;
+	va_list ap;
+	va_start( ap, fmt );
+	fprintf( f, "%lu ", (unsigned long) get_time_in_nanos() );
+	vfprintf( f, fmt, ap );
+	fputc( '\n', f );
+	va_end( ap );
+	static unsigned n;
+	if ( ( ++n % 64 ) == 0 ) fflush( f );
+}
 
