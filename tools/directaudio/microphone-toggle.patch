+static void mic_control_update(void)
+{
+    FILE *f;
+    int enabled;
+    if (!g_mic_control) return;
+    f = fopen(g_mic_control, "r");
+    enabled = f && fgetc(f) == '1';
+    if (f) fclose(f);
+    if (enabled == __atomic_load_n(&g_mic_enabled, __ATOMIC_ACQUIRE)) return;
+    __atomic_store_n(&g_mic_enabled, enabled, __ATOMIC_RELEASE);
+    mic_want(0, "session toggle");
+    REVENT("mic enabled=%d", enabled);
 }
 
