# The DirectAudio release this build ships, pinned: nothing compiled for audio lives in this repo.
# Source and release notes: https://github.com/The412Banner/directaudio
# Bump the tag and the four checksums together (sha256 of each zip, from the release's SHA256SUMS.txt).
DIRECTAUDIO_REPO=The412Banner/directaudio
DIRECTAUDIO_TAG=directaudio-linux-v1.1.0
DIRECTAUDIO_WINE11_SHA256=TBD
DIRECTAUDIO_SYSTHREAD_SHA256=TBD
DIRECTAUDIO_RELAY_SHA256=TBD
DIRECTAUDIO_SINK_SHA256=TBD
