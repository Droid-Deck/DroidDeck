+/* The guest maps the renderer's dma-buf, so a CPU cache sync on it covers the
+ * mapping. Coherent memory needs none.
+ */
+static void
+vtest_bo_sync_cpu_cache(struct vtest *vtest,
+                        struct vtest_bo *bo,
+                        uint64_t direction)
+{
+   if (!bo->incoherent || bo->res_fd < 0)
+      return;
+
+   struct dma_buf_sync sync = { .flags = DMA_BUF_SYNC_START | direction };
+   int ret = ioctl(bo->res_fd, DMA_BUF_IOCTL_SYNC, &sync);
+   if (!ret) {
+      sync.flags = DMA_BUF_SYNC_END | direction;
+      ret = ioctl(bo->res_fd, DMA_BUF_IOCTL_SYNC, &sync);
+   }
+   if (ret)
+      vn_log(vtest->instance, "dma-buf cache sync failed: %s", strerror(errno));
+}
