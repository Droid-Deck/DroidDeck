diff --git a/src/virtio/vulkan/vn_wsi.c b/src/virtio/vulkan/vn_wsi.c
index e73ab48..f0b41b1 100644
--- a/src/virtio/vulkan/vn_wsi.c
+++ b/src/virtio/vulkan/vn_wsi.c
@@ -287,6 +287,53 @@ vn_wsi_memory_info_init(struct vn_device_memory *mem,
    }
 }
 
+/* The buffer WSI copies each frame into for the CPU (software presentation)
+ * gets the hidden cached type: on vtest the host-visible type the app sees is
+ * uncached, and reading a frame from it took most of a present. WSI
+ * invalidates the buffer before each read.
+ */
+uint32_t
+vn_wsi_memory_type_index(const struct vn_device *dev,
+                         const VkMemoryAllocateInfo *alloc_info)
+{
+   const struct vn_physical_device *physical_dev = dev->physical_device;
+   const int readback_type = physical_dev->wsi_readback_memory_type;
+   if (readback_type < 0 || !physical_dev->wsi_device.sw)
+      return alloc_info->memoryTypeIndex;
+
+   const VkMemoryDedicatedAllocateInfo *dedicated_info = NULL;
+   bool wsi = false;
+   vk_foreach_struct_const(pnext, alloc_info->pNext) {
+      switch ((uint32_t)pnext->sType) {
+      case VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO:
+         dedicated_info = (const void *)pnext;
+         break;
+      case VK_STRUCTURE_TYPE_WSI_MEMORY_ALLOCATE_INFO_MESA:
+         wsi = true;
+         break;
+      case VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO:
+      case VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT:
+         return alloc_info->memoryTypeIndex;
+      default:
+         break;
+      }
+   }
+   if (!wsi || !dedicated_info || dedicated_info->buffer == VK_NULL_HANDLE)
+      return alloc_info->memoryTypeIndex;
+
+   const VkMemoryPropertyFlags flags =
+      physical_dev->memory_properties.memoryTypes[alloc_info->memoryTypeIndex]
+         .propertyFlags;
+   const struct vn_buffer *buf = vn_buffer_from_handle(dedicated_info->buffer);
+   const uint32_t type_bits =
+      buf->requirements.memory.memoryRequirements.memoryTypeBits;
+   if (!(flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) ||
+       !(type_bits & BITFIELD_BIT(readback_type)))
+      return alloc_info->memoryTypeIndex;
+
+   return readback_type;
+}
