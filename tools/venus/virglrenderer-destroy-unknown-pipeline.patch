+/* For a destroy command only: an id the renderer never created (the driver refused the create,
+ * which the guest may not have waited for) is logged and destroyed as VK_NULL_HANDLE, a no-op,
+ * instead of marking the whole context fatal - that took the vtest server down (exit 137) when
+ * gamescope destroyed a compute pipeline a Mali-G615 had refused. */
+static inline struct vkr_object *
+vkr_cs_decoder_lookup_object_for_destroy(const struct vkr_cs_decoder *dec,
+                                         vkr_object_id id,
+                                         VkObjectType type)
+{
+   struct vkr_object *obj;
+
+   if (!id)
+      return NULL;
+
+   mtx_lock(dec->object_mutex);
+   const struct hash_entry *entry =
+      _mesa_hash_table_search((struct hash_table *)dec->object_table, &id);
+   obj = likely(entry) ? entry->data : NULL;
+   mtx_unlock(dec->object_mutex);
+   if (unlikely(!obj || obj->type != type)) {
+      vkr_log("destroy of unknown object %" PRIu64 " of type %d ignored", id, type);
+      return NULL;
+   }
+   return obj;
+}
