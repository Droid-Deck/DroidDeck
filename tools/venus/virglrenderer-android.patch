+static int vkr_dma_heap_fd = -1;
+static int vkr_dma_heap_cached_fd = -1;
+
+/* Uncached for coherent memory types: nobody brackets CPU access with
+ * DMA_BUF_IOCTL_SYNC (the guest maps the memory as host-coherent), so on a
+ * cached heap the CPU and the GPU see each other's writes torn at cache-line
+ * granularity. Cached for cached types, which are not coherent: whoever maps
+ * them syncs the CPU cache through the dma-buf.
+ */
+static void
+vkr_dma_heap_init_once(void)
+{
+   vkr_dma_heap_cached_fd = open("/dev/dma_heap/system", O_RDONLY | O_CLOEXEC);
+   vkr_dma_heap_fd = open("/dev/dma_heap/system-uncached", O_RDONLY | O_CLOEXEC);
+   if (vkr_dma_heap_fd < 0) {
+      vkr_log("no uncached dma-buf heap (%s): using the cached one", strerror(errno));
+      vkr_dma_heap_fd = vkr_dma_heap_cached_fd;
+   }
+   if (vkr_dma_heap_fd < 0)
+      vkr_log("no dma-buf heap (%s): allocating AHardwareBuffers", strerror(errno));
+}
+
+/* An AHardwareBuffer's dma-buf: the first fd of its native handle, which the
+ * NDK hands out only through a unix socket.
+ */
+static int
+vkr_ahb_alloc_dma_buf(size_t size)
+{
+   const AHardwareBuffer_Desc desc = {
+      .width = (uint32_t)size,
+      .height = 1,
+      .layers = 1,
+      .format = AHARDWAREBUFFER_FORMAT_BLOB,
+      .usage = AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN | AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN |
+               AHARDWAREBUFFER_USAGE_GPU_DATA_BUFFER,
+   };
+   AHardwareBuffer *ahb = NULL;
+   if (AHardwareBuffer_allocate(&desc, &ahb)) {
+      vkr_log("AHardwareBuffer_allocate of %zu failed", size);
+      return -1;
+   }
+
+   int fd = -1;
+   int sv[2];
+   if (!socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv)) {
+      if (!AHardwareBuffer_sendHandleToUnixSocket(ahb, sv[0])) {
+         char data[4096];
+         char control[CMSG_SPACE(sizeof(int) * 16)];
+         struct iovec iov = { .iov_base = data, .iov_len = sizeof(data) };
+         struct msghdr msg = {
+            .msg_iov = &iov,
+            .msg_iovlen = 1,
+            .msg_control = control,
+            .msg_controllen = sizeof(control),
+         };
+         if (recvmsg(sv[1], &msg, MSG_CMSG_CLOEXEC) > 0) {
+            struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg);
+            if (cmsg && cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS) {
+               const int count = (cmsg->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+               const int *fds = (const int *)CMSG_DATA(cmsg);
+               for (int i = 0; i < count; i++) {
+                  if (i == 0)
+                     fd = fds[i];
+                  else
+                     close(fds[i]);
+               }
+            }
+         }
+      }
+      close(sv[0]);
+      close(sv[1]);
+   }
+   AHardwareBuffer_release(ahb);
+   if (fd < 0)
+      vkr_log("could not get the dma-buf of an AHardwareBuffer");
+   return fd;
+}
+
+static VkResult
+vkr_android_get_fd_info_from_allocation_info(const VkMemoryAllocateInfo *alloc_info,
+                                             bool cached,
+                                             int *out_dma_buf_fd,
+                                             VkImportMemoryFdInfoKHR *out_fd_info)
+{
+   static once_flag dma_heap_once_flag = ONCE_FLAG_INIT;
+   call_once(&dma_heap_once_flag, vkr_dma_heap_init_once);
+
+   const size_t size = align(alloc_info->allocationSize, getpagesize());
+   const int heap_fd =
+      cached && vkr_dma_heap_cached_fd >= 0 ? vkr_dma_heap_cached_fd : vkr_dma_heap_fd;
+   int dma_buf_fd = -1;
+   if (heap_fd >= 0) {
+      struct dma_heap_allocation_data data = {
+         .len = size,
+         .fd_flags = O_RDWR | O_CLOEXEC,
+      };
+      if (!ioctl(heap_fd, DMA_HEAP_IOCTL_ALLOC, &data))
+         dma_buf_fd = data.fd;
+      else
+         vkr_log("dma-buf heap allocation of %zu failed (%s)", size, strerror(errno));
+   }
+   if (dma_buf_fd < 0)
+      dma_buf_fd = vkr_ahb_alloc_dma_buf(size);
+   if (dma_buf_fd < 0)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   const int fd = os_dupfd_cloexec(dma_buf_fd);
+   if (fd < 0) {
+      close(dma_buf_fd);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   *out_dma_buf_fd = dma_buf_fd;
+   *out_fd_info = (VkImportMemoryFdInfoKHR){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = alloc_info->pNext,
+      .fd = fd,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   return VK_SUCCESS;
+}
