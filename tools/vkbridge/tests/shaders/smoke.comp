#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { uint v[]; } src;
layout(std430, binding = 1) writeonly buffer Out { uint v[]; } dst;
layout(push_constant) uniform PC { uint mul; uint add; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    dst.v[i] = src.v[i] * pc.mul + pc.add;
}
