diff --git a/hybris/vulkan/compat/spirv_entry.c b/hybris/vulkan/compat/spirv_entry.c
index 8faf390..9d0298f 100644
--- a/hybris/vulkan/compat/spirv_entry.c
+++ b/hybris/vulkan/compat/spirv_entry.c
@@ -191,3 +191,142 @@ VkResult hybris_spirv_entry(const uint32_t *code, size_t size, uint32_t model,
     hybris_scaled_free(allocator, decorated);
     return result;
 }
+
+struct builtin_use_id {
+    uint32_t op, at, type, object, value, member;
+    unsigned direct, has_member, used_member, live, blocked;
+};
+static uint32_t builtin_use_structure(const struct builtin_use_id *ids,
+    uint32_t bound, uint32_t var, uint32_t *member_word)
+{
+    if (var >= bound || ids[var].op != 59 || ids[var].type >= bound) return 0;
+    uint32_t pointer = ids[var].type;
+    if (ids[pointer].op != 32 || ids[pointer].object >= bound) return 0;
+    uint32_t object = ids[pointer].object;
+    if (member_word) *member_word = ids[object].op == 28 ? 5 : 4;
+    if (ids[object].op == 28) object = ids[object].object;
+    return object < bound && ids[object].op == 30 ? object : 0;
+}
+static int builtin_use_pointer_word(uint32_t op, uint32_t word)
+{
+    switch (op) {
+    case 57: return word >= 4;                       /* OpFunctionCall arguments */
+    case 61: return word == 3;                       /* OpLoad pointer */
+    case 62: return word == 1;                       /* OpStore pointer */
+    case 63: case 64: return word == 1 || word == 2; /* OpCopyMemory target/source */
+    case 65: case 66: case 67: case 70: return word == 3; /* access-chain base */
+    case 68: return word == 3;                       /* OpArrayLength structure */
+    case 83: case 117: case 124: return word == 3;  /* pointer copy/conversion */
+    case 169: return word == 4 || word == 5;         /* OpSelect objects */
+    case 245: return word >= 3 && (word & 1);        /* OpPhi variables */
+    case 254: return word == 1;                      /* OpReturnValue value */
+    case 401: case 402: case 403: return word == 3 || word == 4; /* pointer ops */
+    default: return 0;
+    }
+}
+
+/* Inspect actual uses retained for the selected entry point. This mirrors the
+ * access-chain analysis used by prune_interfaces: entry declarations alone do
+ * not make a direct BuiltIn or gl_PerVertex member active. */
+VkResult hybris_spirv_entry_builtin(const uint32_t *code, size_t size, uint32_t model,
+    const char *entry, uint32_t builtin, const VkAllocationCallbacks *allocator,
+    int *present, const char **reason)
+{
+    uint32_t *selected = NULL;
+    struct builtin_use_id *ids = NULL;
+    size_t selected_size = 0;
+    *present = 0;
+    VkResult result = hybris_spirv_entry(code, size, model, entry, allocator,
+        &selected, &selected_size, reason);
+    if (result != VK_SUCCESS) return result;
+    *reason = "unsupported or malformed SPIR-V builtin use analysis";
+    uint32_t bound = selected[3];
+    if (sizeof(*ids) > SIZE_MAX / bound) { result = VK_ERROR_OUT_OF_HOST_MEMORY; goto done; }
+    ids = hybris_scaled_alloc(allocator, bound * sizeof(*ids),
+        VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+    if (!ids) { result = VK_ERROR_OUT_OF_HOST_MEMORY; goto done; }
+    memset(ids, 0, bound * sizeof(*ids));
+    size_t words = selected_size / 4;
+    for (size_t at = 5; at < words; at += selected[at] >> 16) {
+        const uint32_t *p = selected + at;
+        uint32_t count = p[0] >> 16, op = p[0] & 0xffff;
+        if (!count || count > words - at) { result = VK_ERROR_UNKNOWN; goto done; }
+        if (op == 21 || op == 28 || op == 30 || op == 32) {
+            if (count < 2 || !p[1] || p[1] >= bound) { result = VK_ERROR_UNKNOWN; goto done; }
+            ids[p[1]].op = op;
+            ids[p[1]].at = at;
+            if (op == 21) {
+                if (count != 4) { result = VK_ERROR_UNKNOWN; goto done; }
+                ids[p[1]].value = p[2];
+            }
+            if (op == 28) {
+                if (count != 4 || p[2] >= bound) { result = VK_ERROR_UNKNOWN; goto done; }
+                ids[p[1]].object = p[2];
+            }
+            if (op == 32) {
+                if (count != 4 || p[3] >= bound) { result = VK_ERROR_UNKNOWN; goto done; }
+                ids[p[1]].object = p[3];
+            }
+        } else if (op == 43 || op == 59) {
+            if (count < 4 || p[1] >= bound || !p[2] || p[2] >= bound) {
+                result = VK_ERROR_UNKNOWN; goto done;
+            }
+            ids[p[2]].op = op;
+            ids[p[2]].at = at;
+            ids[p[2]].type = p[1];
+            ids[p[2]].value = p[3];
+        }
+    }
+    for (size_t at = 5; at < words; at += selected[at] >> 16) {
+        const uint32_t *p = selected + at;
+        uint32_t count = p[0] >> 16, op = p[0] & 0xffff;
+        if (op == 71 && count == 4 && p[1] < bound && p[2] == 11 && p[3] == builtin)
+            ids[p[1]].direct = 1;
+        if (op == 72 && count == 5 && p[1] < bound && p[3] == 11 && p[4] == builtin) {
+            if (ids[p[1]].op != 30) { result = VK_ERROR_UNKNOWN; goto done; }
+            if (ids[p[1]].has_member && ids[p[1]].member != p[2]) ids[p[1]].blocked = 1;
+            ids[p[1]].has_member = 1;
+            ids[p[1]].member = p[2];
+        }
+    }
+    for (size_t at = 5; at < words; at += selected[at] >> 16) {
+        const uint32_t *p = selected + at;
+        uint32_t count = p[0] >> 16, op = p[0] & 0xffff, accessed = 0;
+        if ((op == 65 || op == 66) && count >= 5 && p[3] < bound) {
+            uint32_t member_word = 0;
+            uint32_t object = builtin_use_structure(ids, bound, p[3], &member_word);
+            if (object) {
+                accessed = p[3];
+                uint32_t index = count > member_word ? p[member_word] : bound;
+                if (index >= bound || ids[index].op != 43 || ids[index].type >= bound ||
+                    ids[ids[index].type].op != 21 || ids[ids[index].type].value != 32 ||
+                    (selected[ids[index].at] >> 16) != 4) {
+                    ids[object].blocked = 1;
+                } else if (ids[index].value == ids[object].member) {
+                    ids[object].used_member = 1;
+                }
+            }
+        }
+        if (op == 5 || op == 6 || op == 15 || op == 71 || op == 72 ||
+            op == 73 || op == 74 || op == 75 || op == 332 || op == 5632 || op == 5633)
+            continue;
+        for (uint32_t i = 1; i < count; ++i) {
+            uint32_t id = p[i];
+            if (id >= bound || !builtin_use_pointer_word(op, i) || ids[id].op != 59 ||
+                (op == 59 && i == 2) || (id == accessed && i == 3)) continue;
+            ids[id].live = 1;
+            uint32_t object = builtin_use_structure(ids, bound, id, NULL);
+            if (object) ids[object].blocked = 1;
+        }
+    }
+    for (uint32_t id = 1; id < bound; ++id) {
+        if (ids[id].op == 59 && ids[id].direct && ids[id].live) *present = 1;
+        if (ids[id].op == 30 && ids[id].has_member &&
+            (ids[id].used_member || ids[id].blocked)) *present = 1;
+    }
+done:
+    if (result == VK_SUCCESS) *reason = NULL;
+    hybris_scaled_free(allocator, ids);
+    hybris_scaled_free(allocator, selected);
+    return result;
+}
