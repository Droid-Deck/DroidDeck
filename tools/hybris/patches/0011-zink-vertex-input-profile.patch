 {
     if (!name) return NULL;
@@ -163,7 +222,8 @@ static PFN_vkVoidFunction VKAPI_CALL get_instance_proc(VkInstance instance, cons
      * Every command wrapper checks the actual device again before changing it. */
     PFN_vkVoidFunction intercepted = hybris_layer_physical_proc(name);
     if (!intercepted) intercepted = hybris_layer_device_dispatch(name, state.policy != 0);
-    return intercepted ? intercepted : (next ? next : vendor_alias);
+    PFN_vkVoidFunction function = intercepted ? intercepted : (next ? next : vendor_alias);
+    return state.zink_profile && function ? zink_wrap(instance, name, function) : function;
 }
