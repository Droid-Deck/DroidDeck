--- /dev/null
+++ b/hybris/vulkan/compat/zink_profile.c
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define VK_NO_PROTOTYPES
+#include "zink_profile.h"
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/auxv.h>
+
+static pthread_once_t config_once = PTHREAD_ONCE_INIT;
+static int enabled;
+static void configure(void)
+{
+    if (getauxval(AT_SECURE)) return;
+    /* HYBRIS_VULKAN_COMPAT_ZINK_PROFILE=0 keeps the driver's profile, =1 forces this on any HAL.
+     * Unset: only on the PowerVR HAL, the one whose blob is known to carry the profile. */
+    const char *value = getenv("HYBRIS_VULKAN_COMPAT_ZINK_PROFILE");
+    const char *hal = getenv("HYBRIS_VULKAN_HAL");
+    enabled = value ? strcmp(value, "0") != 0 : hal && strstr(hal, "powervr") != NULL;
+}
+
+const char *hybris_zink_profile_engine(const VkApplicationInfo *application)
+{
+    pthread_once(&config_once, configure);
+    if (!enabled || !application || !application->pEngineName || strcmp(application->pEngineName, "mesa zink"))
+        return NULL;
+    static int logged;
+    if (!__atomic_exchange_n(&logged, 1, __ATOMIC_RELAXED))
+        fprintf(stderr, "HYBRIS_ZINK_PROFILE engine \"mesa zink\" presented as \"Mesa zink\"; vertex input dynamic state kept\n");
+    /* the blob matches "mesa zink" case-sensitively, anywhere in the name */
+    return "Mesa zink";
+}
+
+void hybris_zink_profile_features(VkPhysicalDeviceFeatures *f)
+{
+    f->sparseBinding = f->sparseResidencyBuffer = f->sparseResidencyImage2D = f->sparseResidencyImage3D = VK_FALSE;
+    f->sparseResidency2Samples = f->sparseResidency4Samples = f->sparseResidency8Samples = VK_FALSE;
+    f->sparseResidency16Samples = f->sparseResidencyAliased = VK_FALSE;
+}
+
+/* Measured on DXT-48-1536 driver 25.3@6908880 (engine "mesa zink" vs another name, same chain). The
+ * profile also turns on primitivesGeneratedQueryWithNonZeroStreams and geometryStreams; those cannot
+ * be restored from here, and Zink still reports GL 4.6 without them. */
+void hybris_zink_profile_features2(VkPhysicalDeviceFeatures2 *features)
+{
+    hybris_zink_profile_features(&features->features);
+    for (VkBaseOutStructure *node = features->pNext; node; node = node->pNext) {
+        if (node->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_GRAPHICS_PIPELINE_LIBRARY_FEATURES_EXT) {
+            ((VkPhysicalDeviceGraphicsPipelineLibraryFeaturesEXT *)node)->graphicsPipelineLibrary = VK_FALSE;
+        } else if (node->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_3_FEATURES_EXT) {
+            VkPhysicalDeviceExtendedDynamicState3FeaturesEXT *eds3 = (void *)node;
+            eds3->extendedDynamicState3TessellationDomainOrigin = VK_FALSE;
+            eds3->extendedDynamicState3DepthClampEnable = VK_FALSE;
+            eds3->extendedDynamicState3PolygonMode = VK_FALSE;
+            eds3->extendedDynamicState3SampleMask = VK_FALSE;
+            eds3->extendedDynamicState3AlphaToOneEnable = VK_FALSE;
+            eds3->extendedDynamicState3DepthClipEnable = VK_FALSE;
+            eds3->extendedDynamicState3ProvokingVertexMode = VK_FALSE;
+            eds3->extendedDynamicState3LineRasterizationMode = VK_FALSE;
+        }
+    }
+}
diff --git a/hybris/vulkan/compat/zink_profile.h b/hybris/vulkan/compat/zink_profile.h
new file mode 100644
--- /dev/null
+++ b/hybris/vulkan/compat/zink_profile.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef HYBRIS_ZINK_PROFILE_H
+#define HYBRIS_ZINK_PROFILE_H
+#include <vulkan/vulkan.h>
+/* The PowerVR blob gives engine "mesa zink" an application profile. Besides other feature changes,
+ * it hides vertexInputDynamicState, and without dynamic vertex input Mesa 26.2's Zink keeps a stale
+ * pipeline when only vertex formats change between draws (LÖVE's glyph quads read their unorm16
+ * texcoords as float, so all text is invisible). Zink is presented to the driver under another
+ * engine name, and every other feature the profile hides stays hidden. */
+/* The engine name to create the instance with instead, or NULL to keep the application's. */
+const char *hybris_zink_profile_engine(const VkApplicationInfo *application);
+/* Clear what the profile hides, except vertexInputDynamicState. */
+void hybris_zink_profile_features(VkPhysicalDeviceFeatures *features);
+void hybris_zink_profile_features2(VkPhysicalDeviceFeatures2 *features);
+#endif
