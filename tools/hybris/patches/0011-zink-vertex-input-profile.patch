+/* Instances whose Zink engine name was changed: hide what the driver's Zink profile would have. */
+static void VKAPI_CALL zink_features(VkPhysicalDevice physical, VkPhysicalDeviceFeatures *out)
+{
+    struct instance_state state;
+    if (!instance_snapshot(physical, &state) || !state.features) return;
+    state.features(physical, out);
+    hybris_zink_profile_features(out);
+}
+static void VKAPI_CALL zink_features2(VkPhysicalDevice physical, VkPhysicalDeviceFeatures2 *out)
+{
+    struct instance_state state;
+    if (!instance_snapshot(physical, &state) || !state.features2) return;
+    state.features2(physical, out);
+    hybris_zink_profile_features2(out);
+}
+static void VKAPI_CALL zink_features2_khr(VkPhysicalDevice physical, VkPhysicalDeviceFeatures2 *out)
+{
+    struct instance_state state;
+    if (!instance_snapshot(physical, &state) || !state.features2_khr) return;
+    state.features2_khr(physical, out);
+    hybris_zink_profile_features2(out);
+}
+static PFN_vkVoidFunction zink_wrap(VkInstance instance, const char *name, PFN_vkVoidFunction function)
+{
+    PFN_vkVoidFunction wrapper = NULL;
+    void *key = hybris_layer_dispatch_key(instance);
+    pthread_mutex_lock(&guard);
+    for (struct instance_state *state = instances; state; state = state->next) {
+        if (state->key != key) continue;
+        if (!strcmp(name, "vkGetPhysicalDeviceFeatures")) {
+            state->features = (PFN_vkGetPhysicalDeviceFeatures)function;
+            wrapper = (PFN_vkVoidFunction)zink_features;
+        } else if (!strcmp(name, "vkGetPhysicalDeviceFeatures2")) {
+            state->features2 = (PFN_vkGetPhysicalDeviceFeatures2)function;
+            wrapper = (PFN_vkVoidFunction)zink_features2;
+        } else if (!strcmp(name, "vkGetPhysicalDeviceFeatures2KHR")) {
+            state->features2_khr = (PFN_vkGetPhysicalDeviceFeatures2)function;
+            wrapper = (PFN_vkVoidFunction)zink_features2_khr;
+        }
+        break;
+    }
+    pthread_mutex_unlock(&guard);
+    return wrapper ? wrapper : function;
+}
+
