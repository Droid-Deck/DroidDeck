diff --git a/hybris/vulkan/compat/vendor_compat.c b/hybris/vulkan/compat/vendor_compat.c
new file mode 100644
index 0000000..5cb672c
--- /dev/null
+++ b/hybris/vulkan/compat/vendor_compat.c
@@ -0,0 +1,557 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#define VK_NO_PROTOTYPES
+#include "vendor_compat.h"
+#include "bc_policy.h"
+#include "../layer/layer.h"
+#include "scaled_vertex.h"
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/auxv.h>
+
+struct sampler_state {
+    VkSampler handle;
+    VkAllocationCallbacks allocator;
+    int custom_allocator;
+    struct sampler_state *next;
+};
+struct vendor_device {
+    VkDevice handle;
+    VkPhysicalDevice physical;
+    PFN_vkGetDeviceProcAddr resolver;
+    PFN_vkCreateSampler create_sampler;
+    PFN_vkDestroySampler destroy_sampler;
+    PFN_vkCreateDescriptorSetLayout create_layout;
+    PFN_vkGetCalibratedTimestampsEXT timestamps_ext;
+    VkSampler fallback;
+    int immutable_ycbcr;
+    int calibrated_alias;
+    int calibrated_khr_enabled;
+    int calibrated_ext_enabled;
+    VkAllocationCallbacks allocator;
+    int custom_allocator;
+    struct sampler_state *samplers;
+    struct vendor_device *next;
+};
+static pthread_mutex_t guard = PTHREAD_MUTEX_INITIALIZER;
+static struct vendor_device *devices;
+
+static void *array_alloc(const VkAllocationCallbacks *allocator, size_t count, size_t size)
+{
+    if (size && count > SIZE_MAX / size) return NULL;
+    return hybris_scaled_alloc(allocator, count * size, VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+}
+
+struct vendor_policy {
+    uint32_t vendor_id;
+    uint32_t device_id;
+    uint32_t driver_version;
+    int xclipse;
+    int native_bc;
+    int sampler_ycbcr;
+    int calibrated_khr_advertised;
+    int calibrated_ext_advertised;
+    int calibrated_compatible;
+    int calibrated_domain_alias;
+    int calibrated_timestamps_alias;
+};
+
+static int xclipse_hal(void)
+{
+    const char *path = getauxval(AT_SECURE) ? NULL : getenv("HYBRIS_VULKAN_HAL");
+    if (!path) return 0;
+    const char *base = strrchr(path, '/');
+    base = base ? base + 1 : path;
+    return !strcmp(base, "vulkan.samsung.so");
+}
+
+static int xclipse_name(const char *name)
+{
+    return !strncmp(name, "Xclipse ", 8) || !strncmp(name, "Samsung Xclipse ", 16);
+}
+
+static int extension_advertised(VkPhysicalDevice physical,
+    const struct hybris_layer_physical *context, const char *name)
+{
+    PFN_vkEnumerateDeviceExtensionProperties enumerate =
+        (PFN_vkEnumerateDeviceExtensionProperties)context->resolver(context->instance,
+            "vkEnumerateDeviceExtensionProperties");
+    if (!enumerate) return 0;
+    uint32_t count = 0;
+    if (enumerate(physical, NULL, &count, NULL) != VK_SUCCESS) return 0;
+    VkExtensionProperties *extensions = count ? calloc(count, sizeof(*extensions)) : NULL;
+    if (count && !extensions) return 0;
+    VkResult result = enumerate(physical, NULL, &count, extensions);
+    int found = 0;
+    if (result == VK_SUCCESS || result == VK_INCOMPLETE)
+        for (uint32_t i = 0; i < count && !found; ++i)
+            found = !strcmp(extensions[i].extensionName, name);
+    free(extensions);
+    return found;
+}
+
+static int physical_policy(VkPhysicalDevice physical, struct vendor_policy *out)
+{
+    struct hybris_layer_physical context;
+    if (!hybris_layer_lookup_physical(physical, &context)) return 0;
+    PFN_vkGetPhysicalDeviceProperties properties_query =
+        (PFN_vkGetPhysicalDeviceProperties)context.resolver(context.instance,
+            "vkGetPhysicalDeviceProperties");
+    if (!properties_query) return 0;
+    VkPhysicalDeviceProperties properties;
+    memset(&properties, 0, sizeof(properties));
+    properties_query(physical, &properties);
+    properties.deviceName[VK_MAX_PHYSICAL_DEVICE_NAME_SIZE - 1] = '\0';
+
+    *out = (struct vendor_policy){.vendor_id = properties.vendorID,
+        .device_id = properties.deviceID, .driver_version = properties.driverVersion,
+        .xclipse = xclipse_hal() && xclipse_name(properties.deviceName)};
+    PFN_vkGetPhysicalDeviceFeatures features_query =
+        (PFN_vkGetPhysicalDeviceFeatures)context.resolver(context.instance,
+            "vkGetPhysicalDeviceFeatures");
+    if (features_query) {
+        VkPhysicalDeviceFeatures features;
+        memset(&features, 0, sizeof(features));
+        features_query(physical, &features);
+        out->native_bc = features.textureCompressionBC;
+    }
+    if (out->xclipse) {
+        int core_features2 = context.api_version >= VK_API_VERSION_1_1 &&
+            properties.apiVersion >= VK_API_VERSION_1_1;
+        PFN_vkGetPhysicalDeviceFeatures2 features2_query = core_features2 ?
+            (PFN_vkGetPhysicalDeviceFeatures2)context.resolver(context.instance,
+                "vkGetPhysicalDeviceFeatures2") : NULL;
+        if (!features2_query)
+            features2_query = (PFN_vkGetPhysicalDeviceFeatures2)
+                context.resolver(context.instance, "vkGetPhysicalDeviceFeatures2KHR");
+        if (features2_query) {
+            VkPhysicalDeviceSamplerYcbcrConversionFeatures ycbcr = {
+                .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SAMPLER_YCBCR_CONVERSION_FEATURES};
+            VkPhysicalDeviceFeatures2 features2 = {
+                .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &ycbcr};
+            features2_query(physical, &features2);
+            out->sampler_ycbcr = ycbcr.samplerYcbcrConversion;
+        }
+    }
+    out->calibrated_khr_advertised = extension_advertised(physical, &context,
+        VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME);
+    out->calibrated_ext_advertised = extension_advertised(physical, &context,
+        VK_EXT_CALIBRATED_TIMESTAMPS_EXTENSION_NAME);
+    out->calibrated_compatible = out->calibrated_khr_advertised &&
+        out->calibrated_ext_advertised;
+    out->calibrated_domain_alias = out->calibrated_compatible &&
+        !context.resolver(context.instance, "vkGetPhysicalDeviceCalibrateableTimeDomainsKHR") &&
+        context.resolver(context.instance, "vkGetPhysicalDeviceCalibrateableTimeDomainsEXT");
+    out->calibrated_timestamps_alias = out->calibrated_compatible &&
+        !context.resolver(context.instance, "vkGetCalibratedTimestampsKHR") &&
+        context.resolver(context.instance, "vkGetCalibratedTimestampsEXT");
+    return 1;
+}
+
+int hybris_vendor_xclipse_physical(VkPhysicalDevice physical)
+{
+    struct vendor_policy policy;
+    return physical_policy(physical, &policy) && policy.xclipse;
+}
+
+int hybris_vendor_xclipse_bc(VkPhysicalDevice physical)
+{
+    struct vendor_policy policy;
+    return physical_policy(physical, &policy) && policy.xclipse && !policy.native_bc &&
+        hybris_bc_physical_mask(physical);
+}
+
+int hybris_vendor_full_bc_feature(VkPhysicalDevice physical)
+{
+    (void)physical;
+    /* The current per-format decoder omits BC1 RGB and does not provide every
+     * BLIT_SRC/FILTER_LINEAR guarantee required by textureCompressionBC. */
+    return 0;
+}
+
+const char *hybris_vendor_compat_reason(VkPhysicalDevice physical,
+    enum hybris_vendor_compat_workaround workaround)
+{
+    struct vendor_policy policy;
+    if (!physical_policy(physical, &policy)) return NULL;
+    if (workaround == HYBRIS_VENDOR_VIRTUAL_BC && policy.xclipse && !policy.native_bc &&
+        hybris_bc_physical_mask(physical))
+        return "xclipse-hal-and-device/native-bc-missing/per-format-decoder-present";
+    if (workaround == HYBRIS_VENDOR_IMMUTABLE_YCBCR && policy.xclipse && policy.sampler_ycbcr)
+        return "xclipse-hal-and-device/sampler-ycbcr-feature";
+    if (workaround == HYBRIS_VENDOR_CALIBRATED_TIMESTAMPS_ALIAS &&
+        (policy.calibrated_domain_alias || policy.calibrated_timestamps_alias))
+        return "khr-and-ext-advertised/per-command-native-first/ext-enabled-fallback";
+    return NULL;
+}
+
+void hybris_vendor_adjust_bc_format(VkPhysicalDevice physical, VkFormat format,
+    VkFormatProperties *properties)
+{
+    if (!hybris_vendor_xclipse_bc(physical) ||
+        format < VK_FORMAT_BC4_UNORM_BLOCK || format > VK_FORMAT_BC5_SNORM_BLOCK ||
+        !(properties->optimalTilingFeatures & VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT)) return;
+    properties->optimalTilingFeatures |= VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+}
+
+static int extension_enabled(const VkDeviceCreateInfo *info, const char *name)
+{
+    for (uint32_t i = 0; i < info->enabledExtensionCount; ++i)
+        if (!strcmp(info->ppEnabledExtensionNames[i], name)) return 1;
+    return 0;
+}
+
+VkResult hybris_vendor_prepare_device(VkPhysicalDevice physical,
+    const VkDeviceCreateInfo *info, const VkAllocationCallbacks *allocator,
+    struct hybris_vendor_device_create *out)
+{
+    *out = (struct hybris_vendor_device_create){.info = *info};
+    struct vendor_policy policy;
+    if (!physical_policy(physical, &policy) || !policy.calibrated_compatible ||
+        !extension_enabled(info, VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME) ||
+        extension_enabled(info, VK_EXT_CALIBRATED_TIMESTAMPS_EXTENSION_NAME)) return VK_SUCCESS;
+    if (info->enabledExtensionCount == UINT32_MAX) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    size_t count = (size_t)info->enabledExtensionCount + 1;
+    out->extensions = array_alloc(allocator, count, sizeof(*out->extensions));
+    if (!out->extensions) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    if (info->enabledExtensionCount)
+        memcpy(out->extensions, info->ppEnabledExtensionNames,
+            info->enabledExtensionCount * sizeof(*out->extensions));
+    out->extensions[info->enabledExtensionCount] =
+        VK_EXT_CALIBRATED_TIMESTAMPS_EXTENSION_NAME;
+    out->info.enabledExtensionCount = (uint32_t)count;
+    out->info.ppEnabledExtensionNames = out->extensions;
+    return VK_SUCCESS;
+}
+
+void hybris_vendor_release_device_create(struct hybris_vendor_device_create *prepared,
+    const VkAllocationCallbacks *allocator)
+{
+    hybris_scaled_free(allocator, prepared->extensions);
+    prepared->extensions = NULL;
+}
+
+static int snapshot(VkDevice handle, struct vendor_device *out)
+{
+    int found = 0;
+    pthread_mutex_lock(&guard);
+    for (const struct vendor_device *device = devices; device; device = device->next)
+        if (device->handle == handle) { *out = *device; found = 1; break; }
+    pthread_mutex_unlock(&guard);
+    return found;
+}
+
+VkResult hybris_vendor_attach_device(VkDevice handle, VkPhysicalDevice physical,
+    PFN_vkGetDeviceProcAddr resolver, const VkDeviceCreateInfo *info,
+    const VkAllocationCallbacks *allocator)
+{
+    struct vendor_policy policy;
+    if (!physical_policy(physical, &policy)) return VK_SUCCESS;
+    int calibrated_khr_enabled = extension_enabled(info,
+        VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME);
+    int calibrated_ext_enabled = extension_enabled(info,
+        VK_EXT_CALIBRATED_TIMESTAMPS_EXTENSION_NAME);
+    PFN_vkGetCalibratedTimestampsKHR timestamps_khr =
+        (PFN_vkGetCalibratedTimestampsKHR)resolver(handle, "vkGetCalibratedTimestampsKHR");
+    PFN_vkGetCalibratedTimestampsEXT timestamps_ext =
+        (PFN_vkGetCalibratedTimestampsEXT)resolver(handle, "vkGetCalibratedTimestampsEXT");
+    int calibrated_alias = policy.calibrated_compatible && calibrated_khr_enabled &&
+        calibrated_ext_enabled && !timestamps_khr && timestamps_ext;
+    int immutable_ycbcr = policy.xclipse && policy.sampler_ycbcr;
+    if (!immutable_ycbcr && !calibrated_alias) return VK_SUCCESS;
+    PFN_vkCreateSampler create = (PFN_vkCreateSampler)resolver(handle, "vkCreateSampler");
+    PFN_vkDestroySampler destroy = (PFN_vkDestroySampler)resolver(handle, "vkDestroySampler");
+    PFN_vkCreateDescriptorSetLayout layout = (PFN_vkCreateDescriptorSetLayout)
+        resolver(handle, "vkCreateDescriptorSetLayout");
+    struct vendor_device *device = hybris_scaled_alloc(allocator, sizeof(*device),
+        VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+    if (!device) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    *device = (struct vendor_device){.handle = handle, .physical = physical, .resolver = resolver,
+        .create_sampler = create, .destroy_sampler = destroy, .create_layout = layout,
+        .timestamps_ext = timestamps_ext, .immutable_ycbcr = immutable_ycbcr,
+        .calibrated_alias = calibrated_alias,
+        .calibrated_khr_enabled = calibrated_khr_enabled,
+        .calibrated_ext_enabled = calibrated_ext_enabled,
+        .custom_allocator = allocator != NULL};
+    if (allocator) device->allocator = *allocator;
+    if (immutable_ycbcr) {
+        if (!create || !destroy || !layout) {
+            hybris_scaled_free(allocator, device);
+            return VK_ERROR_FEATURE_NOT_PRESENT;
+        }
+        VkSamplerCreateInfo info = {.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+            .magFilter = VK_FILTER_LINEAR, .minFilter = VK_FILTER_LINEAR,
+            .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+            .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+            .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+            .borderColor = VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK};
+        VkResult result = create(handle, &info, allocator, &device->fallback);
+        if (result != VK_SUCCESS) {
+            hybris_scaled_free(allocator, device);
+            return result;
+        }
+    }
+    pthread_mutex_lock(&guard);
+    device->next = devices;
+    devices = device;
+    pthread_mutex_unlock(&guard);
+    return VK_SUCCESS;
+}
+
+void hybris_vendor_release_device(VkDevice handle)
+{
+    struct vendor_device *retired = NULL;
+    pthread_mutex_lock(&guard);
+    for (struct vendor_device **slot = &devices; *slot; slot = &(*slot)->next)
+        if ((*slot)->handle == handle) { retired = *slot; *slot = retired->next; break; }
+    pthread_mutex_unlock(&guard);
+    if (!retired) return;
+    struct sampler_state *sampler = retired->samplers;
+    while (sampler) {
+        struct sampler_state *next = sampler->next;
+        hybris_scaled_free(sampler->custom_allocator ? &sampler->allocator : NULL, sampler);
+        sampler = next;
+    }
+    if (retired->fallback && retired->destroy_sampler)
+        retired->destroy_sampler(handle, retired->fallback,
+            retired->custom_allocator ? &retired->allocator : NULL);
+    hybris_scaled_free(retired->custom_allocator ? &retired->allocator : NULL, retired);
+}
+
+/* Called with guard held; always walk the live list rather than a snapshot whose
+ * head can be retired by an unrelated sampler destruction. */
+static int ycbcr_sampler(VkDevice handle, VkSampler sampler_handle)
+{
+    for (const struct vendor_device *device = devices; device; device = device->next) {
+        if (device->handle != handle) continue;
+        for (const struct sampler_state *sampler = device->samplers; sampler; sampler = sampler->next)
+            if (sampler->handle == sampler_handle) return 1;
+        break;
+    }
+    return 0;
+}
+
+static VkResult VKAPI_CALL create_sampler(VkDevice handle, const VkSamplerCreateInfo *info,
+    const VkAllocationCallbacks *allocator, VkSampler *out)
+{
+    struct vendor_device device;
+    if (!snapshot(handle, &device)) {
+        struct hybris_layer_device layer;
+        if (!hybris_layer_lookup_device(handle, &layer)) return VK_ERROR_INITIALIZATION_FAILED;
+        return ((PFN_vkCreateSampler)layer.resolver(handle, "vkCreateSampler"))
+            (handle, info, allocator, out);
+    }
+    if (!device.create_sampler) return VK_ERROR_INITIALIZATION_FAILED;
+    VkResult result = device.create_sampler(handle, info, allocator, out);
+    if (result != VK_SUCCESS) return result;
+    if (!device.immutable_ycbcr) return VK_SUCCESS;
+    int ycbcr = 0;
+    for (const VkBaseInStructure *node = info->pNext; node && !ycbcr; node = node->pNext)
+        ycbcr = node->sType == VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_INFO;
+    if (!ycbcr) return VK_SUCCESS;
+    struct sampler_state *sampler = hybris_scaled_alloc(allocator, sizeof(*sampler),
+        VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+    if (!sampler) {
+        device.destroy_sampler(handle, *out, allocator);
+        *out = VK_NULL_HANDLE;
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+    *sampler = (struct sampler_state){.handle = *out, .custom_allocator = allocator != NULL};
+    if (allocator) sampler->allocator = *allocator;
+    pthread_mutex_lock(&guard);
+    for (struct vendor_device *live = devices; live; live = live->next)
+        if (live->handle == handle) { sampler->next = live->samplers; live->samplers = sampler; sampler = NULL; break; }
+    pthread_mutex_unlock(&guard);
+    if (sampler) {
+        hybris_scaled_free(allocator, sampler);
+        device.destroy_sampler(handle, *out, allocator);
+        *out = VK_NULL_HANDLE;
+        return VK_ERROR_INITIALIZATION_FAILED;
+    }
+    return VK_SUCCESS;
+}
+
+static void VKAPI_CALL destroy_sampler(VkDevice handle, VkSampler sampler,
+    const VkAllocationCallbacks *allocator)
+{
+    struct vendor_device device;
+    if (!snapshot(handle, &device)) {
+        struct hybris_layer_device layer;
+        if (hybris_layer_lookup_device(handle, &layer))
+            ((PFN_vkDestroySampler)layer.resolver(handle, "vkDestroySampler"))
+                (handle, sampler, allocator);
+        return;
+    }
+    if (!device.destroy_sampler) return;
+    struct sampler_state *retired = NULL;
+    pthread_mutex_lock(&guard);
+    for (struct vendor_device *live = devices; live && !retired; live = live->next) {
+        if (live->handle != handle) continue;
+        for (struct sampler_state **slot = &live->samplers; *slot; slot = &(*slot)->next)
+            if ((*slot)->handle == sampler) { retired = *slot; *slot = retired->next; break; }
+    }
+    pthread_mutex_unlock(&guard);
+    hybris_scaled_free(retired && retired->custom_allocator ? &retired->allocator : NULL, retired);
+    device.destroy_sampler(handle, sampler, allocator);
+}
+
+static VkResult VKAPI_CALL create_layout(VkDevice handle,
+    const VkDescriptorSetLayoutCreateInfo *info, const VkAllocationCallbacks *allocator,
+    VkDescriptorSetLayout *out)
+{
+    struct vendor_device device;
+    if (!snapshot(handle, &device)) {
+        struct hybris_layer_device layer;
+        if (!hybris_layer_lookup_device(handle, &layer)) return VK_ERROR_INITIALIZATION_FAILED;
+        return ((PFN_vkCreateDescriptorSetLayout)layer.resolver(handle,
+            "vkCreateDescriptorSetLayout"))(handle, info, allocator, out);
+    }
+    if (!device.fallback || !device.create_layout)
+        return device.create_layout ? device.create_layout(handle, info, allocator, out) :
+            VK_ERROR_INITIALIZATION_FAILED;
+    int replace = 0;
+    pthread_mutex_lock(&guard);
+    for (uint32_t b = 0; b < info->bindingCount && !replace; ++b) {
+        const VkDescriptorSetLayoutBinding *binding = &info->pBindings[b];
+        if (binding->descriptorType != VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER ||
+            !(binding->stageFlags & VK_SHADER_STAGE_COMPUTE_BIT) ||
+            !binding->pImmutableSamplers) continue;
+        for (uint32_t s = 0; s < binding->descriptorCount; ++s)
+            if (ycbcr_sampler(handle, binding->pImmutableSamplers[s])) { replace = 1; break; }
+    }
+    pthread_mutex_unlock(&guard);
+    if (!replace) return device.create_layout(handle, info, allocator, out);
+
+    VkResult result = VK_ERROR_OUT_OF_HOST_MEMORY;
+    VkDescriptorSetLayoutBinding *bindings = array_alloc(allocator,
+        info->bindingCount, sizeof(*bindings));
+    VkSampler **arrays = array_alloc(allocator, info->bindingCount, sizeof(*arrays));
+    if (arrays) memset(arrays, 0, info->bindingCount * sizeof(*arrays));
+    if (!bindings || !arrays) goto done;
+    for (uint32_t b = 0; b < info->bindingCount; ++b) {
+        bindings[b] = info->pBindings[b];
+        if (bindings[b].descriptorType != VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER ||
+            !(bindings[b].stageFlags & VK_SHADER_STAGE_COMPUTE_BIT) ||
+            !bindings[b].pImmutableSamplers) continue;
+        arrays[b] = array_alloc(allocator, bindings[b].descriptorCount, sizeof(VkSampler));
+        if (bindings[b].descriptorCount && !arrays[b]) goto done;
+        pthread_mutex_lock(&guard);
+        for (uint32_t s = 0; s < bindings[b].descriptorCount; ++s) {
+            VkSampler original = bindings[b].pImmutableSamplers[s];
+            arrays[b][s] = ycbcr_sampler(handle, original) ? device.fallback : original;
+        }
+        pthread_mutex_unlock(&guard);
+        bindings[b].pImmutableSamplers = arrays[b];
+    }
+    VkDescriptorSetLayoutCreateInfo patched = *info;
+    patched.pBindings = bindings;
+    result = device.create_layout(handle, &patched, allocator, out);
+done:
+    for (uint32_t b = 0; arrays && b < info->bindingCount; ++b)
+        hybris_scaled_free(allocator, arrays[b]);
+    hybris_scaled_free(allocator, arrays);
+    hybris_scaled_free(allocator, bindings);
+    return result;
+}
+
+static VkResult VKAPI_CALL time_domains_khr(VkPhysicalDevice physical, uint32_t *count,
+    VkTimeDomainKHR *domains)
+{
+    struct hybris_layer_physical context;
+    if (!hybris_layer_lookup_physical(physical, &context)) return VK_ERROR_INITIALIZATION_FAILED;
+    PFN_vkGetPhysicalDeviceCalibrateableTimeDomainsKHR native =
+        (PFN_vkGetPhysicalDeviceCalibrateableTimeDomainsKHR)
+            context.resolver(context.instance, "vkGetPhysicalDeviceCalibrateableTimeDomainsKHR");
+    if (native) return native(physical, count, domains);
+    struct vendor_policy policy;
+    PFN_vkGetPhysicalDeviceCalibrateableTimeDomainsEXT ext =
+        (PFN_vkGetPhysicalDeviceCalibrateableTimeDomainsEXT)
+            context.resolver(context.instance, "vkGetPhysicalDeviceCalibrateableTimeDomainsEXT");
+    if (!physical_policy(physical, &policy) || !policy.calibrated_domain_alias || !ext) {
+        *count = 0;
+        return VK_ERROR_FEATURE_NOT_PRESENT;
+    }
+    return ext(physical, count, (VkTimeDomainEXT *)domains);
+}
+
+static VkResult VKAPI_CALL timestamps_khr(VkDevice handle, uint32_t count,
+    const VkCalibratedTimestampInfoKHR *infos, uint64_t *timestamps, uint64_t *deviation)
+{
+    struct vendor_device vendor;
+    int found = snapshot(handle, &vendor);
+    if (found) {
+        PFN_vkGetCalibratedTimestampsKHR native = (PFN_vkGetCalibratedTimestampsKHR)
+            vendor.resolver(handle, "vkGetCalibratedTimestampsKHR");
+        if (native) return native(handle, count, infos, timestamps, deviation);
+    }
+    if (found && vendor.calibrated_alias &&
+        vendor.calibrated_khr_enabled && vendor.calibrated_ext_enabled && vendor.timestamps_ext)
+        return vendor.timestamps_ext(handle, count,
+            (const VkCalibratedTimestampInfoEXT *)infos, timestamps, deviation);
+    struct hybris_layer_device device;
+    if (!hybris_layer_lookup_device(handle, &device)) return VK_ERROR_INITIALIZATION_FAILED;
+    PFN_vkGetCalibratedTimestampsKHR query = (PFN_vkGetCalibratedTimestampsKHR)
+        device.resolver(handle, "vkGetCalibratedTimestampsKHR");
+    return query ? query(handle, count, infos, timestamps, deviation) : VK_ERROR_FEATURE_NOT_PRESENT;
+}
+
+PFN_vkVoidFunction hybris_vendor_physical_proc(const char *name)
+{
+    (void)name;
+    return NULL;
+}
+
+PFN_vkVoidFunction hybris_vendor_device_proc(const char *name)
+{
+    if (!strcmp(name, "vkCreateSampler")) return (PFN_vkVoidFunction)create_sampler;
+    if (!strcmp(name, "vkDestroySampler")) return (PFN_vkVoidFunction)destroy_sampler;
+    if (!strcmp(name, "vkCreateDescriptorSetLayout")) return (PFN_vkVoidFunction)create_layout;
+    return NULL;
+}
+
+static int instance_has_calibrated_alias(VkInstance instance,
+    PFN_vkGetInstanceProcAddr resolver, int domains)
+{
+    PFN_vkEnumeratePhysicalDevices enumerate = (PFN_vkEnumeratePhysicalDevices)
+        resolver(instance, "vkEnumeratePhysicalDevices");
+    if (!enumerate) return 0;
+    uint32_t count = 0;
+    if (enumerate(instance, &count, NULL) != VK_SUCCESS) return 0;
+    VkPhysicalDevice *physical = count ? calloc(count, sizeof(*physical)) : NULL;
+    if (count && !physical) return 0;
+    VkResult result = enumerate(instance, &count, physical);
+    int found = 0;
+    if (result == VK_SUCCESS || result == VK_INCOMPLETE)
+        for (uint32_t i = 0; i < count && !found; ++i) {
+            struct vendor_policy policy;
+            found = physical_policy(physical[i], &policy) &&
+                (domains ? policy.calibrated_domain_alias : policy.calibrated_timestamps_alias);
+        }
+    free(physical);
+    return found;
+}
+
+PFN_vkVoidFunction hybris_vendor_physical_alias_proc(VkInstance instance,
+    PFN_vkGetInstanceProcAddr resolver, const char *name)
+{
+    int domains = !strcmp(name, "vkGetPhysicalDeviceCalibrateableTimeDomainsKHR");
+    int timestamps = !strcmp(name, "vkGetCalibratedTimestampsKHR");
+    if ((!domains && !timestamps) || resolver(instance, name) ||
+        !instance_has_calibrated_alias(instance, resolver, domains)) return NULL;
+    if (domains && resolver(instance, "vkGetPhysicalDeviceCalibrateableTimeDomainsEXT"))
+        return (PFN_vkVoidFunction)time_domains_khr;
+    if (timestamps && resolver(instance, "vkGetCalibratedTimestampsEXT"))
+        return (PFN_vkVoidFunction)timestamps_khr;
+    return NULL;
+}
+
+PFN_vkVoidFunction hybris_vendor_device_alias_proc(VkDevice handle, const char *name)
+{
+    if (strcmp(name, "vkGetCalibratedTimestampsKHR")) return NULL;
+    struct vendor_device device;
+    return snapshot(handle, &device) && device.calibrated_alias &&
+        device.calibrated_khr_enabled && device.calibrated_ext_enabled && device.timestamps_ext &&
+        !device.resolver(handle, "vkGetCalibratedTimestampsKHR") ?
+        (PFN_vkVoidFunction)timestamps_khr : NULL;
+}
