new file mode 100644
index 0000000..d259d0f
--- /dev/null
+++ b/hybris/common/vendor_compat.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#include "vendor_compat.h"
+#include <hybris/common/dlfcn.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern char **environ;
+
+static pthread_mutex_t environ_guard = PTHREAD_MUTEX_INITIALIZER;
+static int bionic_environ_ready;
+
+static int prepare_bionic_environ(void)
+{
+    int ready = 0;
+    pthread_mutex_lock(&environ_guard);
+    if (bionic_environ_ready) {
+        pthread_mutex_unlock(&environ_guard);
+        return 1;
+    }
+    void *libc = hybris_dlopen("libc.so", RTLD_NOW | RTLD_LOCAL);
+    char ***bionic_environ = libc ? (char ***)hybris_dlsym(libc, "environ") : NULL;
+    if (!bionic_environ) goto done;
+    if (*bionic_environ) {
+        bionic_environ_ready = ready = 1;
+        goto done;
+    }
+
+    size_t count = 0;
+    while (environ && environ[count]) ++count;
+    char **snapshot = calloc(count + 1, sizeof(*snapshot));
+    if (!snapshot) goto done;
+    for (size_t i = 0; i < count; ++i) {
+        snapshot[i] = strdup(environ[i]);
+        if (!snapshot[i]) {
+            while (i) free(snapshot[--i]);
+            free(snapshot);
+            goto done;
+        }
+    }
+    *bionic_environ = snapshot;
+    bionic_environ_ready = ready = 1;
+done:
+    pthread_mutex_unlock(&environ_guard);
+    return ready;
+}
+
+int hybris_vendor_compat_prepare_vulkan_hal(const char *path)
+{
+    /* A null path asks hw_get_module() to select the HAL. Explicit vendor HALs
+     * bypass Android's loader setup and all need the same Bionic environment. */
+    if (!path || !path[0]) return 1;
+    return prepare_bionic_environ();
+}
