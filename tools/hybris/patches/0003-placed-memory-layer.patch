+#define LAYER_NAME "VK_LAYER_DROIDDECK_placed_memory"
+#define OPAQUE VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT
+#define PLACED VK_EXT_MAP_MEMORY_PLACED_EXTENSION_NAME
+#define MAP2 VK_KHR_MAP_MEMORY_2_EXTENSION_NAME
+#define FD_EXT VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME
