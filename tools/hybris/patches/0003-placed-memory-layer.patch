diff --git a/hybris/vulkan/Makefile.am b/hybris/vulkan/Makefile.am
index 6bf3a57..14444fc 100644
--- a/hybris/vulkan/Makefile.am
+++ b/hybris/vulkan/Makefile.am
@@ -3,7 +3,8 @@ if HAS_VULKAN_HEADERS
 lib_LTLIBRARIES = \
 	libvulkan.la \
 	libhybris-vulkan-icd.la \
-	libVkLayer_hybris_compat.la
+	libVkLayer_hybris_compat.la \
+	libVkLayer_DROIDDECK_placed_memory.la
 
 # Explicit loader layer, independent of Android linker/HAL/WSI libraries.
 # Its manifest is colocated with the DSO; opt in using VK_LAYER_PATH.
@@ -29,7 +30,12 @@ libVkLayer_hybris_compat_la_CFLAGS = -fvisibility=hidden
 # loader unloading its last instance. All per-instance/device state is freed.
 libVkLayer_hybris_compat_la_LDFLAGS = -module -avoid-version -no-undefined -pthread -Wl,-z,nodelete
 layerdir = $(libdir)
-layer_DATA = layer/VkLayer_hybris_compat.json
+# Placed-memory layer runs below compat so translated BC backing buffers pass
+# through its resource/export policy. Activation remains explicitly gated.
+libVkLayer_DROIDDECK_placed_memory_la_SOURCES = placed/placed_layer.c placed/chain_sizes.h placed/vulkan_compat.h
+libVkLayer_DROIDDECK_placed_memory_la_CFLAGS = -std=gnu11 -fvisibility=hidden
+libVkLayer_DROIDDECK_placed_memory_la_LDFLAGS = -module -avoid-version -no-undefined -pthread -Wl,-Bsymbolic
+layer_DATA = layer/VkLayer_hybris_compat.json placed/VkLayer_DROIDDECK_placed_memory.json
 
 libvulkan_la_SOURCES = \
 	vulkan.c \
@@ -62,7 +68,7 @@ libvulkan_la_LDFLAGS = \
 
 # Optional standard-loader backend; no default ICD JSON is installed.
 libhybris_vulkan_icd_la_SOURCES = icd/icd.c icd/instance.c icd/instance.h icd/device.c icd/device.h icd/wsi.c icd/wsi.h icd/swapchain.c icd/swapchain.h icd/vk_android_native_buffer.h icd/hwvulkan.h icd/physical_commands.inc
-EXTRA_DIST = compat/shaders/bc7.glsl compat/shaders/bc6h.glsl compat/shaders/LICENSE.bcdec icd/README.md compat/shaders/bc_decode.comp compat/shaders/generate-bc.py layer/VkLayer_hybris_compat.json
+EXTRA_DIST = placed/VkLayer_DROIDDECK_placed_memory.json compat/shaders/bc7.glsl compat/shaders/bc6h.glsl compat/shaders/LICENSE.bcdec icd/README.md compat/shaders/bc_decode.comp compat/shaders/generate-bc.py layer/VkLayer_hybris_compat.json
 libhybris_vulkan_icd_la_CFLAGS = $(libvulkan_la_CFLAGS) -fvisibility=hidden
 libhybris_vulkan_icd_la_CXXFLAGS = $(libvulkan_la_CXXFLAGS) -fvisibility=hidden
 libhybris_vulkan_icd_la_LDFLAGS = \
