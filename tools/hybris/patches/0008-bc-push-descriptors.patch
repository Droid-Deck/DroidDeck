+static int add_size(size_t *total, size_t bytes)
+{
+    if (bytes > SIZE_MAX - *total) return 0;
+    *total += bytes;
+    return 1;
+}
+
+static int align_size(size_t *total, size_t alignment)
+{
+    size_t remainder = *total % alignment;
+    return !remainder || add_size(total, alignment - remainder);
+}
+
+static int multiply_size(size_t count, size_t size, size_t *out)
+{
+    if (size && count > SIZE_MAX / size) return 0;
+    *out = count * size;
+    return 1;
+}
+
+static int descriptor_element_layout(VkDescriptorType type, size_t *size,
+    size_t *alignment)
+{
+#ifdef HYBRIS_VK_ARM_TENSOR_PAYLOAD
+    if (type == VK_DESCRIPTOR_TYPE_TENSOR_ARM) {
+        *size = sizeof(VkTensorViewARM);
+        *alignment = _Alignof(VkTensorViewARM);
+        return 1;
+    }
+#endif
+    switch (type) {
+    case VK_DESCRIPTOR_TYPE_SAMPLER:
+    case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+    case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+    case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+    case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+#ifdef VK_QCOM_image_processing
+    case VK_DESCRIPTOR_TYPE_SAMPLE_WEIGHT_IMAGE_QCOM:
+    case VK_DESCRIPTOR_TYPE_BLOCK_MATCH_IMAGE_QCOM:
+#endif
+        *size = sizeof(VkDescriptorImageInfo);
+        *alignment = _Alignof(VkDescriptorImageInfo);
+        return 1;
+    case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+    case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+        *size = sizeof(VkBufferView);
+        *alignment = _Alignof(VkBufferView);
+        return 1;
+    case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+    case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+        *size = sizeof(VkDescriptorBufferInfo);
+        *alignment = _Alignof(VkDescriptorBufferInfo);
+        return 1;
+#ifdef VK_KHR_acceleration_structure
+    case VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR:
+        *size = sizeof(VkAccelerationStructureKHR);
+        *alignment = _Alignof(VkAccelerationStructureKHR);
+        return 1;
+#endif
+#ifdef VK_NV_ray_tracing
+    case VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_NV:
+        *size = sizeof(VkAccelerationStructureNV);
+        *alignment = _Alignof(VkAccelerationStructureNV);
+        return 1;
+#endif
+#ifdef VK_NV_partitioned_acceleration_structure
+    case VK_DESCRIPTOR_TYPE_PARTITIONED_ACCELERATION_STRUCTURE_NV:
+        *size = sizeof(VkDeviceAddress);
+        *alignment = _Alignof(VkDeviceAddress);
+        return 1;
+#endif
+    default:
+        return 0;
+    }
+}
+
+enum extension_payload_kind {
+    EXTENSION_PAYLOAD_NONE,
+#ifdef VK_KHR_acceleration_structure
+    EXTENSION_PAYLOAD_ACCELERATION_KHR,
+#endif
+#ifdef VK_NV_ray_tracing
+    EXTENSION_PAYLOAD_ACCELERATION_NV,
+#endif
+#ifdef VK_NV_partitioned_acceleration_structure
+    EXTENSION_PAYLOAD_PARTITIONED_NV,
+#endif
+#ifdef HYBRIS_VK_ARM_TENSOR_PAYLOAD
+    EXTENSION_PAYLOAD_TENSOR_ARM,
+#endif
+};
+
+struct extension_payload {
+    enum extension_payload_kind kind;
+    const VkBaseInStructure *node;
+    const void *elements;
+    size_t header_size, header_alignment, element_size, element_alignment;
+    uint32_t count;
+};
+
+static int descriptor_extension_payload(const VkWriteDescriptorSet *write,
+    struct extension_payload *out)
+{
+    memset(out, 0, sizeof(*out));
+    for (const VkBaseInStructure *node = write->pNext; node; node = node->pNext) {
+        enum extension_payload_kind kind = EXTENSION_PAYLOAD_NONE;
+        const void *elements = NULL;
+        uint32_t count = 0;
+        size_t header_size = 0, header_alignment = 0, element_size = 0,
+            element_alignment = 0;
+        int matches = 0;
+#ifdef HYBRIS_VK_ARM_TENSOR_PAYLOAD
+        if (node->sType == VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_TENSOR_ARM) {
+            const VkWriteDescriptorSetTensorARM *payload = (const void *)node;
+            kind = EXTENSION_PAYLOAD_TENSOR_ARM;
+            count = payload->tensorViewCount;
+            elements = payload->pTensorViews;
+            header_size = sizeof(*payload);
+            header_alignment = _Alignof(VkWriteDescriptorSetTensorARM);
+            element_size = sizeof(VkTensorViewARM);
+            element_alignment = _Alignof(VkTensorViewARM);
+            matches = write->descriptorType == VK_DESCRIPTOR_TYPE_TENSOR_ARM;
+        } else
+#endif
+        switch (node->sType) {
+#if defined(VK_VERSION_1_3) || defined(VK_EXT_inline_uniform_block)
+        case VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_INLINE_UNIFORM_BLOCK:
+            /* Inline uniform blocks are forbidden in push layouts. The node
+             * is still legal but ignored when chained to another type. */
+            break;
+#endif
+#ifdef VK_KHR_acceleration_structure
+        case VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_ACCELERATION_STRUCTURE_KHR: {
+            const VkWriteDescriptorSetAccelerationStructureKHR *payload = (const void *)node;
+            kind = EXTENSION_PAYLOAD_ACCELERATION_KHR;
+            count = payload->accelerationStructureCount;
+            elements = payload->pAccelerationStructures;
+            header_size = sizeof(*payload);
+            header_alignment = _Alignof(VkWriteDescriptorSetAccelerationStructureKHR);
+            element_size = sizeof(VkAccelerationStructureKHR);
+            element_alignment = _Alignof(VkAccelerationStructureKHR);
+            matches = write->descriptorType == VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR;
+            break;
+        }
+#endif
+#ifdef VK_NV_ray_tracing
+        case VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_ACCELERATION_STRUCTURE_NV: {
+            const VkWriteDescriptorSetAccelerationStructureNV *payload = (const void *)node;
+            kind = EXTENSION_PAYLOAD_ACCELERATION_NV;
+            count = payload->accelerationStructureCount;
+            elements = payload->pAccelerationStructures;
+            header_size = sizeof(*payload);
+            header_alignment = _Alignof(VkWriteDescriptorSetAccelerationStructureNV);
+            element_size = sizeof(VkAccelerationStructureNV);
+            element_alignment = _Alignof(VkAccelerationStructureNV);
+            matches = write->descriptorType == VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_NV;
+            break;
+        }
+#endif
+#ifdef VK_NV_partitioned_acceleration_structure
+        case VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_PARTITIONED_ACCELERATION_STRUCTURE_NV: {
+            const VkWriteDescriptorSetPartitionedAccelerationStructureNV *payload = (const void *)node;
+            kind = EXTENSION_PAYLOAD_PARTITIONED_NV;
+            count = payload->accelerationStructureCount;
+            elements = payload->pAccelerationStructures;
+            header_size = sizeof(*payload);
+            header_alignment = _Alignof(VkWriteDescriptorSetPartitionedAccelerationStructureNV);
+            element_size = sizeof(VkDeviceAddress);
+            element_alignment = _Alignof(VkDeviceAddress);
+            matches = write->descriptorType == VK_DESCRIPTOR_TYPE_PARTITIONED_ACCELERATION_STRUCTURE_NV;
+            break;
+        }
+#endif
+        default:
+            return 0;
+        }
+        /* Recognized structures for other descriptor types are semantically
+         * ignored by Vulkan. Drop them from the canonical replay chain. */
+        if (!matches) continue;
+        if (out->kind != EXTENSION_PAYLOAD_NONE || count != write->descriptorCount ||
+            (count && !elements)) return 0;
+        *out = (struct extension_payload){.kind = kind, .node = node,
+            .elements = elements, .header_size = header_size,
+            .header_alignment = header_alignment, .element_size = element_size,
+            .element_alignment = element_alignment, .count = count};
+    }
+#ifdef HYBRIS_VK_ARM_TENSOR_PAYLOAD
+    if (write->descriptorType == VK_DESCRIPTOR_TYPE_TENSOR_ARM)
+        return out->kind != EXTENSION_PAYLOAD_NONE;
+#endif
+    switch (write->descriptorType) {
+#ifdef VK_KHR_acceleration_structure
+    case VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_KHR:
+#endif
+#ifdef VK_NV_ray_tracing
+    case VK_DESCRIPTOR_TYPE_ACCELERATION_STRUCTURE_NV:
+#endif
+#ifdef VK_NV_partitioned_acceleration_structure
+    case VK_DESCRIPTOR_TYPE_PARTITIONED_ACCELERATION_STRUCTURE_NV:
+#endif
+        return out->kind != EXTENSION_PAYLOAD_NONE;
+    default:
+        return 1;
+    }
+}
