+void hybris_bc_save_push_descriptors(struct hybris_bc_command_state *state,
+    VkPipelineLayout layout, uint32_t set, uint32_t count,
+    const VkWriteDescriptorSet *writes, VkShaderStageFlags stages,
+    const char *call_name, int info2)
+{
+    if (!count || state->error != VK_SUCCESS) return;
+    size_t write_bytes, bytes;
+    if (!multiply_size(count, sizeof(*writes), &write_bytes)) {
+        state->error = VK_ERROR_OUT_OF_HOST_MEMORY;
+        return;
+    }
+    bytes = write_bytes;
+    for (uint32_t i = 0; i < count; ++i) {
+        size_t element_size, alignment, payload = 0;
+        struct extension_payload extension;
+        if (!descriptor_element_layout(writes[i].descriptorType, &element_size, &alignment) ||
+            !descriptor_extension_payload(&writes[i], &extension)) {
+            state->error = VK_ERROR_FEATURE_NOT_PRESENT;
+            return;
+        }
+        if (extension.kind != EXTENSION_PAYLOAD_NONE) {
+            if (!align_size(&bytes, extension.header_alignment) ||
+                !add_size(&bytes, extension.header_size) ||
+                !align_size(&bytes, extension.element_alignment)) {
+                state->error = VK_ERROR_OUT_OF_HOST_MEMORY;
+                return;
+            }
+            element_size = extension.element_size;
+        } else if (!align_size(&bytes, alignment)) {
+            state->error = VK_ERROR_OUT_OF_HOST_MEMORY;
+            return;
+        }
+        if (!multiply_size(writes[i].descriptorCount, element_size, &payload) ||
+            !add_size(&bytes, payload)) {
+            state->error = VK_ERROR_OUT_OF_HOST_MEMORY;
+            return;
+        }
+    }
+    struct hybris_bc_saved_command *saved = save(state, layout, bytes);
+    if (!saved) return;
+    saved->kind = SAVED_PUSH_DESCRIPTORS;
+    saved->bind_point = VK_PIPELINE_BIND_POINT_COMPUTE;
+    saved->set = set;
+    /* Maintenance6 stage masks are equivalent to separate bind-point calls.
+     * The decoder disturbs compute only; replaying a mixed mask would overwrite
+     * newer graphics-only push state. */
+    saved->stages = info2 ? VK_SHADER_STAGE_COMPUTE_BIT : 0;
+    saved->count = count;
+    saved->call_name = call_name;
+    saved->info2 = info2;
+    VkWriteDescriptorSet *copies = (VkWriteDescriptorSet *)saved->data;
+    size_t cursor = write_bytes;
+    for (uint32_t i = 0; i < count; ++i) {
+        size_t element_size, alignment, payload = 0;
+        struct extension_payload extension;
+        descriptor_element_layout(writes[i].descriptorType, &element_size, &alignment);
+        descriptor_extension_payload(&writes[i], &extension);
+        if (extension.kind != EXTENSION_PAYLOAD_NONE) {
+            align_size(&cursor, extension.header_alignment);
+            void *header = saved->data + cursor;
+            memcpy(header, extension.node, extension.header_size);
+            ((VkBaseOutStructure *)header)->pNext = NULL;
+            copies[i] = writes[i];
+            copies[i].pNext = header;
+            copies[i].pImageInfo = NULL;
+            copies[i].pBufferInfo = NULL;
+            copies[i].pTexelBufferView = NULL;
+            cursor += extension.header_size;
+            align_size(&cursor, extension.element_alignment);
+            multiply_size(extension.count, extension.element_size, &payload);
+            void *destination = saved->data + cursor;
+            if (payload) memcpy(destination, extension.elements, payload);
+            switch (extension.kind) {
+#ifdef VK_KHR_acceleration_structure
+            case EXTENSION_PAYLOAD_ACCELERATION_KHR:
+                ((VkWriteDescriptorSetAccelerationStructureKHR *)header)->pAccelerationStructures = destination;
+                break;
+#endif
+#ifdef VK_NV_ray_tracing
+            case EXTENSION_PAYLOAD_ACCELERATION_NV:
+                ((VkWriteDescriptorSetAccelerationStructureNV *)header)->pAccelerationStructures = destination;
+                break;
+#endif
+#ifdef VK_NV_partitioned_acceleration_structure
+            case EXTENSION_PAYLOAD_PARTITIONED_NV:
+                ((VkWriteDescriptorSetPartitionedAccelerationStructureNV *)header)->pAccelerationStructures = destination;
+                break;
+#endif
+#ifdef HYBRIS_VK_ARM_TENSOR_PAYLOAD
+            case EXTENSION_PAYLOAD_TENSOR_ARM:
+                ((VkWriteDescriptorSetTensorARM *)header)->pTensorViews = destination;
+                break;
+#endif
+            default:
+                break;
+            }
+            cursor += payload;
+            continue;
+        }
+        align_size(&cursor, alignment);
+        multiply_size(writes[i].descriptorCount, element_size, &payload);
+        copies[i] = writes[i];
+        copies[i].pNext = NULL;
+        copies[i].pImageInfo = NULL;
+        copies[i].pBufferInfo = NULL;
+        copies[i].pTexelBufferView = NULL;
+        if (writes[i].descriptorCount) {
+            void *destination = saved->data + cursor;
+            const void *source;
+            switch (writes[i].descriptorType) {
+            case VK_DESCRIPTOR_TYPE_SAMPLER:
+            case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+            case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+            case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
