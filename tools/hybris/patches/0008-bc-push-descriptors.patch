+static struct hybris_bc_layout *acquire_layout(struct hybris_bc_layouts *layouts,
+    VkPipelineLayout handle)
+{
+    struct hybris_bc_layout *layout;
+    return hybris_bc_layout_acquire(layouts, handle, &layout) == VK_SUCCESS ? layout : NULL;
+}
+
+static void release_template(struct hybris_bc_layouts *layouts,
+    struct hybris_bc_template *update_template)
+{
+    pthread_mutex_lock(&layouts->guard);
+    int destroy = --update_template->references == 0;
+    pthread_mutex_unlock(&layouts->guard);
+    if (!destroy) return;
+    PFN_vkDestroyDescriptorUpdateTemplate destroy_template =
+        (PFN_vkDestroyDescriptorUpdateTemplate)layouts->resolver(layouts->device,
+            update_template->destroy_name);
+    if (destroy_template)
+        destroy_template(layouts->device, update_template->shadow, NULL);
+    hybris_bc_layout_release(layouts, update_template->layout);
+    free(update_template);
+}
+
+static struct hybris_bc_template *acquire_template(struct hybris_bc_layouts *layouts,
+    VkDescriptorUpdateTemplate handle)
+{
+    pthread_mutex_lock(&layouts->guard);
+    struct hybris_bc_template *update_template = layouts->templates;
+    while (update_template && update_template->handle != handle)
+        update_template = update_template->next;
+    if (update_template && update_template->references != SIZE_MAX)
+        ++update_template->references;
+    else update_template = NULL;
+    pthread_mutex_unlock(&layouts->guard);
+    return update_template;
+}
+
+VkResult hybris_bc_template_add(struct hybris_bc_layouts *layouts,
+    VkDescriptorUpdateTemplate handle, const VkDescriptorUpdateTemplateCreateInfo *info,
+    const char *create_name, const char *destroy_name)
+{
+    if (info->pNext || info->templateType != VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_PUSH_DESCRIPTORS ||
+        info->pipelineBindPoint != VK_PIPELINE_BIND_POINT_COMPUTE)
+        return VK_ERROR_FEATURE_NOT_PRESENT;
+    size_t entry_bytes;
+    if (!multiply_size(info->descriptorUpdateEntryCount,
+            sizeof(struct hybris_bc_template_entry), &entry_bytes) ||
+        entry_bytes > SIZE_MAX - sizeof(struct hybris_bc_template))
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    struct hybris_bc_layout *layout = acquire_layout(layouts, info->pipelineLayout);
+    if (!layout) return VK_ERROR_INITIALIZATION_FAILED;
+    struct hybris_bc_template *update_template =
+        calloc(1, sizeof(*update_template) + entry_bytes);
+    VkDescriptorUpdateTemplateEntry *normalized = info->descriptorUpdateEntryCount ?
+        calloc(info->descriptorUpdateEntryCount, sizeof(*normalized)) : NULL;
+    if (!update_template || (info->descriptorUpdateEntryCount && !normalized)) {
+        free(normalized);
+        free(update_template);
+        hybris_bc_layout_release(layouts, layout);
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+    update_template->handle = handle;
+    update_template->layout = layout;
+    update_template->references = 1;
+    update_template->entry_count = info->descriptorUpdateEntryCount;
+    update_template->destroy_name = destroy_name;
+    VkResult result = VK_SUCCESS;
+    size_t packed = 0;
+    for (uint32_t i = 0; i < info->descriptorUpdateEntryCount; ++i) {
+        const VkDescriptorUpdateTemplateEntry *source = &info->pDescriptorUpdateEntries[i];
+        size_t element_size, alignment, payload;
+        if (!descriptor_element_layout(source->descriptorType, &element_size, &alignment)) {
+            result = VK_ERROR_FEATURE_NOT_PRESENT;
+            break;
+        }
+        if (!align_size(&packed, alignment) ||
+            !multiply_size(source->descriptorCount, element_size, &payload) ||
+            !add_size(&packed, payload)) {
+            result = VK_ERROR_OUT_OF_HOST_MEMORY;
+            break;
+        }
+        if (source->descriptorCount) {
+            size_t last;
+            if (!multiply_size(source->descriptorCount - 1, source->stride, &last) ||
+                source->offset > SIZE_MAX - last ||
+                source->offset + last > SIZE_MAX - element_size) {
+                result = VK_ERROR_OUT_OF_HOST_MEMORY;
+                break;
+            }
+        }
+        update_template->entries[i] = (struct hybris_bc_template_entry){
+            .source = *source, .packed_offset = packed - payload,
+            .element_size = element_size};
+        normalized[i] = *source;
+        normalized[i].offset = packed - payload;
+        normalized[i].stride = element_size;
+    }
+    update_template->packed_size = packed;
+    if (result == VK_SUCCESS) {
+        PFN_vkCreateDescriptorUpdateTemplate create_template =
+            (PFN_vkCreateDescriptorUpdateTemplate)layouts->resolver(layouts->device, create_name);
+        if (!create_template) result = VK_ERROR_INITIALIZATION_FAILED;
+        else {
+            VkDescriptorUpdateTemplateCreateInfo shadow_info = *info;
+            shadow_info.pNext = NULL;
+            shadow_info.pDescriptorUpdateEntries = normalized;
+            shadow_info.pipelineLayout = layout->clone;
+            result = create_template(layouts->device, &shadow_info, NULL,
+                &update_template->shadow);
+        }
+    }
+    free(normalized);
+    if (result != VK_SUCCESS) {
+        hybris_bc_layout_release(layouts, layout);
+        free(update_template);
+        return result;
+    }
+    pthread_mutex_lock(&layouts->guard);
+    update_template->next = layouts->templates;
+    layouts->templates = update_template;
+    pthread_mutex_unlock(&layouts->guard);
+    return VK_SUCCESS;
+}
+
+void hybris_bc_template_remove(struct hybris_bc_layouts *layouts,
+    VkDescriptorUpdateTemplate handle)
+{
+    pthread_mutex_lock(&layouts->guard);
+    struct hybris_bc_template **link = &layouts->templates;
+    while (*link && (*link)->handle != handle) link = &(*link)->next;
+    struct hybris_bc_template *update_template = *link;
+    if (update_template) *link = update_template->next;
+    pthread_mutex_unlock(&layouts->guard);
+    if (update_template) release_template(layouts, update_template);
+}
+
 void hybris_bc_layouts_finish(struct hybris_bc_layouts *layouts)
 {
     /* All command-buffer journals must have been retired first. */
+    while (layouts->templates)
+        hybris_bc_template_remove(layouts, layouts->templates->handle);
     while (layouts->head) hybris_bc_layout_remove(layouts, layouts->head->handle);
     pthread_mutex_destroy(&layouts->guard);
 }
