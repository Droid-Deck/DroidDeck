+#ifndef HYBRIS_BC_VULKAN_COMPAT_H
+#define HYBRIS_BC_VULKAN_COMPAT_H
+#include <vulkan/vulkan.h>
+
+/* Vulkan-Headers 1.4.309 predates VK_ARM_tensors. Keep only the descriptor
+ * payload ABI needed to preserve an advertised driver's push state; this does
+ * not expose the extension or any tensor commands through the layer. */
+#ifndef VK_ARM_tensors
+VK_DEFINE_NON_DISPATCHABLE_HANDLE(VkTensorViewARM)
+#define VK_DESCRIPTOR_TYPE_TENSOR_ARM ((VkDescriptorType)1000460000)
+#define VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_TENSOR_ARM ((VkStructureType)1000460003)
+typedef struct VkWriteDescriptorSetTensorARM {
+    VkStructureType sType;
+    const void *pNext;
+    uint32_t tensorViewCount;
+    const VkTensorViewARM *pTensorViews;
+} VkWriteDescriptorSetTensorARM;
+#endif
+#define HYBRIS_VK_ARM_TENSOR_PAYLOAD 1
+
+#endif
