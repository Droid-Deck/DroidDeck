+/* Same condition as hybris_shader_device_create's polygon flag: the app enables fillModeNonSolid and the layer
+ * emulates it. Polygon draws need the recorded bind/viewport/rendering state. */
+static int polygon_tracking(VkPhysicalDevice physical, const VkDeviceCreateInfo *info)
+{
+    VkBool32 requested = info->pEnabledFeatures ? info->pEnabledFeatures->fillModeNonSolid : VK_FALSE;
+    for (const VkBaseInStructure *node = info->pNext; node; node = node->pNext)
+        if (node->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2)
+            requested = ((const VkPhysicalDeviceFeatures2 *)node)->features.fillModeNonSolid;
+    return requested && hybris_shader_polygon_emulated(physical);
+}
