diff --git a/hybris/vulkan/compat/spirv_names.c b/hybris/vulkan/compat/spirv_names.c
new file mode 100644
--- /dev/null
+++ b/hybris/vulkan/compat/spirv_names.c
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* PowerVR D-Series (driver 25.3, Android 17) miscompiles a vertex shader in which an Input and an Output
+ * variable carry the same OpName: the input then reads as zero. DXVK names a passed-through attribute and
+ * its varying alike ("TEXCOORD"), so Unity's full-screen blits sample one texel and the frame goes flat
+ * (Megabonk). Names are debug information only, so dropping them never changes what a shader does. */
+#define _GNU_SOURCE
+#define VK_NO_PROTOTYPES
+#include "spirv_names.h"
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/auxv.h>
+
+#define SPIRV_MAGIC 0x07230203u
+#define OP_NAME 5
+#define OP_MEMBER_NAME 6
+
+static pthread_once_t once = PTHREAD_ONCE_INIT;
+static int enabled;
+static void configure(void)
+{
+    const char *value = getauxval(AT_SECURE) ? NULL : getenv("HYBRIS_VULKAN_COMPAT_STRIP_NAMES");
+    enabled = !value || strcmp(value, "0");
+}
+int hybris_spirv_strip_names_enabled(void)
+{
+    pthread_once(&once, configure);
+    return enabled;
+}
+VkResult hybris_spirv_strip_names(const uint32_t *code, size_t size,
+    const VkAllocationCallbacks *allocator, uint32_t **output, size_t *output_size,
+    unsigned *removed)
+{
+    *output = NULL;
+    *output_size = 0;
+    *removed = 0;
+    size_t words = size / sizeof(uint32_t);
+    if (!code || size % sizeof(uint32_t) || words < 5 || code[0] != SPIRV_MAGIC) return VK_SUCCESS;
+    unsigned names = 0;
+    for (size_t i = 5; i < words;) {
+        uint32_t count = code[i] >> 16, op = code[i] & 0xffff;
+        if (!count || count > words - i) return VK_SUCCESS; /* malformed: the driver reports it */
+        names += op == OP_NAME || op == OP_MEMBER_NAME;
+        i += count;
+    }
+    if (!names) return VK_SUCCESS;
+    uint32_t *copy = hybris_scaled_alloc(allocator, size, VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+    if (!copy) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    memcpy(copy, code, 5 * sizeof(uint32_t));
+    size_t kept = 5;
+    for (size_t i = 5; i < words;) {
+        uint32_t count = code[i] >> 16, op = code[i] & 0xffff;
+        if (op != OP_NAME && op != OP_MEMBER_NAME) {
+            memcpy(copy + kept, code + i, count * sizeof(uint32_t));
+            kept += count;
+        }
+        i += count;
+    }
+    *output = copy;
+    *output_size = kept * sizeof(uint32_t);
+    *removed = names;
+    return VK_SUCCESS;
+}
diff --git a/hybris/vulkan/compat/spirv_names.h b/hybris/vulkan/compat/spirv_names.h
new file mode 100644
--- /dev/null
+++ b/hybris/vulkan/compat/spirv_names.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef HYBRIS_SPIRV_NAMES_H
+#define HYBRIS_SPIRV_NAMES_H
+#include "scaled_vertex.h"
+/* HYBRIS_VULKAN_COMPAT_STRIP_NAMES: on unless set to 0. */
+int hybris_spirv_strip_names_enabled(void);
+/* Drop every OpName and OpMemberName. Null output means the original is unchanged
+ * (nothing to drop, or code this pass does not parse). */
+VkResult hybris_spirv_strip_names(const uint32_t *code, size_t size,
+    const VkAllocationCallbacks *allocator, uint32_t **output, size_t *output_size,
+    unsigned *removed);
+#endif
