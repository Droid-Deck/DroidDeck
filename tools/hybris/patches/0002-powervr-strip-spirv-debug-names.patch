+/* Every module and pipeline this layer hands to the driver passes through
+ * these two calls, after any other conversion. */
+static VkResult driver_shader(struct shader_device *device, const VkShaderModuleCreateInfo *info,
+    const VkAllocationCallbacks *allocator, VkShaderModule *module)
+{
+    uint32_t *code = NULL;
+    size_t size = 0;
+    unsigned removed = 0;
+    VkShaderModuleCreateInfo unnamed = *info;
+    if (device->debug_names) {
+        VkResult result = hybris_spirv_debug_names(info->pCode, info->codeSize, allocator, &code, &size, &removed);
+        if (result != VK_SUCCESS) return result;
+        if (code) {
+            unnamed.pCode = code; unnamed.codeSize = size;
+            hybris_debug_names_report(removed, info->codeSize, size);
+        }
+    }
+    VkResult result = device->create_shader(device->handle, &unnamed, allocator, module);
+    hybris_scaled_free(allocator, code);
+    return result;
+}
+struct unnamed_stages {
+    VkPipelineShaderStageCreateInfo *stages;
+    VkShaderModuleCreateInfo *modules;
+    uint32_t **codes;
+    uint32_t count;
+};
+/* SPIR-V supplied directly in a stage's pNext (VK_KHR_maintenance5, how DXVK
+ * passes it) never reaches vkCreateShaderModule. Only a create info that leads
+ * the chain is replaced; the caller's structures are left untouched. */
+static VkResult driver_pipelines(struct shader_device *device, VkPipelineCache cache, uint32_t count,
+    const VkGraphicsPipelineCreateInfo *infos, const VkAllocationCallbacks *allocator, VkPipeline *pipelines)
+{
+    int direct = 0;
+    if (device->debug_names) for (uint32_t i = 0; i < count && !direct; ++i)
+        for (uint32_t j = 0; j < infos[i].stageCount && !direct; ++j) {
+            const VkBaseInStructure *first = infos[i].pStages[j].pNext;
+            direct = !infos[i].pStages[j].module && first && first->sType == VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+        }
+    if (!direct) return device->create_pipelines(device->handle, cache, count, infos, allocator, pipelines);
+    VkGraphicsPipelineCreateInfo *changed = hybris_scaled_alloc(allocator, count * sizeof(*changed), VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+    struct unnamed_stages *copies = hybris_scaled_alloc(allocator, count * sizeof(*copies), VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+    VkResult result = VK_ERROR_OUT_OF_HOST_MEMORY;
+    if (copies) memset(copies, 0, count * sizeof(*copies));
+    if (!changed || !copies) goto done;
+    memcpy(changed, infos, count * sizeof(*changed));
+    for (uint32_t i = 0; i < count; ++i) {
+        struct unnamed_stages *copy = &copies[i];
+        uint32_t stages = infos[i].stageCount;
+        if (!stages) continue;
+        copy->stages = hybris_scaled_alloc(allocator, stages * sizeof(*copy->stages), VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+        copy->modules = hybris_scaled_alloc(allocator, stages * sizeof(*copy->modules), VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+        copy->codes = hybris_scaled_alloc(allocator, stages * sizeof(*copy->codes), VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+        if (copy->codes) { memset(copy->codes, 0, stages * sizeof(*copy->codes)); copy->count = stages; }
+        result = VK_ERROR_OUT_OF_HOST_MEMORY;
+        if (!copy->stages || !copy->modules || !copy->codes) goto done;
+        memcpy(copy->stages, infos[i].pStages, stages * sizeof(*copy->stages));
+        for (uint32_t j = 0; j < stages; ++j) {
+            const VkShaderModuleCreateInfo *module = copy->stages[j].pNext;
+            size_t size = 0;
+            unsigned removed = 0;
+            if (copy->stages[j].module || !module || module->sType != VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO) continue;
+            result = hybris_spirv_debug_names(module->pCode, module->codeSize, allocator, &copy->codes[j], &size, &removed);
+            if (result != VK_SUCCESS) goto done;
+            if (!copy->codes[j]) continue;
+            copy->modules[j] = *module;
+            copy->modules[j].pCode = copy->codes[j];
+            copy->modules[j].codeSize = size;
+            copy->stages[j].pNext = &copy->modules[j];
+            hybris_debug_names_report(removed, module->codeSize, size);
+        }
+        changed[i].pStages = copy->stages;
+    }
+    result = device->create_pipelines(device->handle, cache, count, changed, allocator, pipelines);
+    goto release;
+done:
+    for (uint32_t i = 0; i < count; ++i) pipelines[i] = VK_NULL_HANDLE;
+release:
+    if (copies) for (uint32_t i = 0; i < count; ++i) {
+        if (copies[i].codes) for (uint32_t j = 0; j < copies[i].count; ++j) hybris_scaled_free(allocator, copies[i].codes[j]);
+        hybris_scaled_free(allocator, copies[i].codes);
+        hybris_scaled_free(allocator, copies[i].modules);
+        hybris_scaled_free(allocator, copies[i].stages);
+    }
+    hybris_scaled_free(allocator, copies);
+    hybris_scaled_free(allocator, changed);
+    return result;
+}
