diff --git a/hybris/vulkan/compat/spirv_debug_names.c b/hybris/vulkan/compat/spirv_debug_names.c
new file mode 100644
index 0000000..2c776e5
--- /dev/null
+++ b/hybris/vulkan/compat/spirv_debug_names.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#define _GNU_SOURCE
+#define VK_NO_PROTOTYPES
+#include "spirv_debug_names.h"
+#include "../layer/layer.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/auxv.h>
+
+static pthread_once_t once = PTHREAD_ONCE_INIT;
+static int enabled = 1;
+static _Atomic unsigned reports;
+static void configure(void)
+{
+    const char *control = getauxval(AT_SECURE) ? NULL : getenv("HYBRIS_VULKAN_COMPAT_DEBUG_NAMES");
+    enabled = !control || strcmp(control, "0");
+}
+int hybris_debug_names_enabled(void) { pthread_once(&once, configure); return enabled; }
+
+int hybris_debug_names_active(VkPhysicalDevice physical)
+{
+    struct hybris_layer_physical context;
+    if (!hybris_debug_names_enabled() || !hybris_layer_lookup_physical(physical, &context)) return 0;
+    PFN_vkGetPhysicalDeviceProperties properties = (PFN_vkGetPhysicalDeviceProperties)
+        context.resolver(context.instance, "vkGetPhysicalDeviceProperties");
+    if (!properties) return 0;
+    VkPhysicalDeviceProperties p;
+    properties(physical, &p);
+    /* Observed on PowerVR D-Series DXT-48-1536, driver 25.3@6908880 (Tensor G5).
+     * Names carry no meaning, so every Imagination driver gets the same input. */
+    return p.vendorID == 0x1010;
+}
+
+VkResult hybris_spirv_debug_names(const uint32_t *code, size_t size,
+    const VkAllocationCallbacks *allocator, uint32_t **output, size_t *output_size,
+    unsigned *removed)
+{
+    *output = NULL; *output_size = 0; *removed = 0;
+    if (!code || size < 20 || size % 4 || code[0] != 0x07230203) return VK_SUCCESS;
+    size_t words = size / 4;
+    unsigned names = 0;
+    for (size_t at = 5; at < words;) {
+        uint32_t count = code[at] >> 16, op = code[at] & 65535;
+        if (!count || count > words - at) return VK_SUCCESS;
+        names += op == 5 || op == 6;
+        at += count;
+    }
+    if (!names) return VK_SUCCESS;
+    uint32_t *result = hybris_scaled_alloc(allocator, size, VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+    if (!result) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    memcpy(result, code, 5 * sizeof(*code));
+    size_t out = 5;
+    for (size_t at = 5; at < words;) {
+        uint32_t count = code[at] >> 16, op = code[at] & 65535;
+        if (op != 5 && op != 6) {
+            memcpy(result + out, code + at, count * sizeof(*code));
+            out += count;
+        }
+        at += count;
+    }
+    *output = result;
+    *output_size = out * sizeof(*code);
+    *removed = names;
+    return VK_SUCCESS;
+}
+
+void hybris_debug_names_report(unsigned removed, size_t original, size_t converted)
+{
+    unsigned slot = atomic_load(&reports);
+    while (slot < 33 && !atomic_compare_exchange_weak(&reports, &slot, slot + 1)) {}
+    if (slot < 32) fprintf(stderr, "HYBRIS_DEBUG_NAMES removed=%u original=%zu converted=%zu\n", removed, original, converted);
+    else if (slot == 32) fprintf(stderr, "HYBRIS_DEBUG_NAMES truncated\n");
+}
diff --git a/hybris/vulkan/compat/spirv_debug_names.h b/hybris/vulkan/compat/spirv_debug_names.h
new file mode 100644
index 0000000..e06e0bc
--- /dev/null
+++ b/hybris/vulkan/compat/spirv_debug_names.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef HYBRIS_SPIRV_DEBUG_NAMES_H
+#define HYBRIS_SPIRV_DEBUG_NAMES_H
+#include "scaled_vertex.h"
+int hybris_debug_names_enabled(void);
+/* Imagination's proprietary driver resolves shader interface variables by
+ * their OpName. A vertex input and an output with the same debug name (DXVK's
+ * D3D11 compiler names both after the HLSL semantic) then read each other's
+ * storage: the input arrives as undefined per-tile data. */
+int hybris_debug_names_active(VkPhysicalDevice physical);
+/* Remove OpName and OpMemberName. They have no semantics, so the module is
+ * otherwise unchanged. Null output means no change. */
+VkResult hybris_spirv_debug_names(const uint32_t *code, size_t size,
+    const VkAllocationCallbacks *allocator, uint32_t **output, size_t *output_size,
+    unsigned *removed);
+void hybris_debug_names_report(unsigned removed, size_t original, size_t converted);
+#endif
