+qreal WaylandOutput::presentationScale() const
+{
+    return qEnvironmentVariableIsSet("DROIDDECK_NESTED_SCALE") ? m_pendingScale : scale();
+}
+
+QPointF WaylandOutput::mapToOutput(const QPointF &hostPosition) const
+{
+    const QPointF inPanel = hostPosition * presentationScale() / scale();
+    const QSizeF panelSize = QSize(std::round(modeSize().width() / scale()),
+                                   std::round(modeSize().height() / scale()));
+    return position() + transform().inverted().map(inPanel, panelSize);
+}
