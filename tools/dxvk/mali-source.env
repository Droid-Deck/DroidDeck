# The regular DXVK source revision is pinned in source.env. These separate
# component pins make the container and ARM64X-capable cross-compiler reproducible.
DXVK_MALI_CONTAINER_IMAGE=registry.gitlab.steamos.cloud/proton/steamrt4/sdk/x86_64-llvm-mingw:20260602@sha256:61285abb4b01a033abc624d73aed5ffa73d890a1356ca8fef3faa276aed5592c
# The container's older compiler can build ARM64 or ARM64EC separately, but not
# the post-TLS-fix ARM64X image required by the ARM64 Proton loader.
DXVK_MALI_LLVM_MINGW_VERSION=20261006
DXVK_MALI_LLVM_MINGW_ARCHIVE=llvm-mingw-20261006-ucrt-ubuntu-22.04-x86_64.tar.xz
DXVK_MALI_LLVM_MINGW_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20261006/llvm-mingw-20261006-ucrt-ubuntu-22.04-x86_64.tar.xz
DXVK_MALI_LLVM_MINGW_SHA256=5f9c6ed95b2d4bdb2869a488c5fd5857fbdabcf288a0aa3eb1da43f6a08d8ab4
DXVK_MALI_PROTON_RECIPE=bc896217ffcd67f892f952b010f898fe7bd0f0a1
DXVK_MALI_ARM64X_RECIPE=ba0ce9311db9359a8bec77beb89613171a1f010a
DXVK_MALI_BASE_VERSION=v3.1.1-27-g25ca63f17f34bdc
