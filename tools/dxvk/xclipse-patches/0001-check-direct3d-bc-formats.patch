diff --git a/src/dxvk/dxvk_bc_formats.h b/src/dxvk/dxvk_bc_formats.h
new file mode 100644
index 0000000..e55faca
--- /dev/null
+++ b/src/dxvk/dxvk_bc_formats.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <array>
+
+#include <vulkan/vulkan.h>
+
+namespace dxvk::bc {
+
+  constexpr std::array<VkFormat, 14> D3dFormats = {{
+    VK_FORMAT_BC1_RGBA_UNORM_BLOCK,
+    VK_FORMAT_BC1_RGBA_SRGB_BLOCK,
+    VK_FORMAT_BC2_UNORM_BLOCK,
+    VK_FORMAT_BC2_SRGB_BLOCK,
+    VK_FORMAT_BC3_UNORM_BLOCK,
+    VK_FORMAT_BC3_SRGB_BLOCK,
+    VK_FORMAT_BC4_UNORM_BLOCK,
+    VK_FORMAT_BC4_SNORM_BLOCK,
+    VK_FORMAT_BC5_UNORM_BLOCK,
+    VK_FORMAT_BC5_SNORM_BLOCK,
+    VK_FORMAT_BC6H_UFLOAT_BLOCK,
+    VK_FORMAT_BC6H_SFLOAT_BLOCK,
+    VK_FORMAT_BC7_UNORM_BLOCK,
+    VK_FORMAT_BC7_SRGB_BLOCK,
+  }};
+
+  constexpr VkFormatFeatureFlags2 D3dFormatFeatures =
+      VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_BIT
+    | VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_FILTER_LINEAR_BIT
+    | VK_FORMAT_FEATURE_2_TRANSFER_SRC_BIT
+    | VK_FORMAT_FEATURE_2_TRANSFER_DST_BIT;
+
+  template<typename Query>
+  bool supportsD3dFormats(Query&& query) {
+    for (VkFormat format : D3dFormats) {
+      if ((query(format) & D3dFormatFeatures) != D3dFormatFeatures)
+        return false;
+    }
+
+    return true;
+  }
+
+}
