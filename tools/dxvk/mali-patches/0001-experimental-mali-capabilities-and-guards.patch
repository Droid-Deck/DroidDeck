+  void DxvkIrShader::validateBuiltInFeatures(const VkPhysicalDeviceFeatures& features) {
+    if (features.shaderCullDistance && features.multiViewport)
+      return;
+
+    convertIr("validateBuiltInFeatures()");
+
+    dxbc_spv::ir::Builder builder;
+    deserializeIr(builder);
+
+    // Check optimized declarations, including non-rasterized geometry streams
+    // which are intentionally absent from the pipeline linkage I/O metadata.
+    for (auto iter = builder.getDeclarations().first;
+              iter != builder.getDeclarations().second; iter++) {
+      auto opCode = iter->getOpCode();
+      if (opCode != dxbc_spv::ir::OpCode::eDclInputBuiltIn
+       && opCode != dxbc_spv::ir::OpCode::eDclOutputBuiltIn)
+        continue;
+
+      auto builtIn = dxbc_spv::ir::BuiltIn(iter->getOperand(iter->getFirstLiteralOperandIndex()));
+      if (builtIn == dxbc_spv::ir::BuiltIn::eCullDistance && !features.shaderCullDistance)
+        throw DxvkError("D3D11: Shader requires unavailable shaderCullDistance");
+      if (builtIn == dxbc_spv::ir::BuiltIn::eViewportIndex && !features.multiViewport)
+        throw DxvkError("D3D11: Shader requires unavailable multiViewport");
+    }
+  }
