{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_DROIDDECK_gpu_load",
        "type": "GLOBAL",
        "library_path": "/usr/local/lib/droiddeck-gpuload/libVkLayer_droiddeck_gpuload.so",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "Times this process's GPU work for DroidDeck's HUD where Android hides the GPU load; idle unless a HUD is shown",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "DroidDeckGpuLoad_NegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": {
            "DROIDDECK_GPU_LOAD": "1"
        },
        "disable_environment": {
            "DROIDDECK_GPU_LOAD_DISABLE": "1"
        }
    }
}
