diff --git a/src/lib.rs b/src/lib.rs
index 0c539f1..50fdd21 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -16,3 +16,10 @@ lazy_static! {
         .and_then(|x| if !x.contains("-") { None } else { Some(x) })
         .unwrap_or_else(|| String::from("en-US"));
 }
+
+
+pub fn client_allowed(client_id: &str) -> bool {
+    let Ok(path) = std::env::var("COMET_ALLOWED_CLIENTS") else { return true; };
+    std::fs::read(path).ok().and_then(|data| serde_json::from_slice::<Vec<String>>(&data).ok())
+        .is_some_and(|clients| clients.iter().any(|id| id == client_id))
+}
