{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/droiddeck/fastfetch/logo.txt",
    "color": {
      "1": "38;2;255;255;255",
      "2": "38;2;26;159;255"
    },
    "padding": { "right": 3 }
  },
  "modules": [
    "title", "separator", "os",
    { "type": "command", "key": "Host", "text": "droiddeck-device-info host" },
    "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal",
    { "type": "command", "key": "CPU", "text": "droiddeck-device-info cpu" },
    "gpu", "memory", "swap",
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "Battery" },
    "locale",
    "break", "colors"
  ]
}
