<?xml version="1.0"?>
<!-- labwc for a handheld: a plain theme, large enough to hit with a finger, and the keybinds a
     desktop expects. Refreshed from here every session. -->
<labwc_config>
  <core><gap>0</gap><reuseOutputMode>yes</reuseOutputMode></core>
  <theme>
    <name>Clearlooks</name>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow"><name>DejaVu Sans</name><size>11</size></font>
  </theme>
  <output name="WL-1" mode="@MODE@"/>
  <placement><policy>center</policy></placement>
  <windowSwitcher><osd show="yes" preview="yes"/></windowSwitcher>
  <keyboard>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="W-Return"><action name="Execute"><command>qterminal</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>pcmanfm-qt</command></action></keybind>
    <keybind key="W-d"><action name="ToggleMaximize"/></keybind>
  </keyboard>
  <mouse><doubleClickTime>500</doubleClickTime></mouse>
  <!-- Programs opened on the desktop at a size that suits it. melonDS remembers a 1x window for the
       front end's full-screen toggle (bannerlator-pad-defaults), too small for a desktop: here it
       opens at 800x600, centred (AutoPlace alone kept the top-left corner). Only the desktop reads this file, so the front end is unaffected. -->
  <windowRules>
    <windowRule title="melonDS*">
      <action name="ResizeTo" width="800" height="600"/>
      <action name="AutoPlace" policy="center"/>
    </windowRule>
  </windowRules>
</labwc_config>
