#!/usr/bin/python3
# Keeps Steam's quick access menu rendering for the bottom screen: parks its X window outside the Big Picture window,
# and relays the app to Steam's DevTools port, which only answers clients inside the guest.
#   droiddeck-qam-park start <devtools port>   prints the relay port
#   droiddeck-qam-park size <width> <height>   pixels of the menu's X window
#   droiddeck-qam-park stop

import ctypes
import os
import re
import socket
import subprocess
import sys
import threading
import time

FLAG = "/tmp/.dd-qam-park"
SIZE = "/tmp/.dd-qam-size"
TOLERANCE = 4
INTERVAL = 0.25
MAX_SECONDS = 6 * 3600
CHILD = re.compile(r"^\s+(0x[0-9a-f]+) .*?\s(\d+)x(\d+)\+(-?\d+)\+(-?\d+)\s")


def display():
    return os.environ.get("DISPLAY") or ":0"


def find(width, height):
    lines = subprocess.run(["xwininfo", "-root", "-tree"], env=dict(os.environ, DISPLAY=display()),
                           capture_output=True, text=True, timeout=5).stdout.splitlines()
    for i, line in enumerate(lines):
        if '"Steam Big Picture Mode"' not in line:
            continue
        parent = re.search(r"\s(\d+)x(\d+)\+", line)
        parent_width = int(parent.group(1)) if parent else 1280
        indent = len(line) - len(line.lstrip())
        for child in lines[i + 1:]:
            if child.strip() and len(child) - len(child.lstrip()) <= indent:
                break
            m = CHILD.match(child)
            if not m or len(child) - len(child.lstrip()) != indent + 3:
                continue
            w, h, x, y = int(m.group(2)), int(m.group(3)), int(m.group(4)), int(m.group(5))
            if abs(w - width) <= TOLERANCE and abs(h - height) <= TOLERANCE:
                return int(m.group(1), 16), x, y, parent_width
    return None


def owner():
    try:
        with open(FLAG) as f:
            return f.read().strip()
    except OSError:
        return None


def wanted_size():
    try:
        with open(SIZE) as f:
            w, h = f.read().split()
            return int(w), int(h)
    except (OSError, ValueError):
        return None


def pipe(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except OSError:
        pass
    for s in (src, dst):
        try:
            s.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass


def relay(server, devtools_port):
    while True:
        try:
            client, _ = server.accept()
        except OSError:
            return
        try:
            upstream = socket.create_connection(("127.0.0.1", devtools_port), 3)
        except OSError:
            client.close()
            continue
        for a, b in ((client, upstream), (upstream, client)):
            threading.Thread(target=pipe, args=(a, b), daemon=True).start()


def park():
    x11 = ctypes.CDLL("libX11.so.6")
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XMoveWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int]
    x11.XFlush.argtypes = [ctypes.c_void_p]
    d = x11.XOpenDisplay(display().encode())
    started = time.monotonic()
    me = str(os.getpid())
    while owner() == me and time.monotonic() - started < MAX_SECONDS:
        size = wanted_size()
        if d and size:
            try:
                found = find(*size)
            except (OSError, subprocess.SubprocessError):
                found = None
            if found:
                win, x, y, parent_width = found
                if x < parent_width:
                    x11.XMoveWindow(d, win, parent_width + 64, y)
                    x11.XFlush(d)
        time.sleep(INTERVAL)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "stop":
        for path in (FLAG, SIZE):
            try:
                os.unlink(path)
            except FileNotFoundError:
                pass
        return 0
    if command == "size" and len(sys.argv) == 4:
        with open(SIZE, "w") as f:
            f.write("%d %d" % (int(sys.argv[2]), int(sys.argv[3])))
        return 0
    if command != "start" or len(sys.argv) != 3:
        print("usage: droiddeck-qam-park start <devtools port> | size <width> <height> | stop", file=sys.stderr)
        return 2
    devtools_port = int(sys.argv[2])
    server = socket.socket()
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 0))
    server.listen(4)
    print(server.getsockname()[1], flush=True)
    if os.fork():
        return 0
    os.setsid()
    with open(FLAG, "w") as f:
        f.write(str(os.getpid()))
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    threading.Thread(target=relay, args=(server, devtools_port), daemon=True).start()
    park()
    server.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
