BIN = Path(__file__).resolve().parent
RUNTIME = Path('/usr/local/lib/droiddeck-xbox')
DLLS = ('xgameruntime.dll', 'winhttp.dll', 'windows.web.dll', 'twinapi.appcore.dll', 'wintypes.dll', 'libnghttp2.dll')
CLASSES = {
    'twinapi.appcore.dll': ('Windows.ApplicationModel.DataTransfer.DataTransferManager',
                            'Windows.Security.ExchangeActiveSyncProvisioning.EasClientDeviceInformation',
                            'Windows.System.Profile.AnalyticsInfo', 'Windows.System.UserProfile.AdvertisingManager',
                            'Windows.UI.ViewManagement.ApplicationView'),
    # Device enumeration is how a title lists the render devices it can open. Wine carries the DLL but its
    # class keys only reached the 32-bit view of the registry, so a 64-bit title looks one up and finds nothing.
    'windows.devices.enumeration.dll': ('Windows.Devices.Enumeration.DeviceInformation',
                                        'Windows.Devices.Enumeration.DeviceAccessInformation'),
    'windows.web.dll': ('Windows.Data.Json.JsonArray', 'Windows.Data.Json.JsonObject', 'Windows.Data.Json.JsonValue'),
    'wintypes.dll': ('Windows.Foundation.PropertyValue', 'Windows.Foundation.Collections.PropertySet',
                     'Windows.Foundation.Metadata.ApiInformation', 'Windows.Storage.Streams.Buffer',
                     'Windows.Storage.Streams.DataWriter'),
}
CLASS_KEY = 'Software\\Microsoft\\WindowsRuntime\\ActivatableClassId\\'
PACKAGE_KEY = ('Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\CurrentVersion\\'
               'AppModel\\PackageRepository\\Packages\\')
VCLIBS_X64 = 'Microsoft.VCLibs.140.00_14.0.30704.0_x64__8wekyb3d8bbwe'
# A package whose manifest names a view entry point is started by the Windows app model: it asks for
# CoreApplication to run its IFrameworkView and for the CoreWindow that view draws in. Wine resolves those
# classes to a DLL and calls DllGetActivationFactory, but ships nothing behind them, so the runtime carries a
# small host (tools/xbox/uwp-host) that answers them and drives the title's view. A package naming
# Windows.FullTrustApplication never sees it.
UWP_HOST = RUNTIME / 'compat' / 'uwp-host.dll'


def uwp_host_package_copy(env):
    """The app-model host a compatibility package delivered, if any.

    A .wcp installs into a proton tool, and that tool may carry the host at
    files/share/droiddeck/uwp-host.dll. Nothing keys the installed tools by which
    one this prefix uses, so newest wins when several carry a host; the launcher's
    own copy remains the fallback."""
    client = env.get('STEAM_COMPAT_CLIENT_INSTALL_PATH')
    if not client:
        return None
    tools = Path(client) / 'compatibilitytools.d'
    try:
        found = [entry / 'files' / 'share' / 'droiddeck' / 'uwp-host.dll'
                 for entry in tools.iterdir() if entry.is_dir()]
        found = [path for path in found if path.is_file()]
        found.sort(key=lambda path: path.stat().st_mtime, reverse=True)
    except OSError:
        return None
    return found[0] if found else None
# The host answers the app model itself (CoreApplication, CoreWindow) and, because Wine ships nothing behind
# them, the platform services a packaged title reaches for on the way up: storage, package identity,
# cryptography, display, media and input. They all resolve to this one DLL.
UWP_CLASSES = ('Windows.ApplicationModel.Core.CoreApplication', 'Windows.UI.Core.CoreWindow',
               'Windows.Storage.ApplicationData', 'Windows.ApplicationModel.Package',
               'Windows.ApplicationModel.PackageCatalog',
               'Windows.Security.Cryptography.Core.HashAlgorithmProvider',
               'Windows.Security.Cryptography.Core.HashAlgorithmNames',
               'Windows.Security.Cryptography.CryptographicBuffer',
               'Windows.Graphics.Display.DisplayInformation', 'Windows.Media.Devices.MediaDevice',
               'Windows.System.MemoryManager',
               'Windows.Devices.Input.MouseDevice', 'Windows.Devices.Input.MouseCapabilities',
               'Windows.Devices.Input.KeyboardCapabilities',
               'Windows.UI.ViewManagement.ApplicationView', 'Windows.UI.Popups.MessageDialog',
               'Windows.Devices.Enumeration.DeviceInformation',
               'Windows.Services.Store.StoreContext',
               'Windows.System.Profile.HardwareIdentification',
               'Windows.System.Profile.SystemIdentification',
               'Windows.System.User',
               'Windows.System.KnownUserProperties',
               'Windows.System.UserPicker',
               'Windows.Security.Authentication.Web.Core.WebAuthenticationCoreManager',
               'Windows.Security.Authentication.Web.Core.WebTokenRequest',
               'Windows.System.Threading.ThreadPoolTimer',
               'Windows.ApplicationModel.Resources.Core.ResourceContext',
               'Windows.Gaming.XboxLive.Storage.GameSaveProvider',
               'Windows.Foundation.Diagnostics.LoggingOptions',
               'Windows.Foundation.Diagnostics.LoggingChannelOptions',
               'Windows.Foundation.Diagnostics.LoggingChannel',
               'Windows.Foundation.Diagnostics.LoggingFields',
               'Windows.Networking.PushNotifications.PushNotificationChannelManager',
               'Windows.Networking.XboxLive.XboxLiveDeviceAddress',
               'Windows.Networking.XboxLive.XboxLiveEndpointPairTemplate',
               'Windows.ApplicationModel.ExtendedExecution.ExtendedExecutionSession',
               'Windows.Networking.Sockets.MessageWebSocket',
               'Windows.Data.Json.JsonObject',
               'Windows.Data.Json.JsonArray',
               'Windows.Data.Json.JsonValue')
# COM CLSIDs hosted by uwp-host.dll via DllGetClassObject.
# FreeThreadedXMLHTTP60 replaces Wine msxml6's stub where IXMLHTTPRequest2::SetCustomResponseStream
# returns E_NOTIMPL and breaks every UWP cpprest/XSAPI Xbox Live REST call.
COM_CLSID_KEY = 'Software\\Classes\\CLSID\\'
UWP_COM_CLSIDS = ('{88d96a09-f192-11d4-a65f-0040963251e5}',)
VIEW_DRIVES = 'xwvutsrqponmlkjihgfe'


def trace(env, message):
    """Name the launch decisions when DROIDDECK_UWP_TRACE is set."""
    if env.get('DROIDDECK_UWP_TRACE'):
        print('droiddeck-xbox: ' + message, file=sys.stderr)


def bridge(upstream):
    key = secrets.token_hex(32).encode('ascii')
    server = socket.socket()
    server.bind(('127.0.0.1', 0))
    server.listen(16)
    clients = set()
    lock = threading.Lock()
    stopped = threading.Event()

    def forward(source, target):
        try:
            while not stopped.is_set():
                data = source.recv(65536)
                if not data:
                    break
                target.sendall(data)
        except OSError:
            pass
        finally:
            try:
                target.shutdown(socket.SHUT_WR)
            except OSError:
                pass

    def connect(client):
        remote = None
        try:
            client.settimeout(10)
            supplied = b''
            while len(supplied) < len(key):
                part = client.recv(len(key) - len(supplied))
                if not part:
                    return
                supplied += part
            if not hmac.compare_digest(supplied, key):
                return
            remote = socket.socket(socket.AF_UNIX)
            remote.connect(upstream)
            client.settimeout(None)
            with lock:
                clients.add(remote)
            writer = threading.Thread(target=forward, args=(client, remote), daemon=True)
            writer.start()
            forward(remote, client)
            writer.join(2)
        except OSError:
            pass
        finally:
            for sock in (client, remote):
                if sock is not None:
                    with lock:
                        clients.discard(sock)
                    sock.close()

    def accept():
        while not stopped.is_set():
            try:
                client, _ = server.accept()
            except OSError:
                break
            with lock:
                if len(clients) >= 64:
                    client.close()
                    continue
                clients.add(client)
            threading.Thread(target=connect, args=(client,), daemon=True).start()

    threading.Thread(target=accept, daemon=True).start()

    def close():
        stopped.set()
        server.close()
        with lock:
            for client in clients:
                try:
                    client.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
                client.close()
            clients.clear()

    return server.getsockname()[1], key.decode('ascii'), close


def class_paths(registry):
    """Map each registered ActivatableClassId to the DllPath recorded for it."""
    paths = {}
    current = None
    prefix = CLASS_KEY.replace('\\', '\\\\')
    for line in registry.splitlines():
        # Wine writes a section as [key] followed by its modification time.
        if line.startswith('[') and ']' in line:
            body = line[1:line.rindex(']')]
            current = body[len(prefix):] if body.startswith(prefix) else None
        elif current is not None and line.startswith('"DllPath"='):
            paths[current.replace('\\\\', '\\')] = line[10:].strip('"').replace('\\\\', '\\')
    return paths


def register_classes(proton, prefix, env, extra=None):
    """Register CLASSES, plus `extra` ({DLL path: class names}), where the prefix does not already point there.

    A DLL path without a directory is one staged in system32. A class named in `extra` too resolves to the DLL
    `extra` gives it, so the host can stand in front of a class Wine only partly implements.
    """
    try:
        registry = (prefix / 'system.reg').read_text(encoding='utf-8', errors='replace')
    except OSError:
        return
    entries = {}
    for dll, names in [*CLASSES.items(), *(extra or {}).items()]:
        for name in names:
            entries[name] = dll if '\\' in dll else 'C:\\windows\\system32\\' + dll
    installed = class_paths(registry)
    # Compare the DllPath, not just the section: a section left behind by an older build points at a DLL
    # that is no longer staged, and resolving that class would fail instead of falling back to the host.
    missing = [(name, path) for name, path in entries.items() if installed.get(name, '').lower() != path.lower()]
    if not missing:
        return
    text = 'Windows Registry Editor Version 5.00\r\n\r\n' + ''.join(
        '[HKEY_LOCAL_MACHINE\\%s%s]\r\n"DllPath"="%s"\r\n\r\n' % (CLASS_KEY, name, path.replace('\\', '\\\\'))
        for name, path in missing)
    with tempfile.TemporaryDirectory(prefix='droiddeck-xbox-') as temporary:
        source = Path(temporary) / 'classes.reg'
        source.write_bytes(b'\xff\xfe' + text.encode('utf-16-le'))
        try:
            failed = subprocess.run([proton, 'run', 'reg.exe', 'import', 'Z:' + str(source).replace('/', '\\')],
                                    stdout=sys.stderr, env=env, timeout=90).returncode != 0
        except subprocess.TimeoutExpired:
            failed = True
    if failed:
        print('droiddeck-xbox: Windows Runtime class registration failed; launching without it', file=sys.stderr)


def com_class_entries(registry):
    """Map each registered COM CLSID (lowercased) to (dll_path, threading_model)."""
    entries = {}
    current = None
    prefix = COM_CLSID_KEY.replace('\\', '\\\\').lower()
    suffix = '\\\\inprocserver32'
    for line in registry.splitlines():
        if line.startswith('[') and ']' in line:
            body = line[1:line.rindex(']')].lower()
            if body.startswith(prefix) and body.endswith(suffix):
                current = body[len(prefix):-len(suffix)]
            else:
                current = None
        elif current is not None and line.startswith('@='):
            path = line[2:].strip('"').replace('\\\\', '\\')
            _, threading = entries.get(current, ('', None))
            entries[current] = (path, threading)
        elif current is not None and line.lower().startswith('"threadingmodel"='):
            threading = line.split('=', 1)[1].strip('"').replace('\\\\', '\\')
            path, _ = entries.get(current, ('', None))
            entries[current] = (path, threading)
    return entries


def com_class_paths(registry):
    """Map each registered COM CLSID (lowercased) to its InprocServer32 default DLL path."""
    return {clsid: path for clsid, (path, _) in com_class_entries(registry).items()}


def register_com_classes(proton, prefix, env, dll, clsids):
    """Register COM InprocServer32 CLSIDs pointing to `dll` and return prior entries for restore."""
    try:
        registry = (prefix / 'system.reg').read_text(encoding='utf-8', errors='replace')
    except OSError:
        return {}
    dll_path = dll if '\\' in dll else 'C:\\windows\\system32\\' + dll
    installed = com_class_entries(registry)
    missing = [clsid for clsid in clsids if installed.get(clsid.lower(), ('', None))[0].lower() != dll_path.lower()]
    if not missing:
        return {}
    previous = {clsid: installed.get(clsid.lower()) for clsid in missing}
    escaped = dll_path.replace('\\', '\\\\')
    text = 'Windows Registry Editor Version 5.00\r\n\r\n' + ''.join(
        '[HKEY_LOCAL_MACHINE\\%s%s\\InprocServer32]\r\n@="%s"\r\n"ThreadingModel"="Both"\r\n\r\n'
        % (COM_CLSID_KEY, clsid, escaped)
        for clsid in missing)
    with tempfile.TemporaryDirectory(prefix='droiddeck-xbox-') as temporary:
        source = Path(temporary) / 'com_classes.reg'
        source.write_bytes(b'\xff\xfe' + text.encode('utf-16-le'))
        try:
            failed = subprocess.run([proton, 'run', 'reg.exe', 'import', 'Z:' + str(source).replace('/', '\\')],
                                    stdout=sys.stderr, env=env, timeout=90).returncode != 0
        except subprocess.TimeoutExpired:
            failed = True
    if failed:
        print('droiddeck-xbox: COM class registration failed; launching without it', file=sys.stderr)
    return previous


def restore_com_classes(proton, prefix, env, previous):
    """Restore COM InprocServer32 CLSIDs modified for a view launch."""
    if not previous:
        return
    blocks = []
    for clsid, prior in previous.items():
        if prior is None:
            blocks.append('[-HKEY_LOCAL_MACHINE\\%s%s\\InprocServer32]\r\n\r\n' % (COM_CLSID_KEY, clsid))
        else:
            path, threading = prior
            escaped = path.replace('\\', '\\\\')
            lines = ['[HKEY_LOCAL_MACHINE\\%s%s\\InprocServer32]' % (COM_CLSID_KEY, clsid),
                     '@="%s"' % escaped]
            if threading is not None:
                lines.append('"ThreadingModel"="%s"' % threading.replace('\\', '\\\\'))
            else:
                lines.append('"ThreadingModel"=-')
            blocks.append('\r\n'.join(lines) + '\r\n\r\n')
    text = 'Windows Registry Editor Version 5.00\r\n\r\n' + ''.join(blocks)
    with tempfile.TemporaryDirectory(prefix='droiddeck-xbox-') as temporary:
        source = Path(temporary) / 'restore_com_classes.reg'
        source.write_bytes(b'\xff\xfe' + text.encode('utf-16-le'))
        try:
            failed = subprocess.run([proton, 'run', 'reg.exe', 'import', 'Z:' + str(source).replace('/', '\\')],
                                    stdout=sys.stderr, env=env, timeout=90).returncode != 0
        except subprocess.TimeoutExpired:
            failed = True
    if failed:
        print('droiddeck-xbox: COM class restore failed', file=sys.stderr)


def game_config(exe):
    path = Path(exe)
    if not path.is_absolute():
        return None
    for folder in list(path.parents)[:4]:
        config = folder / 'MicrosoftGame.config'
        if config.is_file():
            return config
    return None


def windows_arguments(text):
    arguments, current, quoted, started, at = [], [], False, False, 0
    while at < len(text):
        char = text[at]
        if char == '\\':
            run = len(text) - at - len(text[at:].lstrip('\\'))
            at += run
            if at < len(text) and text[at] == '"':
                current.append('\\' * (run // 2))
                if run % 2:
                    current.append('"')
                    at += 1
            else:
                current.append('\\' * run)
            started = True
            continue
        if char == '"':
            if quoted and text[at + 1:at + 2] == '"':
                current.append('"')
                at += 2
                continue
            quoted = not quoted
            started = True
        elif char in ' \t' and not quoted:
            if started:
                arguments.append(''.join(current))
                current, started = [], False
        else:
            current.append(char)
            started = True
        at += 1
    if started:
        arguments.append(''.join(current))
    return arguments


def install_actions(config):
    try:
        root = ElementTree.fromstring(config.read_bytes())
    except (OSError, ElementTree.ParseError):
        return []
    actions = []
    for registration in root.iter():
        if registration.tag.rsplit('}', 1)[-1] != 'CustomInstallActions':
            continue
        folder = next((node.text or '' for node in registration if node.tag.rsplit('}', 1)[-1] == 'Folder'), '')
        for node in registration.iter():
            if node.tag.rsplit('}', 1)[-1] != 'InstallAction':
                continue
            name, file = node.get('Name', ''), node.get('File', '')
            parts = [part for part in (folder.strip() + '\\' + file).replace('/', '\\').split('\\') if part]
            if not name or not file or any(part in ('.', '..') or ':' in part for part in parts):
                continue
            target = config.parent.joinpath(*parts)
            try:
                inside = target.resolve().is_relative_to(config.parent.resolve())
            except OSError:
                inside = False
            if inside and target.is_file() and target.suffix.lower() in ('.msi', '.exe'):
                actions.append((name, target, windows_arguments(node.get('Arguments', ''))))
    return actions


def run_install_actions(proton, prefix, exe, env):
    config = game_config(exe)
    if config is None:
        return
    done = prefix / 'drive_c' / 'ProgramData' / 'DroidDeck' / 'install-actions'
    for name, target, arguments in install_actions(config):
        try:
            content = hashlib.sha256()
            with target.open('rb') as source:
                for block in iter(lambda: source.read(1 << 20), b''):
                    content.update(block)
            identity = hashlib.sha256(name.encode('utf-8') + b'\0' + content.digest()).hexdigest()[:24]
            marker = done / ('%s-%s' % (''.join(c for c in name if c.isalnum() or c in '-_')[:64], identity))
            if marker.exists():
                continue
        except OSError as error:
            print('droiddeck-xbox: install action %s could not be read (%s); launching without it' % (name, error), file=sys.stderr)
            continue
        windows = 'Z:' + str(target).replace('/', '\\')
        if target.suffix.lower() == '.msi':
            command = [proton, 'run', 'msiexec', '/i', windows, *arguments]
        else:
            command = [proton, 'run', windows, *arguments]
        try:
            code = subprocess.run(command, stdout=sys.stderr, env=env, timeout=600).returncode
        except (OSError, subprocess.TimeoutExpired):
            code = None
        if code != 0:
            print('droiddeck-xbox: install action %s did not finish; launching without it' % name, file=sys.stderr)
            continue
        try:
            done.mkdir(parents=True, exist_ok=True)
            marker.touch()
        except OSError as error:
            print('droiddeck-xbox: install action %s finished but could not be recorded (%s)' % (name, error), file=sys.stderr)


def view_drive(prefix, exe):
    path = Path(exe)
    view = next((parent for parent in path.parents if parent.name.startswith('droiddeck-xbox-')), None)
    if not path.is_absolute() or view is None:
        return exe, None
    devices = prefix / 'dosdevices'
    for letter in VIEW_DRIVES:
        link = devices / (letter + ':')
        staged = devices / ('.%s-%s' % (letter, secrets.token_hex(4)))
        try:
            if os.path.lexists(link) and (os.path.exists(link) or not os.readlink(link).startswith(str(view.parent.parent) + '/')):
                continue
            devices.mkdir(parents=True, exist_ok=True)
            staged.symlink_to(view.parent)
            os.replace(staged, link)
        except OSError:
            if os.path.lexists(staged):
                staged.unlink()
            continue
        return letter.upper() + ':\\' + str(path.relative_to(view.parent)).replace('/', '\\'), link
    return exe, None


def wine(argv, source_env=None, package=None):
    source_env = os.environ if source_env is None else source_env
    with open(source_env['DROIDDECK_XBOX_COMMAND_FILE'], encoding='utf-8') as file:
        command = json.load(file)
    if len(command) < 3 or command[1] != 'waitforexitandrun' or len(argv) != 1:
        raise ValueError('Invalid Xbox Proton invocation')
    env = dict(source_env)
    # A marker file beside the runtime turns on the ws2_32 datagram trace for the
    # next launch, so a session can be diagnosed on the device without rebuilding
    # the runtime. The patched ws2_32 writes the lines to stderr, so WINEDEBUG=-all
    # does not hide them.
    if (RUNTIME / 'sock-trace').exists():
        env['DROIDDECK_SOCK_TRACE'] = '1'
    for name in ('DROIDDECK_XBOX_CREDENTIAL_SOCKET', 'DROIDDECK_XBOX_CREDENTIAL_PORT', 'DROIDDECK_XBOX_CREDENTIAL_KEY'):
        env.pop(name, None)
    env.pop('DROIDDECK_XBOX_COMMAND_FILE', None)
    prefix = Path(source_env['STEAM_COMPAT_DATA_PATH']) / 'pfx'
    prefix.parent.mkdir(parents=True, exist_ok=True)
    if not (prefix / 'system.reg').is_file():
        result = subprocess.run([command[0], 'run', 'cmd', '/c', 'exit', '0'], stdout=sys.stderr, env=env)
        if result.returncode:
            return result.returncode
    system = prefix / 'drive_c/windows/system32'
    system.mkdir(parents=True, exist_ok=True)
    for name in DLLS:
        target = system / name
        if target.is_symlink():
            target.unlink()
        shutil.copyfile(RUNTIME / 'windows' / name, target)
    exe, drive = view_drive(prefix, argv[0])
    view_root = next((p for p in Path(argv[0]).parents if p.name.startswith('droiddeck-xbox-')), None)
    # When launching from a decrypted EAppx view, point the staged WindowsApps root and manifest
    # InProcessServer DllPaths at the decrypted view for the session lifetime (the view remains
    # mounted until launch()'s finally releases the lease after wine() returns), then restore the
    # WindowsApps symlink to the persistent package folder on exit.
    active_package = view_root if (view_root is not None and (view_root / 'AppxManifest.xml').is_file()) else package
    package_root = None
    staged_full_name = None
    com_previous = {}
    try:
        if active_package is not None:
            parsed = package_manifest_identity(active_package)
            if parsed is not None:
                staged_full_name = parsed[0]
                package_root = stage_package_root(prefix, active_package, staged_full_name)
        classes = package_classes(active_package, install_path=package_root) if active_package is not None else {}
        if env.get('DROIDDECK_XBOX_UWP_HOST') == '1':
            # A package may carry the host into the proton tool it installs. When it
            # does, that copy runs: it was built against the same runtime the title
            # runs on, and it registers its own classes, so a launcher whose class
            # list is a version behind still resolves them.
            source = uwp_host_package_copy(env)
            try:
                data = source.read_bytes() if source is not None else UWP_HOST.read_bytes()
                replace_file(system, 'uwp-host.dll', data)
            except OSError as error:
                print('droiddeck-xbox: app-model host unavailable (%s)' % error, file=sys.stderr)
            else:
                trace(env, 'app-model host staged from %s (%d bytes)'
                      % (source or UWP_HOST, len(data)))
                classes['uwp-host.dll'] = UWP_CLASSES
        register_classes(command[0], prefix, env, classes)
        if 'uwp-host.dll' in classes:
            com_previous = register_com_classes(command[0], prefix, env, 'uwp-host.dll', UWP_COM_CLSIDS)
        if active_package is not None:
            register_packages(command[0], prefix, env, package_identities(active_package, install_path=package_root))
        run_install_actions(command[0], prefix, argv[0], env)
        overrides = ';'.join(name[:-4] + '=n' for name in DLLS if name != 'libnghttp2.dll')
        env['WINEDLLOVERRIDES'] = overrides + ';' + env.get('WINEDLLOVERRIDES', '')
        if package_root is not None:
            env['DROIDDECK_XBOX_PACKAGE_ROOT'] = package_root
        elif active_package is not None and Path(active_package).is_absolute():
            env['DROIDDECK_XBOX_PACKAGE_ROOT'] = 'Z:' + str(Path(active_package)).replace('/', '\\')
        if active_package is not None and package_root is not None and drive is None:
            rel_exe = relative_to_package(argv[0], active_package)
            if rel_exe is not None:
                exe = package_root + '\\' + str(rel_exe).replace('/', '\\')
        return subprocess.call([*command[:2], exe, *command[3:]], env=env)
    finally:
        if com_previous:
            restore_com_classes(command[0], prefix, env, com_previous)
        if staged_full_name is not None and package is not None and active_package != package:
            stage_package_root(prefix, package, staged_full_name)
        if drive is not None:
            try:
                drive.unlink()
            except OSError:
                pass


# PlayFab Game Saves picks its provider from the Gaming Runtime unless HKLM\SOFTWARE\Microsoft\GamingServices
# ForceUseInprocGameSaves is set, and its in-process provider needs a save folder the title never passes on Windows.
# The runtime has no GRTS saves, so titles such as Forza Horizon 6 stop with E:0-17. xodus-nexus ships a proxy
# (scripts/runtime-compat/playfab-save-folder.c, MIT) that keeps the title's own SDK as nexus_pgs_native.dll and
# supplies both; this stages it the same way.
PGS_PROXY = RUNTIME / 'compat' / 'PlayFabGameSave.dll'
PGS_NATIVE = 'nexus_pgs_native.dll'
PGS_EXPORTS = (
    'PFGameSaveFilesAddUserWithUiAsync', 'PFGameSaveFilesAddUserWithUiResult', 'PFGameSaveFilesGetFolder',
    'PFGameSaveFilesGetFolderSize', 'PFGameSaveFilesGetRemainingQuota', 'PFGameSaveFilesGetSaveDescriptionForDebug',
    'PFGameSaveFilesGetSaveDescriptionSizeForDebug', 'PFGameSaveFilesGetStatsJsonForDebug',
    'PFGameSaveFilesGetStatsJsonSizeForDebug', 'PFGameSaveFilesInitialize', 'PFGameSaveFilesIsConnectedToCloud',
    'PFGameSaveFilesPauseUploadForDebug', 'PFGameSaveFilesResetCloudAsync', 'PFGameSaveFilesResetCloudResult',
    'PFGameSaveFilesResumeUploadForDebug', 'PFGameSaveFilesSetActiveDeviceChangedCallback',
    'PFGameSaveFilesSetActiveDevicePollForceChangeForDebug', 'PFGameSaveFilesSetActiveDevicePollIntervalForDebug',
    'PFGameSaveFilesSetForceNullPendingManifestForDebug', 'PFGameSaveFilesSetForceOutOfStorageErrorForDebug',
    'PFGameSaveFilesSetForceSyncFailedErrorForDebug', 'PFGameSaveFilesSetMockDataFolderForDebug',
    'PFGameSaveFilesSetMockDeviceIdForDebug', 'PFGameSaveFilesSetMockForceOfflineForDebug',
    'PFGameSaveFilesSetMockManifestOffsetForDebug', 'PFGameSaveFilesSetMockRootFolderForDebug',
    'PFGameSaveFilesSetSaveDescriptionAsync', 'PFGameSaveFilesSetSaveDescriptionResult',
    'PFGameSaveFilesSetUiActiveDeviceContentionResponse', 'PFGameSaveFilesSetUiCallbacks',
    'PFGameSaveFilesSetUiConflictResponse', 'PFGameSaveFilesSetUiOutOfStorageResponse',
    'PFGameSaveFilesSetUiProgressResponse', 'PFGameSaveFilesSetUiSyncFailedResponse',
    'PFGameSaveFilesSetWriteManifestsToDiskForDebug', 'PFGameSaveFilesUiProgressGetProgress',
    'PFGameSaveFilesUninitializeAsync', 'PFGameSaveFilesUninitializeResult', 'PFGameSaveFilesUploadWithUiAsync',
    'PFGameSaveFilesUploadWithUiResult',
)


def pe_exports(data):
    """(export address table size, [(name, ordinal index, forwarder or None) for each named export]) of an x64
    PE image, or None. The table size also counts exports that have no name."""
    def u16(offset):
        return int.from_bytes(data[offset:offset + 2], 'little')

    def u32(offset):
        return int.from_bytes(data[offset:offset + 4], 'little')

    def string(offset):
        end = data.find(b'\0', offset)
        return None if offset is None or end < 0 else data[offset:end].decode('ascii', 'replace')

    if len(data) < 256 or data[:2] != b'MZ':
        return None
    pe = u32(60)
    if data[pe:pe + 4] != b'PE\0\0' or u16(pe + 4) != 0x8664:
        return None
    count, optional_size = u16(pe + 6), u16(pe + 20)
    optional = pe + 24
    if optional_size < 120 or u16(optional) != 0x20B or u32(optional + 108) < 1:
        return None
    sections = optional + optional_size

    def offset_of(address):
        for index in range(count):
            section = sections + index * 40
            start, size, raw = u32(section + 12), u32(section + 16), u32(section + 20)
            if start <= address < start + size and raw + address - start < len(data):
                return raw + address - start
        return None

    directory_rva, directory_size = u32(optional + 112), u32(optional + 116)
    directory = offset_of(directory_rva)
    if directory is None or u32(directory + 16) != 1:
        return None
    functions, names = u32(directory + 20), u32(directory + 24)
    function_table, name_table, ordinal_table = (offset_of(u32(directory + 28)), offset_of(u32(directory + 32)),
                                                 offset_of(u32(directory + 36)))
    if None in (function_table, name_table, ordinal_table):
        return None
    exports = []
    for index in range(names):
        name = string(offset_of(u32(name_table + 4 * index)))
        ordinal = u16(ordinal_table + 2 * index)
        address = u32(function_table + 4 * ordinal) if ordinal < functions else 0
        if name is None or not address:
            return None
        forward = string(offset_of(address)) if directory_rva <= address < directory_rva + directory_size else None
        exports.append((name, ordinal, forward))
    return functions, exports


def playfab_sdk(data):
    """The PlayFab Game Saves SDK the proxy was written for: exactly its 40 exports, all named, none forwarded."""
    parsed = pe_exports(data)
    if parsed is None or parsed[0] != len(PGS_EXPORTS):
        return False
    exports = parsed[1]
    return ([(name, ordinal) for name, ordinal, _ in exports] == list(zip(PGS_EXPORTS, range(len(PGS_EXPORTS))))
            and all(forward is None for _, _, forward in exports))


def playfab_proxy(data):
    """A save-folder proxy (this one or an earlier build): the same 40 exports, forwarding into nexus_pgs_native."""
    parsed = pe_exports(data)
    if parsed is None or parsed[0] != len(PGS_EXPORTS):
        return False
    exports = parsed[1]
    return ([name for name, _, _ in exports] == list(PGS_EXPORTS)
            and any((forward or '').startswith(PGS_NATIVE[:-4] + '.') for _, _, forward in exports))


def kept_sdk(native):
    """True when nexus_pgs_native.dll is a regular file holding a recognised SDK."""
    return not native.is_symlink() and native.is_file() and playfab_sdk(native.read_bytes())


def replace_file(directory, name, data):
    descriptor, temporary = tempfile.mkstemp(prefix='.droiddeck-pgs-', dir=directory)
    try:
        with os.fdopen(descriptor, 'wb') as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, Path(directory) / name)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def stage_playfab_proxy(folder):
    """Put the save-folder proxy in front of every PlayFab Game Saves SDK in the game folder. Returns how many."""
    try:
        proxy = PGS_PROXY.read_bytes()
    except OSError:
        return 0
    staged = 0
    for root, _, files in os.walk(folder):
        directory = Path(root)
        for name in files:
            if name.lower() != 'playfabgamesave.dll':
                continue
            path = directory / name
            native = directory / PGS_NATIVE
            try:
                if path.is_symlink():
                    continue
                data = path.read_bytes()
                if playfab_sdk(data):
                    # A first launch, or a game update that brought a new SDK: the update's copy becomes the native one,
                    # but only in place of nothing or of an earlier SDK copy, never over an unknown file or a link.
                    if os.path.lexists(native) and not kept_sdk(native):
                        print('droiddeck-xbox: unknown %s next to the PlayFab Game Saves SDK in %s; left unchanged'
                              % (PGS_NATIVE, directory), file=sys.stderr)
                        continue
                    replace_file(directory, PGS_NATIVE, data)
                elif not playfab_proxy(data):
                    print('droiddeck-xbox: PlayFab Game Saves SDK with unknown exports in %s; left unchanged' % directory,
                          file=sys.stderr)
                    continue
                elif not kept_sdk(native):
                    print('droiddeck-xbox: PlayFab save proxy without its SDK in %s; left unchanged' % directory,
                          file=sys.stderr)
                    continue
                if data != proxy:
                    replace_file(directory, name, proxy)
                staged += 1
            except OSError as error:
                print('droiddeck-xbox: PlayFab save proxy not staged in %s (%s)' % (directory, error), file=sys.stderr)
    return staged


def parse_manifest_xml(text):
    """Parse an AppxManifest.xml document (or fragment) into an ElementTree root, or None."""
    try:
        return ElementTree.fromstring(text)
    except ElementTree.ParseError:
        stripped = re.sub(r'^\s*<\?xml[^>]*\?>', '', text)
        try:
            return ElementTree.fromstring('<_>' + stripped + '</_>')
        except ElementTree.ParseError:
            return None


def xml_local_tag(element):
    tag = element.tag
    return tag.rsplit('}', 1)[-1] if '}' in tag else tag


def _norm_manifest_rel(path_text):
    return str(path_text or '').replace('\\', '/').lstrip('./').lower()


def uwp_view_app(folder, exe=None):
    """True when the launched manifest Application starts through a view EntryPoint rather than FullTrust."""
    try:
        text = (Path(folder) / 'AppxManifest.xml').read_text(encoding='utf-8', errors='replace')
    except OSError:
        return False
    root = parse_manifest_xml(text)
    if root is None:
        return False
    target_rel = None
    target_name = None
    if exe:
        exe_path = Path(exe)
        rel = relative_to_package(exe_path, folder)
        if rel is None:
            view_root = next((p for p in exe_path.parents if p.name.startswith('droiddeck-xbox-')), None)
            if view_root is not None:
                rel = relative_to_package(exe_path, view_root)
        target_rel = _norm_manifest_rel(rel) if rel is not None else _norm_manifest_rel(exe)
        target_name = exe_path.name.lower()
    apps = []
    for applications in root:
        if xml_local_tag(applications) != 'Applications':
            continue
        for app in applications:
            if xml_local_tag(app) == 'Application':
                apps.append(app)
    if target_rel:
        matched = [a for a in apps if _norm_manifest_rel(a.attrib.get('Executable')) == target_rel]
        if not matched and target_name:
            matched = [a for a in apps if Path((a.attrib.get('Executable') or '').replace('\\', '/')).name.lower() == target_name]
        if matched:
            apps = matched
    for app in apps:
        entry = (app.attrib.get('EntryPoint') or '').strip()
        if entry and entry.split(',')[0].strip().lower() != 'windows.fulltrustapplication':
            return True
    return False


def publisher_id(publisher):
    """AppModel Crockford base32 publisher ID: first 8 bytes of SHA-256(UTF-16LE(publisher))."""
    alphabet = '0123456789abcdefghjkmnpqrstvwxyz'
    digest = hashlib.sha256(publisher.encode('utf-16-le')).digest()[:8]
    value = int.from_bytes(digest, 'big') << 1
    return ''.join(alphabet[(value >> shift) & 31] for shift in range(60, -1, -5))


def package_paths(registry):
    """Map each PackageRepository entry to the Path recorded for it."""
    paths = {}
    current = None
    prefix = PACKAGE_KEY.replace('\\', '\\\\')
    for line in registry.splitlines():
        if line.startswith('[') and ']' in line:
            body = line[1:line.rindex(']')]
            current = body[len(prefix):] if body.startswith(prefix) else None
        elif current is not None and line.startswith('"Path"='):
            paths[current.replace('\\\\', '\\')] = line[7:].strip('"').replace('\\\\', '\\')
    return paths


def package_manifest_identity(folder):
    """Return `(full_name, arch, manifest_text)` from `<folder>/AppxManifest.xml`, or None."""
    folder = Path(folder)
    if not folder.is_absolute():
        return None
    try:
        text = (folder / 'AppxManifest.xml').read_text(encoding='utf-8', errors='replace')
        root = ElementTree.fromstring(text)
    except (OSError, ElementTree.ParseError):
        return None
    identity = next((el for el in root if el.tag.endswith('}Identity') or el.tag == 'Identity'), None)
    if identity is None:
        return None
    name = (identity.attrib.get('Name') or '').strip()
    publisher = (identity.attrib.get('Publisher') or '').strip()
    version = (identity.attrib.get('Version') or '').strip()
    arch = (identity.attrib.get('ProcessorArchitecture') or 'neutral').strip().lower()
    resource_id = (identity.attrib.get('ResourceId') or '').strip()
    if not (name and publisher and version):
        return None
    full = '%s_%s_%s_%s_%s' % (name, version, arch, resource_id, publisher_id(publisher))
    return full, arch, text


def relative_to_package(exe_path, package):
    """Return `exe_path` relative to `package` even when `exe_path` uses an alternate mount/symlink prefix."""
    path = Path(exe_path)
    try:
        return path.relative_to(Path(package))
    except ValueError:
        pass
    parts = []
    cur = path
    for parent in path.parents:
        parts.append(cur.name)
        cur = parent
        try:
            if os.path.samefile(parent, package):
                return Path(*reversed(parts))
        except OSError:
            pass
    return None


def stage_package_root(prefix, folder, full_name):
    r"""Expose `folder` under C:\Program Files\WindowsApps\<full_name> inside `prefix` via a directory symlink."""
    apps_dir = prefix / 'drive_c/Program Files/WindowsApps'
    link = apps_dir / full_name
    staged = apps_dir / ('.%s-%s' % (full_name, secrets.token_hex(4)))
    try:
        apps_dir.mkdir(parents=True, exist_ok=True)
        if link.is_symlink() and os.readlink(link) == str(folder):
            return 'C:\\Program Files\\WindowsApps\\' + full_name
        if os.path.lexists(link) and not link.is_symlink():
            return None
        staged.symlink_to(folder)
        os.replace(staged, link)
    except OSError:
        if os.path.lexists(staged):
            try:
                staged.unlink()
            except OSError:
                pass
        return None
    return 'C:\\Program Files\\WindowsApps\\' + full_name


def package_identities(folder, install_path=None):
    """AppModel PackageRepository entries ({full name: Windows path}) for the package in `folder`."""
    parsed = package_manifest_identity(folder)
    if parsed is None:
        return {}
    full, arch, text = parsed
    root = install_path or ('Z:' + str(Path(folder)).replace('/', '\\'))
    entries = {full: root}
    if arch == 'x64' and 'Microsoft.VCLibs.140.00' in text:
        entries[VCLIBS_X64] = 'C:\\windows\\system32'
    return entries


def register_packages(proton, prefix, env, packages):
    """Register AppModel PackageRepository entries where the prefix does not already record them."""
    if not packages:
        return
    try:
        registry = (prefix / 'system.reg').read_text(encoding='utf-8', errors='replace')
    except OSError:
        return
    installed = package_paths(registry)
    missing = []
    for full, target in packages.items():
        existing = installed.get(full, '')
        if full == VCLIBS_X64 and existing:
            continue
        if existing.lower() != target.lower():
            missing.append((full, target))
    if not missing:
        return
    text = 'Windows Registry Editor Version 5.00\r\n\r\n' + ''.join(
        '[HKEY_LOCAL_MACHINE\\%s%s]\r\n"Path"="%s"\r\n\r\n' % (PACKAGE_KEY, full, target.replace('\\', '\\\\'))
        for full, target in missing)
    with tempfile.TemporaryDirectory(prefix='droiddeck-xbox-') as temporary:
        source = Path(temporary) / 'packages.reg'
        source.write_bytes(b'\xff\xfe' + text.encode('utf-16-le'))
        result = subprocess.run([proton, 'run', 'reg', 'import', 'Z:' + str(source).replace('/', '\\')],
                                stdout=sys.stderr, env=env)
        if result.returncode:
            print('droiddeck-xbox: package registration exited %d' % result.returncode, file=sys.stderr)


def package_classes(folder, install_path=None):
    """The in-process Windows Runtime classes the package's manifest declares, as {DLL path: class names}.

    Windows registers these when it deploys the package, so a title that activates a class it ships gets the
    package's own DLL. Scanned as text like uwp_view_app: the manifest is untrusted, so a server's DLL must be a
    relative path to a file inside the package and a class name a dotted identifier.
    """
    folder = Path(folder)
    if not folder.is_absolute():
        return {}
    try:
        text = (folder / 'AppxManifest.xml').read_text(encoding='utf-8', errors='replace')
    except OSError:
        return {}
    root = parse_manifest_xml(text)
    if root is None:
        return {}
    classes = {}
    root_path = install_path or ('Z:' + str(folder).replace('/', '\\'))
    for server in root.iter():
        if xml_local_tag(server) != 'InProcessServer':
            continue
        path_el = next((el for el in server if xml_local_tag(el) == 'Path'), None)
        if path_el is None or path_el.text is None:
            continue
        names = []
        for el in server:
            if xml_local_tag(el) == 'ActivatableClass':
                cid = (el.attrib.get('ActivatableClassId') or '').strip()
                if cid and re.fullmatch(r'[A-Za-z0-9_.]+', cid):
                    names.append(cid)
        if not names:
            continue
        relative = path_el.text.strip().replace('\\', '/')
        if not relative or relative.startswith('/') or ':' in relative or '..' in relative.split('/'):
            continue
        dll = folder / relative
        if dll.is_file():
            dll_path = root_path + '\\' + relative.replace('/', '\\')
            classes.setdefault(dll_path, []).extend(names)
    return classes


def renew_lease(ask, channel, product, lease, stopped):
    while not stopped.wait(15):
        response = ask(channel, {'op': 'xbox-renew', 'id': product, 'lease': lease}, timeout=10)
        if response is not None and response.get('ok') is False:
            return


def launch(command, env):
    if len(command) < 3 or command[1] != 'waitforexitandrun' or env.get('DROIDDECK_XBOX_ACTIVE') == '1':
        return None
    try:
        store = runpy.run_path(str(BIN / 'droiddeck-store-launch'))
    except Exception as error:
        print('droiddeck-xbox: store detection unavailable (%s); stock launch' % error, file=sys.stderr)
        return None
    found = store['find_store_game'](command[2:])
    if found is None or found[1].get('store') != 'xbox':
        return None
    folder, sidecar = found
    trace(env, 'xbox package %s' % folder)
    for name in DLLS:
        if not (RUNTIME / 'windows' / name).is_file():
            raise RuntimeError('Xbox Windows runtime is missing; update the Linux runtime')
    launch_dir = env.get('DD_LAUNCH_DIR')
    if not launch_dir:
        raise RuntimeError('No Xbox account channel; start the game from DroidDeck')
    reply = store['ask'](Path(launch_dir) / 'stores', {'op': 'xbox-prepare', 'id': sidecar['id']}, timeout=190)
    if not reply or not reply.get('ok'):
        raise RuntimeError((reply or {}).get('reason') or 'Xbox account service is unavailable; sign in again and retry')
    stopped = threading.Event()
    close = lambda: None
    try:
        port, key, close = bridge(reply['socket'])

        threading.Thread(target=renew_lease, args=(store['ask'], Path(launch_dir) / 'stores',
                         sidecar['id'], reply['lease'], stopped), daemon=True).start()
        with tempfile.TemporaryDirectory(prefix='droiddeck-xbox-') as temporary:
            context = Path(temporary) / 'command.json'
            context.write_text(json.dumps(command), encoding='utf-8')
            context.chmod(0o600)
            owned_env = dict(env, DROIDDECK_XBOX_ACTIVE='1', DROIDDECK_XBOX_COMMAND_FILE=str(context),
                             XODUS_SOCKET=reply['socket'], XODUS_BRIDGE_PORT=str(port), XODUS_BRIDGE_KEY=key,
                             XODUS_LOG='off', RUST_LOG='off', XODUS_SAVE_SYNC='auto' if sidecar.get('cloud', True) else 'none')
            for name in ('DROIDDECK_XBOX_CREDENTIAL_SOCKET', 'DROIDDECK_XBOX_CREDENTIAL_PORT', 'DROIDDECK_XBOX_CREDENTIAL_KEY'):
                owned_env.pop(name, None)
            if reply.get('playfab'):
                owned_env['XODUS_XSTS_PLAYFAB'] = reply['playfab']
            # The runtime mounts DLC only inside this backend-owned workspace (E_NOTIMPL without it).
            mount_root = reply.get('mountRoot')
            if isinstance(mount_root, str) and mount_root.startswith('/'):
                owned_env['XODUS_MOUNT_ROOT'] = 'Z:' + mount_root.replace('/', '\\')
            content = folder / '.xbox-content'
            roots = []
            if content.is_dir():
                for entry in content.iterdir():
                    try:
                        marker = json.loads((entry / '.droiddeck-content.json').read_text())
                        if marker.get('parent') == sidecar['id'] and marker.get('productId') == entry.name and not entry.is_symlink():
                            roots.append('Z:' + str(entry).replace('/', '\\'))
                    except (OSError, ValueError, TypeError):
                        pass
            if roots:
                owned_env['XODUS_CONTENT_ROOTS'] = ';'.join(roots)
            # No DLL override for the proxy or the kept SDK: Wine has no builtin of either, so both load from the
            # game folder as they are. Forcing them native-only (as Nexus does) made Forza Horizon 6 fail with E:0-0-4.
            try:
                stage_playfab_proxy(folder)
            except Exception as error:
                print('droiddeck-xbox: PlayFab save proxy skipped (%s)' % error, file=sys.stderr)
            # Only a view package needs the app model; asking for its host costs nothing else.
            view = uwp_view_app(folder, reply['exe'])
            trace(env, 'package starts a view: %s' % view)
            if view:
                owned_env['DROIDDECK_XBOX_UWP_HOST'] = '1'
            else:
                owned_env.pop('DROIDDECK_XBOX_UWP_HOST', None)
            return wine([reply['exe']], owned_env, folder)
    finally:
        stopped.set()
        close()
        store['ask'](Path(launch_dir) / 'stores', {'op': 'xbox-released', 'lease': reply['lease']})


if __name__ == '__main__':
    try:
        sys.exit(wine(sys.argv[1:]))
    except (OSError, ValueError, KeyError, RuntimeError):
        print('droiddeck-xbox: Xbox launch failed; check your account, runtime and package.', file=sys.stderr)
        sys.exit(1)
