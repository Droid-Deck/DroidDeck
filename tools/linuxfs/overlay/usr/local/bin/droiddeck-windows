#!/usr/bin/python3
"""Window metadata and control only; never reads a window's rendered pixels."""
import array
import configparser
import ctypes
import ctypes.util
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import select
import socket
import struct
import tempfile
import threading
import time
import zlib


def string(value):
    data = value.encode() + b"\0"
    return struct.pack("<I", len(data)) + data + b"\0" * (-len(data) % 4)


def read_string(data, offset=0):
    length = struct.unpack_from("<I", data, offset)[0]
    return data[offset + 4:offset + 4 + max(0, length - 1)].decode(errors="replace")


def png_icon(values):
    choices, offset = [], 0
    while offset + 2 <= len(values):
        w, h = values[offset:offset + 2]
        if not 0 < w <= 1024 or not 0 < h <= 1024 or offset + 2 + w * h > len(values):
            break
        choices.append((icon_size_rank(w, h), w, h, offset + 2))
        offset += 2 + w * h
    if not choices:
        return None
    _, w, h, start = min(choices)
    pixels = values[start:start + w * h]
    rows = b"".join(b"\0" + b"".join(bytes(((p >> 16) & 255, (p >> 8) & 255, p & 255, p >> 24))
                                     for p in pixels[y * w:(y + 1) * w]) for y in range(h))
    def chunk(kind, body):
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))


def icon_size_rank(width, height):
    edge = max(width, height)
    return (edge < 256, abs(edge - 256), -min(width, height))


def stream_icon(data):
    signature = b"\x89PNG\r\n\x1a\n"
    choices, search = [], 0
    while (start := data.find(signature, search)) >= 0:
        search = start + len(signature)
        offset, dimensions, pixels = search, None, False
        while offset + 12 <= len(data):
            length = struct.unpack_from(">I", data, offset)[0]
            end = offset + length + 12
            if end > len(data):
                break
            kind = data[offset + 4:offset + 8]
            body = data[offset + 8:end - 4]
            if zlib.crc32(kind + body) != struct.unpack_from(">I", data, end - 4)[0]:
                break
            if dimensions is None:
                if kind != b"IHDR" or length != 13:
                    break
                dimensions = struct.unpack_from(">II", body)
                w, h = dimensions
                if not 0 < w <= 4096 or not 0 < h <= 4096 or w * h > 4 * 1024 * 1024:
                    break
            if kind == b"IDAT":
                pixels = True
            if kind == b"IEND":
                if length == 0 and pixels:
                    choices.append((icon_size_rank(*dimensions), data[start:end]))
                    search = end
                break
            offset = end
    return min(choices, key=lambda item: item[0])[1] if choices else None


class IconTransfer:
    def __init__(self):
        self.fd, self.writer = os.pipe()
        os.set_blocking(self.fd, False)
        self.data = bytearray()
        self.deadline = time.monotonic() + 5

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def read(self):
        try:
            while True:
                chunk = os.read(self.fd, 65536)
                if not chunk:
                    self.close()
                    return bytes(self.data)
                self.data.extend(chunk)
                if len(self.data) > 1024 * 1024:
                    self.close()
                    return b""
        except BlockingIOError:
            if time.monotonic() < self.deadline:
                return None
            self.close()
            return b""
        except OSError:
            self.close()
            return b""


class Plasma:
    def __init__(self, path, publish_icon):
        self.s = socket.socket(socket.AF_UNIX)
        self.s.settimeout(1)
        self.s.connect(str(path))
        self.buffer = b""
        self.next_id = 3
        self.manager = None
        self.security_manager = None
        self.scope = None
        self.close_fd = None
        self.creator = None
        self.windows = {}
        self.transfers = {}
        self.publish_icon = publish_icon
        self.send(1, 1, struct.pack("<I", 2))
        deadline = time.monotonic() + 1
        try:
            while self.manager is None and time.monotonic() < deadline:
                self.pump(0.1)
                if self.security_manager is not None and self.manager is None:
                    self.scoped_connection(path)
                    deadline = time.monotonic() + 1
        except OSError:
            self.close()
            raise
        if self.manager is None:
            self.close()
            raise OSError("No Plasma window manager")

    def scoped_connection(self, path):
        app_id = "org.droiddeck.WindowBridge"
        applications = Path.home() / ".local/share/applications"
        applications.mkdir(parents=True, exist_ok=True)
        (applications / (app_id + ".desktop")).write_text(
            "[Desktop Entry]\nType=Application\nName=DroidDeck window bridge\n"
            "Exec=/usr/local/bin/droiddeck-windows\nNoDisplay=true\n"
            "X-KDE-Wayland-Interfaces=org_kde_plasma_window_management\n")
        self.scope = tempfile.TemporaryDirectory(prefix="droiddeck-window-", dir=str(path.parent))
        listener_path = str(Path(self.scope.name) / "wayland")
        listener = socket.socket(socket.AF_UNIX)
        listener.bind(listener_path)
        listener.listen(1)
        read_fd, self.close_fd = os.pipe()
        context = self.allocate()
        data = struct.pack("<I", context)
        message = struct.pack("<II", self.security_manager, ((len(data) + 8) << 16) | 1) + data
        self.s.sendmsg([message], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", [listener.fileno(), read_fd]))])
        self.send(context, 1, string("org.droiddeck"))
        self.send(context, 2, string(app_id))
        self.send(context, 4)
        listener.close()
        os.close(read_fd)
        self.creator = self.s
        self.s = socket.socket(socket.AF_UNIX)
        self.s.settimeout(1)
        self.s.connect(listener_path)
        self.buffer = b""
        self.next_id = 3
        self.security_manager = None
        self.send(1, 1, struct.pack("<I", 2))

    def close(self):
        for transfer in self.transfers.values():
            transfer.close()
        self.transfers.clear()
        self.s.close()
        if self.creator is not None:
            self.creator.close()
            self.creator = None
        if self.close_fd is not None:
            os.close(self.close_fd)
            self.close_fd = None
        if self.scope is not None:
            self.scope.cleanup()
            self.scope = None

    def send(self, obj, opcode, data=b"", fd=None):
        message = struct.pack("<II", obj, ((len(data) + 8) << 16) | opcode) + data
        if fd is None:
            self.s.sendall(message)
        else:
            self.s.sendmsg([message], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", [fd]))])

    def allocate(self):
        value = self.next_id
        self.next_id += 1
        return value

    def pump(self, timeout=0):
        if select.select([self.s], [], [], timeout)[0]:
            data = self.s.recv(65536)
            if not data:
                raise OSError("Plasma connection closed")
            self.buffer += data
        while len(self.buffer) >= 8:
            obj, header = struct.unpack_from("<II", self.buffer)
            length, opcode = header >> 16, header & 65535
            if length < 8 or length > 1024 * 1024:
                raise OSError("Invalid Wayland event")
            if len(self.buffer) < length:
                break
            data, self.buffer = self.buffer[8:length], self.buffer[length:]
            self.event(obj, opcode, data)

    def event(self, obj, opcode, data):
        if obj == 1 and opcode == 0:
            raise OSError("Wayland protocol error")
        if obj == 2 and opcode == 0:
            name = read_string(data, 4)
            version = struct.unpack_from("<I", data, 8 + ((len(name.encode()) + 1 + 3) & ~3))[0]
            if name == "org_kde_plasma_window_management" and version >= 17:
                self.manager = self.allocate()
                self.send(2, 0, struct.pack("<I", struct.unpack_from("<I", data)[0]) + string(name)
                          + struct.pack("<II", min(version, 18), self.manager))
            elif name == "wp_security_context_manager_v1" and self.scope is None:
                self.security_manager = self.allocate()
                self.send(2, 0, struct.pack("<I", struct.unpack_from("<I", data)[0]) + string(name)
                          + struct.pack("<II", 1, self.security_manager))
        elif obj == self.manager and opcode == 4:
            uuid = read_string(data, 4)
            wid = self.allocate()
            self.windows[wid] = {"key": "wl:" + uuid, "backend": "plasma", "title": "", "program": "",
                                 "geometry": [0, 0, 0, 0], "state": 0, "ready": False}
            self.send(self.manager, 2, struct.pack("<I", wid) + string(uuid))
        elif obj in self.windows:
            win = self.windows[obj]
            if opcode in (0, 1):
                win["title" if opcode == 0 else "program"] = read_string(data)
            elif opcode == 2:
                win["state"] = struct.unpack_from("<I", data)[0]
            elif opcode == 4:
                self.cancel_icon(obj)
                win.pop("icon", None)
                win["iconName"] = read_string(data)
                win["iconPending"] = True
            elif opcode == 5:
                self.cancel_icon(obj)
                del self.windows[obj]
                self.send(obj, 7)
            elif opcode == 6:
                win["ready"] = True
            elif opcode == 7:
                parent = struct.unpack_from("<I", data)[0]
                win["parentKey"] = self.windows.get(parent, {}).get("key", "")
            elif opcode in (8, 17):
                win["geometry"] = list(struct.unpack("<iiII", data))
            elif opcode == 9:
                self.cancel_icon(obj)
                win.pop("icon", None)
                win["iconPending"] = True
            elif opcode == 10:
                win["pid"] = struct.unpack_from("<I", data)[0]

    def cancel_icon(self, wid):
        transfer = self.transfers.pop(wid, None)
        if transfer is not None:
            transfer.close()

    def snapshot(self):
        self.pump()
        result = []
        for wid, win in list(self.windows.items()):
            if not win["ready"] or win["state"] & (0x1000 | 0x40000) or not win["program"]:
                self.cancel_icon(wid)
                continue
            if win.pop("iconPending", False):
                transfer = IconTransfer()
                try:
                    self.send(wid, 8, fd=transfer.writer)
                except OSError:
                    transfer.close()
                    raise
                finally:
                    os.close(transfer.writer)
                self.transfers[wid] = transfer
            if wid in self.transfers:
                data = self.transfers[wid].read()
                if data is not None:
                    self.transfers.pop(wid)
                    icon = stream_icon(data)
                    if icon:
                        win["icon"] = self.publish_icon(icon)
            result.append({k: v for k, v in win.items() if k not in ("ready", "iconPending")})
        return result

    def control(self, key, action):
        wid = next((wid for wid, win in self.windows.items() if win["key"] == key), None)
        if wid is None:
            raise ValueError("Window no longer exists")
        if action == "close":
            self.send(wid, 4)
        elif action == "focus":
            self.send(wid, 0, struct.pack("<II", 3, 1))
        elif action == "minimize":
            self.send(wid, 0, struct.pack("<II", 2, 2))


def process_identity(pid):
    try:
        if pid <= 0:
            return None
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, ValueError, IndexError):
        return None


class WindowReturns:
    def __init__(self):
        self.returned = set()
        self.parents = {}
        self.pending = {}
        self.results = []

    def remember(self, windows):
        self.parents.update((w["key"], w.get("parentKey", "")) for w in windows)

    def family(self, key):
        result = {key}
        while True:
            children = {child for child, parent in self.parents.items() if parent in result}
            if children <= result:
                return result
            result.update(children)

    def begin(self, request, windows, now):
        self.remember(windows)
        window = next((w for w in windows if w["key"] == request["key"]), None)
        if window is None:
            return
        identity = process_identity(window.get("pid", 0))
        self.returned.update(self.family(window["key"]))
        self.pending[request["id"]] = {
            "id": request["id"], "key": window["key"], "title": window["title"],
            "program": window["program"], "pid": window.get("pid", 0),
            "identity": identity, "before": {w["key"] for w in windows},
            "deadline": now + 2.0,
        }

    def failed(self, request_id, error):
        if request_id in self.pending:
            self.pending[request_id]["error"] = str(error)

    def snapshot_results(self):
        return [dict(result) for result in self.results]

    def host(self, key):
        root = key
        seen = set()
        while self.parents.get(root) in self.returned and root not in seen:
            seen.add(root)
            root = self.parents[root]
        self.returned.difference_update(self.family(root))
        self.pending = {i: p for i, p in self.pending.items() if p["key"] != root}

    def restore(self, key):
        self.returned.update(self.family(key))

    def observe(self, windows, now):
        self.remember(windows)
        for pending in self.pending.values():
            for window in windows:
                if window["key"] not in pending["before"] and pending["identity"] is not None and \
                        window.get("pid") == pending["pid"] and \
                        process_identity(pending["pid"]) == pending["identity"]:
                    self.returned.add(window["key"])
        for key in list(self.returned):
            self.returned.update(self.family(key))
        for request_id, pending in list(self.pending.items()):
            if now < pending["deadline"]:
                continue
            related = [w for w in windows if w["key"] in self.family(pending["key"]) or
                       (w["key"] not in pending["before"] and w["key"] in self.returned and
                        w.get("pid") == pending["pid"])]
            alive = pending["identity"] is not None and process_identity(pending["pid"]) == pending["identity"]
            siblings = any(w.get("pid") == pending["pid"] and w["key"] in pending["before"] and
                           w["key"] not in self.family(pending["key"]) for w in windows)
            outcome = ("unsupported" if "error" in pending else
                       "minimized" if related and all(w.get("state", 0) & 2 for w in related) else
                       "running" if related else "background" if alive and not siblings else "closed")
            self.results.append({k: pending[k] for k in ("id", "key", "title", "program", "pid")} |
                                {"outcome": outcome})
            self.results = self.results[-32:]
            del self.pending[request_id]
        return [dict(w, desktop=w["key"] in self.returned) for w in windows]


class WindowBridge(threading.Thread):
    def __init__(self, directory):
        super().__init__(daemon=True, name="native-windows")
        self.dir = directory
        self.icons = directory / "window-icons"
        self.requests = directory / "window-requests"
        self.plasma = None
        self.last = None
        self.generation = str(time.time_ns())
        self.x_api = runpy.run_path(str(Path(__file__).with_name("droiddeck-agent")))
        self.themed = {}
        self.returns = WindowReturns()

    def themed_icon(self, name):
        if not name or len(name) > 4096:
            return None
        plain = re.fullmatch(r"[A-Za-z0-9._+-]{1,256}", name) and name not in (".", "..")
        absolute = name.startswith("/") and Path(name).suffix in (".png", ".svg")
        if not plain and not absolute:
            return None
        cached = self.themed.get(name)
        if cached and (cached[1] is not None or time.monotonic() - cached[0] < 5):
            return cached[1]
        icon_name = name
        if plain:
            for root in (Path.home() / ".local/share/applications", Path("/usr/local/share/applications"),
                         Path("/usr/share/applications")):
                try:
                    entry = root / (name + ".desktop")
                    if not entry.is_file() or entry.stat().st_size > 65536:
                        continue
                    desktop = configparser.ConfigParser(interpolation=None, strict=False)
                    desktop.read(entry, encoding="utf-8")
                    icon_name = desktop.get("Desktop Entry", "Icon", fallback=name)
                    break
                except (OSError, configparser.Error, UnicodeError):
                    continue
        roots = [Path.home() / ".local/share/icons", Path("/usr/share/icons"), Path("/usr/share/pixmaps")]
        found = []
        if icon_name.startswith("/") and Path(icon_name).suffix in (".png", ".svg"):
            found = [Path(icon_name)]
        elif re.fullmatch(r"[A-Za-z0-9._+-]{1,256}", icon_name) and icon_name not in (".", ".."):
            if icon_name.endswith((".png", ".svg")):
                icon_name = icon_name[:-4]
            for root in roots:
                for suffix in (".png", ".svg"):
                    found.extend(root.glob("**/" + icon_name + suffix))
        def rank(path):
            sizes = [int(part.split("x")[0]) for part in path.parts if re.fullmatch(r"\d+x\d+", part)]
            return (0 if path.suffix == ".svg" else 1,
                    icon_size_rank(sizes[-1], sizes[-1]) if sizes else (True, 256, 0), len(str(path)))
        found.sort(key=rank)
        result = None
        for path in found[:8]:
            try:
                if path.stat().st_size > 1024 * 1024:
                    continue
                if path.suffix == ".png":
                    result = self.icon(path.read_bytes())
                else:
                    rsvg = ctypes.CDLL(ctypes.util.find_library("rsvg-2") or "librsvg-2.so.2")
                    cairo = ctypes.CDLL(ctypes.util.find_library("cairo") or "libcairo.so.2")
                    gobject = ctypes.CDLL(ctypes.util.find_library("gobject-2.0") or "libgobject-2.0.so.0")
                    rsvg.rsvg_handle_new_from_file.argtypes = [ctypes.c_char_p, ctypes.c_void_p]
                    rsvg.rsvg_handle_new_from_file.restype = ctypes.c_void_p
                    rsvg.rsvg_handle_render_cairo.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
                    cairo.cairo_image_surface_create.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int]
                    cairo.cairo_image_surface_create.restype = ctypes.c_void_p
                    cairo.cairo_create.argtypes = [ctypes.c_void_p]
                    cairo.cairo_create.restype = ctypes.c_void_p
                    cairo.cairo_scale.argtypes = [ctypes.c_void_p, ctypes.c_double, ctypes.c_double]
                    cairo.cairo_translate.argtypes = [ctypes.c_void_p, ctypes.c_double, ctypes.c_double]
                    cairo.cairo_surface_write_to_png.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
                    cairo.cairo_destroy.argtypes = [ctypes.c_void_p]
                    cairo.cairo_surface_destroy.argtypes = [ctypes.c_void_p]
                    gobject.g_object_unref.argtypes = [ctypes.c_void_p]
                    class Dimensions(ctypes.Structure):
                        _fields_ = [("width", ctypes.c_int), ("height", ctypes.c_int),
                                    ("em", ctypes.c_double), ("ex", ctypes.c_double)]
                    rsvg.rsvg_handle_get_dimensions.argtypes = [ctypes.c_void_p, ctypes.POINTER(Dimensions)]
                    handle = rsvg.rsvg_handle_new_from_file(os.fsencode(path), None)
                    if not handle:
                        continue
                    dimensions = Dimensions()
                    rsvg.rsvg_handle_get_dimensions(handle, ctypes.byref(dimensions))
                    surface = cairo.cairo_image_surface_create(0, 256, 256)
                    cr = cairo.cairo_create(surface)
                    try:
                        scale = 256 / max(1, dimensions.width, dimensions.height)
                        cairo.cairo_translate(cr, (256 - dimensions.width * scale) / 2,
                                              (256 - dimensions.height * scale) / 2)
                        cairo.cairo_scale(cr, scale, scale)
                        if rsvg.rsvg_handle_render_cairo(handle, cr):
                            self.icons.mkdir(exist_ok=True)
                            temp = self.icons / "themed.tmp.png"
                            if cairo.cairo_surface_write_to_png(surface, os.fsencode(temp)) == 0:
                                result = self.icon(temp.read_bytes())
                            temp.unlink(missing_ok=True)
                    finally:
                        cairo.cairo_destroy(cr)
                        cairo.cairo_surface_destroy(surface)
                        gobject.g_object_unref(handle)
                if result:
                    break
            except (OSError, ValueError):
                continue
        if len(self.themed) >= 128:
            self.themed.pop(next(iter(self.themed)))
        self.themed[name] = (time.monotonic(), result)
        return result

    def icon(self, data):
        if not data or len(data) > 1024 * 1024:
            return None
        data = stream_icon(data)
        if data is None:
            return None
        self.icons.mkdir(exist_ok=True)
        name = hashlib.sha256(data).hexdigest() + ".png"
        path = self.icons / name
        if not path.exists():
            path.write_bytes(data)
        return name

    def x_snapshot(self):
        result = []
        shown = self.x_api["displays"]()
        shown += [":" + p.name[1:] for p in Path("/tmp/.X11-unix").glob("X[0-9]*")]
        for display in dict.fromkeys(shown):
            try:
                x = self.x_api["X"](display)
                try:
                    clients = x.prop(x.root, "_NET_CLIENT_LIST") or x.children(x.root)
                    for wid in clients:
                        attrs = x.attributes(wid)
                        if not attrs or attrs[1] or attrs[2] == 2:
                            continue
                        state = x.prop(wid, "WM_STATE")
                        if attrs[0] != 2 and not (state and state[0] == 3):
                            continue
                        kinds = x.prop(wid, "_NET_WM_WINDOW_TYPE") or []
                        if any(x.atom_name(a) in ("_NET_WM_WINDOW_TYPE_DESKTOP", "_NET_WM_WINDOW_TYPE_DOCK",
                                                  "_NET_WM_WINDOW_TYPE_TOOLTIP", "_NET_WM_WINDOW_TYPE_MENU")
                               for a in kinds):
                            continue
                        cls = (x.prop(wid, "WM_CLASS") or b"").rstrip(b"\0").split(b"\0")[-1].decode(errors="replace")
                        if not cls:
                            continue
                        title = (x.prop(wid, "_NET_WM_NAME") or x.prop(wid, "WM_NAME") or b"").decode(errors="replace")
                        result.append({"key": "x:" + display + ":" + str(wid), "backend": "x11", "title": title,
                                       "program": cls, "geometry": list(x.geometry(wid) or (0, 0, 0, 0)),
                                       "icon": self.icon(png_icon(x.prop(wid, "_NET_WM_ICON", 262144) or []))
                                               or self.themed_icon(cls.lower()),
                                       "state": 2 if state and state[0] == 3 else 0})
                finally:
                    x.close()
            except OSError:
                continue
        return result

    def control(self, key, action):
        if action not in ("focus", "close", "minimize", "host", "restore"):
            raise ValueError("Unsupported window action")
        if action == "restore":
            self.returns.restore(key)
            return
        if action == "host":
            self.returns.host(key)
            action = "focus"
        if key.startswith("wl:") and self.plasma:
            return self.plasma.control(key, action)
        _, display, screen, window = key.split(":")
        x = self.x_api["X"](":" + screen)
        try:
            wid = int(window)
            if action == "focus":
                x.cardinals(x.root, "GAMESCOPECTRL_BASELAYER_WINDOW", [wid])
                atom, values, destination, mask = "_NET_ACTIVE_WINDOW", [2, 0, 0, 0, 0], x.root, 0x180000
            elif action == "minimize":
                atom, values, destination, mask = "WM_CHANGE_STATE", [3, 0, 0, 0, 0], x.root, 0x180000
            else:
                protocols = x.prop(wid, "WM_PROTOCOLS") or []
                delete = x.atom("WM_DELETE_WINDOW")
                if delete not in protocols:
                    raise ValueError("Application has no graceful close protocol")
                atom, values, destination, mask = "WM_PROTOCOLS", [delete, 0, 0, 0, 0], wid, 0
            event = struct.pack("<BBHII5I", 33, 32, 0, wid, x.atom(atom), *values)
            x.s.sendall(struct.pack("<BBHII", 25, 0, 11, destination, mask) + event)
        finally:
            x.close()

    def run(self):
        self.requests.mkdir(exist_ok=True)
        while True:
            enabled = (self.dir / "windows-enabled").exists()
            if not enabled:
                if self.plasma:
                    self.plasma.close()
                    self.plasma = None
                self.last = None
                self.returns = WindowReturns()
                time.sleep(0.25)
                continue
            try:
                if self.plasma is None:
                    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/droiddeck"))
                    for path in sorted(runtime.glob("wayland-[1-9]*")):
                        if path.name.endswith(".lock"):
                            continue
                        try:
                            self.plasma = Plasma(path, self.icon)
                            break
                        except OSError:
                            pass
                wins = self.plasma.snapshot() if self.plasma else self.x_snapshot()
                if self.plasma:
                    for win in wins:
                        if not win.get("icon"):
                            win["icon"] = self.themed_icon(win.get("iconName")) or self.themed_icon(win["program"])
                host = self.dir / "window-host.json"
                host_state = {}
                if host.is_file():
                    try:
                        host_state = json.loads(host.read_text())
                    except (OSError, ValueError):
                        pass
                managed = {w["key"]: w for w in host_state.get("managed", [])}
                for win in wins:
                    win.update({k: v for k, v in managed.get(win["key"], {}).items() if k != "key"})
                for path in sorted(self.requests.glob("*.json"), key=lambda p: (p.stat().st_mtime_ns, p.name)):
                    request = {}
                    try:
                        request = json.loads(path.read_bytes()[:4096])
                        if request.get("action") == "close" and request.get("returnToDesktop"):
                            self.returns.begin(request, wins, time.monotonic())
                        self.control(request["key"], request["action"])
                    except (OSError, ValueError, KeyError) as error:
                        self.returns.failed(request.get("id"), error)
                        self.x_api["log"]("window control: " + str(error))
                    finally:
                        path.unlink(missing_ok=True)
                wins = self.returns.observe(wins, time.monotonic())
                body = {"generation": self.generation, "windows": wins,
                        "backend": "plasma" if self.plasma else "x11",
                        "independent": host_state.get("backend") == "kwin-independent",
                        "closeResults": self.returns.snapshot_results()}
                if body != self.last or not (self.dir / "windows.json").exists():
                    self.x_api["write_json"](self.dir / "windows.json", body)
                    self.last = body
            except OSError as error:
                self.x_api["log"]("window bridge reconnect: " + str(error))
                if self.plasma:
                    self.plasma.close()
                    self.plasma = None
            time.sleep(0.25)
