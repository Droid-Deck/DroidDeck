#!/usr/bin/python3
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
import posixpath
import tarfile

RELEASES = "https://api.github.com/repos/%s/releases"
SOURCES = {
    "ge": ("GloriousEggroll/proton-ge-custom", re.compile(r"aarch64\.tar\.(gz|xz)$")),
    "cachyos": ("CachyOS/proton-cachyos", re.compile(r"arm64\.tar\.(gz|xz)$")),
    "droiddeck": ("Droid-Deck/DroidDeck-Proton", re.compile(r"aarch64\.tar\.(gz|xz)$")),
}
USER_AGENT = "droiddeck-proton-extra"
NEED_BYTES = 4 * 1024 * 1024 * 1024
MAX_ENTRIES = 100000
MAX_FILE_BYTES = 2 * 1024 * 1024 * 1024
MAX_EXPANDED_BYTES = 8 * 1024 * 1024 * 1024


def log(*args):
    print("droiddeck-proton-extra:", *args, flush=True)


def fetch_json(url):
    req = urllib.request.Request(url, headers={
        "User-Agent": USER_AGENT, "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def pick_asset(source):
    repo, pattern = SOURCES[source]
    for release in fetch_json(RELEASES % repo + "?per_page=15"):
        if release.get("draft") or release.get("prerelease"):
            continue
        assets = {a["name"]: a["browser_download_url"] for a in release.get("assets", ())}
        for name in sorted(assets):
            if pattern.search(name):
                sums = [u for n, u in assets.items()
                        if n.startswith(name.split(".tar")[0]) and "sha512" in n]
                return release["tag_name"], assets[name], (sums[0] if sums else None)
    return None, None, None


def release_asset(source, tag):
    repo, pattern = SOURCES[source]
    release = fetch_json(RELEASES % repo + "/tags/" + tag)
    assets = {a["name"]: a["browser_download_url"] for a in release.get("assets", ())}
    for name in sorted(assets):
        if pattern.search(name):
            sums = [u for n, u in assets.items()
                    if n.startswith(name.split(".tar")[0]) and "sha512" in n]
            return tag, assets[name], (sums[0] if sums else None)
    raise SystemExit("droiddeck-proton-extra: %s has no ARM64 asset" % tag)


def download(url, path):
    log("downloading %s" % os.path.basename(path))
    rc = subprocess.call([
        "curl", "-fL", "--retry", "5", "--retry-delay", "3", "--retry-connrefused",
        "-C", "-", "-A", USER_AGENT, "-o", path, url])
    if rc != 0:
        raise SystemExit("droiddeck-proton-extra: download failed (curl %d)" % rc)
    log("downloaded %.0f MB" % (os.path.getsize(path) / 1048576.0))


def verify(path, sums_url):
    if not sums_url:
        log("no checksum published; skipping verification")
        return
    try:
        req = urllib.request.Request(sums_url, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(req, timeout=60) as r:
            want = r.read().decode("utf-8", "replace").split()[0].lower()
    except (urllib.error.URLError, IndexError, OSError) as e:
        log("could not read the checksum (%s); skipping verification" % e)
        return
    h = hashlib.sha512()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(4 << 20), b""):
            h.update(chunk)
    if h.hexdigest() != want:
        os.unlink(path)
        raise SystemExit("droiddeck-proton-extra: checksum mismatch; the download was deleted")
    log("checksum ok")


def validate_archive(tarball):
    seen = set()
    links = set()
    expanded = 0
    with tarfile.open(tarball, "r:*") as archive:
        members = archive.getmembers()
        if len(members) > MAX_ENTRIES:
            raise SystemExit("droiddeck-proton-extra: archive has too many entries")
        for member in members:
            name = member.name.replace("\\", "/")
            normalized = posixpath.normpath(name)
            if (not name or name.startswith("/") or normalized in (".", "..")
                    or normalized.startswith("../") or normalized in seen):
                raise SystemExit("droiddeck-proton-extra: unsafe or duplicate archive path")
            seen.add(normalized)
            if member.ischr() or member.isblk() or member.isfifo():
                raise SystemExit("droiddeck-proton-extra: unsupported archive entry")
            if member.isfile():
                if member.size < 0 or member.size > MAX_FILE_BYTES:
                    raise SystemExit("droiddeck-proton-extra: archive entry is too large")
                expanded += member.size
                if expanded > MAX_EXPANDED_BYTES:
                    raise SystemExit("droiddeck-proton-extra: archive expands beyond its limit")
            if member.issym() or member.islnk():
                links.add(normalized)
                base = "" if member.islnk() else posixpath.dirname(normalized)
                target = posixpath.normpath(posixpath.join(base, member.linkname))
                if (not member.linkname or member.linkname.startswith("/") or target == ".." or target.startswith("../")):
                    raise SystemExit("droiddeck-proton-extra: unsafe archive link")
        for name in seen:
            parts = name.split("/")
            if any("/".join(parts[:index]) in links for index in range(1, len(parts))):
                raise SystemExit("droiddeck-proton-extra: archive link used as a directory")


def extract(tarball, into):
    validate_archive(tarball)
    os.makedirs(into, exist_ok=True)
    log("unpacking (a few minutes; nothing is shown while tar runs)")
    rc = subprocess.call(["tar", "-xf", tarball, "-C", into])
    if rc != 0:
        raise SystemExit("droiddeck-proton-extra: tar failed (%d)" % rc)
    entries = [e for e in sorted(os.listdir(into)) if not e.startswith(".")]
    for entry in entries:
        path = os.path.join(into, entry)
        if os.path.isdir(path) and os.path.isfile(os.path.join(path, "toolmanifest.vdf")):
            return contained_path(into, path)
    if len(entries) == 1 and os.path.isdir(os.path.join(into, entries[0])):
        return contained_path(into, os.path.join(into, entries[0]))
    raise SystemExit("droiddeck-proton-extra: no Proton tree in the archive")


def contained_path(root, path):
    real_root = os.path.realpath(root)
    real_path = os.path.realpath(path)
    try:
        contained = os.path.commonpath((real_root, real_path)) == real_root
    except ValueError:
        contained = False
    if not contained:
        raise SystemExit("droiddeck-proton-extra: archive link escapes the staging tree")
    return real_path


def regular_path(root, path):
    real_path = contained_path(root, path)
    if os.path.islink(path) or not os.path.isfile(real_path):
        raise SystemExit("droiddeck-proton-extra: tool metadata is not a regular in-tree file")
    return real_path


def compatibility_identity(path):
    try:
        with open(path, "r", encoding="utf-8") as source:
            text = source.read()
    except OSError as error:
        raise SystemExit("droiddeck-proton-extra: could not read compatibilitytool.vdf (%s)" % error)
    pattern = re.compile(r'(\"compat_tools\"\s*\{\s*)\"([^\"]+)\"', re.DOTALL)
    matches = list(pattern.finditer(text))
    if len(matches) != 1:
        raise SystemExit("droiddeck-proton-extra: expected one compatibility tool identity")
    return text, pattern, matches[0].group(2)


def namespace_tool(tree, identity, staging_root=None):
    if staging_root is not None:
        tree = contained_path(staging_root, tree)
    path = regular_path(tree, os.path.join(tree, "compatibilitytool.vdf"))
    text, pattern, old = compatibility_identity(path)
    new = "%s--dd-%s" % (old, identity)
    text = pattern.sub(lambda match: match.group(1) + '"' + new + '"', text, count=1)
    staged = path + ".tmp"
    with open(staged, "w", encoding="utf-8") as output:
        output.write(text)
        output.flush()
        os.fsync(output.fileno())
    os.replace(staged, path)


def validate_adopted_tool(final, identity, required_prefix):
    if os.path.islink(final) or not os.path.isdir(final):
        raise SystemExit("droiddeck-proton-extra: existing source-qualified tool is unsafe or incomplete")
    receipt_path = regular_path(final, os.path.join(final, ".droiddeck-source.json"))
    regular_path(final, os.path.join(final, "toolmanifest.vdf"))
    config_path = regular_path(final, os.path.join(final, "compatibilitytool.vdf"))
    try:
        with open(receipt_path, "r", encoding="utf-8") as source:
            receipt = json.load(source)
    except (OSError, ValueError) as error:
        raise SystemExit("droiddeck-proton-extra: existing source receipt is unreadable (%s)" % error)
    source_id, archive_sha = identity.split("-", 1)
    if (receipt.get("schema") != 1 or receipt.get("sourceId") != source_id
            or receipt.get("sha256") != archive_sha
            or receipt.get("toolPrefix") != required_prefix):
        raise SystemExit("droiddeck-proton-extra: existing source receipt does not match this archive")
    _, _, installed_identity = compatibility_identity(config_path)
    if not installed_identity.endswith("--dd-" + identity):
        raise SystemExit("droiddeck-proton-extra: existing tool identity does not match this archive")


def installed(tools):
    out = []
    for entry in sorted(os.listdir(tools)) if os.path.isdir(tools) else ():
        if entry.startswith("."):
            continue
        if os.path.isfile(os.path.join(tools, entry, "toolmanifest.vdf")):
            out.append(entry)
    return out


def main():
    argv = sys.argv[1:]
    if not argv:
        raise SystemExit(__doc__ or "usage: droiddeck-proton-extra <steam root> ge|cachyos|droiddeck|<url>")
    steam_root = argv.pop(0)
    tools = os.path.join(steam_root, "compatibilitytools.d")
    os.makedirs(tools, exist_ok=True)

    if not argv or argv[0] in ("--list", "-l"):
        for name in installed(tools):
            log("installed: %s" % name)
        return

    what = argv.pop(0)
    tag = None
    if argv and argv[0] in ("--tag", "-t"):
        argv.pop(0)
        tag = argv.pop(0) if argv else None

    identity = None
    required_prefix = None
    while argv:
        option = argv.pop(0)
        if option == "--identity" and argv:
            identity = argv.pop(0)
            if not re.fullmatch(r"[0-9a-f]{64}-[0-9a-f]{64}", identity):
                raise SystemExit("droiddeck-proton-extra: invalid source identity")
        elif option == "--prefix" and argv:
            required_prefix = argv.pop(0)
            if (not required_prefix or len(required_prefix) > 100
                    or not re.fullmatch(r"[A-Za-z0-9._+ -]+", required_prefix)):
                raise SystemExit("droiddeck-proton-extra: invalid tool prefix")
        else:
            raise SystemExit("droiddeck-proton-extra: unknown or incomplete option %r" % option)

    local = None
    if what in SOURCES:
        tag, url, sums = release_asset(what, tag) if tag else pick_asset(what)
        if not url:
            raise SystemExit("droiddeck-proton-extra: no ARM64 build published for %s" % what)
        log("%s -> %s" % (what, tag))
    elif what.startswith("http"):
        url, sums = what, None
    elif os.path.isfile(what):
        local, url, sums = what, None, None
        log("using %s" % what)
    else:
        raise SystemExit(
            "droiddeck-proton-extra: expected ge, cachyos, droiddeck, a URL or a tarball path, got %r" % what)

    free = shutil.disk_usage(tools).free
    if free < NEED_BYTES:
        raise SystemExit("droiddeck-proton-extra: needs about %d GB free, has %.1f GB" % (
            NEED_BYTES // (1024 ** 3), free / float(1024 ** 3)))

    shutil.rmtree(os.path.join(tools, ".bannerlator-download"), ignore_errors=True)
    staging = os.path.join(tools, ".droiddeck-download")
    os.makedirs(staging, exist_ok=True)
    if local:
        tarball = local
    else:
        tarball = os.path.join(staging, os.path.basename(url.split("?")[0]))
        download(url, tarball)
        verify(tarball, sums)

    unpacked = os.path.join(staging, "unpacked")
    shutil.rmtree(unpacked, ignore_errors=True)
    tree = extract(tarball, unpacked)
    name = os.path.basename(tree)
    if required_prefix and not name.startswith(required_prefix):
        raise SystemExit("droiddeck-proton-extra: archive tool identity does not match its manifest")
    if identity:
        namespace_tool(tree, identity, unpacked)
        suffix = "--dd-%s" % identity
        safe_name = re.sub(r"[^A-Za-z0-9._+ -]+", "_", name).strip(" .") or "Proton"
        name = "%s%s" % (safe_name[:255 - len(suffix)], suffix)
    final = os.path.join(tools, name)
    adopted = False
    if os.path.lexists(final):
        if identity:
            validate_adopted_tool(final, identity, required_prefix)
            shutil.rmtree(tree)
            adopted = True
        else:
            shutil.rmtree(final, ignore_errors=True)
    if not adopted:
        os.rename(tree, final)
    if local:
        shutil.rmtree(os.path.join(staging, "unpacked"), ignore_errors=True)
    else:
        shutil.rmtree(staging, ignore_errors=True)
    log(("%s %s" % ("adopted" if adopted else "installed", name)))

    subprocess.call(["steam-compatibility", steam_root])


if __name__ == "__main__":
    main()
