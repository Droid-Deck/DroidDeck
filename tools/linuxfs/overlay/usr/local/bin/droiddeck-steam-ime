#!/bin/bash
[ -n "${IBUS_ADDRESS:-}" ] || exit 0
unset LD_PRELOAD LD_LIBRARY_PATH GSETTINGS_SCHEMA_DIR
export LD_LIBRARY_PATH=/usr/local/lib/droiddeck-ime
export DCONF_PROFILE=/usr/local/share/droiddeck/ibus.profile
exec /usr/bin/ibus-daemon --address "$IBUS_ADDRESS" --panel disable --config default \
  --emoji-extension disable --cache none
