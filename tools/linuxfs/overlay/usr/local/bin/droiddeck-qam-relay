#!/usr/bin/python3
# Relays the app to Steam's DevTools port, which only answers clients inside the guest, while the bottom screen
# shows Steam's quick access menu. Only requests carrying the secret printed at start reach DevTools, and only for
# the target list and page sockets, so other local apps cannot use the relay to reach Steam.
#   droiddeck-qam-relay start <devtools port>   prints the relay port and its secret
#   droiddeck-qam-relay stop [<relay port>]       stops the relay, or only the one on that port

import hmac
import os
import re
import secrets
import socket
import sys
import threading
import time

FLAG = "/tmp/.dd-qam-relay"
INTERVAL = 0.5
MAX_SECONDS = 6 * 3600
IDLE_SECONDS = 30
ALLOWED = re.compile(r"^/(json|json/list|devtools/page/[A-Za-z0-9-]+)$")


class Activity:
    def __init__(self):
        self.lock = threading.Lock()
        self.open = 0
        self.last = time.monotonic()

    def change(self, delta):
        with self.lock:
            self.open += delta
            self.last = time.monotonic()

    def idle(self):
        with self.lock:
            return self.open == 0 and time.monotonic() - self.last > IDLE_SECONDS


def owner():
    try:
        with open(FLAG) as f:
            return f.read().split()
    except OSError:
        return []


def pipe(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except OSError:
        pass
    for s in (src, dst):
        try:
            s.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass


def rewrite(head, token):
    """Returns the request with the secret removed from its path, or None when it is not an allowed request."""
    line, sep, rest = head.partition(b"\r\n")
    parts = line.split(b" ")
    if not sep or len(parts) != 3 or parts[0] != b"GET" or not parts[2].startswith(b"HTTP/1."):
        return None
    prefix = b"/" + token.encode()
    path = parts[1]
    if not hmac.compare_digest(path[:len(prefix)], prefix) or not ALLOWED.match(path[len(prefix):].decode("ascii", "replace")):
        return None
    return b"GET " + path[len(prefix):] + b" " + parts[2] + sep + rest


def handle(client, devtools_port, token, activity):
    activity.change(1)
    try:
        client.settimeout(3)
        head = b""
        while b"\r\n" not in head and len(head) < 4096:
            data = client.recv(4096)
            if not data:
                break
            head += data
        request = rewrite(head, token)
        if request is None:
            client.sendall(b"HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            return
        client.settimeout(None)
        upstream = socket.create_connection(("127.0.0.1", devtools_port), 3)
        upstream.sendall(request)
        back = threading.Thread(target=pipe, args=(upstream, client), daemon=True)
        back.start()
        pipe(client, upstream)
        back.join()
    except OSError:
        pass
    finally:
        client.close()
        activity.change(-1)


def relay(server, devtools_port, token, activity):
    while True:
        try:
            client, _ = server.accept()
        except OSError:
            return
        threading.Thread(target=handle, args=(client, devtools_port, token, activity), daemon=True).start()


def serve(server, devtools_port, me, token):
    activity = Activity()
    threading.Thread(target=relay, args=(server, devtools_port, token, activity), daemon=True).start()
    started = time.monotonic()
    while owner()[:1] == [me] and time.monotonic() - started < MAX_SECONDS and not activity.idle():
        time.sleep(INTERVAL)
    server.close()


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "stop" and len(sys.argv) in (2, 3):
        if len(sys.argv) == 3 and owner()[1:] != [sys.argv[2]]:
            return 0
        try:
            os.unlink(FLAG)
        except FileNotFoundError:
            pass
        return 0
    if command != "start" or len(sys.argv) != 3:
        print("usage: droiddeck-qam-relay start <devtools port> | stop [<relay port>]", file=sys.stderr)
        return 2
    devtools_port = int(sys.argv[2])
    server = socket.socket()
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 0))
    server.listen(4)
    token = secrets.token_hex(16)
    print(server.getsockname()[1], token, flush=True)
    if os.fork():
        return 0
    os.setsid()
    me = str(os.getpid())
    with open(FLAG, "w") as f:
        f.write("%s %d" % (me, server.getsockname()[1]))
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    serve(server, devtools_port, me, token)
    return 0


if __name__ == "__main__":
    sys.exit(main())
