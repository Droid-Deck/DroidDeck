L = 1-45,10-193
R = 1-51,10-192
An.Up = 1-37,10-4003
An.Down = 1-39,10-4002
An.Left = 1-38,10-4001
An.Right = 1-40,10-4000
RightAn.Up = 10-4007
RightAn.Down = 10-4006
RightAn.Left = 10-4005
RightAn.Right = 10-4004
Pause = 1-111,10-4
"""


def ppsspp():
    seed(os.path.join(CONFIG, "ppsspp/PSP/SYSTEM/controls.ini"), PPSSPP_CONTROLS, "PPSSPP")


# RetroArch: the udev joypad driver finds nothing here (no udev database in the runtime); sdl2
# does, and matches this profile by vendor/product (task_autodetect.c).
RETROARCH_PROFILE = """input_driver = "sdl2"
input_device = "Xbox 360 Controller"
input_vendor_id = "1118"
input_product_id = "654"
input_b_btn = "0"
input_a_btn = "1"
input_y_btn = "2"
input_x_btn = "3"
input_select_btn = "4"
input_menu_toggle_btn = "5"
input_start_btn = "6"
input_l3_btn = "7"
input_r3_btn = "8"
input_l_btn = "9"
input_r_btn = "10"
input_up_btn = "11"
input_down_btn = "12"
input_left_btn = "13"
input_right_btn = "14"
input_l2_axis = "+4"
input_r2_axis = "+5"
input_l_x_plus_axis = "+0"
input_l_x_minus_axis = "-0"
input_l_y_plus_axis = "+1"
input_l_y_minus_axis = "-1"
input_r_x_plus_axis = "+2"
input_r_x_minus_axis = "-2"
input_r_y_plus_axis = "+3"
input_r_y_minus_axis = "-3"
"""


def retroarch():
    d = os.path.join(CONFIG, "retroarch")
    seed(os.path.join(d, "autoconfig/sdl2/Xbox 360 Controller.cfg"), RETROARCH_PROFILE, "RetroArch (profile)")
    cfg = os.path.join(d, "retroarch.cfg")
    if not os.path.isfile(cfg):
        seed(cfg, 'input_joypad_driver = "sdl2"\ninput_autodetect_enable = "true"\n', "RetroArch")
        return
    with open(cfg, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()
    changed = False
    for i, l in enumerate(lines):
        if l.replace(" ", "").startswith('input_joypad_driver="udev"'):
            lines[i] = 'input_joypad_driver = "sdl2"'
            changed = True
    if changed:
        with open(cfg + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(cfg + ".tmp", cfg)
        print(f"bannerlator-pad-defaults: RetroArch: joypad driver udev -> sdl2 ({cfg})")


# yuzu and its forks: Player 1 in [Controls] of <name>/qt-config.ini, which each writes at its first
# start with the keyboard bound. Bindings are input_common ParamPackages, laid out by position as the
# frontend's own auto-map does (sdl_driver.cpp GetDefaultButtonBinding); the guid is SDL's with the
# name CRC cleared (GetGUID). A key is only read while its \default is false. Done once per emulator,
# and only while Player 1 is still on the keyboard.
SWITCH_PAD = "engine:sdl,port:0,guid:030000005e0400008e02000010010000,"
SWITCH_PLAYER1 = {
    "button_a": "button:1", "button_b": "button:0", "button_x": "button:3", "button_y": "button:2",
    "button_lstick": "button:9", "button_rstick": "button:10", "button_l": "button:4", "button_r": "button:5",
    "button_zl": "axis:2,threshold:0.5,invert:+", "button_zr": "axis:5,threshold:0.5,invert:+",
    "button_plus": "button:7", "button_minus": "button:6", "button_home": "button:8",
    "button_dleft": "hat:0,direction:left", "button_dup": "hat:0,direction:up",
    "button_dright": "hat:0,direction:right", "button_ddown": "hat:0,direction:down",
    "lstick": "axis_x:0,axis_y:1,offset_x:0,offset_y:0,invert_x:+,invert_y:+",
    "rstick": "axis_x:3,axis_y:4,offset_x:0,offset_y:0,invert_x:+,invert_y:+",
}


def switch_emulators():
    for name in sorted(os.listdir(CONFIG)) if os.path.isdir(CONFIG) else ():
        cfg = os.path.join(CONFIG, name, "qt-config.ini")
        marker = os.path.join(CONFIG, name, ".droiddeck-pad")
        if os.path.exists(marker) or not os.path.isfile(cfg):
            continue
        with open(cfg, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
        span = ini_section(lines, "Controls")
        if not span:
            continue
        current = {l.split("=", 1)[0]: l.split("=", 1)[1] for l in lines[span[0]:span[1]] if "=" in l}
        if "engine:keyboard" not in current.get("player_0_button_a", ""):
            continue
        wanted = {"player_0_connected": "true", "player_0_type": "0"}
        for key, binding in SWITCH_PLAYER1.items():
            wanted[f"player_0_{key}"] = f'"{SWITCH_PAD}{binding}"'
        body = [l for l in lines[span[0]:span[1]]
                if l.split("=", 1)[0].removesuffix("\\default") not in wanted]
        while body and not body[-1].strip():
            body.pop()
        for key, value in wanted.items():
            body += [f"{key}\\default=false", f"{key}={value}"]
        lines[span[0]:span[1]] = body + [""]
        with open(cfg + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(cfg + ".tmp", cfg)
        open(marker, "w").close()
        print(f"bannerlator-pad-defaults: {name}: Player 1 on the controller ({cfg})")


for step in (rpcs3, duckstation, pcsx2, armsx2, dolphin, cemu, melonds, ppsspp, retroarch, switch_emulators):
    try:
        step()
    except Exception as e:
        print(f"bannerlator-pad-defaults: {step.__name__}: {e}")
