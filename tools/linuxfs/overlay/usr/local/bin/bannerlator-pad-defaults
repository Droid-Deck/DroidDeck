#!/usr/bin/python3
# Player 1 on the session's controller, for every emulator that would otherwise start on the
# keyboard. The session's pad is an Xbox 360 controller (libfakeinput's identity outside Steam) that
# SDL maps by itself; what an emulator lacks is a profile that points Player 1 at it. One is
# written only where the emulator has none yet - a profile the user made is never touched.
# Run at every desktop start and before every program from the rail.
import os

HOME = os.environ.get("HOME", "/root")
CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))


def seed(path, text, what, done="Player 1 on the controller"):
    if os.path.exists(path):
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".tmp", path)
    print(f"bannerlator-pad-defaults: {what}: {done} ({path})")
    return True


# RPCS3: its global input configuration (rpcs3::utils::get_input_config_dir() + "Default.yml").
# Without one it adds the keyboard pad handler (pad_config.cpp, cfg_input::load). SDL handler
# names from rpcs3/Input/sdl_pad_handler.cpp (button_list, init_config); the device is
# "<SDL gamepad name> <n>" (sdl_pad_handler::enumerate_devices).
RPCS3_PLAYER1 = """Player 1 Input:
  Handler: SDL
  Device: Xbox 360 Controller 1
  Config:
    Left Stick Left: LS X-
    Left Stick Down: LS Y-
    Left Stick Right: LS X+
    Left Stick Up: LS Y+
    Right Stick Left: RS X-
    Right Stick Down: RS Y-
    Right Stick Right: RS X+
    Right Stick Up: RS Y+
    Start: Start
    Select: Back
    PS Button: Guide
    Square: West
    Cross: South
    Circle: East
    Triangle: North
    Left: Left
    Down: Down
    Right: Right
    Up: Up
    R1: RB
    R2: RT
    R3: RS
    L1: LB
    L2: LT
    L3: LS
    Left Stick Deadzone: 8000
    Right Stick Deadzone: 8000
    Left Stick Anti-Deadzone: 4259
    Right Stick Anti-Deadzone: 4259
    Left Trigger Threshold: 0
    Right Trigger Threshold: 0
    Color Value B: 20
    LED battery indicator brightness: 10
  Buddy Device: ""
"""


def rpcs3():
    seed(os.path.join(CONFIG, "rpcs3/input_configs/global/Default.yml"), RPCS3_PLAYER1, "RPCS3")
    rpcs3_shader_mode()


# RPCS3's default shader mode (Async Recompiler with Shader Interpreter) builds 6650 interpreter
# pipelines at the start of every boot, minutes on an Adreno. The async recompiler compiles only
# what a game draws, in the background, once. A new install starts with it (a config.yml that
# holds only this is merged over RPCS3's defaults); an existing one still on the default is moved
# once, and a marker keeps any later choice the user makes in RPCS3's own settings.
RPCS3_INTERPRETER = "Async Recompiler with Shader Interpreter"
RPCS3_RECOMPILER = "Async Recompiler (multi-threaded)"  # the GUI says "Async Shader Recompiler"; this is the value (system_config_types.cpp)


def rpcs3_shader_mode():
    d = os.path.join(CONFIG, "rpcs3")
    marker = os.path.join(d, ".droiddeck-shader-mode")
    if os.path.exists(marker):
        return
    cfg = os.path.join(d, "config.yml")
    if not os.path.isfile(cfg):
        if seed(cfg, f"Video:\n  Shader Mode: {RPCS3_RECOMPILER}\n", "RPCS3", f"shader mode {RPCS3_RECOMPILER}"):
            open(marker, "w").close()
        return
    with open(cfg, encoding="utf-8", errors="replace") as f:
        text = f.read()
    if f"Shader Mode: {RPCS3_INTERPRETER}" in text:
        text = text.replace(f"Shader Mode: {RPCS3_INTERPRETER}", f"Shader Mode: {RPCS3_RECOMPILER}", 1)
        with open(cfg + ".tmp", "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(cfg + ".tmp", cfg)
        print(f"bannerlator-pad-defaults: RPCS3: shader mode {RPCS3_RECOMPILER} ({cfg})")
    open(marker, "w").close()


# ---- ini helpers (DuckStation and PCSX2 share one ini dialect, keys may repeat) -------------

def ini_section(lines, name):
    """(start, end) line indices of [name]'s body, or None."""
    start = None
    for i, l in enumerate(lines):
        t = l.strip()
        if t.startswith("[") and t.endswith("]"):
            if start is not None:
                return start, i
            if t[1:-1].strip() == name:
                start = i + 1
    return (start, len(lines)) if start is not None else None


def patch_ini_section(path, section, body, what, needle="SDL-", require=None, done="Player 1 on the controller"):
    """Add body's lines to [section] of an ini the emulator wrote itself, unless the section
    already binds a controller (needle). Missing file: nothing - the emulator writes its own
    defaults on first run and this runs again."""
    if not os.path.isfile(path):
        return
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    if require and require not in text:
        return
    lines = text.splitlines()
    span = ini_section(lines, section)
    if span and any(needle in l for l in lines[span[0]:span[1]]):
        return
    new = body.strip("\n").splitlines()
    if span:
        # The controller type the emulator already wrote stays; only bindings are added.
        have = {l.split("=", 1)[0].strip() for l in lines[span[0]:span[1]] if "=" in l}
        new = [l for l in new if not (l.split("=", 1)[0].strip() == "Type" and "Type" in have)]
        end = span[1]
        while end > span[0] and not lines[end - 1].strip():
            end -= 1
        lines[end:end] = new
    else:
        lines += ["", f"[{section}]"] + new
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(path + ".tmp", path)
    print(f"bannerlator-pad-defaults: {what}: {done} ({path})")


# DuckStation: SDL-<n>/<name>, axes signed (src/util/sdl_input_source.cpp); Pad1 keys from
# src/core/analog_controller.cpp. Its defaults bind the keyboard only (settings.cpp).
DUCKSTATION_PAD1 = """Type = AnalogController
Up = SDL-0/DPadUp
Down = SDL-0/DPadDown
Left = SDL-0/DPadLeft
Right = SDL-0/DPadRight
Cross = SDL-0/A
Circle = SDL-0/B
Square = SDL-0/X
Triangle = SDL-0/Y
Select = SDL-0/Back
Start = SDL-0/Start
Analog = SDL-0/Guide
L1 = SDL-0/LeftShoulder
R1 = SDL-0/RightShoulder
L2 = SDL-0/+LeftTrigger
R2 = SDL-0/+RightTrigger
L3 = SDL-0/LeftStick
R3 = SDL-0/RightStick
LLeft = SDL-0/-LeftX
LRight = SDL-0/+LeftX
LUp = SDL-0/-LeftY
LDown = SDL-0/+LeftY
RLeft = SDL-0/-RightX
RRight = SDL-0/+RightX
RUp = SDL-0/-RightY
RDown = SDL-0/+RightY
LargeMotor = SDL-0/LargeMotor
SmallMotor = SDL-0/SmallMotor
"""


def ini_get(path, section, key):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    span = ini_section(lines, section)
    if not span:
        return None
    for l in lines[span[0]:span[1]]:
        if "=" in l and l.split("=", 1)[0].strip() == key:
            return l.split("=", 1)[1].strip()
    return None


def ini_set(path, section, key, value):
    """Sets one key (the first of that name) in [section], adding either as needed."""
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()
    span = ini_section(lines, section)
    if span is None:
        lines += ["", f"[{section}]", f"{key} = {value}"]
    else:
        for i in range(span[0], span[1]):
            if "=" in lines[i] and lines[i].split("=", 1)[0].strip() == key:
                lines[i] = f"{key} = {value}"
                break
        else:
            end = span[1]
            while end > span[0] and not lines[end - 1].strip():
                end -= 1
            lines.insert(end, f"{key} = {value}")
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(path + ".tmp", path)


def drop_line(path, line):
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()
    kept = [l for l in lines if l.replace(" ", "") != line.replace(" ", "")]
    if len(kept) != len(lines):
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(kept) + "\n")
        os.replace(path + ".tmp", path)


def system_folder(names, default):
    for name in names:
        for cand in (name, name.upper()):
            d = os.path.join(ROMS, cand)
            if os.path.isdir(d):
                return d
    return os.path.join(ROMS, default)


def bios_folder(base):
    for name in ("bios", "BIOS", "firmware"):
        d = os.path.join(base, name)
        if os.path.isdir(d):
            return d
    d = os.path.join(base, "bios")
    if os.path.isdir(ROMS):
        try:
            os.makedirs(d, exist_ok=True)  # where the user is told to put their BIOS
        except OSError:
            pass
    return d


# DuckStation (PS1) - set up like ARMSX2: users bring their own BIOS and games, in the ROMs folder.
# Front-end runs use -batch -bigpicture -fullscreen, so the guide button is the pause menu
# (Hotkeys OpenPauseMenu, src/core/hotkeys.cpp), not the analog toggle. Keys from
# src/core/settings.cpp: [BIOS] SearchDirectory, [GPU] Renderer ("Vulkan"), [Main]
# SetupWizardIncomplete (src/duckstation-qt/qthost.cpp).
DUCKSTATION_PAD1_GUIDE_FREE = "\n".join(l for l in DUCKSTATION_PAD1.splitlines() if not l.startswith("Analog ")) + "\n"


def duckstation():
    ps1 = system_folder(("psx", "ps1"), "psx")
    d = os.path.join(CONFIG, "duckstation")
    ini = os.path.join(d, "settings.ini")
    legacy = os.path.join(HOME, ".local/share/duckstation/settings.ini")
    if not os.path.isfile(ini) and os.path.isfile(legacy):
        ini = legacy
    if not os.path.isfile(ini):
        # A new player: everything DuckStation's first-time setup asks is answered here (it finds
        # the BIOS in its folder by itself), so a game from the front end boots straight away.
        bios = bios_folder(ps1)
        seed(ini, "[Main]\nSetupWizardIncomplete = false\nInhibitScreensaver = false\n\n"
                  f"[BIOS]\nSearchDirectory = {bios}\n\n"
                  f"[GameList]\nRecursivePaths = {ps1}\n\n"
                  "[GPU]\nRenderer = Vulkan\n\n"
                  "[Hotkeys]\nOpenPauseMenu = Keyboard/Escape\nOpenPauseMenu = SDL-0/Guide\n\n"
                  "[Pad1]\n" + DUCKSTATION_PAD1_GUIDE_FREE, "DuckStation", "first-time setup, BIOS from " + bios)
        return
    patch_ini_section(ini, "Pad1", DUCKSTATION_PAD1_GUIDE_FREE, "DuckStation")
    drop_line(ini, "Analog = SDL-0/Guide")
    patch_ini_section(ini, "Hotkeys", "OpenPauseMenu = SDL-0/Guide\n", "DuckStation", needle="SDL-0/Guide",
                      done="the guide button opens the pause menu")
    patch_ini_section(ini, "GameList", f"RecursivePaths = {ps1}\n", "DuckStation", needle=ROMS,
                      done="games listed from the ROMs folder")
    # One set up by an earlier build still has its first-time setup pending, in the way of a game.
    if ini_get(ini, "Main", "SetupWizardIncomplete") == "true":
        ini_set(ini, "Main", "SetupWizardIncomplete", "false")
        print("bannerlator-pad-defaults: DuckStation: first-time setup already done here")
    # Keeping the screen awake goes through org.freedesktop.ScreenSaver, which nothing in the session
    # provides (Android decides when the screen sleeps): DuckStation only warns it failed, every game.
    if (ini_get(ini, "Main", "InhibitScreensaver") or "true") == "true":
        ini_set(ini, "Main", "InhibitScreensaver", "false")
        print("bannerlator-pad-defaults: DuckStation: no screensaver inhibit (no such service here)")
    # Once, for a DuckStation set up before this: its own empty BIOS folder moves to the ROMs folder,
    # and Automatic becomes Vulkan. A later choice in DuckStation's settings is kept.
    marker = os.path.join(os.path.dirname(ini), ".droiddeck-setup")
    if os.path.exists(marker):
        return
    current = ini_get(ini, "BIOS", "SearchDirectory") or "bios"
    own = current if os.path.isabs(current) else os.path.join(os.path.dirname(ini), current)
    if not (os.path.isdir(own) and os.listdir(own)):
        ini_set(ini, "BIOS", "SearchDirectory", bios_folder(ps1))
        print(f"bannerlator-pad-defaults: DuckStation: BIOS from {bios_folder(ps1)}")
    if (ini_get(ini, "GPU", "Renderer") or "Automatic") == "Automatic":
        ini_set(ini, "GPU", "Renderer", "Vulkan")
        print("bannerlator-pad-defaults: DuckStation: renderer Vulkan")
    open(marker, "w").close()


# PCSX2: FaceSouth/... names (pcsx2/Input/SDLInputSource.cpp), keys from SIO/Pad/PadDualshock2.cpp.
# An ini without [UI] SettingsVersion is thrown away and rebuilt, so only a complete one is patched.
