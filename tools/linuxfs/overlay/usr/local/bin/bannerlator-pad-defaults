# ARMSX2 - the PS2 emulator (PCSX2 with ARM64 recompilers; upstream PCSX2 interprets on ARM64). Its
# files are PCSX2's under $XDG_CONFIG_HOME/ARMSX2 (pcsx2/Pcsx2Config.cpp). The user supplies the BIOS
# and the games; they live in the ROMs folder (/root/ROMs). The guide button opens the pause menu
# (Hotkeys OpenPauseMenu) - the way out of a game started from the front end, which runs ARMSX2
# without its window (-batch -bigpicture) - so it is not also the analog toggle here.
ARMSX2_PAD1 = "\n".join(l for l in PCSX2_PAD1.splitlines() if not l.startswith("Analog ")) + "\n"
ROMS = "/root/ROMs"


def ps2_folder():
    for name in ("ps2", "PS2"):
        d = os.path.join(ROMS, name)
        if os.path.isdir(d):
            return d
    return os.path.join(ROMS, "ps2")


def ps2_bios_folder():
    base = ps2_folder()
    for name in ("bios", "BIOS", "firmware"):
        d = os.path.join(base, name)
        if os.path.isdir(d):
            return d
    d = os.path.join(base, "bios")
    if os.path.isdir(ROMS):
        try:
            os.makedirs(d, exist_ok=True)  # where the user is told to put their BIOS
        except OSError:
            pass
    return d


def armsx2():
    root = os.path.join(CONFIG, "ARMSX2")
    ini = os.path.join(root, "inis/PCSX2.ini")
    old = os.path.join(CONFIG, "PCSX2")
    if not os.path.isfile(ini) and os.path.isfile(os.path.join(old, "inis/PCSX2.ini")):
        # Someone who played on PCSX2 here: the same settings, BIOS choice and memory cards (the
        # saves), copied once. PCSX2's own folder is left as it was.
        import shutil
        for sub in ("inis", "memcards", "bios", "gamesettings", "cheats", "patches", "covers",
                    "inputprofiles", "textures"):
            src = os.path.join(old, sub)
            if os.path.isdir(src):
                shutil.copytree(src, os.path.join(root, sub), dirs_exist_ok=True)
        print(f"bannerlator-pad-defaults: ARMSX2: settings and memory cards copied from PCSX2 ({root})")
    elif not os.path.isfile(ini):
        # A new player: everything ARMSX2's first-time setup asks is answered here - the BIOS
        # folder in the ROMs folder, the ps2 folder as its game list, the controller on Player 1 -
        # and the BIOS file itself is picked below once one is there.
        bios, games = ps2_bios_folder(), ps2_folder()
        seed(ini, "[UI]\nSettingsVersion = 1\nSetupWizardIncomplete = false\n\n"
                  f"[Folders]\nBios = {bios}\n\n"
                  f"[GameList]\nRecursivePaths = {games}\n\n"
                  # Vulkan outright rather than Auto's pick: the renderer every other path here uses.
                  "[EmuCore/GS]\nRenderer = 14\n\n"
                  "[Hotkeys]\nOpenPauseMenu = Keyboard/Escape\nOpenPauseMenu = SDL-0/Guide\n\n"
                  "[Pad1]\n" + ARMSX2_PAD1, "ARMSX2", "first-time setup, BIOS from " + bios)
        armsx2_bios(ini)
        return
    patch_ini_section(ini, "Pad1", ARMSX2_PAD1, "ARMSX2", require="SettingsVersion")
    # The guide button is the pause menu here; PCSX2's profile (ours, copied over) had it as the
    # analog toggle as well.
    with open(ini, encoding="utf-8", errors="replace") as f:
        lines = f.read().splitlines()
    kept = [l for l in lines if l.replace(" ", "") != "Analog=SDL-0/Guide"]
    if len(kept) != len(lines):
        with open(ini + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(kept) + "\n")
        os.replace(ini + ".tmp", ini)
    patch_ini_section(ini, "Hotkeys", "OpenPauseMenu = SDL-0/Guide\n", "ARMSX2", needle="SDL-0/Guide",
                      require="SettingsVersion", done="the guide button opens the pause menu")
    patch_ini_section(ini, "GameList", f"RecursivePaths = {ps2_folder()}\n", "ARMSX2", needle=ROMS,
                      require="SettingsVersion", done="games listed from the ROMs folder")
    if ini_get(ini, "UI", "SetupWizardIncomplete") == "true":
        ini_set(ini, "UI", "SetupWizardIncomplete", "false")
        print("bannerlator-pad-defaults: ARMSX2: first-time setup already done here")
    armsx2_bios(ini)


def armsx2_bios(ini):
    """PCSX2 boots the one BIOS file named in [Filenames] BIOS (inside [Folders] Bios); its first-time
    setup is what names it. With that skipped, the first dump in the folder is named here - a US one
    first - while none is named or the named one is gone. A choice made in ARMSX2 is kept."""
    folder = ini_get(ini, "Folders", "Bios") or ps2_bios_folder()
    if not os.path.isabs(folder):
        folder = os.path.join(os.path.dirname(os.path.dirname(ini)), folder)
    current = ini_get(ini, "Filenames", "BIOS")
    if current and os.path.isfile(os.path.join(folder, current)):
        return
    try:
        # A PS2 BIOS dump is 4 MiB (a few are 8); the .nvm/.mec files beside it are not dumps.
        dumps = sorted(f for f in os.listdir(folder)
                       if os.path.isfile(os.path.join(folder, f)) and 4 << 20 <= os.path.getsize(os.path.join(folder, f)) <= 8 << 20)
    except OSError:
        return
    if not dumps:
        return
    us = [f for f in dumps if any(t in f.lower() for t in ("usa", "(us)", "(us,", "ntsc-u"))]
    pick = (us or dumps)[0]
    ini_set(ini, "Filenames", "BIOS", pick)
    print(f"bannerlator-pad-defaults: ARMSX2: BIOS {pick}")


# Dolphin (PC) has no controller menu, so the guide button is its Toggle Fullscreen hotkey: out of full
# screen is Dolphin's own window with its Config / Graphics / Stop buttons. Hotkeys.ini is all-or-
# nothing - a file with one line drops every other default - so a new one carries Dolphin's defaults,
# generated from HotkeyManager.cpp's LoadDefaults (Linux branch, RetroAchievements on) plus the guide;
# an existing one only gets the guide added to its Toggle Fullscreen. The Wii remote's Home, which
# was on the guide button, is on the right shoulder button instead.
DOLPHIN_GUIDE = "`SDL/0/Xbox 360 Controller:Guide`"
DOLPHIN_HOTKEYS = """[Hotkeys]
Device = XInput2/0/Virtual core pointer
General/Open = @(Ctrl+O)
