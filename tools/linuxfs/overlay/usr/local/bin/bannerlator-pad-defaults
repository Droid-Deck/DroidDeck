Save State/Save State Slot 6 = @(Shift+F6)
Save State/Save State Slot 7 = @(Shift+F7)
Save State/Save State Slot 8 = @(Shift+F8)
Other State Hotkeys/Undo Load State = F12
Other State Hotkeys/Undo Save State = @(Shift+F12)
GBA Core/Load ROM = @(`Ctrl`+`Shift`+`O`)
GBA Core/Unload ROM = @(`Ctrl`+`Shift`+`W`)
GBA Core/Reset = @(`Ctrl`+`Shift`+`R`)
GBA Volume/Volume Down = `KP_Subtract`
GBA Volume/Volume Up = `KP_Add`
GBA Volume/Volume Toggle Mute = `M`
GBA Window Size/1x = `KP_1`
GBA Window Size/2x = `KP_2`
GBA Window Size/3x = `KP_3`
GBA Window Size/4x = `KP_4`
USB Emulation Devices/Show Skylanders Portal = @(Ctrl+P)
USB Emulation Devices/Show Infinity Base = @(Ctrl+I)
"""

DOLPHIN_APPIMAGE = "/opt/appimages/dolphin.AppImage"
DOLPHIN_DATA = "/usr/share/dolphin-emu"


def dolphin_data():
    """The Dolphin build in the catalog finds its own data - the GameCube fonts, the per-game fixes
    (GameSettings: GUT.ini puts Ultimate Spider-Man on the MMU), its icons and shaders - only at the
    fixed /usr/share/dolphin-emu it was built for; there is no setting or variable to move it. Here it
    runs from a copy unpacked under /tmp (no FUSE), so it found none of it: a GameCube game stopped
    on "Windows-1252 fonts are not loaded", another on an invalid write the missing game fix would
    have prevented. So the folder is unpacked from the AppImage to that path, once per AppImage."""
    import shutil, subprocess, tempfile
    try:
        st = os.stat(DOLPHIN_APPIMAGE)
    except OSError:
        return
    stamp = "%d:%d" % (st.st_size, int(st.st_mtime))
    marker = os.path.join(DOLPHIN_DATA, ".droiddeck-from")
    try:
        if open(marker).read() == stamp and os.path.isfile(os.path.join(DOLPHIN_DATA, "Sys/GC/font_western.bin")):
            return
    except OSError:
        pass
    work = tempfile.mkdtemp(prefix="dolphin-data-", dir="/tmp")
    try:
        subprocess.run([DOLPHIN_APPIMAGE, "--appimage-extract", "usr/share/dolphin-emu/*"], cwd=work,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
        src = os.path.join(work, "squashfs-root/usr/share/dolphin-emu")
        if not os.path.isfile(os.path.join(src, "Sys/GC/font_western.bin")):
            print("bannerlator-pad-defaults: Dolphin: could not unpack its data from the AppImage")
            return
        new = DOLPHIN_DATA + ".new"
        shutil.rmtree(new, ignore_errors=True)
        shutil.move(src, new)
        with open(os.path.join(new, ".droiddeck-from"), "w") as f:
            f.write(stamp)
        shutil.rmtree(DOLPHIN_DATA, ignore_errors=True)
        os.rename(new, DOLPHIN_DATA)
        print("bannerlator-pad-defaults: Dolphin: its data (fonts, per-game fixes) in " + DOLPHIN_DATA)
    except (OSError, subprocess.SubprocessError) as e:
        print("bannerlator-pad-defaults: Dolphin: unpacking its data failed: %s" % e)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def dolphin():
    if not os.path.isfile(DOLPHIN_APPIMAGE):
        return
    dolphin_data()
    d = os.path.join(CONFIG, "dolphin-emu")
    seed(os.path.join(d, "GCPadNew.ini"), DOLPHIN_GC, "Dolphin (GameCube)")
    seed(os.path.join(d, "WiimoteNew.ini"), DOLPHIN_WII, "Dolphin (Wii)")
    wii_pad = os.path.join(d, "WiimoteNew.ini")
    if ini_get(wii_pad, "Wiimote1", "Buttons/Home") == "`Guide`":
        ini_set(wii_pad, "Wiimote1", "Buttons/Home", "`Shoulder R`")
        print("bannerlator-pad-defaults: Dolphin (Wii): Home on the right shoulder button (guide = Dolphin's window)")
    hotkeys = os.path.join(d, "Hotkeys.ini")
    if not os.path.isfile(hotkeys):
        seed(hotkeys, DOLPHIN_HOTKEYS, "Dolphin", "the guide button shows Dolphin's window (Toggle Fullscreen)")
    else:
        current = ini_get(hotkeys, "Hotkeys", "General/Toggle Fullscreen")
        if current is not None and DOLPHIN_GUIDE not in current:
            ini_set(hotkeys, "Hotkeys", "General/Toggle Fullscreen",
                    (current + " | " if current else "") + DOLPHIN_GUIDE)
            print("bannerlator-pad-defaults: Dolphin: the guide button shows Dolphin's window (Toggle Fullscreen)")
    # Games from the ROMs folder's gamecube and wii folders, subfolders included; Vulkan; no
    # NKit warning (it will not let a game start until a box is ticked - games run either way,
    # the warning is about loading times, netplay and save states); no statistics question.
    # Names from Dolphin's MainSettings.cpp / UISettings.cpp. Only what is not set yet is added,
    # except the game folders, which are added to whatever the user has.
    ini = os.path.join(d, "Dolphin.ini")
    gc = system_folder(("gamecube", "gc", "ngc"), "gamecube")
    wii = system_folder(("wii",), "wii")
    if not os.path.isfile(ini):
        os.makedirs(d, exist_ok=True)
        with open(ini, "w", encoding="utf-8") as f:
            f.write("[Analytics]\nEnabled = False\nPermissionAsked = True\n"
                    "[Core]\nGFXBackend = Vulkan\n"
                    "[General]\nISOPaths = 2\nISOPath0 = %s\nISOPath1 = %s\nRecursiveISOPaths = True\n"
                    "[Interface]\nSkipNKitWarning = True\n" % (gc, wii))
        print("bannerlator-pad-defaults: Dolphin: first-time setup (Vulkan, games from %s and %s)" % (gc, wii))
        return
    try:
        count = int(ini_get(ini, "General", "ISOPaths") or "0")
    except ValueError:
        count = 0
    paths = [ini_get(ini, "General", "ISOPath%d" % i) for i in range(count)]
    changed = []
    # The whole ROMs folder as a game folder (what Dolphin's "set a games directory" was pointed at
    # before) would, searched with its subfolders, have Dolphin open every PS2 and PS3 image too;
    # the system folders below cover it.
    if any((p or "").rstrip("/") == ROMS for p in paths):
        paths = [p for p in paths if p and p.rstrip("/") != ROMS]
        for i, p in enumerate(paths):
            ini_set(ini, "General", "ISOPath%d" % i, p)
        for i in range(len(paths), count):
            ini_set(ini, "General", "ISOPath%d" % i, "")
        count = len(paths)
        ini_set(ini, "General", "ISOPaths", str(count))
        changed.append("not the whole ROMs folder")
    for folder in (gc, wii):
        if folder not in paths:
            ini_set(ini, "General", "ISOPath%d" % count, folder)
            count += 1
            paths.append(folder)
            changed.append(folder)
    if changed:
        ini_set(ini, "General", "ISOPaths", str(count))
    if ini_get(ini, "General", "RecursiveISOPaths") != "True":
        ini_set(ini, "General", "RecursiveISOPaths", "True")
        changed.append("subfolders")
    if changed:
        print("bannerlator-pad-defaults: Dolphin: games from " + ", ".join(changed))
    # Once, for a Dolphin set up before this: Vulkan unless it was chosen already, and the NKit box.
    marker = os.path.join(d, ".droiddeck-setup")
    if os.path.exists(marker):
        return
    if not ini_get(ini, "Core", "GFXBackend"):
        ini_set(ini, "Core", "GFXBackend", "Vulkan")
    ini_set(ini, "Interface", "SkipNKitWarning", "True")
    if ini_get(ini, "Analytics", "PermissionAsked") != "True":
        ini_set(ini, "Analytics", "Enabled", "False")
        ini_set(ini, "Analytics", "PermissionAsked", "True")
    open(marker, "w").close()
    print("bannerlator-pad-defaults: Dolphin: Vulkan, no NKit warning")


# Cemu: an SDLController profile for the GamePad. The uuid is "<index>_<SDL GUID>" and SDL's GUID
# carries a CRC of the device name; this is the one SDL reports for the session's pad
# ("Xbox 360 Controller (0)", 045e:028e - read from RPCS3's SDL log on the device). Mapping ids
# from VPADController.h, values from Controller.h, Cemu's own SDL default layout plus Home.
CEMU_MAP = [(1, 1), (2, 0), (3, 3), (4, 2), (5, 9), (6, 10), (7, 42), (8, 43), (9, 6), (10, 4),
            (11, 11), (12, 12), (13, 13), (14, 14), (15, 7), (16, 8), (17, 45), (18, 39), (19, 44),
            (20, 38), (21, 47), (22, 41), (23, 46), (24, 40), (27, 5)]
CEMU_XML = """<?xml version="1.0" encoding="UTF-8"?>
<emulated_controller>
\t<type>Wii U GamePad</type>
\t<toggle_display>0</toggle_display>
\t<controller>
\t\t<api>SDLController</api>
\t\t<uuid>0_03005e615e0400008e02000010010000</uuid>
\t\t<display_name>Xbox 360 Controller</display_name>
\t\t<rumble>0.5</rumble>
\t\t<mappings>
""" + "".join(f"\t\t\t<entry>\n\t\t\t\t<mapping>{m}</mapping>\n\t\t\t\t<button>{b}</button>\n\t\t\t</entry>\n" for m, b in CEMU_MAP) + """\t\t</mappings>
\t</controller>
</emulated_controller>
"""


# Cemu's settings, so its Getting Started dialog (shown while settings.xml is missing, and whose
# folder picker cannot reach ROMs) never blocks a launch: the Wii U games folder, Vulkan
# (Graphic api 1), and audio through Cubeb (the only backend on Linux; api 3) on the default
# device for both the TV and the GamePad speaker - some titles play everything through the
# GamePad - at full volume (Cemu's own default is 20 %). Keys from config/CemuConfig.cpp.
CEMU_SETTINGS = """<?xml version="1.0" encoding="UTF-8"?>
<content>
    <mlc_path></mlc_path>
    <GamePaths>
        <Entry>{games}</Entry>
    </GamePaths>
    <Graphic>
        <api>1</api>
    </Graphic>
    <Audio>
        <api>3</api>
        <TVVolume>100</TVVolume>
        <PadVolume>100</PadVolume>
        <TVDevice>default</TVDevice>
        <PadDevice>default</PadDevice>
    </Audio>
</content>
"""


def cemu():
    seed(os.path.join(CONFIG, "Cemu/controllerProfiles/controller0.xml"), CEMU_XML, "Cemu")
    games = system_folder(["wiiu", "wii u"], "wiiu")
    seed(os.path.join(CONFIG, "Cemu/settings.xml"), CEMU_SETTINGS.format(games=games), "Cemu",
         done=f"games in {games}, Vulkan, Cubeb audio on the default device")


# melonDS 1.x: raw SDL joystick indices. The session's pad has the kernel's Xbox 360 layout
# (buttons A B X Y LB RB Back Start Guide LS RS = 0..10, hat 0 for the d-pad); the d-pad values
# also take the left stick (EmuInstanceInput.cpp; encoding InputConfig/MapButton.h). The guide
# button toggles full screen (HK_FullscreenToggle), as it does in Dolphin: the front end starts
# melonDS full screen (-f), and leaving it shows the window's menus for settings.
MELONDS_GUIDE = 8
MELONDS_JOY = f"""[Instance0.Joystick]
A = 1
B = 0
X = 3
Y = 2
L = 4
R = 5
Select = 6
Start = 7
Up = 17891585
Down = 16843012
Left = 1114376
Right = 65794
HK_FullscreenToggle = {MELONDS_GUIDE}
"""

# The screen a handheld's wide panel suits best: the top screen as big as the panel's height allows
# with the bottom screen alone beside it, centred (ScreenLayout.h: Horizontal = 2, EmphTop = 1;
# melonDS's Hybrid shows the big screen a second time, small, above the bottom one; nobody needs
# it twice). Sharp pixels: no filtering, and no integer steps that leave the panel half used. Keys as
# melonDS writes them (Window.cpp windowCfg).
MELONDS_WINDOW = """[Instance0.Window0]
ScreenLayout = 2
ScreenSizing = 1
IntegerScaling = false
ScreenFilter = false
"""
# melonDS's own defaults for those, which an existing install is moved off once. Hybrid (3) was
# this preset's first layout, and moves on too.
MELONDS_WINDOW_DEFAULTS = {"ScreenLayout": ("0", "3"), "ScreenSizing": ("0",), "ScreenFilter": ("true",)}


# The window melonDS returns to when the guide button leaves full screen: 1x wide (the width of
# two DS screens side by side, Screen.cpp screenGetMinSize) and 16:9, so gamescope stretches it to
# fill the panel and the menu bar and cursor come out large enough to use. A bigger window keeps
# its menus at their real size, tiny on a handheld. Qt's saveGeometry() v3 blob: magic, version,
# frame and normal rects (x, y, right, bottom), screen, maximized, full screen, screen width, and
# the normal rect again (QWidget::restoreGeometry).
def melonds_geometry():
    import base64, struct
    w, h = 512, 288
    try:
        screen_w = int(os.environ.get("BL_WIDTH", "1920"))
    except ValueError:
        screen_w = 1920
    rect = (0, 0, w - 1, h - 1)
    blob = struct.pack(">IHH4i4iiBBi4i", 0x1D9D0CB, 3, 0, *rect, *rect, 0, 0, 0, screen_w, *rect)
    return base64.b64encode(blob).decode()


def toml_get(lines, table, key):
    """The raw value of key in [table], or None."""
    inside = False
    for l in lines:
        t = l.strip()
        if t.startswith("["):
            inside = t == f"[{table}]"
        elif inside and "=" in t and t.split("=", 1)[0].strip() == key:
            return t.split("=", 1)[1].strip()
    return None


def toml_set(lines, table, key, value):
    """key = value in [table]; the table is added at the end when missing."""
    start = None
    for i, l in enumerate(lines):
        t = l.strip()
        if t.startswith("["):
            if start is not None:
                break
            if t == f"[{table}]":
                start = i
        elif start is not None and "=" in t and t.split("=", 1)[0].strip() == key:
            lines[i] = f"{key} = {value}"
            return
    if start is None:
        lines += ["", f"[{table}]", f"{key} = {value}"]
        return
    end = start + 1
    while end < len(lines) and not lines[end].strip().startswith("["):
        end += 1
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines.insert(end, f"{key} = {value}")


def toml_str(path):
    return '"' + path.replace("\\", "\\\\").replace('"', '\\"') + '"'


# The user's own BIOS, firmware and DSi NAND, found in the ROMs folder's nds/bios (or firmware)
# folder by what each file is: the DS BIOSes by size and checksum (the GBA BIOS is also 16 KB),
# firmware and NAND by size, the DSi boot ROMs (both 64 KB) by the 7 or 9 in their names. A path
# is only filled where melonDS has none, and external files are only switched on when a whole set
# was found - without them melonDS runs DS games on its built-in free BIOS.
DS_BIOS7_MD5 = "df692a80a5b1bc90728bc3dfc76cd948"
DS_BIOS9_MD5 = "a392174eb3e572fed6447e956bde4b25"


def nds_firmware_files():
    import hashlib
    base = system_folder(("nds", "ds"), "nds")
    roots = [os.path.join(base, n) for n in ("bios", "BIOS", "firmware") if os.path.isdir(os.path.join(base, n))]
    found = {}
    for root in roots:
        for d, _, files in os.walk(root):
            if d[len(root):].count(os.sep) > 2:
                continue
            for name in sorted(files):
                f = os.path.join(d, name)
                try:
                    size = os.path.getsize(f)
                except OSError:
                    continue
                low = name.lower()
                if size == 16384 or size == 4096:
                    with open(f, "rb") as h:
                        md5 = hashlib.md5(h.read()).hexdigest()
                    if md5 == DS_BIOS7_MD5:
                        found.setdefault("DS.BIOS7Path", f)
                    elif md5 == DS_BIOS9_MD5:
                        found.setdefault("DS.BIOS9Path", f)
                elif size in (262144, 524288) and "dsi" not in low:
                    found.setdefault("DS.FirmwarePath", f)
                elif size == 65536:
                    if "arm7" in low or "bios7" in low:
                        found.setdefault("DSi.BIOS7Path", f)
                    elif "arm9" in low or "bios9" in low:
                        found.setdefault("DSi.BIOS9Path", f)
                elif size == 131072:
                    found.setdefault("DSi.FirmwarePath", f)
                elif size >= 200 * 1024 * 1024 and "nand" in low:
                    found.setdefault("DSi.NANDPath", f)
    return found


def melonds_bios(lines):
    found = nds_firmware_files()
    changed = []
    for key, f in found.items():
        table, k = key.split(".", 1)
        if (toml_get(lines, table, k) or '""') == '""':
            toml_set(lines, table, k, toml_str(f))
            changed.append(key)
    for table, flag, keys in (("Emu", "ExternalBIOSEnable", ("DS.BIOS7Path", "DS.BIOS9Path", "DS.FirmwarePath")),
                              ("DSi", "ExternalBIOSEnable", ("DSi.BIOS7Path", "DSi.BIOS9Path", "DSi.FirmwarePath", "DSi.NANDPath"))):
        if all(k in found for k in keys) and any(k in changed for k in keys):
            toml_set(lines, table, flag, "true")
    return changed


def melonds():
    path = os.path.join(CONFIG, "melonDS/melonDS.toml")
    marker = os.path.join(os.path.dirname(path), ".droiddeck-display-2")
    if not os.path.isfile(path):
        seed(path, "[Instance0]\nJoystickID = 0\n\n" + MELONDS_JOY + "\n" + MELONDS_WINDOW +
             f'Geometry = "{melonds_geometry()}"\n', "melonDS",
             "Player 1 on the controller, big top screen")
        open(marker, "w").close()
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    try:
        import tomllib
        joy = tomllib.loads(text).get("Instance0", {}).get("Joystick", {})
    except Exception:
        return
    lines = text.splitlines()
    done = []
    if not any(isinstance(v, int) and v != -1 and k != "HK_FullscreenToggle" for k, v in joy.items()):
        # Replace melonDS's own all-unbound table with ours (a TOML table can be defined only once).
        out, skipping = [], False
        for line in lines:
            t = line.strip()
            if t.startswith("["):
                skipping = t == "[Instance0.Joystick]"
            if not skipping:
                out.append(line)
        lines = "\n".join(out).rstrip("\n").splitlines() + [""] + MELONDS_JOY.rstrip("\n").splitlines()
        done.append("Player 1 on the controller")
    elif joy.get("HK_FullscreenToggle", -1) == -1 and MELONDS_GUIDE not in joy.values():
        toml_set(lines, "Instance0.Joystick", "HK_FullscreenToggle", str(MELONDS_GUIDE))
        done.append("guide button toggles full screen")
    # Once, for a melonDS set up before this: the big top screen, where it is still on its own
    # defaults. The marker keeps whatever the user picks in melonDS's View menu afterwards.
    if not os.path.exists(marker):
        for l in MELONDS_WINDOW.splitlines()[1:]:
            k, v = (x.strip() for x in l.split("=", 1))
            if toml_get(lines, "Instance0.Window0", k) in (None,) + MELONDS_WINDOW_DEFAULTS.get(k, ()):
                toml_set(lines, "Instance0.Window0", k, v)
        toml_set(lines, "Instance0.Window0", "Geometry", f'"{melonds_geometry()}"')
        done.append("big top screen, 1x window")
        open(marker, "w").close()
    bios = melonds_bios(lines)
    if bios:
        done.append("BIOS " + ", ".join(bios))
    if done:
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            f.write("\n".join(lines).rstrip("\n") + "\n")
        os.replace(path + ".tmp", path)
        print(f"bannerlator-pad-defaults: melonDS: {'; '.join(done)} ({path})")


# PPSSPP (SDL): its pad defaults leave the shoulders, the right stick and the triggers unbound on
# SDL builds (SDLJoystick.cpp codes vs KeyMapDefaults.cpp); a [ControlMapping] that exists replaces
# every default, so this one is complete, keyboard included (device 1 keyboard, 10 pad).
PPSSPP_CONTROLS = """[ControlMapping]
