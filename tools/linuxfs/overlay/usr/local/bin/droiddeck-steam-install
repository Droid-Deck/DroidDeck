#!/bin/bash
set -eu
cdn_list="https://client-update.steamstatic.com https://client-update.akamai.steamstatic.com https://client-update.fastly.steamstatic.com"
steam_channel=steamdeck_publicbeta
manifest=steam_client_${steam_channel}_linuxarm64
steam_root=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
stamp=$steam_root/package/droiddeck-installed
legacy_stamp=$steam_root/package/bannerlator-installed
unconfirmed=$steam_root/package/droiddeck-unconfirmed
repair_request=$HOME/.bl-steam-repair
if [ -f "$legacy_stamp" ] && [ ! -f "$stamp" ]; then
  mv -f "$legacy_stamp" "$stamp" || true
fi
repair=""
if [ -e "$repair_request" ]; then
  repair="requested"
elif [ -f "$unconfirmed" ] && ! grep -qx repaired "$unconfirmed" \
    && [ "$(grep -cx start "$unconfirmed")" -ge 2 ]; then
  repair="the client was started $(grep -cx start "$unconfirmed") times without showing anything"
fi
if [ -n "$repair" ]; then
  echo "== STEP $(date -u +%H:%M:%S) repairing the Steam client ($repair)"
  rm -f "$stamp" "$legacy_stamp" "$steam_root/.crash" "$steam_root/steam.pid" \
    "$steam_root/package/droiddeck-cdn" \
    "$steam_root"/package/steam_client_*.manifest "$steam_root"/package/steam_client_*.installed
  for part in "$steam_root"/package/*.zip.*; do
    [ -f "$part" ] || continue
    sum=${part##*.}
    sum=${sum%%_*}
    case $sum in
      *[!0-9a-f]*|"") continue ;;
    esac
    [ ${#sum} -eq 40 ] || continue
    [ "$(sha1sum "$part" | cut -d' ' -f1)" = "$sum" ] || rm -f "$part"
  done
fi
[ -x "$steam_root/steamrtarm64/steam" ] && [ -f "$stamp" ] && exit 0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cdn=""
for candidate in $cdn_list; do
  if curl -fsSL --connect-timeout 10 --max-time 30 --retry 2 --retry-connrefused --retry-delay 3 \
      "$candidate/$manifest" -o "$work/manifest"; then
    cdn=$candidate
    break
  fi
done
[ -n "$cdn" ] || { echo "droiddeck-steam-install: no Steam client CDN answered for $manifest" >&2; exit 1; }
version=$(awk -F'"' '$2 == "version" { print $4; exit }' "$work/manifest")
awk -F'"' '
  /^\t"/ && NF >= 3 && $4 == "" { block = $2 }
  $2 == "file" { file[block] = $4 }
  $2 == "sha2" { sha[block] = $4 }
  $2 == "size" { size[block] = $4 }
  $2 == "zipvz" { vz[block] = $4 }
  $2 == "sha2vz" { vzsha[block] = $4 }
  END { for (b in file) if (b ~ /_all$/ || b ~ /_linuxarm64_linuxarm64$/) print b, file[b], sha[b], size[b] }
' "$work/manifest" | sort > "$work/parts"
[ -s "$work/parts" ] || { echo "droiddeck-steam-install: no client components in $manifest" >&2; exit 1; }
total=$(grep -c . "$work/parts" 2>/dev/null || echo 0)

# The CDN that answers the manifest first is not the fastest one, so measure the
# opening of the largest component and take the source that actually moves bytes.
probe_file=$(sort -k4 -rn "$work/parts" | head -1 | awk '{ print $2 }')
fastest=""
fastest_speed=0
for candidate in $cdn_list; do
  speed=$(curl -fsSL --connect-timeout 8 --max-time 8 -r 0-2097151 -o /dev/null \
    -w '%{speed_download}' "$candidate/$probe_file" 2>/dev/null) || true
  speed=${speed%%.*}
  case $speed in ''|*[!0-9]*) speed=0 ;; esac
  if [ "$speed" -gt "$fastest_speed" ]; then
    fastest_speed=$speed
    fastest=$candidate
  fi
done
[ -n "$fastest" ] || fastest=$cdn
echo "steam client source: ${fastest#https://} ($((fastest_speed / 1024)) KB/s)"
cdn_order=("$fastest")
for candidate in $cdn_list; do
  [ "$candidate" = "$fastest" ] || cdn_order+=("$candidate")
done

mkdir -p "$steam_root/package"
# The client fetches its own first-run update; it should use the source measured above.
echo "${fastest#https://}/" > "$steam_root/package/droiddeck-cdn"
fetch_part() {
  local host=$1 file=$2 sum=$3 floor=$4 target
  target=$work/$file
  rm -f "$target"
  if [ "$floor" = 1 ]; then
    curl -fsSL --connect-timeout 10 --speed-limit 262144 --speed-time 20 --max-time 1800 \
      "$host/$file" -o "$target" || return 1
  else
    curl -fsSL --connect-timeout 10 --max-time 1800 "$host/$file" -o "$target" || return 1
  fi
  echo "$sum  $target" | sha256sum -c --quiet 2>/dev/null || { rm -f "$target"; return 1; }
}
while read -r block file sum size; do
  i=$((${i:-0} + 1))
  echo "== STEP $(date -u +%H:%M:%S) downloading Steam: $block ($i/$total)"
  fetched=""
  for host in "${cdn_order[@]}"; do
    fetch_part "$host" "$file" "$sum" 1 && { fetched=$host; break; }
  done
  # Every source crawls: take the fastest one without the floor rather than fail.
  if [ -z "$fetched" ] && fetch_part "${cdn_order[0]}" "$file" "$sum" 0; then
    fetched=${cdn_order[0]}
  fi
  [ -n "$fetched" ] || { echo "droiddeck-steam-install: $file failed on every CDN" >&2; exit 1; }
  unzip -qo "$work/$file" -d "$steam_root"
  rm -f "$work/$file"
done < "$work/parts"
# Steam verifies the archives in package/ by name and size before it unpacks them, so
# leaving them there saves the client a first run that fetches the whole set again.
awk -F'"' '
  /^\t"/ && NF >= 3 && $4 == "" { block = $2 }
  $2 == "file" { file[block] = $4 }
  $2 == "sha2" { sha[block] = $4 }
  $2 == "size" { size[block] = $4 }
  $2 == "zipvz" { vz[block] = $4 }
  $2 == "sha2vz" { vzsha[block] = $4 }
  END {
    for (b in file) {
      if (vz[b] != "") {
        n = split(vz[b], part, "_")
        print b, vz[b], vzsha[b], part[n]
      } else {
        print b, file[b], sha[b], size[b]
      }
    }
  }
' "$work/manifest" | sort > "$work/packages"
packages=$(grep -c . "$work/packages" 2>/dev/null || echo 0)
while read -r block name sum bytes; do
  j=$((${j:-0} + 1))
  target=$steam_root/package/$name
  if [ -f "$target" ] && [ "$(stat -c %s "$target")" = "$bytes" ]; then continue; fi
  echo "== STEP $(date -u +%H:%M:%S) downloading Steam: $block ($j/$packages)"
  fetched=""
  for host in "${cdn_order[@]}"; do
    fetch_part "$host" "$name" "$sum" 1 && { fetched=$host; break; }
  done
  if [ -z "$fetched" ] && fetch_part "${cdn_order[0]}" "$name" "$sum" 0; then
    fetched=${cdn_order[0]}
  fi
  [ -n "$fetched" ] || { echo "droiddeck-steam-install: $name failed on every CDN" >&2; exit 1; }
  mv -f "$work/$name" "$target"
done < "$work/packages"
find "$steam_root" -depth -name '*\\*' | while read -r odd; do
  fixed=${odd//\\//}
  mkdir -p "$(dirname "$fixed")"
  if [ -d "$odd" ]; then
    cp -a "$odd/." "$fixed/" && rm -rf "$odd"
  else
    mv -f "$odd" "$fixed"
  fi
done
echo "$steam_channel" > "$steam_root/package/beta"
ln -sfn "$steam_root/steamrtarm64" "$steam_root/steamrtarm32"
# The packages carry no exec bits; the client's own updater used to set them.
chmod -R +x "$steam_root" 2>/dev/null || true
mkdir -p "$HOME/.steam"
ln -sfn "$steam_root" "$HOME/.steam/root"
ln -sfn "$steam_root" "$HOME/.steam/steam"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/bin64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdk64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdkarm64"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/binarm64"
ln -sfn "$steam_root/linux32" "$HOME/.steam/sdk32"
echo "$version" > "$stamp"
if [ -n "$repair" ]; then
  echo repaired > "$unconfirmed"
  rm -f "$repair_request"
fi
