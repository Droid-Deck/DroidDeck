BINDING = "droiddeckCompatChanged"
BRIGHTNESS_BINDING = "droiddeckBrightnessChanged"
CONTROLS_DIR = "/etc/droiddeck-device-controls"
BRIGHTNESS_JS = r"""
(() => {
  if (window.__droiddeckBrightness) return "present";
  const display = SteamClient.System?.Display;
  if (!display?.RegisterForBrightnessChanges || !display?.SetBrightness) return "unavailable";
  const self = { expected: null, updating: true, revision: 0 };
  self.set = value => {
    if (typeof value !== "number" || !Number.isFinite(value) || value < 0 || value > 1) return;
    if (!self.updating && self.expected !== null && Math.abs(value - self.expected) < 0.0001) return;
    self.expected = value;
    self.updating = true;
    const revision = ++self.revision;
    setTimeout(() => { if (self.revision === revision) self.updating = false; }, 500);
    display.SetBrightness(value);
  };
  self.subscription = display.RegisterForBrightnessChanges(state => {
    const value = state?.flBrightness;
    if (typeof value !== "number" || !Number.isFinite(value) || value < 0 || value > 1 || self.expected === null) return;
    if (Math.abs(value - self.expected) < 0.0001) { self.updating = false; return; }
    if (self.updating) { self.updating = false; return; }
    self.expected = value;
    if (typeof window.__BINDING__ === "function") window.__BINDING__(String(value));
  });
  window.__droiddeckBrightness = self;
  return "installed";
})()
""".replace("__BINDING__", BRIGHTNESS_BINDING)


def brightness_request(payload, directory=CONTROLS_DIR):
    try:
        value = float(payload)
        if not math.isfinite(value) or not 0 <= value <= 1:
            return
        path = os.path.join(directory, "brightness.request")
        with open(path + ".tmp", "w") as target:
            target.write(str(value) + "\n")
        os.replace(path + ".tmp", path)
    except (ValueError, TypeError, OSError):
        return


INSTALL_JS = r"""
(() => {
  if (window.__droiddeckCompat) return "present";
  const enc = new TextEncoder(), dec = new TextDecoder();
  const varint = (value, out) => { let n = BigInt(value); do { let b = Number(n & 0x7fn); n >>= 7n; if (n) b |= 0x80; out.push(b); } while (n); };
  const key = (field, wire, out) => varint(field * 8 + wire, out);
  const str = (field, s, out) => { const b = enc.encode(s); key(field, 2, out); varint(b.length, out); for (const x of b) out.push(x); };
  const uint = (field, v, out) => { key(field, 0, out); varint(v, out); };
  const fixed64 = (field, v, out) => { key(field, 1, out); let n = BigInt(v); for (let i = 0; i < 8; i++) { out.push(Number(n & 0xffn)); n >>= 8n; } };
  const parse = (bytes) => {
    const fields = {};
    let i = 0;
    const read = () => { let r = 0n, s = 0n, b; do { b = bytes[i++]; r |= BigInt(b & 0x7f) << s; s += 7n; } while (b & 0x80); return r; };
    while (i < bytes.length) {
      const k = Number(read()), field = k >> 3, wire = k & 7;
      let v;
      if (wire === 0) v = read();
      else if (wire === 1) { v = 0n; for (let j = 0; j < 8; j++) v |= BigInt(bytes[i + j]) << BigInt(8 * j); i += 8; }
      else if (wire === 2) { const n = Number(read()); v = bytes.subarray(i, i + n); i += n; }
      else if (wire === 5) { v = bytes.subarray(i, i + 4); i += 4; }
      else throw new Error("unexpected wire type " + wire);
      (fields[field] = fields[field] || []).push(v);
    }
    return fields;
  };
  const text = (f, n) => f[n] ? dec.decode(f[n][0]) : "";
  const self = { seq: 0, pending: new Map(), ws: null, opening: null, changes: 0 };
  const frame = (method, body, auth) => {
    const h = [];
    fixed64(10, ++self.seq, h);
    str(12, method, h);
    if (auth) str(40, auth, h);
    const out = new Uint8Array(8 + h.length + body.length);
    const view = new DataView(out.buffer);
    view.setUint32(0, (0x80000000 | 146) >>> 0, true);
    view.setUint32(4, h.length, true);
    out.set(h, 8);
    out.set(body, 8 + h.length);
    return [self.seq, out];
  };
  const onMessage = (event) => {
    const bytes = new Uint8Array(event.data);
    const length = new DataView(event.data).getUint32(4, true);
    const header = parse(bytes.subarray(8, 8 + length));
    const target = header[11] ? Number(header[11][0] & 0xffffffffn) : -1;
    if (self.pending.has(target)) {
      const done = self.pending.get(target);
      self.pending.delete(target);
      const result = header[13] ? Number(header[13][0]) : 2;
      done(result === 1 ? { ok: true, body: parse(bytes.subarray(8 + length)) } : { ok: false, eresult: result, error: text(header, 14) });
      return;
    }
    if (text(header, 12).startsWith("CompatManager.NotifyStateChanged")) {
      self.changes++;
      if (typeof window.__BINDING__ === "function") window.__BINDING__(String(self.changes));
    }
  };
  const send = (method, body, auth) => new Promise((resolve, reject) => {
    const [id, out] = frame(method, Uint8Array.from(body), auth);
    const timer = setTimeout(() => { self.pending.delete(id); reject(new Error(method + " timed out")); }, 10000);
    self.pending.set(id, (r) => { clearTimeout(timer); resolve(r); });
    self.ws.send(out);
  });
  const open = async () => {
    const info = await SteamClient.WebUITransport.GetTransportInfo();
    const ws = new WebSocket("ws://127.0.0.1:" + info.portClientdll + "/transportsocket/");
    ws.binaryType = "arraybuffer";
    await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = () => reject(new Error("the client's transport refused the connection")); });
    ws.onmessage = onMessage;
    ws.onclose = () => {
      if (self.ws === ws) self.ws = null;
      for (const done of self.pending.values()) done({ ok: false, eresult: 0, error: "connection closed" });
      self.pending.clear();
    };
    self.ws = ws;
    const body = [];
    str(1, info.authKeyClientdll, body);
    const r = await send("TransportAuth.Authenticate#1", body, info.authKeyClientdll);
    if (!r.ok) { ws.close(); throw new Error("the client's transport refused authentication (" + r.eresult + ")"); }
  };
  const ready = async () => {
    if (self.ws && self.ws.readyState === 1) return;
    if (!self.opening) self.opening = open().finally(() => { self.opening = null; });
    await self.opening;
  };
  self.get = async (appid) => {
    await ready();
    const body = [];
    uint(1, appid, body);
    const r = await send("CompatManager.GetCompatTools#1", body);
    if (!r.ok) throw Object.assign(new Error("GetCompatTools " + appid + " failed (" + r.eresult + " " + r.error + ")"), { eresult: r.eresult });
    return { selected: text(r.body, 3), fallback: text(r.body, 4), tools: (r.body[1] || []).map((t) => text(parse(t), 1)) };
  };
  self.set = async (appid, name) => {
    await ready();
    const body = [];
    uint(1, appid, body);
    str(2, name, body);
    const r = await send("CompatManager.SpecifyCompatTool#1", body);
    if (!r.ok) throw new Error("SpecifyCompatTool " + appid + " " + name + " failed (" + r.eresult + " " + r.error + ")");
    return true;
  };
  self.many = async (apps) => {
    const out = {};
    for (const app of apps) {
      try {
        out[app] = (await self.get(Number(app))).selected;
      } catch (e) {
        if (e.eresult !== 128) throw e;
      }
    }
    return out;
  };
  window.__droiddeckCompat = self;
  return "installed";
})()
""".replace("__BINDING__", BINDING)
TOOLS_JS = r"""
(() => {
  if (window.__droiddeckTools) return "present";
  const installs = SteamClient.Installs, downloads = SteamClient.Downloads;
  if (typeof installs?.OpenInstallWizard !== "function" || typeof installs?.RegisterForShowInstallWizard !== "function" ||
      typeof installs?.ContinueInstall !== "function" || typeof downloads?.QueueAppUpdate !== "function")
    throw new Error("the client's install calls are not ready");
  const self = { asked: new Map() };
  installs.RegisterForShowInstallWizard((state) => {
    const app = Number(state?.currentAppID);
    if (state?.eInstallState === 7 && Date.now() - (self.asked.get(app) || 0) < 120000) {
      self.asked.delete(app);
      installs.ContinueInstall();
    }
  });
  self.install = (app) => { self.asked.set(app, Date.now()); installs.OpenInstallWizard([app], "0"); return true; };
  self.update = (app) => { downloads.QueueAppUpdate(app, "0"); return true; };
  window.__droiddeckTools = self;
  return "installed";
})()
"""
