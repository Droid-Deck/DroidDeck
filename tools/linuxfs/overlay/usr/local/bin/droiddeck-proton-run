#!/usr/bin/python3
"""Runs a Windows program with the Proton the Steam client has chosen for it.

    droiddeck-proton-run [--window] [--prefix ID] [--verb run] [--game-id ID] [--desktop WxH] PROGRAM [ARGS...]
    droiddeck-proton-run --app ID [--dir FOLDER] [--options TEXT] [PROGRAM [ARGS...]]

The program belongs to an installed Steam game when it sits in one's folder, to a prefix when it
sits in one's drive_c, or to a non-Steam shortcut that names it; any other program gets a prefix of
its own, under the id the client gives a new shortcut. That title's CompatToolMapping entry in
config.vdf picks the tool, else the client's default for all other titles ("0"). The tool is
started as the client starts it - its toolmanifest's command line, the waitforexitandrun verb and
the STEAM_COMPAT_* environment - so its wrapper applies the game's settings, components and audio.
--window keeps the program in the desktop's own window, drawn with WineD3D on the desktop's software
GL (llvmpipe): KWin there composites in software, and the session's zink finds no device.
--prefix ID puts the program in compatdata/ID whatever it is. --verb run starts it beside what already
runs in the prefix, which waitforexitandrun would wait for; the wrapper's launch-time steps are skipped.
--game-id ID keeps the id of the launch it runs for: gamescope shows the windows that carry the id Steam launched.
--app starts one game without the Steam client (its Start without Steam): a Steam game's default
Windows launch option from appinfo.vdf when no program is given, else the program in that
shortcut's own prefix, started in --dir with the shortcut's launch options (--options). Without
--options it takes the launch options set in the client's Properties for that game or shortcut.
"""
import itertools
import json
import os
import re
import runpy
import shlex
import struct
import sys
import zlib

HOME = os.environ.get("HOME") or "/root"
STEAM_ROOT = os.path.join(HOME, ".local", "share", "Steam")
BIN_DIR = os.path.dirname(os.path.abspath(__file__))
STATE = os.path.join(HOME, ".local", "share", "droiddeck-compat", "state.json")
EXTRA_LIBRARIES = ("/mnt/droiddeck", "/mnt/droiddeck-sd")
SYSTEM_TOOLS = ("/usr/share/steam/compatibilitytools.d", "/usr/local/share/steam/compatibilitytools.d")
DESKTOP_GL = {"LIBGL_ALWAYS_SOFTWARE": "1", "GALLIUM_DRIVER": "llvmpipe"}
NOT_DESKTOP_GL = ("MESA_LOADER_DRIVER_OVERRIDE", "LIBGL_KOPPER_DRI2")
VERB = "waitforexitandrun"
VERBS = (VERB, "run")
SHORTCUT_BIT = 0x80000000
STEAM_APP_LIMIT = 2 ** 31

_compat = None


def say(message):
    print("droiddeck-proton-run: %s" % message, file=sys.stderr, flush=True)


def compat():
    global _compat
    if _compat is None:
        _compat = runpy.run_path(os.path.join(BIN_DIR, "steam-compatibility"))
    return _compat


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def libraries(root):
    found, seen = [], set()
    for library in compat()["libraries"](root) + list(EXTRA_LIBRARIES):
        try:
            key = os.stat(os.path.join(library, "steamapps"))
        except OSError:
            continue
        if (key.st_dev, key.st_ino) not in seen:
            seen.add((key.st_dev, key.st_ino))
            found.append(library)
    return found


def mapping(root):
    text = read_text(os.path.join(root, "config", "config.vdf"))
    if not text:
        return {}
    c = compat()
    tokens = c["tokenize"](text)
    steam = c["find_block"](tokens, ["InstallConfigStore", "Software", "Valve", "Steam"])
    if steam is None:
        return {}
    block = c["find_block"](tokens[steam + 1:], ["CompatToolMapping"])
    return {} if block is None else c["read_mapping"](tokens, block + steam + 1)


def tools(root):
    c = compat()
    wrapper = os.path.join(root, "compatibilitytools.d", c["TOOL"])
    complete = os.access(os.path.join(wrapper, c["LAUNCHER"]), os.X_OK) and os.path.isfile(os.path.join(wrapper, "toolmanifest.vdf"))
    if c["TOOL"].lower() not in c["local_tools"](root) or not complete:
        depot = c["find_source"](root, runnable=True)
        if depot is not None:
            try:
                c["build_tool"](wrapper, depot)
            except OSError:
                pass
    found = {}
    bases = [os.path.join(root, "compatibilitytools.d")] + list(SYSTEM_TOOLS)
    for base in bases:
        try:
            entries = sorted(os.listdir(base))
        except OSError:
            continue
        for entry in entries:
            folder = os.path.join(base, entry)
            vdf = os.path.join(folder, "compatibilitytool.vdf")
            if not re.search(r'"from_oslist"\s+"[^"]*windows', read_text(vdf) or "", re.I):
                continue
            command = compat()["manifest_entry_point"](os.path.join(folder, "toolmanifest.vdf"))
            if not command or not os.access(os.path.join(folder, command), os.X_OK):
                continue
            name = compat()["first_key"](vdf, ["compatibilitytools", "compat_tools"]) or entry
            found.setdefault(name, (folder, command))
    return found


def state_default():
    try:
        with open(STATE, encoding="utf-8") as f:
            value = json.load(f).get("default")
        return value if isinstance(value, str) else None
    except (OSError, ValueError, AttributeError):
        return None


def newest_own(available):
    c = compat()
    builds = c["own_builds"]([{"name": name, "dir": os.path.basename(folder)} for name, (folder, _) in available.items()])
    return max(builds, key=lambda t: (c["build_key"](t["dir"]), t["dir"]))["name"] if builds else None


def choose_tool(appid, current, available):
    c = compat()
    newest = newest_own(available)
    for key, why in ((appid, "Steam's choice for this title"), ("0", "Steam's default")):
        name = current.get(key)
        if name in available:
            return name, why
        if newest and isinstance(name, str) and name.startswith(c["OWN_PROTON"]):
            return newest, "%s, replacing the removed %s" % (why, name)
    default = state_default()
    if newest and isinstance(default, str) and default.startswith(c["OWN_PROTON"]) and default not in available:
        return newest, "the default, replacing the removed %s" % default
    for name in (default, c["TOOL"], c["TOOL_11"]):
        if name in available:
            return name, "the default ARM64 Proton"
    return (sorted(available)[0], "the only one installed") if available else (None, None)


class Target:
    def __init__(self, appid, compatdata, install, library, kind, start=None):
        self.appid = str(appid)
        self.compatdata = compatdata
        self.install = install
        self.library = library
        self.kind = kind
        self.start = start or install


def ancestors(path):
    child, folder = path, os.path.dirname(path)
    while True:
        yield folder, os.path.basename(child)
        if folder == os.path.dirname(folder):
            return
        child, folder = folder, os.path.dirname(folder)


def identity(path):
    try:
        st = os.stat(path)
        return st.st_dev, st.st_ino
    except OSError:
        return None


def installed_app(steamapps, installdir):
    for name in sorted(os.listdir(steamapps)):
        m = re.fullmatch(r"appmanifest_(\d+)\.acf", name)
        if not m:
            continue
        found = re.search(r'"installdir"\s+"([^"]+)"', read_text(os.path.join(steamapps, name)) or "")
        if found and found.group(1).lower() == installdir.lower():
            return m.group(1)
    return None


def steam_game(program, libs):
    commons = {}
    for library in libs:
        key = identity(os.path.join(library, "steamapps", "common"))
        if key:
            commons.setdefault(key, library)
    for folder, below in ancestors(program):
        library = commons.get(identity(folder))
        if library is None:
            continue
        appid = installed_app(os.path.join(library, "steamapps"), below)
        if appid is None or appid in compat()["NOT_GAMES"]:
            return None
        return Target(appid, os.path.join(library, "steamapps", "compatdata", appid),
                      os.path.join(folder, below), library, "steam")
    return None


def prefix_of(program):
    for folder, below in ancestors(program):
        parent = os.path.dirname(folder)
        if below == "pfx" and os.path.basename(parent) == "compatdata" and re.fullmatch(r"-?[0-9]+", os.path.basename(folder)):
            library = os.path.dirname(os.path.dirname(parent))
            return Target(str(int(os.path.basename(folder)) % 2 ** 32), folder, os.path.dirname(program), library, "prefix")
    return None


def unquoted(value):
    return value.strip().strip('"') if isinstance(value, str) else ""


def same_file(a, b):
    try:
        return bool(b) and os.path.samefile(a, b)
    except OSError:
        return False


def shortcut_entries(root):
    entries = []
    try:
        tool = runpy.run_path(os.path.join(BIN_DIR, "droiddeck-steam-shortcuts"))
        account = tool["account_dir"](root)
        if account:
            with open(os.path.join(account, "config", "shortcuts.vdf"), "rb") as f:
                shortcuts = tool["parse"](f.read()).get("shortcuts", {})
            for value in shortcuts.values():
                if not isinstance(value, dict):
                    continue
                appid = value.get("appid", value.get("AppId"))
                exe = value.get("Exe", value.get("exe"))
                if isinstance(appid, int) and exe:
                    entries.append((appid & 0xFFFFFFFF, unquoted(exe), unquoted(value.get("StartDir", ""))))
    except (OSError, ValueError, IndexError, KeyError, struct.error):
        pass
    try:
        with open(os.environ.get("DD_ADDED_GAMES", ""), encoding="utf-8") as f:
            for game in json.load(f):
                if isinstance(game, dict) and game.get("exe") and str(game.get("appid", "")).isdigit():
                    entries.append((int(game["appid"]) & 0xFFFFFFFF, game["exe"], game.get("dir") or ""))
    except (OSError, ValueError, TypeError):
        pass
    return entries


def prefix_folder(root, appid):
    folder = os.path.join(root, "steamapps", "compatdata")
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        names = []
    candidates = []
    for name in names:
        if not re.fullmatch(r"-?[0-9]+", name):
            continue
        try:
            matches = int(name) % 2 ** 32 == appid % 2 ** 32
        except ValueError:
            continue
        match = os.path.join(folder, name)
        if matches and os.path.isdir(match):
            candidates.append((os.path.isdir(os.path.join(match, "pfx")),
                               name == str(appid % 2 ** 32), name, match))
    if candidates:
        return min(candidates, key=lambda item: (not item[0], not item[1], item[2]))[3]
    return os.path.join(folder, str(appid % 2 ** 32))


def vdf_string(token):
    return re.sub(r'\\(.)', r'\1', token[1:-1]) if token.startswith('"') else ""


def steam_options(app, root):
    try:
        tool = runpy.run_path(os.path.join(BIN_DIR, "droiddeck-steam-shortcuts"))
        account = tool["account_dir"](root)
        if not account:
            return ""
        if int(app) >= STEAM_APP_LIMIT:
            with open(os.path.join(account, "config", "shortcuts.vdf"), "rb") as f:
                shortcuts = tool["parse"](f.read()).get("shortcuts", {})
            for value in shortcuts.values():
                if isinstance(value, dict) and (value.get("appid", value.get("AppId")) or 0) & 0xFFFFFFFF == int(app):
                    options = value.get("LaunchOptions", value.get("launchoptions", ""))
                    return options if isinstance(options, str) else ""
            return ""
        tokens = compat()["tokenize"](read_text(os.path.join(account, "config", "localconfig.vdf")) or "")
        start = compat()["find_block"](tokens, ["UserLocalConfigStore", "Software", "Valve", "Steam", "apps", app])
        if start is None:
            return ""
        end, depth = compat()["block_end"](tokens, start), 0
        for i in range(start + 1, end):
            if tokens[i] in ("{", "}"):
                depth += 1 if tokens[i] == "{" else -1
            elif depth == 0 and tokens[i].lower() == '"launchoptions"' and i + 1 < end:
                return vdf_string(tokens[i + 1])
    except (OSError, ValueError, IndexError, KeyError, TypeError, AttributeError, struct.error):
        pass
    return ""


def shortcut(program, root):
    for appid, exe, start in shortcut_entries(root):
        if same_file(program, exe):
            return Target(appid, prefix_folder(root, appid),
                          os.path.dirname(program), root, "shortcut", start if os.path.isdir(start) else None)
    return None


def own_id(program):
    name = os.path.splitext(os.path.basename(program))[0]
    return zlib.crc32(('"%s"%s' % (program, name)).encode("utf-8")) | SHORTCUT_BIT


def locate(program, root):
    libs = libraries(root)
    found = steam_game(program, libs) or prefix_of(program) or shortcut(program, root)
    if found:
        return found
    appid = own_id(program)
    return Target(appid, prefix_folder(root, appid),
                  os.path.dirname(program), root, "own")


def fixed(program, root, appid, compatdata=None):
    return Target(appid, compatdata or os.path.join(root, "steamapps", "compatdata", str(appid)),
                  os.path.dirname(program), root, "fixed")


def prefix_id(value):
    return value if value.isdigit() and not value.startswith("0") and int(value) <= 0xFFFFFFFF else None


def split_words(text):
    try:
        return shlex.split(text or "")
    except ValueError:
        return (text or "").split()


def split_options(text):
    words = split_words(text)
    if "%command%" not in words:
        return {}, words
    at = words.index("%command%")
    env = {}
    for word in words[:at]:
        name, equals, value = word.partition("=")
        if equals and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            env[name] = value
    return env, words[at + 1:]


def find_file(base, relative):
    path = base
    for part in [p for p in relative.replace("\\", "/").split("/") if p and p != "."]:
        exact = os.path.join(path, part)
        if part == ".." or os.path.exists(exact):
            path = exact
            continue
        try:
            match = next((name for name in sorted(os.listdir(path)) if name.lower() == part.lower()), None)
        except OSError:
            return None
        if match is None:
            return None
        path = os.path.join(path, match)
    return os.path.normpath(path)


def steam_install(appid, root):
    for library in libraries(root):
        found = re.search(r'"installdir"\s+"([^"]+)"',
                          read_text(os.path.join(library, "steamapps", "appmanifest_%s.acf" % appid)) or "")
        if found:
            return library, os.path.join(library, "steamapps", "common", found.group(1))
    return None, None


def steam_launch(appid, root):
    library, install = steam_install(appid, root)
    if not install or not os.path.isdir(install):
        return None
    entry = compat()["appinfo_entries"](os.path.join(root, "appcache", "appinfo.vdf"), wanted={str(appid)}).get(str(appid), {})
    options = [option for option in entry.get("launch_options", ())
               if not option["betakey"] and (not option["oslist"] or "windows" in option["oslist"])]
    options.sort(key=lambda option: (option["type"] not in ("", "default", "none"),
                                     int(option["key"]) if option["key"].isdigit() else 0))
    for option in options:
        program = find_file(install, option["executable"])
        if not program or not os.path.isfile(program):
            continue
        start = find_file(install, option["workingdir"]) if option["workingdir"] else None
        target = Target(appid, os.path.join(library, "steamapps", "compatdata", str(appid)), install, library, "steam",
                        start if start and os.path.isdir(start) else os.path.dirname(program))
        return target, program, split_words(option["arguments"])
    return None


def shortcut_target(appid, program, start, root):
    appid = int(appid) % 2 ** 32
    return Target(str(appid), prefix_folder(root, appid), os.path.dirname(program), root,
                  "shortcut", start if start and os.path.isdir(start) else None)


def steam_launches(target, program, root):
    if target.kind != "steam":
        return False
    entry = compat()["appinfo_entries"](os.path.join(root, "appcache", "appinfo.vdf"), wanted={target.appid}).get(target.appid, {})
    return os.path.relpath(program, target.install).replace(os.sep, "/").lower() in entry.get("launch", ())


STEAM_ID_FILES = ("steam_appid.txt", "steam_settings/steam_appid.txt")
STEAM_CLIENT_MARKERS = (b"ISteamClient", b"ISteamApps")
STEAM_LIBRARY_DIRS = ("bin", "binaries", "x64", "x86", "x86_64", "win64", "win32")
STEAM_SPACEWAR = 480
# A launch scans at most this many folders, directory entries, DLL candidates and bytes; a
# pathological game folder must not delay the launch or hold the launcher open.
STEAM_SCAN_FOLDERS = 64
STEAM_SCAN_ENTRIES = 4096
STEAM_SCAN_FILES = 256
STEAM_SCAN_BYTES = 256 << 20
# Real Steam client libraries are far smaller; the cap only stops a huge file from being read.
STEAM_CLIENT_SCAN = 64 << 20


def scan_entries(path, budget=None):
    """Sorted entries, at most STEAM_SCAN_ENTRIES from one folder and, when a budget is given, no
    more than what the launch has left of it."""
    limit = STEAM_SCAN_ENTRIES if budget is None else min(STEAM_SCAN_ENTRIES, budget[0])
    if limit <= 0:
        return []
    try:
        with os.scandir(path) as entries:
            found = sorted(itertools.islice(entries, limit), key=lambda entry: entry.name)
    except OSError:
        return []
    if budget is not None:
        budget[0] -= len(found)
    return found


def game_folder(root, path):
    """A folder entry resolved, and only while it is still under the game root: a link into another
    game's folder must not be searched for this game's libraries."""
    path = os.path.realpath(path)
    return path if path.startswith(root.rstrip(os.sep) + os.sep) else None


def steam_folders(target, budget=None):
    """Where a game's Steam libraries can sit: beside the exe, at the folder it starts in, one level
    inside either, and inside the usual bin/x64 folders, since games keep them there. A start folder
    outside the exe's folder is searched itself; its known containers are searched only when the
    exe's folder is under one of them, so a shelf's sibling bin is not adopted, and a container that
    leads down to the exe's folder is searched along that branch only. A symlinked start folder is
    resolved first, and a folder link that leaves the game root is not searched."""
    folders = []
    seen = set()
    install = os.path.realpath(target.install) if target.install else None
    for root in (target.install, target.start):
        if not root:
            continue
        root = os.path.realpath(root)
        if not os.path.isdir(root) or root in seen:
            continue
        seen.add(root)
        folders.append(root)
        restricted = bool(install and root != install and not root.startswith(install.rstrip(os.sep) + os.sep))
        below = os.path.relpath(install, root).split(os.sep, 1)[0] if restricted else ""
        above = bool(restricted and below.lower() in STEAM_LIBRARY_DIRS)
        if restricted and not above:
            continue
        for entry in scan_entries(root, budget):
            if len(folders) >= STEAM_SCAN_FOLDERS:
                return folders
            if not entry.is_dir() or entry.name.startswith("."):
                continue
            if restricted and entry.name.lower() not in STEAM_LIBRARY_DIRS:
                continue
            folder = game_folder(root, entry.path)
            if folder is None or folder in seen:
                continue
            seen.add(folder)
            folders.append(folder)
            if entry.name.lower() not in STEAM_LIBRARY_DIRS:
                continue
            # A container on the way down to the exe's folder holds one game; its other children
            # are other games, so only the branch the exe sits in is searched.
            on_the_way = bool(install and install.startswith(folder + os.sep))
            for child in scan_entries(folder, budget):
                if len(folders) >= STEAM_SCAN_FOLDERS:
                    return folders
                if child.name.startswith("."):
                    continue
                child_folder = game_folder(root, child.path)
                if child_folder is None or child_folder in seen or not os.path.isdir(child_folder):
                    continue
                if on_the_way and child_folder != install and not install.startswith(child_folder + os.sep):
                    continue
                seen.add(child_folder)
                folders.append(child_folder)
    return folders


def managed_pe(content):
    """A .NET assembly can carry the interface names in its metadata, but cannot replace the native client."""
    if not content.startswith(b"MZ") or len(content) < 0x40:
        return False
    offset = struct.unpack_from("<I", content, 0x3C)[0]
    if offset + 24 > len(content) or content[offset:offset + 4] != b"PE\0\0":
        return False
    optional = offset + 24
    if optional + 2 > len(content):
        return False
    magic = struct.unpack_from("<H", content, optional)[0]
    if magic == 0x10B:
        count, directories = optional + 92, optional + 96
    elif magic == 0x20B:
        count, directories = optional + 108, optional + 112
    else:
        return False
    if count + 4 > len(content):
        return False
    if struct.unpack_from("<I", content, count)[0] <= 14:
        return False
    entry = directories + 14 * 8
    return entry + 8 <= len(content) and struct.unpack_from("<II", content, entry) != (0, 0)


STEAM_IDENTIFIER = frozenset(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_")
# steam_api[64].dll spells the interfaces as flat exports, SteamAPI_ISteamClient_GetISteamApps, which
# names the client on the machine rather than one beside the game.
STEAM_FLAT_API = b"SteamAPI_"


def steam_interface(content, marker):
    """Whether a marker appears outside a flat-API export name: the stock Steamworks wrapper carries
    both interface names only there, and still loads the client on the machine."""
    start = 0
    while (index := content.find(marker, start)) >= 0:
        begin, end = index, index + len(marker)
        while begin and content[begin - 1] in STEAM_IDENTIFIER:
            begin -= 1
        while end < len(content) and content[end] in STEAM_IDENTIFIER:
            end += 1
        if not content[begin:end].startswith(STEAM_FLAT_API):
            return True
        start = end
    return False


def implements_steam_client(entry, budget):
    try:
        if not entry.is_file():
            return False, budget
        limit = min(STEAM_CLIENT_SCAN, budget)
        if limit <= 0 or entry.stat().st_size > limit:
            return False, budget
        with open(entry.path, "rb") as library:
            content = library.read(limit + 1)
    except OSError:
        return False, budget
    spent = len(content)
    if spent > limit or managed_pe(content):
        return False, max(0, budget - spent)
    found = content.startswith(b"MZ") and all(steam_interface(content, marker) for marker in STEAM_CLIENT_MARKERS)
    return found, max(0, budget - spent)


def steam_libraries(target, folders=None, entries=None):
    """The Steam libraries a game brings itself, told apart by the interfaces they carry rather than by
    one file name: a game that switches interfaces of the client on the machine for its own ships these."""
    found = set()
    budget = STEAM_SCAN_BYTES
    files = 0
    for folder in steam_folders(target, entries) if folders is None else folders:
        for entry in scan_entries(folder, entries):
            name = entry.name.lower()
            if not name.endswith(".dll") or len(name) == 4:
                continue
            if files >= STEAM_SCAN_FILES or budget <= 0:
                return found
            files += 1
            matched, budget = implements_steam_client(entry, budget)
            if matched:
                found.add(entry.name[:-4])
    return found


# An emulator that replaces the client itself (Goldberg, CODEX, RUNE, SmartSteamEmu, LumaEmu) brings a
# settings file, a loader or a client library; those name it even when its own DLLs carry no interface
# strings. A real Steamworks game ships its steam_api wrapper alone, which is none of these.
STEAM_FAMILY_DLLS = ("steam_api", "steam_api64", "steamclient", "steamclient64", "valveapi", "tier0_s", "vstdlib_s")
STEAM_EMULATOR_FILES = (
    "steam_emu.ini", "steam_api.ini", "steam_api64.ini", "steamclient.ini", "smartsteamemu.ini",
    "lumaemu.ini", "coldclientloader.ini", "reloaded.ini", "codex.ini", "rune.ini", "skidrow.ini",
    "plaza.ini", "flt.ini", "empress.ini", "prophet.ini", "hoodlum.ini", "tenoke.ini", "tinyiso.ini",
    "3dm.ini", "ali213.ini",
)
STEAM_EMULATOR_DIRS = ("steam_settings",)
STEAM_EMULATOR_PROGRAMS = (
    "steamclient_loader", "coldclientloader", "smartsteamloader", "smartsteamemu", "steamclient", "steamclient64",
)
# The Steam client's own libraries never sit beside a game, so one there is an emulator whatever it holds.
STEAM_BUNDLED_CLIENTS = ("steamclient", "steamclient64")


def steam_emulator(target, folders=None, entries=None):
    """Whether a shortcut ships its own Steam emulator, by the settings file, loader or client library beside it."""
    for folder in steam_folders(target, entries) if folders is None else folders:
        for entry in scan_entries(folder, entries):
            name = entry.name.lower()
            if name in STEAM_EMULATOR_FILES:
                return True
            if entry.is_dir():
                if name in STEAM_EMULATOR_DIRS:
                    return True
                continue
            if name.rsplit(".", 1)[0] in STEAM_EMULATOR_PROGRAMS:
                return True
    return False


def steam_family(target, folders=None, entries=None):
    """The Steam libraries beside a game, by name: the files an emulator replaces, which Wine must take from
    the folder instead of answering with its own bridges."""
    found = set()
    for folder in steam_folders(target, entries) if folders is None else folders:
        for entry in scan_entries(folder, entries):
            name = entry.name.lower()
            if name.endswith(".dll") and name[:-4] in STEAM_FAMILY_DLLS:
                found.add(entry.name[:-4])
    return found


def steam_app_id(path):
    """The app id in a game's own file, when it names a real Steam app rather than Spacewar or a placeholder."""
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as source:
            text = source.read(64).strip()
    except OSError:
        return None
    value = text.split(maxsplit=1)[0] if text else ""
    if not value.isdigit():
        return None
    app_id = int(value)
    return app_id if 0 < app_id < STEAM_APP_LIMIT and app_id != STEAM_SPACEWAR else None


def steam_id_folders(target):
    """The exe's folder, the folder the shortcut starts in, and the folders between them, but not the
    start folder's other children: a game bundled beside its neighbours must not adopt their app id."""
    folders, seen = [], set()

    def add(path):
        if not path:
            return
        path = os.path.realpath(path)
        if path not in seen and os.path.isdir(path):
            seen.add(path)
            folders.append(path)

    add(target.install)
    add(target.start)
    if target.install and target.start:
        start = os.path.realpath(target.start)
        folder = os.path.realpath(target.install)
        if folder.startswith(start.rstrip(os.sep) + os.sep):
            while folder != start:
                parent = os.path.dirname(folder)
                if parent == folder:
                    break
                folder = parent
                add(folder)
    return folders


def own_steam_id(target):
    """A game that brings its own Steam service names the app id beside its exe or in the folder the
    shortcut starts in; a zeroed SteamAppId in the environment takes precedence over that file and
    fails its Steam init."""
    return any(steam_app_id(os.path.join(folder, name)) is not None
               for folder in steam_id_folders(target) for name in STEAM_ID_FILES)


def steam_state(target):
    """The libraries a shortcut brings itself, whether it names its own app id, and whether it ships a Steam
    emulator; a Steam title or other program has none of them."""
    if target.kind != "shortcut":
        return set(), False, False
    # One allowance for the launch: the folders are discovered once and the detectors read the same
    # directory entries budget, so the work stays bounded however many of them look.
    entries = [STEAM_SCAN_ENTRIES]
    folders = steam_folders(target, entries)
    libraries = steam_libraries(target, folders, entries)
    own_id = own_steam_id(target)
    family = steam_family(target, folders, entries)
    # A game naming its own app id beside a Steam wrapper is the same case: the wrapper answers that file,
    # not the client on the machine.
    emulator = steam_emulator(target, folders, entries) or bool(libraries) or (own_id and bool(family))
    if emulator:
        libraries |= family
    return libraries, own_id, emulator


# Both launch helpers are staged by name (SessionFiles), so a shared parser would need another
# staged file; this copy is kept here and in droiddeck-game-env, and the two must change together.
def merge_overrides(*values):
    """One entry per DLL, the last setting winning; a comma-separated name list is split, and an
    entry that is not NAME=mode stays as it was written."""
    kept, modes = [], {}
    for value in values:
        for entry in (value or "").split(";"):
            entry = entry.strip()
            if '"' in entry or "'" in entry:
                continue
            name, equals, mode = entry.partition("=")
            if not equals or not name:
                if entry:
                    kept.append(entry)
                continue
            for part in name.split(","):
                part = part.strip().lower()
                if part:
                    modes[part] = mode.strip()
    return ";".join(kept + [name + "=" + mode for name, mode in modes.items()])


def prefer_game_steam_client(env, state):
    """Wine answers Steam's libraries with its builtin bridges, which expect the client on the machine and
    leave a game that brings its own without a working Steam init. The game's libraries come first and the
    bridge stays out of the way."""
    steam, _, emulator = state
    if not steam and not emulator:
        return
    entries = merge_overrides(env.get("WINEDLLOVERRIDES", ""))
    named = {part.split("=", 1)[0] for part in entries.split(";") if part}
    added = [name.lower() + "=n,b" for name in sorted(steam) if name.lower() not in named]
    if "lsteamclient" not in named:
        added.append("lsteamclient=d")
    if added:
        env["WINEDLLOVERRIDES"] = merge_overrides(entries, ";".join(added))


def environment(env, target, tool_folder, root, window=False, game_id=None, state=None):
    env = dict(env)
    steamapps = [os.path.join(lib, "steamapps") for lib in libraries(root)]
    env.update({
        "STEAM_COMPAT_DATA_PATH": target.compatdata,
        "STEAM_COMPAT_CLIENT_INSTALL_PATH": root,
        "STEAM_COMPAT_INSTALL_PATH": target.install,
        "STEAM_COMPAT_LIBRARY_PATHS": ":".join(steamapps),
        "STEAM_COMPAT_TOOL_PATHS": tool_folder,
        "STEAM_COMPAT_SHADER_PATH": os.path.join(target.library, "steamapps", "shadercache", target.appid),
    })
    steam, own_id, emulator = steam_state(target) if state is None else state
    number = int(target.appid)
    if number < STEAM_APP_LIMIT:
        env.update(SteamAppId=target.appid, SteamGameId=target.appid, SteamOverlayGameId=target.appid,
                   STEAM_COMPAT_APP_ID=target.appid)
    else:
        game = str(number << 32 | 0x02000000)
        if target.kind == "shortcut" and (steam or own_id or emulator):
            for name in ("SteamAppId", "SteamGameId", "SteamOverlayGameId"):
                env.pop(name, None)
            env["STEAM_COMPAT_APP_ID"] = "0"
        else:
            env.update(SteamAppId="0", STEAM_COMPAT_APP_ID="0", SteamGameId=game, SteamOverlayGameId=game)
    if game_id:
        env.update(SteamGameId=game_id, SteamOverlayGameId=game_id)
    if window:
        env.setdefault("PROTON_USE_WINED3D", "1")
        env.update(DESKTOP_GL)
        for name in NOT_DESKTOP_GL:
            env.pop(name, None)
    return env


def windows_path(path, compatdata=None):
    if compatdata:
        drive = os.path.join(compatdata, "pfx", "drive_c")
        inside = os.path.relpath(path, drive)
        if inside != "." and not inside.startswith(".."):
            return "C:\\" + inside.replace("/", "\\")
    return "Z:" + path.replace("/", "\\")


def arguments(program, args, desktop=None, compatdata=None):
    if program.lower().endswith(".msi"):
        return ["msiexec", "/i", windows_path(program)] + args
    if desktop:
        return ["explorer.exe", "/desktop=droiddeck,%s" % desktop, windows_path(program, compatdata)] + args
    return [program] + args


def main(argv):
    window = False
    prefix = None
    compatdata = None
    verb = VERB
    game_id = None
    desktop = None
    app, start, options = None, None, None
    while argv and argv[0].startswith("--"):
        option = argv.pop(0)
        if option == "--window":
            window = True
        elif option == "--prefix" and argv and prefix_id(argv[0]):
            prefix = argv.pop(0)
        elif option == "--compatdata" and argv and os.path.isabs(argv[0]):
            compatdata = argv.pop(0)
        elif option == "--verb" and argv and argv[0] in VERBS:
            verb = argv.pop(0)
        elif option == "--game-id" and argv and argv[0].isdigit() and argv[0] != "0":
            game_id = argv.pop(0)
        elif option == "--desktop" and argv and re.fullmatch(r"[1-9][0-9]{2,4}x[1-9][0-9]{2,4}", argv[0]):
            desktop = argv.pop(0)
        elif option in ("--app", "--dir", "--options") and argv:
            value = argv.pop(0)
            if option == "--app":
                app = value
            elif option == "--dir":
                start = value
            else:
                options = value
        elif option == "--":
            break
        else:
            say("unknown option %s" % option)
            return 2
    if app is not None and not (app.isdigit() and 0 < int(app) < 2 ** 32):
        say("%s is not an app id" % app)
        return 2
    if not argv and app is None:
        say("usage: droiddeck-proton-run [--window] [--prefix ID [--compatdata DIR]] [--verb run] [--game-id ID] [--desktop WxH] PROGRAM [ARGS...]")
        return 2
    root = os.environ.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or STEAM_ROOT
    if options is None:
        options = steam_options(app, root) if app is not None else ""
    extra, args = split_options(options)
    if not argv:
        if int(app) >= STEAM_APP_LIMIT:
            say("shortcut %s needs its program" % app)
            return 2
        found = steam_launch(app, root)
        if found is None:
            say("Steam game %s is not installed, or has no Windows launch option" % app)
            return 2
        target, program, own = found
        args = own + args
    else:
        program = os.path.abspath(argv[0])
        if not os.path.isfile(program):
            say("%s does not exist" % program)
            return 2
        args = args + argv[1:]
        if app is not None and int(app) >= STEAM_APP_LIMIT:
            target = shortcut_target(app, program, start, root)
        elif prefix:
            target = fixed(program, root, prefix, compatdata)
        else:
            target = locate(program, root)
    available = tools(root)
    name, why = choose_tool(target.appid, mapping(root), available)
    if name is None:
        say("no Proton is installed yet; open Steam once and it is downloaded for you")
        return 69
    folder, command = available[name]
    os.makedirs(target.compatdata, exist_ok=True)
    state = steam_state(target)
    env = environment(os.environ, target, folder, root, window, game_id, state)
    env.update(extra)
    if app is None and verb == VERB:
        env["DROIDDECK_DESKTOP_PROGRAM"] = program
    prefer_game_steam_client(env, state)
    if state[2]:
        say("the game ships a Steam emulator (%s); its own libraries load first and the Steam bridge stays off"
            % (", ".join(sorted(state[0])) or "no library files"))
    say("%s with %s (%s), %s prefix %s%s" % (program, name, why, target.kind, target.compatdata,
                                              ", without the Steam client" if app is not None else ""))
    try:
        os.chdir(target.start)
    except OSError:
        os.chdir(os.path.dirname(program))
    entry = os.path.join(folder, command)
    os.execve(entry, [entry, verb] + arguments(program, args, desktop, target.compatdata), env)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
