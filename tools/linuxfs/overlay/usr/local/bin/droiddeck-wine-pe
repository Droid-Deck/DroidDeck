#!/usr/bin/python3
import os
import re
from pathlib import Path


PE_MACHINES = {
    "system32": ("aarch64-windows", frozenset((0xAA64, 0xA641))),
    "syswow64": ("i386-windows", frozenset((0x14C,))),
}


def pe_machine(path):
    try:
        with open(path, "rb") as image:
            head = image.read(64)
            if head[:2] != b"MZ" or len(head) < 64:
                return None
            image.seek(int.from_bytes(head[60:64], "little"))
            header = image.read(6)
    except OSError:
        return None
    if header[:4] != b"PE\0\0" or len(header) < 6:
        return None
    return int.from_bytes(header[4:6], "little")


def pe_has_arm64ec_metadata(path):
    try:
        with open(path, "rb") as image:
            image.seek(60)
            raw = image.read(4)
            if len(raw) != 4:
                return False
            pe_offset = int.from_bytes(raw, "little")
            image.seek(pe_offset)
            if image.read(4) != b"PE\0\0":
                return False
            coff = image.read(20)
            if len(coff) != 20:
                return False
            section_count = int.from_bytes(coff[2:4], "little")
            if section_count > 96:
                return False
            optional_size = int.from_bytes(coff[16:18], "little")
            optional_offset = pe_offset + 24
            image.seek(optional_offset)
            optional = image.read(optional_size)
            if len(optional) != optional_size or int.from_bytes(optional[:2], "little") != 0x20B:
                return False
            directory_count = int.from_bytes(optional[108:112], "little")
            directory_offset = 112 + 10 * 8
            if directory_count <= 10 or directory_offset + 8 > len(optional):
                return False
            load_config_rva = int.from_bytes(optional[directory_offset:directory_offset + 4], "little")
            load_config_size = int.from_bytes(optional[directory_offset + 4:directory_offset + 8], "little")
            if not load_config_rva or load_config_size < 0xD0:
                return False
            section_offset = optional_offset + optional_size
            for index in range(section_count):
                image.seek(section_offset + index * 40)
                section = image.read(40)
                if len(section) != 40:
                    return False
                virtual_address = int.from_bytes(section[12:16], "little")
                raw_size = int.from_bytes(section[16:20], "little")
                raw_offset = int.from_bytes(section[20:24], "little")
                relative = load_config_rva - virtual_address
                if 0 <= relative <= raw_size - 0xD0:
                    image.seek(raw_offset + relative)
                    load_config = image.read(0xD0)
                    if len(load_config) != 0xD0 or int.from_bytes(load_config[:4], "little") < 0xD0:
                        return False
                    return int.from_bytes(load_config[0xC8:0xD0], "little") != 0
    except (OSError, OverflowError, ValueError):
        return False
    return False


# Only x64 code and members of the same runtime family import these, so an x64 copy loads in an
# ARM64EC prefix, and games check for a newer version than Wine's builtins report.
VC_RUNTIME = re.compile(r"(msvc[pr]\d.*|vcruntime\d.*|vcomp\d*|vcamp\d.*|vccorlib\d.*|concrt\d.*|mfcm?\d.*)\.dll",
                        re.IGNORECASE)


def pe_imports(path):
    try:
        with open(path, "rb") as image:
            head = image.read(64)
            if head[:2] != b"MZ" or len(head) < 64:
                return []
            pe_offset = int.from_bytes(head[60:64], "little")
            image.seek(pe_offset)
            if image.read(4) != b"PE\0\0":
                return []
            coff = image.read(20)
            if len(coff) != 20:
                return []
            section_count = int.from_bytes(coff[2:4], "little")
            optional_size = int.from_bytes(coff[16:18], "little")
            if section_count > 96:
                return []
            optional = image.read(optional_size)
            if len(optional) != optional_size or len(optional) < 2:
                return []
            magic = int.from_bytes(optional[:2], "little")
            directories = {0x20B: 112, 0x10B: 96}.get(magic)
            if directories is None:
                return []
            sections = []
            for _ in range(section_count):
                section = image.read(40)
                if len(section) != 40:
                    return []
                sections.append((int.from_bytes(section[12:16], "little"),
                                 max(int.from_bytes(section[8:12], "little"), int.from_bytes(section[16:20], "little")),
                                 int.from_bytes(section[20:24], "little")))

            def offset(rva):
                for start, size, raw in sections:
                    if start <= rva < start + size:
                        return raw + rva - start
                return None

            def directory(index):
                at = directories + index * 8
                if len(optional) < at + 8:
                    return 0
                return int.from_bytes(optional[at:at + 4], "little")

            def name_at(rva):
                at = offset(rva)
                if at is None:
                    return None
                image.seek(at)
                raw = image.read(256).split(b"\0", 1)[0]
                return raw.decode("ascii", "replace").lower() or None

            names = []
            for index, size, field in ((1, 20, 12), (13, 32, 4)):
                at = offset(directory(index)) if directory(index) else None
                while at is not None and len(names) < 512:
                    image.seek(at)
                    entry = image.read(size)
                    if len(entry) != size or not any(entry):
                        break
                    name = name_at(int.from_bytes(entry[field:field + 4], "little"))
                    if name:
                        names.append(name)
                    at += size
            return names
    except (OSError, OverflowError, ValueError):
        return []


IMPORTERS = {}


def builtin_importers(builtins):
    try:
        stamp = os.stat(builtins).st_mtime_ns
    except OSError:
        return {}
    cached = IMPORTERS.get(str(builtins))
    if cached and cached[0] == stamp:
        return cached[1]
    importers = {}
    try:
        entries = list(os.scandir(builtins))
    except OSError:
        return {}
    for entry in entries:
        if entry.name.lower().endswith(".dll"):
            for name in pe_imports(entry.path):
                importers.setdefault(name, set()).add(entry.name.lower())
    IMPORTERS[str(builtins)] = (stamp, importers)
    return importers


def x64_guests(builtins, names):
    importers = builtin_importers(builtins)
    guests = {name.lower() for name in names}
    changed = True
    while changed:
        changed = False
        for name in sorted(guests):
            if not importers.get(name, set()) <= guests:
                guests.discard(name)
                changed = True
    return guests


def machine_compatible(path, machines, machine=None, guests=frozenset(), name=None):
    machine = pe_machine(path) if machine is None else machine
    name = name or Path(path).name
    if machine == 0x8664 and 0xA641 in machines and VC_RUNTIME.fullmatch(name):
        return True
    if machine == 0x8664 and 0xA641 in machines and name.lower() in guests and not pe_has_arm64ec_metadata(path):
        return True
    if machine == 0x8664 and pe_has_arm64ec_metadata(path):
        return 0xA641 in machines
    return machine in machines


def proton_pe_machines(proton, env=None):
    dist = Path(proton).parent / "files/lib/wine"
    if (dist / "aarch64-unix").is_dir() and (env or {}).get("PROTON_USE_ARM64", "1") == "1":
        return PE_MACHINES
    if (dist / "x86_64-unix").is_dir():
        return {
            "system32": ("x86_64-windows", frozenset((0x8664,))),
            "syswow64": PE_MACHINES["syswow64"],
        }
    return None
