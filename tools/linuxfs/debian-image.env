# The Debian 11 image the x86 preloads are compiled in (glibc 2.31, what Steam's Linux runtime
# has). Published once by .github/workflows/ci-debian-image.yml to a release on this repo; the
# build downloads it from there instead of pulling from a public registry mirror, whose
# anonymous rate limit the shared runners keep hitting. Debian 11 is frozen upstream, so a
# refresh is only ever a new -rN release with the three lines below updated.
DEBIAN_IMAGE_TAG=ci-debian-bullseye-r1
DEBIAN_IMAGE_ASSET=debian-bullseye.tar.zst
DEBIAN_IMAGE_SHA256=
