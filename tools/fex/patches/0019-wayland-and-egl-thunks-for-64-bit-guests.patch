+  }
+  size_t needed = array->size + size;
+  size_t alloc = array->alloc > 0 ? array->alloc : 16;
+  while (alloc < needed) {
+    alloc = alloc > SIZE_MAX / 2 ? needed : alloc * 2;
+  }
+  if (array->alloc < alloc) {
+    void* data = array->alloc > 0 ? realloc(array->data, alloc) : malloc(alloc);
+    if (!data) {
+      return nullptr;
+    }
+    array->data = data;
+    array->alloc = alloc;
+  }
+  void* p = (char*)array->data + array->size;
+  array->size += size;
+  return p;
+}
+
+extern "C" int wl_array_copy(wl_array* array, wl_array* source) {
