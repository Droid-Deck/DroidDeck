 }
+
+const char* eglQueryString(EGLDisplay display, EGLint name) {
+  const char* result = fexfn_pack_eglQueryString(display, name);
+  if (!result || name != EGL_EXTENSIONS) {
+    return result;
+  }
+  std::string filtered;
+  std::string_view all {result};
+  while (!all.empty()) {
+    auto end = all.find(' ');
+    auto extension = all.substr(0, end);
+    if (!extension.empty() && GuestHasEntrypoints(extension)) {
+      if (!filtered.empty()) {
+        filtered += ' ';
+      }
+      filtered += extension;
+    }
+    all = end == std::string_view::npos ? std::string_view {} : all.substr(end + 1);
+  }
+  static std::mutex mutex;
+  static std::set<std::string> strings;
+  std::lock_guard lock(mutex);
+  return strings.insert(std::move(filtered)).first->c_str();
+}
+}
