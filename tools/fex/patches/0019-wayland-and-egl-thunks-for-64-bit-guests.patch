+}
 
 #include "thunkgen_host_libEGL.inl"
 
+static bool IsWaylandDisplay(void* native) {
+  static std::atomic<void*> cached_interface {nullptr};
+  void* wl_display_interface = cached_interface.load(std::memory_order_acquire);
+  if (!wl_display_interface) {
+    if (void* so = dlopen("libwayland-client.so.0", RTLD_LAZY | RTLD_NOLOAD)) {
+      wl_display_interface = dlsym(so, "wl_display_interface");
+      dlclose(so);
+      cached_interface.store(wl_display_interface, std::memory_order_release);
+    }
+  }
+  return wl_display_interface && *reinterpret_cast<void**>(native) == wl_display_interface;
+}
+
+static bool IsHostDevice(void* native) {
+  EGLDeviceEXT devices[16];
+  EGLint count = 0;
+  if (!fexldr_ptr_libEGL_eglQueryDevicesEXT || !fexldr_ptr_libEGL_eglQueryDevicesEXT(16, devices, &count)) {
+    return false;
+  }
+  for (EGLint i = 0; i < count; ++i) {
+    if (devices[i] == native) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static void* HostNativeDisplay(EGLenum platform, void* native, _XDisplay** guest_x11) {
+  if (!native) {
+    return nullptr;
+  }
+  switch (platform) {
+  case EGL_PLATFORM_X11_KHR: break;
+#ifdef EGL_PLATFORM_XCB_EXT
+  case EGL_PLATFORM_XCB_EXT: return x11_manager.GuestToHostConnection(static_cast<xcb_connection_t*>(native));
+#endif
+  case 0:
+    if (IsHostDevice(native) || IsWaylandDisplay(native)) {
+      return native;
+    }
+    break;
+  default: return native;
+  }
+  *guest_x11 = static_cast<_XDisplay*>(native);
+  return x11_manager.GuestToHostDisplay(*guest_x11);
+}
+
+static EGLDisplay TrackDisplay(EGLDisplay display, _XDisplay* guest_x11) {
+  if (display != EGL_NO_DISPLAY && guest_x11) {
+    std::lock_guard lock(x11_displays_mutex);
+    x11_displays[display] = guest_x11;
+  }
+  return display;
+}
+
+static void SyncGuestDisplay(EGLDisplay display) {
+  _XDisplay* guest_x11 = nullptr;
+  {
+    std::lock_guard lock(x11_displays_mutex);
+    if (auto it = x11_displays.find(display); it != x11_displays.end()) {
+      guest_x11 = it->second;
+    }
+  }
+  if (guest_x11) {
+    x11_manager.GuestXSync(guest_x11, 0);
+  }
+}
+
+EGLDisplay fexfn_impl_libEGL_eglGetDisplay(guest_layout<EGLNativeDisplayType> native) {
+  _XDisplay* guest_x11 = nullptr;
+  auto host = HostNativeDisplay(0, native.force_get_host_pointer(), &guest_x11);
+  return TrackDisplay(fexldr_ptr_libEGL_eglGetDisplay(static_cast<EGLNativeDisplayType>(host)), guest_x11);
+}
+
+EGLDisplay fexfn_impl_libEGL_eglGetPlatformDisplay(EGLenum platform, void* native, const EGLAttrib* attribs) {
+  _XDisplay* guest_x11 = nullptr;
+  auto host = HostNativeDisplay(platform, native, &guest_x11);
+  return TrackDisplay(fexldr_ptr_libEGL_eglGetPlatformDisplay(platform, host, attribs), guest_x11);
+}
+
+EGLDisplay fexfn_impl_libEGL_eglGetPlatformDisplayEXT(EGLenum platform, void* native, const EGLint* attribs) {
+  _XDisplay* guest_x11 = nullptr;
+  auto host = HostNativeDisplay(platform, native, &guest_x11);
+  return TrackDisplay(fexldr_ptr_libEGL_eglGetPlatformDisplayEXT(platform, host, attribs), guest_x11);
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreateWindowSurface(EGLDisplay display, EGLConfig config, EGLNativeWindowType window, const EGLint* attribs) {
+  SyncGuestDisplay(display);
+  return fexldr_ptr_libEGL_eglCreateWindowSurface(display, config, window, attribs);
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreatePixmapSurface(EGLDisplay display, EGLConfig config, EGLNativePixmapType pixmap, const EGLint* attribs) {
+  SyncGuestDisplay(display);
+  return fexldr_ptr_libEGL_eglCreatePixmapSurface(display, config, pixmap, attribs);
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreatePlatformWindowSurface(EGLDisplay display, EGLConfig config, void* window, const EGLAttrib* attribs) {
+  SyncGuestDisplay(display);
+  return fexldr_ptr_libEGL_eglCreatePlatformWindowSurface(display, config, window, attribs);
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreatePlatformPixmapSurface(EGLDisplay display, EGLConfig config, void* pixmap, const EGLAttrib* attribs) {
+  SyncGuestDisplay(display);
+  return fexldr_ptr_libEGL_eglCreatePlatformPixmapSurface(display, config, pixmap, attribs);
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreatePlatformWindowSurfaceEXT(EGLDisplay display, EGLConfig config, void* window, const EGLint* attribs) {
+  SyncGuestDisplay(display);
+  return fexldr_ptr_libEGL_eglCreatePlatformWindowSurfaceEXT(display, config, window, attribs);
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreatePlatformPixmapSurfaceEXT(EGLDisplay display, EGLConfig config, void* pixmap, const EGLint* attribs) {
+  SyncGuestDisplay(display);
