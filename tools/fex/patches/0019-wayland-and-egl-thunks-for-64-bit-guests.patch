+static bool GuestHasEntrypoints(std::string_view extension) {
+  for (const auto& [name, entrypoint] : ExtensionEntrypoints) {
+    if (name == extension) {
+      return Self() && dlsym(Self(), entrypoint);
+    }
+  }
+  return true;
