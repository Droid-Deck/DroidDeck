 voidFunc* eglGetProcAddress(const char* procname) {
-  // TODO: Fix this HACK
+  if (strncmp(procname, "egl", 3) == 0) {
+    return Self() ? reinterpret_cast<voidFunc*>(dlsym(Self(), procname)) : nullptr;
