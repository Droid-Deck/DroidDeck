+// Marks each run of host mappings that overlaps the range as used, in full. Returns false if none overlaps.
+bool MemAllocator32Bit::SetHostMappedPages(uint64_t PageAddr, size_t PagesLength) {
+  const int MapsFD = ::open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  if (MapsFD == -1) {
+    return false;
+  }
+
+  const auto Gaps =
+    FEXCore::Allocator::CollectMemoryGaps(BASE_KEY << FEXCore::Utils::FEX_PAGE_SHIFT, TOP_KEY << FEXCore::Utils::FEX_PAGE_SHIFT, MapsFD);
+  close(MapsFD);
+
+  const uint64_t EndPage = PageAddr + PagesLength;
+  uint64_t MappedBegin = BASE_KEY;
+  bool Marked = false;
+  auto MarkIfOverlapping = [&](uint64_t MappedEnd) {
+    if (MappedBegin < MappedEnd && MappedBegin < EndPage && PageAddr < MappedEnd) {
+      SetUsedPages(MappedBegin, MappedEnd - MappedBegin);
+      Marked = true;
+    }
+  };
+
+  for (const auto& Gap : Gaps) {
+    const uintptr_t GapBegin = reinterpret_cast<uintptr_t>(Gap.Ptr);
+    MarkIfOverlapping(GapBegin >> FEXCore::Utils::FEX_PAGE_SHIFT);
+    MappedBegin = (GapBegin + Gap.Size) >> FEXCore::Utils::FEX_PAGE_SHIFT;
+  }
+  MarkIfOverlapping(TOP_KEY);
+
+  return Marked;
+}
