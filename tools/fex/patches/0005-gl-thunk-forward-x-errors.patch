+static XErrorHandler HostPreviousXErrorHandler = nullptr;
+
+static int HostXErrorHandler(Display* HostDisplay, XErrorEvent* Event) {
+  auto GuestDisplay = x11_manager.FindGuestDisplay(HostDisplay);
+  if (!GuestDisplay || !x11_manager.GuestXErrorForward) {
+    return HostPreviousXErrorHandler ? HostPreviousXErrorHandler(HostDisplay, Event) : 0;
+  }
+  return x11_manager.GuestXErrorForward(GuestDisplay, Event->type, static_cast<guest_long>(Event->resourceid),
+                                        static_cast<guest_long>(Event->serial), Event->error_code, Event->request_code, Event->minor_code);
+}
+
+static void fexfn_impl_libGL_GL_SetGuestXErrorForward(uintptr_t GuestTarget, uintptr_t GuestUnpacker) {
+  MakeHostTrampolineForGuestFunctionAt(GuestTarget, GuestUnpacker, &x11_manager.GuestXErrorForward);
+  auto Previous = x11_manager.HostXSetErrorHandler(HostXErrorHandler);
+  if (Previous != HostXErrorHandler) {
+    HostPreviousXErrorHandler = Previous;
+  }
+}
