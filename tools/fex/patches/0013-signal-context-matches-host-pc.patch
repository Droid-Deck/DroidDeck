+static uint64_t BlockHeaderAtEntryPoint(uint64_t HostPC) {
+  constexpr uint32_t Rd = FEXCore::CPU::TMP1.Idx();
+  constexpr uint32_t HeaderStore =
+    0xF9000000U | ((offsetof(FEXCore::Core::CPUState, InlineJITBlockHeader) / 8) << 10) | (FEXCore::CPU::STATE.Idx() << 5) | Rd;
+  const auto IsAdr = [](uint32_t Inst) {
+    return (Inst & 0x9F00001FU) == (0x10000000U | Rd);
+  };
+  const auto IsAdrp = [](uint32_t Inst) {
+    return (Inst & 0x9F00001FU) == (0x90000000U | Rd);
+  };
+  const auto IsAdd = [](uint32_t Inst) {
+    return (Inst & 0xFFC003FFU) == (0x91000000U | (Rd << 5) | Rd);
+  };
+  const auto Imm21 = [](uint32_t Inst) {
+    const uint64_t Raw = (static_cast<uint64_t>((Inst >> 5) & 0x7FFFF) << 2) | ((Inst >> 29) & 3);
+    return static_cast<int64_t>(Raw << 43) >> 43;
+  };
+
+  const auto Code = reinterpret_cast<const uint32_t*>(HostPC);
+  for (uint64_t Ahead = 0; Ahead < 3; ++Ahead) {
+    if (Code[Ahead] != HeaderStore) {
+      continue;
+    }
+    const uint64_t Store = HostPC + Ahead * 4;
+    const uint64_t Prev = Store - 4;
+    const auto PrevInst = *reinterpret_cast<const uint32_t*>(Prev);
+    uint64_t Start {};
+    uint64_t Header {};
+    if (IsAdr(PrevInst)) {
+      Start = Prev;
+      Header = Prev + Imm21(PrevInst);
+    } else if (IsAdrp(PrevInst)) {
+      Start = Prev;
+      Header = (Prev & ~0xFFFULL) + (Imm21(PrevInst) << 12);
+    } else if (IsAdd(PrevInst) && IsAdrp(*reinterpret_cast<const uint32_t*>(Prev - 4))) {
+      Start = Prev - 4;
+      Header = (Start & ~0xFFFULL) + (Imm21(*reinterpret_cast<const uint32_t*>(Start)) << 12) + ((PrevInst >> 10) & 0xFFF);
+    }
+    if (!Header || HostPC < Start || Header >= Start) {
+      return 0;
+    }
+    const auto InlineHeader = reinterpret_cast<const CPU::CPUBackend::JITCodeHeader*>(Header);
+    const auto InlineTail = reinterpret_cast<const CPU::CPUBackend::JITCodeTail*>(Header + InlineHeader->OffsetToBlockTail);
+    return HostPC < Header + InlineTail->Size ? Header : 0;
+  }
+  return 0;
+}
