+void SyscallHandler::ProtectWritableAliasOfCode(uint64_t Base, uint64_t Length) {
+  if (SMCChecks != FEXCore::Config::CONFIG_SMC_MTRACK) {
+    return;
+  }
+
+  auto Mapping = VMATracking.FindVMAEntry(Base);
+  if (Mapping == VMATracking.VMAs.end() || !Mapping->second.Flags.Shared || !Mapping->second.Prot.Writable || !Mapping->second.Resource) {
+    return;
+  }
+
+  const auto MapTop = Mapping->first + Mapping->second.Length;
+  const auto Top = std::min(Base + Length, MapTop);
+  if (Top <= Base) {
+    return;
+  }
+
+  const auto OffsetBase = Mapping->second.Offset + (Base - Mapping->first);
+  const auto OffsetTop = OffsetBase + (Top - Base);
+
+  for (auto VMA = Mapping->second.Resource->FirstVMA; VMA; VMA = VMA->ResourceNextVMA) {
+    if (!VMA->Prot.Executable || VMA->Offset >= OffsetTop || VMA->Offset + VMA->Length <= OffsetBase) {
+      continue;
+    }
+
+    const auto OverlapBase = std::max(VMA->Offset, OffsetBase);
+    const auto OverlapTop = std::min(VMA->Offset + VMA->Length, OffsetTop);
+    auto rv = mprotect((void*)(Base + (OverlapBase - OffsetBase)), OverlapTop - OverlapBase, PROT_READ);
+    LogMan::Throw::AFmt(rv == 0, "mprotect({}, {}) failed", OverlapBase, OverlapTop - OverlapBase);
+  }
+}
