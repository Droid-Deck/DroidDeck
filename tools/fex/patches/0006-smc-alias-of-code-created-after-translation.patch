+void SyscallHandler::ProtectWritableAliasOfCode(uint64_t Base, uint64_t Length) {
+  if (SMCChecks != FEXCore::Config::CONFIG_SMC_MTRACK) {
+    return;
+  }
+
+  const auto End = Base + Length;
+  auto Mapping = VMATracking.FindVMAEntry(Base);
+  if (Mapping == VMATracking.VMAs.end()) {
+    Mapping = VMATracking.VMAs.lower_bound(Base);
+  }
+
+  for (; Mapping != VMATracking.VMAs.end() && Mapping->first < End; ++Mapping) {
+    if (!Mapping->second.Flags.Shared || !Mapping->second.Prot.Writable || !Mapping->second.Resource) {
+      continue;
+    }
+
+    const auto MapBase = std::max(Base, Mapping->first);
+    const auto MapTop = std::min(End, Mapping->first + Mapping->second.Length);
+    if (MapTop <= MapBase) {
+      continue;
+    }
+
+    const auto OffsetBase = Mapping->second.Offset + (MapBase - Mapping->first);
+    const auto OffsetTop = OffsetBase + (MapTop - MapBase);
+
+    for (auto VMA = Mapping->second.Resource->FirstVMA; VMA; VMA = VMA->ResourceNextVMA) {
+      if (!VMA->Prot.Executable || VMA->Offset >= OffsetTop || VMA->Offset + VMA->Length <= OffsetBase) {
+        continue;
+      }
+
+      const auto OverlapBase = std::max(VMA->Offset, OffsetBase);
+      const auto OverlapTop = std::min(VMA->Offset + VMA->Length, OffsetTop);
+      auto rv = mprotect((void*)(MapBase + (OverlapBase - OffsetBase)), OverlapTop - OverlapBase, PROT_READ);
+      LogMan::Throw::AFmt(rv == 0, "mprotect({}, {}) failed", OverlapBase, OverlapTop - OverlapBase);
+    }
+  }
+}
