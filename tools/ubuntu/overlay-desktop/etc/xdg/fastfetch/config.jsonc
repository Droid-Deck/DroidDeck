{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/droiddeck/fastfetch/logo.txt",
    "color": {
      "1": "38;2;255;255;255",
      "2": "38;2;26;159;255"
    },
    "padding": { "right": 3 }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal", "cpu", "gpu", "memory", "swap", "disk", "battery", "locale",
    "break", "colors"
  ]
}
