+/* Slab entries and cached buffers a client frees are otherwise only reclaimed by its next
+ * allocation, so a client that goes idle (a browser UI behind a fullscreen game) keeps all of
+ * that memory allocated. On UMA devices it is system RAM that cannot be swapped. */
+static int
+bo_reclaim_thread(void *data)
+{
+   struct zink_screen *screen = data;
+   uint32_t seen = p_atomic_read(&screen->pb.alloc_serial);
+
+   u_thread_setname("zink_reclaim");
+   mtx_lock(&screen->pb.reclaim_lock);
+   while (!screen->pb.reclaim_stop) {
+      struct timespec deadline;
+      timespec_get(&deadline, TIME_UTC);
+      deadline.tv_sec += 1;
+      cnd_timedwait(&screen->pb.reclaim_cond, &screen->pb.reclaim_lock, &deadline);
+      if (screen->pb.reclaim_stop)
+         break;
+      mtx_unlock(&screen->pb.reclaim_lock);
+
+      uint32_t serial = p_atomic_read(&screen->pb.alloc_serial);
+      if (serial == seen) {
+         for (unsigned i = 0; i < NUM_SLAB_ALLOCATORS; i++)
+            pb_slabs_reclaim(&screen->pb.bo_slabs[i]);
+         pb_cache_release_all_buffers(&screen->pb.bo_cache);
+      }
+      seen = serial;
+
+      mtx_lock(&screen->pb.reclaim_lock);
+   }
+   mtx_unlock(&screen->pb.reclaim_lock);
+   return 0;
+}
+
