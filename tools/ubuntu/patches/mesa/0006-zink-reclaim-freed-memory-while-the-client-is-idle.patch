@@ -1425,12 +1461,25 @@
       min_slab_order = max_order + 1;
    }
    screen->pb.min_alloc_size = 1 << screen->pb.bo_slabs[0].min_order;
+
+   mtx_init(&screen->pb.reclaim_lock, mtx_plain);
+   cnd_init(&screen->pb.reclaim_cond);
+   screen->pb.reclaim_running =
+      u_thread_create(&screen->pb.reclaim_thread, bo_reclaim_thread, screen) == thrd_success;
    return true;
 }
 
 void
 zink_bo_deinit(struct zink_screen *screen)
 {
+   if (screen->pb.reclaim_running) {
+      mtx_lock(&screen->pb.reclaim_lock);
+      screen->pb.reclaim_stop = true;
+      cnd_signal(&screen->pb.reclaim_cond);
+      mtx_unlock(&screen->pb.reclaim_lock);
+      thrd_join(screen->pb.reclaim_thread, NULL);
+      screen->pb.reclaim_running = false;
