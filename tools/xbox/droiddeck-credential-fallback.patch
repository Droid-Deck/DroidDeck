+fn loopback(value: &Value) -> Result<Value, TokenStoreError> {
+    let port: u16 = std::env::var("DROIDDECK_XBOX_CREDENTIAL_PORT").ok().and_then(|v| v.parse().ok())
+        .ok_or_else(|| std::io::Error::other("Android credential port is unavailable"))?;
+    let key = std::env::var("DROIDDECK_XBOX_CREDENTIAL_KEY")
+        .map_err(|_| std::io::Error::other("Android credential key is unavailable"))?;
+    let address = SocketAddrV4::new(Ipv4Addr::LOCALHOST, port).into();
+    let stream = TcpStream::connect_timeout(&address, Duration::from_secs(5)).inspect_err(|error| {
+        eprintln!("NEXUS_CREDENTIAL_ERROR_V1 loopback-{}", reason(error));
+    })?;
+    stream.set_read_timeout(Some(Duration::from_secs(10)))?;
+    stream.set_write_timeout(Some(Duration::from_secs(10)))?;
+    exchange(stream, Some(&key), value)
+}
+
+fn request(value: Value) -> Result<Value, TokenStoreError> {
+    if LOOPBACK.load(Ordering::Relaxed) { return loopback(&value); }
+    let name = std::env::var("DROIDDECK_XBOX_CREDENTIAL_SOCKET")
+        .map_err(|_| std::io::Error::other("Android credential host is unavailable"))?;
+    let address = SocketAddr::from_abstract_name(name)?;
+    match UnixStream::connect_addr(&address) {
+        Ok(stream) => {
+            stream.set_read_timeout(Some(Duration::from_secs(10)))?;
+            stream.set_write_timeout(Some(Duration::from_secs(10)))?;
+            exchange(stream, None, &value)
+        }
+        Err(error) => {
+            if !REPORTED.swap(true, Ordering::Relaxed) {
+                eprintln!("NEXUS_CREDENTIAL_ERROR_V1 socket-{}", reason(&error));
+            }
+            let result = loopback(&value);
+            if result.is_ok() {
+                LOOPBACK.store(true, Ordering::Relaxed);
+                eprintln!("NEXUS_CREDENTIAL_ERROR_V1 loopback-in-use");
+            }
+            result
+        }
+    }
+}
