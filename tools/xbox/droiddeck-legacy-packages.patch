+// EAppxMagic is EXPH (single), EXSH and EXBH (bundle). Anything else is not an
+// EAppx container, so a bundle's plain ZIP members are not recursed into.
+fn is_eappx(path: &Path) -> bool {
+    use std::io::Read;
+    let Ok(mut file) = std::fs::File::open(path) else { return false };
+    let mut magic = [0u8; 4];
+    if file.read_exact(&mut magic).is_err() {
+        return false;
+    }
+    matches!(&magic, b"EXPH" | b"EXSH" | b"EXBH")
+}
+
+fn derive(
+    infile: &Path,
+    outdir: &Path,
+    keys: &KeyCollection,
+    depth: usize,
+) -> Result<(), Failure> {
+    let file = std::fs::File::open(infile)
+        .map_err(|e| Failure::at("open", infile, &e.to_string()))?;
+    let mut reader = std::io::BufReader::new(file);
+
+    let mut eappx = EAppxFile::from_stream(&mut reader)
+        .map_err(|e| Failure::at("header", infile, &e.to_string()))?;
+
+    println!("{eappx}");
+
+    // The licence and the header name the same key differently, so the set is
+    // rebuilt per package and reconciled before the header is judged.
+    let mut required = KeyCollection::new(&keys.keys);
+    align_keys(&mut required, &eappx.header.key_ids);
+
+    if !required.has_required_keys(&eappx.header.key_ids) {
+        // The count is the useful part: a license that carries one key cannot
+        // open a bundle whose members each declare their own.
+        return Err(Failure::new(
+            "missing-keys",
+            &infile.file_name().map(|name| name.to_string_lossy().into_owned()).unwrap_or_default(),
+            &format!("{} of {} content keys present", required.keys.len(), eappx.header.key_ids.len()),
+        ));
     }
+
+    eappx
+        .load_keys(&required)
+        .map_err(|e| Failure::at("load-keys", infile, &e.to_string()))?;
+
+    std::fs::create_dir_all(outdir)
+        .map_err(|e| Failure::at("create-dir", outdir, &e.to_string()))?;
+
+    eappx
+        .extract(&mut reader, outdir)
+        .map_err(|e| Failure::at("extract", infile, &e.to_string()))?;
+
+    println!("Extracted {}", infile.file_name().unwrap_or_default().to_string_lossy());
+
+    let mut nested: Vec<PathBuf> = std::fs::read_dir(outdir)
+        .map_err(|e| Failure::at("list", outdir, &e.to_string()))?
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|path| path.is_file() && is_eappx(path))
+        .collect();
+    nested.sort();
+
+    if nested.is_empty() {
+        return Ok(());
+    }
+    if depth >= MAX_BUNDLE_DEPTH {
+        return Err(Failure::at("nesting", infile, "bundle nesting exceeds the limit"));
+    }
+
+    for child in nested {
+        let name = child
+            .file_stem()
+            .map(|name| name.to_string_lossy().into_owned())
+            .ok_or_else(|| Failure::at("no-name", &child, "package without a usable name"))?;
+        derive(&child, &outdir.join(&name), keys, depth + 1)?;
+        // The member's bytes are no longer needed once its contents are on disk.
+        // A bundle of a full title holds tens of gigabytes, and keeping every
+        // member beside the decrypted copy doubles what the install occupies.
+        std::fs::remove_file(&child).ok();
+    }
+
+    Ok(())
 }
