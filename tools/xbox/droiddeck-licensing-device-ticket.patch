+// Content licensing rejects a delegation-compact device ticket in the d= form
+// (HTTP 401); it takes the same licensing form as the user ticket, as
+// xodus-service store_license does for Store license tokens. Plain compact
+// device tickets are sent unchanged.
+fn content_device_ticket(response: soap::RequestSecurityTokenResponse) -> Result<String, String> {
+    let delegation = response.token_type == "urn:passport:delegationcompact";
+    let Token::Compact(ticket) = Token::try_from(response).map_err(|error| error.to_string())? else {
+        return Err("Unsupported token".to_string());
+    };
+    Ok(if delegation { xodus::models::secrets::licensing_ticket(ticket) } else { ticket })
+}
