+fn credential_licensing_device_ticket_delegation_forms_use_the_licensing_wire_form() {
+    for raw in [
+        jwe(json!({"alg":"dir","enc":"A128CBC-HS256"}), ""),
+        jwe(json!({"alg":"RSA-OAEP-256","enc":"A256GCM"}), "a2V5"),
