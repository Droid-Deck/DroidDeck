index 0000000..858afec
--- /dev/null
+++ b/crates/xodus-cli/src/commands/unzip.rs
@@ -0,0 +1,191 @@
+//! Plain ZIP packages, which is what the store serves for a framework.
+//!
+//! Framework packages (`Microsoft.VCLibs.140.00` and its siblings) arrive from the
+//! delivery service as ordinary `.appx` zips, not the EAppx containers a title is
+//! packed in: there is nothing to decrypt and no header to parse. The packager
+//! writes them in the ZIP64 form, so the central directory and each entry may name
+//! its sizes and offset in an extra field instead of the fixed header.
+
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::path::Path;
+
+/// The end record is 22 bytes and its comment field can push it back 64 KiB.
+const TAIL: u64 = 65_557;
+const END: &[u8; 4] = b"PK\x05\x06";
+const ZIP64_END: &[u8; 4] = b"PK\x06\x06";
+const ZIP64_LOCATOR: &[u8; 4] = b"PK\x06\x07";
+const CENTRAL: &[u8; 4] = b"PK\x01\x02";
+const SATURATED: u32 = 0xFFFF_FFFF;
+
+pub fn extract(archive: &Path, destination: &Path) -> Result<(), String> {
+    let mut file = std::fs::File::open(archive).map_err(|error| format!("package open failed: {error}"))?;
+    let length = file.metadata().map_err(|error| format!("package size failed: {error}"))?.len();
+    if length < 22 {
+        return Err("the package is too small to be an archive".into());
+    }
+    let tail = length.min(TAIL);
+    file.seek(SeekFrom::Start(length - tail)).map_err(|error| format!("package seek failed: {error}"))?;
+    let mut buffer = vec![0u8; tail as usize];
+    file.read_exact(&mut buffer).map_err(|error| format!("package read failed: {error}"))?;
+    let end = buffer
+        .windows(END.len())
+        .rposition(|window| window == END)
+        .ok_or("the package is not a zip archive")?;
+    if end + 22 > buffer.len() {
+        return Err("the package end record is truncated".into());
+    }
+    let mut entries = u16::from_le_bytes([buffer[end + 10], buffer[end + 11]]) as u64;
+    let mut offset = u32::from_le_bytes([buffer[end + 16], buffer[end + 17], buffer[end + 18], buffer[end + 19]]) as u64;
+    if entries == 0xFFFF || offset == u64::from(SATURATED) || offset > length {
+        let (zip64_entries, zip64_offset) = zip64(&mut file, length, &buffer, end)?;
+        entries = zip64_entries;
+        offset = zip64_offset;
+    }
+    if offset >= length {
+        return Err(format!("the package directory starts past the archive at {offset} of {length}"));
+    }
+    std::fs::create_dir_all(destination).map_err(|error| format!("package folder failed: {error}"))?;
+    for _ in 0..entries {
+        file.seek(SeekFrom::Start(offset)).map_err(|error| format!("package seek failed: {error}"))?;
+        let mut header = [0u8; 46];
+        file.read_exact(&mut header).map_err(|error| format!("package header failed at {offset} of the directory, {error}"))?;
+        if &header[0..4] != CENTRAL {
+            return Err(format!("the package directory is malformed at {offset}"));
+        }
+        let method = u16::from_le_bytes([header[10], header[11]]);
+        let uncompressed = u32::from_le_bytes([header[24], header[25], header[26], header[27]]);
+        let mut compressed = u64::from(u32::from_le_bytes([header[20], header[21], header[22], header[23]]));
+        let name_length = u16::from_le_bytes([header[28], header[29]]) as usize;
+        let extra_length = u16::from_le_bytes([header[30], header[31]]) as usize;
+        let comment_length = u16::from_le_bytes([header[32], header[33]]) as usize;
+        let mut local = u64::from(u32::from_le_bytes([header[42], header[43], header[44], header[45]]));
+        let mut name = vec![0u8; name_length];
+        file.read_exact(&mut name).map_err(|error| format!("package name failed: {error}"))?;
+        let mut extra = vec![0u8; extra_length];
+        file.read_exact(&mut extra).map_err(|error| format!("package extra failed: {error}"))?;
+        offset += 46 + name_length as u64 + extra_length as u64 + comment_length as u64;
+        if compressed == u64::from(SATURATED) || local == u64::from(SATURATED) || uncompressed == SATURATED {
+            let wide = zip64_entry(&extra, uncompressed == SATURATED, compressed == u64::from(SATURATED), local == u64::from(SATURATED));
+            if compressed == u64::from(SATURATED) {
+                compressed = wide.compressed.ok_or("a package entry has no wide size")?;
+            }
+            if local == u64::from(SATURATED) {
+                local = wide.local.ok_or("a package entry has no wide offset")?;
+            }
+        }
+        let name = String::from_utf8(name).map_err(|_| "a package entry has an unreadable name".to_string())?;
+        if name.ends_with('/') {
+            continue;
+        }
+        let Some(relative) = safe(&name) else { continue };
+        let target = destination.join(relative);
+        if let Some(parent) = target.parent() {
+            std::fs::create_dir_all(parent).map_err(|error| format!("package folder failed: {error}"))?;
+        }
+        file.seek(SeekFrom::Start(local)).map_err(|error| format!("package seek failed: {error}"))?;
+        let mut local_header = [0u8; 30];
+        file.read_exact(&mut local_header).map_err(|error| format!("package header failed: {error}"))?;
+        let local_name = u16::from_le_bytes([local_header[26], local_header[27]]) as usize;
+        let local_extra = u16::from_le_bytes([local_header[28], local_header[29]]) as usize;
+        file.seek(SeekFrom::Current((local_name + local_extra) as i64))
+            .map_err(|error| format!("package seek failed: {error}"))?;
+        let mut body = (&mut file).take(compressed);
+        let mut written = std::fs::File::create(&target).map_err(|error| format!("package write failed: {error}"))?;
+        match method {
+            0 => {
+                let copied = std::io::copy(&mut body, &mut written).map_err(|error| format!("package copy failed: {error}"))?;
+                if copied != compressed {
+                    return Err(format!("the package entry {name} is truncated"));
+                }
+            }
+            8 => {
+                let mut inflate = flate2::read::DeflateDecoder::new(body);
+                let copied = std::io::copy(&mut inflate, &mut written).map_err(|error| format!("package inflate failed: {error}"))?;
+                if uncompressed != SATURATED && copied != u64::from(uncompressed) {
+                    return Err(format!("the package entry {name} is truncated"));
+                }
+            }
+            _ => return Err(format!("a package entry uses compression {method}, which is not supported")),
+        }
+        written.flush().ok();
+    }
+    Ok(())
+}
+
+/// The end record of the ZIP64 archive that precedes the ordinary one.
+fn zip64(file: &mut std::fs::File, length: u64, buffer: &[u8], end: usize) -> Result<(u64, u64), String> {
+    let locator = buffer[..end]
+        .windows(ZIP64_LOCATOR.len())
+        .rposition(|window| window == ZIP64_LOCATOR)
+        .ok_or("the package names a wide directory with no locator")?;
+    if locator + 20 > buffer.len() {
+        return Err("the package locator is truncated".into());
+    }
+    let at = u64::from_le_bytes(buffer[locator + 8..locator + 16].try_into().map_err(|_| "unreadable locator")?);
+    if at + 56 > length {
+        return Err(format!("the package names a wide end record past the archive at {at} of {length}"));
+    }
+    file.seek(SeekFrom::Start(at)).map_err(|error| format!("package seek failed: {error}"))?;
+    let mut record = [0u8; 56];
+    file.read_exact(&mut record).map_err(|error| format!("package end record failed: {error}"))?;
+    if &record[0..4] != ZIP64_END {
+        return Err("the package wide end record is malformed".into());
+    }
+    let entries = u64::from_le_bytes(record[32..40].try_into().map_err(|_| "unreadable entry count")?);
+    let offset = u64::from_le_bytes(record[48..56].try_into().map_err(|_| "unreadable directory offset")?);
+    Ok((entries, offset))
+}
+
+/// The compressed size and local header offset a ZIP64 entry keeps in its extra,
+/// in the order the format wrote them: only the fields that were saturated.
+fn zip64_entry(extra: &[u8], has_size: bool, has_compressed: bool, has_local: bool) -> Wide {
+    let mut wide = Wide::default();
+    let mut at = 0;
+    while at + 4 <= extra.len() {
+        let id = u16::from_le_bytes([extra[at], extra[at + 1]]);
+        let size = u16::from_le_bytes([extra[at + 2], extra[at + 3]]) as usize;
+        let body = at + 4;
+        if body + size > extra.len() {
+            break;
+        }
+        if id == 0x0001 {
+            let fields = &extra[body..body + size];
+            let mut cursor = 0usize;
+            let mut take = |present: bool| -> Option<u64> {
+                if !present || cursor + 8 > fields.len() {
+                    return None;
+                }
+                let value = u64::from_le_bytes(fields[cursor..cursor + 8].try_into().ok()?);
+                cursor += 8;
+                Some(value)
+            };
+            take(has_size);
+            wide.compressed = take(has_compressed);
+            wide.local = take(has_local);
+            return wide;
+        }
+        at = body + size;
+    }
+    wide
+}
+
+#[derive(Default)]
+struct Wide {
+    compressed: Option<u64>,
+    local: Option<u64>,
+}
+
+/// The entry's relative path, or nothing when it would land outside the folder.
+fn safe(name: &str) -> Option<std::path::PathBuf> {
+    let mut parts = Vec::new();
+    for part in name.split('/') {
+        if part.is_empty() || part == "." {
+            continue;
+        }
+        if part == ".." || part.contains('\\') || part.contains(':') {
+            return None;
+        }
+        parts.push(part);
+    }
+    if parts.is_empty() { None } else { Some(parts.iter().collect()) }
+}
