+const PLAIN_LIMIT: u64 = 1 << 30;
+
+const PENDING: &str = ".pending";
+
+fn publish(staging: &Path, out: &Path) -> Result<(), String> {
+    let previous = out.join(".xodus-plain-previous");
+    if previous.join(PENDING).exists() {
+        restore(&previous, out).map_err(|error| format!("an earlier replacement could not be undone: {error}"))?;
+    } else if previous.exists() && std::fs::remove_dir_all(&previous).is_err() {
+        let stale = out.join(format!(".xodus-plain-stale-{}", std::process::id()));
+        std::fs::rename(&previous, &stale).map_err(|error| format!("an earlier replacement left files behind: {error}"))?;
+    }
+    std::fs::create_dir_all(&previous).map_err(|error| format!("could not prepare the replacement: {error}"))?;
+    std::fs::write(previous.join(PENDING), b"").map_err(|error| format!("could not prepare the replacement: {error}"))?;
+    let mut names: Vec<std::ffi::OsString> = std::fs::read_dir(staging)
+        .map_err(|error| format!("staged package unreadable: {error}"))?
+        .map(|entry| entry.map(|entry| entry.file_name()))
+        .collect::<Result<_, _>>()
+        .map_err(|error| format!("staged package unreadable: {error}"))?;
+    names.retain(|name| name != PENDING);
+    names.sort();
+    let mut placed = Vec::new();
+    let result = (|| {
+        for name in &names {
+            let target = out.join(name);
+            if std::fs::symlink_metadata(&target).is_ok() {
+                std::fs::rename(&target, previous.join(name))
+                    .map_err(|error| format!("could not replace {}: {error}", target.display()))?;
+            }
+            std::fs::rename(staging.join(name), &target)
+                .map_err(|error| format!("could not place {}: {error}", target.display()))?;
+            placed.push(name.clone());
+        }
+        Ok::<(), String>(())
+    })();
+    match result {
+        Ok(()) => release(&previous),
+        Err(error) => {
+            let stuck: Vec<String> = placed
+                .iter()
+                .filter(|name| remove(&out.join(name)).is_err())
+                .map(|name| name.to_string_lossy().into_owned())
+                .collect();
+            if !stuck.is_empty() {
+                let listed = std::fs::write(previous.join(PENDING), stuck.join("
+"));
+                let names = stuck.join(", ");
+                return Err(match listed {
+                    Ok(()) => format!("{error}; {names} could not be removed, the previous files are kept in {}", previous.display()),
+                    Err(write) => format!("{error}; {names} could not be removed and could not be recorded ({write})"),
+                });
+            }
+            match restore(&previous, out) {
+                Ok(()) => Err(error),
+                Err(undo) => Err(format!("{error}; the previous files are kept in {} ({undo})", previous.display())),
+            }
+        }
+    }
+}
+
+/// Moves every entry kept in `previous` back into `out`, then removes `previous`.
+/// On any failure `previous` stays, holding what has not been put back.
+fn release(previous: &Path) -> Result<(), String> {
+    std::fs::remove_file(previous.join(PENDING))
+        .map_err(|error| format!("the replacement finished but its backup could not be released: {error}"))?;
+    std::fs::remove_dir_all(previous).ok();
+    Ok(())
+}
+
+fn restore(previous: &Path, out: &Path) -> Result<(), String> {
+    restore_with(previous, out, &mut |from, to| std::fs::rename(from, to))
+}
+
+fn restore_with(
+    previous: &Path,
+    out: &Path,
+    move_entry: &mut dyn FnMut(&Path, &Path) -> std::io::Result<()>,
+) -> Result<(), String> {
+    let placed = std::fs::read_to_string(previous.join(PENDING)).map_err(|error| error.to_string())?;
+    for name in placed.lines().filter(|name| !name.is_empty() && !name.contains(['/', '\\']) && *name != "." && *name != "..") {
+        let target = out.join(name);
+        if std::fs::symlink_metadata(&target).is_ok() {
+            remove(&target).map_err(|error| format!("could not clear {}: {error}", target.display()))?;
+        }
+    }
+    if !placed.is_empty() {
+        std::fs::write(previous.join(PENDING), b"").map_err(|error| error.to_string())?;
+    }
+    let entries = std::fs::read_dir(previous).map_err(|error| error.to_string())?;
+    for entry in entries {
+        let entry = entry.map_err(|error| error.to_string())?;
+        if entry.file_name() == PENDING {
+            continue;
+        }
+        let target = out.join(entry.file_name());
+        if std::fs::symlink_metadata(&target).is_ok() {
+            remove(&target).map_err(|error| format!("could not clear {}: {error}", target.display()))?;
+        }
+        move_entry(&entry.path(), &target).map_err(|error| format!("could not restore {}: {error}", target.display()))?;
+    }
+    std::fs::remove_file(previous.join(PENDING)).map_err(|error| error.to_string())?;
+    std::fs::remove_dir(previous).map_err(|error| error.to_string())
+}
+
+fn remove(path: &Path) -> std::io::Result<()> {
+    if std::fs::symlink_metadata(path)?.is_dir() { std::fs::remove_dir_all(path) } else { std::fs::remove_file(path) }
+}
+
+async fn plain_package<R: AsyncRead + Unpin>(mut remote: R, length: u64, out: &Path) -> ExitCode {
+    if length > PLAIN_LIMIT {
+        eprintln!("NEXUS_TRANSFER_DIAGNOSTIC_V1 plain-package-too-large 0");
+        eprintln!("This package is a plain archive larger than this installer unpacks.");
+        return ExitCode::FAILURE;
+    }
+    let archive = out.join(".xodus-plain-package.zip");
+    let written = async {
+        let mut file = File::create(&archive).await?;
+        let copied = tokio::io::copy(&mut remote, &mut file).await?;
+        tokio::io::AsyncWriteExt::flush(&mut file).await?;
+        Ok::<u64, std::io::Error>(copied)
+    }
+    .await;
+    match written {
+        Ok(copied) if copied == length => {}
+        Ok(_) => {
+            std::fs::remove_file(&archive).ok();
+            eprintln!("NEXUS_TRANSFER_DIAGNOSTIC_V1 transfer-short 0");
+            eprintln!("The package ended early. Retry this installation to obtain a fresh package link.");
+            return ExitCode::FAILURE;
+        }
+        Err(error) => {
+            std::fs::remove_file(&archive).ok();
+            failure::report(&error);
+            return ExitCode::FAILURE;
+        }
+    }
+    let staging = out.join(".xodus-plain-staging");
+    std::fs::remove_dir_all(&staging).ok();
+    let unpacked = crate::commands::unzip::extract(&archive, &staging).and_then(|()| publish(&staging, out));
+    std::fs::remove_file(&archive).ok();
+    std::fs::remove_dir_all(&staging).ok();
+    match unpacked {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("NEXUS_TRANSFER_DIAGNOSTIC_V1 plain-package-invalid 0");
+            eprintln!("Could not unpack the package: {error}");
+            ExitCode::FAILURE
+        }
+    }
+}
