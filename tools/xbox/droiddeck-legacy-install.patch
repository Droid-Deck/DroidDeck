+    let refused = serde_json::to_vec(&json!({"code":"BadRequest","innererror":{"faultcode":3043,"code":"DeviceNameNotHexBinary","message":"private"}})).unwrap();
+    let other = serde_json::to_vec(&json!({"code":"BadRequest","innererror":{"code":"Other"}})).unwrap();
+    let mut oversized = refused.clone();
+    oversized.splice(1..1, std::iter::repeat_n(b' ', 70 * 1024));
+    for (body, expected) in [(refused, "content-device-name"), (other, "content-http"), (b"not json".to_vec(), "content-http"), (oversized, "content-http")] {
+        let (url, server) = server(format!("HTTP/1.1 400 Fixture\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", body.len()), body).await;
+        let error = fetch(reqwest::Client::new().get(url)).await.err().unwrap();
+        assert_eq!(error.stage(), expected);
+        assert!(!error.to_string().contains("private"));
+        server.await.unwrap();
+    }
