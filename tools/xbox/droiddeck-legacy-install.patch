+//! Installs a legacy Store title: resolve, license, download, extract.
+//!
+//! `streaming` only understands MSIXVC, where the container *is* the game and
+//! the bytes arrive in the block layout the runtime reads. A legacy title ships
+//! as an EAppx bundle instead, so its bytes have to be fetched whole, licensed
+//! and decrypted before anything is launchable.
+//!
+//! Two delivery routes exist and both are needed in practice: the Xbox content
+//! service serves MSIXVC and some legacy packages, and Windows Update serves the
+//! legacy desktop bundles it refuses (see `store_delivery`). Each is tried in
+//! turn and whichever names a container is used.
+//!
+//! The three verbs under that (`license`, `download`, `extract-eappx`) are chained
+//! here rather than from the app because each process would restart the progress
+//! sequence, and the installer requires it to increase within one stream.
+
+use std::path::{Path, PathBuf};
+use std::process::ExitCode;
+use std::time::{Duration, Instant};
+
+use futures_util::StreamExt;
+use tokio::io::AsyncWriteExt;
+use xodus::tokens::TokenManager;
+
+/// Downloaded containers live here until extraction succeeds. They are large and
+/// useless afterwards, so they are removed on success and kept on failure.
+const CONTAINER_DIR: &str = ".xodus-container";
+/// Content keys for the containers above, removed alongside them.
+const KEYS_DIR: &str = ".xodus-keys";
+/// The manifest the launcher resolves executables against, expected at the root.
+const MANIFEST: &str = "MicrosoftGame.config";
+/// A legacy package carries this instead of the config above.
+const LEGACY_MANIFEST: &str = "AppxManifest.xml";
+/// Framework packages unpack here, and their libraries are copied up beside the title.
+const FRAMEWORK_DIR: &str = ".droiddeck-frameworks";
+/// Marks a framework whose libraries are already beside the title.
+const INSTALLED: &str = ".installed";
+/// The libraries `copy_libraries` put beside the title, one name per line.
+const COPIED: &str = ".droiddeck-copied";
+
+fn is_legacy_name(name: &str) -> bool {
+    let name = name.to_ascii_lowercase();
+    name.ends_with(".eappx") || name.ends_with(".eappxbundle")
+}
+
+/// Free bytes on the filesystem holding `path`, or `None` when it cannot be read.
+///
+/// The install runs inside the device's own Linux environment, where `df -P -k` is
+/// the one portable free-space query that needs no extra crate, and a failed read
+/// only skips the check rather than blocking a valid install.
+fn free_bytes(path: &Path) -> Option<u64> {
+    let output = std::process::Command::new("df").arg("-kP").arg(path).output().ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    let text = String::from_utf8_lossy(&output.stdout);
+    let available = text.lines().nth(1)?.split_whitespace().nth(3)?;
+    available.parse::<u64>().ok().map(|kib| kib.saturating_mul(1024))
+}
+
+/// Reports why the install stopped without disclosing anything sensitive.
+///
+/// The app only forwards stderr lines that are on a known allowlist, so a bare
+/// message is invisible there. Two lines are emitted instead: a stable stage code,
+/// and the message reduced to lowercase words with every token that could carry a
+/// path, URL or identifier dropped.
+fn fail(code: &str, message: &str) -> ExitCode {
+    eprintln!("NEXUS_LEGACY_INSTALL_DIAGNOSTIC_V1 {code}");
+    let detail = plain(message);
+    if !detail.is_empty() {
+        eprintln!("NEXUS_LEGACY_INSTALL_DETAIL_V1 {detail}");
+    }
+    eprintln!("{message}");
+    ExitCode::FAILURE
+}
+
+/// The message reduced to whatever can be shown over a diagnostic line.
+fn plain(message: &str) -> String {
+    let mut detail = String::new();
+    for word in message.split_whitespace() {
+        if word.contains('/') || word.contains(':') || word.contains('\\') {
+            continue;
+        }
+        let cleaned: String = word
+            .chars()
+            .filter(|c| c.is_ascii_alphanumeric() || *c == '-' || *c == '.')
+            .collect::<String>()
+            .to_ascii_lowercase();
+        if cleaned.is_empty() {
+            continue;
+        }
+        if !detail.is_empty() {
+            detail.push(' ');
+        }
+        detail.push_str(&cleaned);
+        if detail.len() >= 200 {
+            break;
+        }
+    }
+    detail
+}
+
+/// `plain` for callers outside this file.
+pub(crate) fn plain_for_log(message: &str) -> String {
+    plain(message)
+}
+
+/// The installer parses this and only this, so it must match the streaming
+/// schema exactly; `phase` drives its stage display.
+struct Progress {
+    json: bool,
+    sequence: u64,
+    phase: &'static str,
+    completed: u64,
+    total: Option<u64>,
+    previous: u64,
+    last: Instant,
+}
+
+impl Progress {
+    fn new(json: bool) -> Self {
+        let mut progress = Self {
+            json,
+            sequence: 0,
+            phase: "metadata",
+            completed: 0,
+            total: None,
+            previous: 0,
+            last: Instant::now(),
+        };
+        progress.emit();
+        progress
+    }
+
+    fn total(&mut self, total: u64) {
+        self.total = Some(total);
+        self.emit();
+    }
+
+    /// Stage transitions are always reported; byte updates are rate limited so a
+    /// multi-gigabyte download cannot flood the pipe.
+    fn phase(&mut self, phase: &'static str) {
+        self.phase = phase;
+        self.completed = 0;
+        self.previous = 0;
+        self.emit();
+    }
+
+    fn advance(&mut self, delta: u64) {
+        self.completed = self.completed.saturating_add(delta);
+        if self.last.elapsed() >= Duration::from_millis(200) {
+            self.emit();
+        }
+    }
+
+    /// Reports unpacking, which counts bytes neither the download nor a file list
+    /// can see, so the bar advances while a multi-gigabyte member is decrypted.
+    fn bytes(&mut self, completed: u64, total: u64) {
+        self.phase = "installing";
+        self.completed = completed;
+        self.total = Some(total);
+        if self.last.elapsed() >= Duration::from_millis(700) {
+            self.emit();
+        }
+    }
+
+    fn complete(&mut self, success: bool) {
+        self.phase = if success { "complete" } else { "failed" };
+        self.emit();
+    }
+
+    fn emit(&mut self) {
+        let elapsed = self.last.elapsed();
+        let rate = (self.completed.saturating_sub(self.previous) as f64 / elapsed.as_secs_f64().max(0.001)) as u64;
+        self.previous = self.completed;
+        self.last = Instant::now();
+        if self.json {
+            let record = serde_json::json!({
+                "schema": 1,
+                "event": "progress",
+                "sequence": self.sequence,
+                "phase": self.phase,
+                "paused": false,
+                "canPause": false,
+                "completedBytes": self.completed,
+                "totalBytes": self.total,
+                "bytesPerSecond": rate,
+            });
+            println!("NEXUS_PROGRESS {record}");
+        } else {
+            match self.total {
+                Some(total) => println!("{}: {}/{} bytes", self.phase, self.completed, total),
+                None => println!("{}: {} bytes", self.phase, self.completed),
+            }
+        }
+        self.sequence += 1;
+    }
+}
+
+/// A container to fetch, wherever its location came from.
+struct Container {
+    name: String,
+    url: String,
+    size: u64,
+}
+
+/// What to install and which content id its keys are licensed under.
+struct Install {
+    content_id: String,
+    containers: Vec<Container>,
+    /// Why the other route was not used, for the failure message.
+    note: String,
+}
+
+/// Resolves the legacy containers the Xbox content service is willing to serve.
+///
+/// Every legacy-format member of the offer is tried, because a product can carry
+/// more than one content id and only some of them are served files. Measured on
+/// FH4: the desktop EAppxBundle is acknowledged with an empty file list while the
+/// console XVC of the same product is served normally, so the empty answer is
+/// reported as such rather than as a title that is not owned.
+async fn from_xbox_service(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    product: &str,
+    market: &str,
+    preferred: Option<&str>,
+) -> Result<Install, String> {
+    let region = market.to_uppercase();
+    let mut candidates: Vec<String> = Vec::new();
+    if let Some(preferred) = preferred.filter(|id| uuid::Uuid::try_parse(id).is_ok()) {
+        candidates.push(preferred.to_string());
+    } else if uuid::Uuid::try_parse(product).is_ok() {
+        candidates.push(product.to_string());
+    } else {
+        let plan = crate::package_plan::resolve(client, &product.to_uppercase(), &region)
+            .await
+            .map_err(|error| format!("resolve {error}"))?;
+        for choice in &plan.choices {
+            let legacy_format = choice.format == "EAPPX" || choice.format == "EAPPXBUNDLE";
+            if legacy_format && !candidates.contains(&choice.content_id) {
+                candidates.push(choice.content_id.clone());
+            }
+        }
+        // The catalogue names the package a listing shows, which need not be the
+        // container the content service hands over, so the resolver's own choice
+        // is asked first and the rest of the offer is only a fallback.
+        if let Ok(pick) = plan.without_durable_selection().select(None) {
+            candidates.retain(|candidate| *candidate != pick);
+            candidates.insert(0, pick);
+        }
+    }
+    if candidates.is_empty() {
+        return Err("the Store offer names no legacy package".into());
+    }
+
+    let mut probe: Vec<String> = Vec::new();
+    for (index, candidate) in candidates.iter().take(4).enumerate() {
+        match crate::package::get_packages(client, tokens, candidate.clone()).await {
+            Ok(package) => {
+                let legacy: Vec<_> = package
+                    .package_files
+                    .iter()
+                    .filter(|file| is_legacy_name(&file.file_name))
+                    .collect();
+                probe.push(format!("c{index} n{} l{}", package.package_files.len(), legacy.len()));
+                if legacy.is_empty() {
+                    continue;
+                }
+                let mut containers = Vec::new();
+                for file in legacy {
+                    let Some(root) = file.cdn_root_paths.first() else {
+                        return Err("a package file has no download location".into());
+                    };
+                    containers.push(Container {
+                        name: file.file_name.clone(),
+                        url: format!("{root}{}", file.relative_url),
+                        size: file.file_size.max(0) as u64,
+                    });
+                }
+                return Ok(Install { content_id: candidate.clone(), containers, note: probe.join(" ") });
+            }
+            Err(error) => probe.push(format!("c{index} {error}")),
+        }
+    }
+    Err(format!("{} candidates, {}", candidates.len(), probe.join(" ")))
+}
+
+pub async fn run(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    product: String,
+    destination: String,
+    market: Option<String>,
+    selected_content_id: Option<String>,
+    progress_json: bool,
+    resolve_only: bool,
+) -> ExitCode {
+    let destination = PathBuf::from(destination);
+    if let Err(error) = tokio::fs::create_dir_all(&destination).await {
+        return fail("destination-failed", &format!("Could not prepare the install folder: {error}"));
+    }
+    let mut progress = Progress::new(progress_json);
+    let region = market.clone().unwrap_or("US".into()).to_uppercase();
+
+    // One client covers both routes: a package the content service serves is also
+    // downloaded from a delivery host, so both download and update calls use it.
+    let delivery_client = match crate::commands::store_delivery::client() {
+        Ok(client) => client,
+        Err(error) => return fail("update-client-failed", &error),
+    };
+    let install = match from_xbox_service(client, tokens, &product, &region, selected_content_id.as_deref()).await {
+        Ok(install) => install,
+        Err(xbox_error) => {
+            // The content service does not serve legacy desktop bundles, so the
+            // Windows Update route is the one that has to work.
+            match crate::commands::store_delivery::resolve(&delivery_client, &product, &region).await {
+                Ok(delivery) => Install {
+                    content_id: delivery.content_id,
+                    containers: delivery
+                        .files
+                        .into_iter()
+                        .map(|file| Container { name: file.name, url: file.url, size: file.size })
+                        .collect(),
+                    note: "windows-update".into(),
+                },
+                Err(update_error) => {
+                    return fail(
+                        "no-container",
+                        &format!("{xbox_error}; windows update: {update_error}"),
+                    )
+                }
+            }
+        }
+    };
+    if install.containers.is_empty() {
+        return fail("no-container", "No package files were listed for this title");
+    }
+    let total: u64 = install.containers.iter().map(|container| container.size).sum();
+    let largest = install.containers.iter().map(|container| container.size).max().unwrap_or(0);
+    progress.total(total);
+    if resolve_only {
+        // Printing locations is what makes a failure diagnosable without spending
+        // hours on a download, so this stops before any byte is written.
+        println!("content-id: {} ({})", install.content_id, install.note);
+        for container in &install.containers {
+            println!("{} {} {}", container.size, container.name, container.url);
+        }
+        return ExitCode::SUCCESS;
+    }
+    let mut held = 0u64;
+    for container in &install.containers {
+        let Some(name) = Path::new(&container.name).file_name() else { continue };
+        let staged = destination.join(CONTAINER_DIR).join(name);
+        if let Ok(meta) = std::fs::metadata(&staged) {
+            if container.size > 0 && meta.len() == container.size {
+                held = held.saturating_add(meta.len());
+            } else {
+                std::fs::remove_file(&staged).ok();
+            }
+        }
+    }
+    if let Some(free) = free_bytes(&destination) {
+        let needed = total.saturating_add(largest).saturating_add(largest / 10);
+        if free.saturating_add(held) < needed {
+            return fail(
+                "insufficient-space",
+                &format!(
+                    "An install this size needs about {} GB free to unpack, and {} GB is available",
+                    needed / 1_000_000_000,
+                    free.saturating_add(held) / 1_000_000_000
+                ),
+            );
+        }
+    }
+
+    // The license verb already writes the [Keys] text eappx reads, so reuse it
+    // rather than re-deriving the content keys here.
+    let keys = destination.join(KEYS_DIR);
+    if let Err(error) = tokio::fs::create_dir_all(&keys).await {
+        return fail("keys-folder-failed", &format!("Could not prepare the key folder: {error}"));
+    }
+    // The standalone verb defaults to "neutral" and that is the market this path
+    // was proven against, so default the same way rather than forwarding a
+    // region the license service may not accept.
+    let license_market = market.clone().unwrap_or("neutral".into());
+    let licensed = crate::commands::license::run(
+        client,
+        tokens,
+        install.content_id.clone(),
+        license_market,
+        keys.display().to_string(),
+    )
+    .await;
+    if licensed != ExitCode::SUCCESS {
+        return fail("license-failed", &format!("No license for content {} ({})", install.content_id, install.note));
+    }
+    let key_file = keys.join("eappx-keys.txt");
+    if !key_file.is_file() {
+        return fail("no-keys", "The license contained no content keys for this title");
+    }
+
+    let store = destination.join(CONTAINER_DIR);
+    if let Err(error) = tokio::fs::create_dir_all(&store).await {
+        return fail("staging-folder-failed", &format!("Could not prepare the staging folder: {error}"));
+    }
+    progress.phase("downloading");
+    let mut downloaded: Vec<PathBuf> = Vec::new();
+    for container in &install.containers {
+        // Only the container's own name is used, never a server-provided path.
+        let Some(name) = Path::new(&container.name).file_name() else {
+            return fail("unusable-name", "Microsoft returned an unusable package name");
+        };
+        let target = store.join(name);
+        // A container a stopped attempt finished is not fetched again: it is most
+        // of an install this size, and the failure that stopped the run was almost
+        // never in its bytes.
+        if let Ok(meta) = tokio::fs::metadata(&target).await {
+            if container.size > 0 && meta.len() == container.size {
+                progress.advance(meta.len());
+                downloaded.push(target);
+                continue;
+            }
+        }
+        let response = match delivery_client.get(&container.url).send().await {
+            Ok(response) => response,
+            Err(_) => return fail("download-request-failed", "Could not reach the download server"),
+        };
+        if !response.status().is_success() {
+            return fail(
+                &format!("download-refused-{}", response.status().as_u16()),
+                "The download server refused this package",
+            );
+        }
+        let mut file = match tokio::fs::File::create(&target).await {
+            Ok(file) => file,
+            Err(error) => return fail("download-write-failed", &format!("Could not write the package: {error}")),
+        };
+        let mut stream = response.bytes_stream();
+        while let Some(chunk) = stream.next().await {
+            let Ok(chunk) = chunk else {
+                return fail("download-interrupted", "The transfer was interrupted; resume to retry");
+            };
+            if let Err(error) = file.write_all(&chunk).await {
+                return fail("download-write-failed", &format!("Could not write the package: {error}"));
+            }
+            progress.advance(chunk.len() as u64);
+        }
+        if let Err(error) = file.flush().await {
+            return fail("download-flush-failed", &format!("Could not finish writing the package: {error}"));
+        }
+        downloaded.push(target);
+    }
+
+    progress.phase("installing");
+    let key_file_text = key_file.display().to_string();
+    let meter = std::sync::Arc::new(crate::commands::extract_eappx::Meter::default());
+    // Taken before the first byte is written, so growth of the folder is the
+    // progress of the unpack and not the container that was already downloaded.
+    let baseline = crate::commands::extract_eappx::tree_size(&destination);
+    let mut high = 0u64;
+    for container in &downloaded {
+        let source = container.display().to_string();
+        // Unpacking never yields, so it runs on a blocking thread and this task
+        // reports the counter while it works. Without that, the phase would only
+        // be visible once it had finished.
+        let unpacking = tokio::task::spawn_blocking({
+            let destination = destination.clone();
+            let key_file_text = key_file_text.clone();
+            let meter = meter.clone();
+            move || {
+                crate::commands::extract_eappx::run_blocking(
+                    source,
+                    destination.display().to_string(),
+                    Some(key_file_text),
+                    Some(&meter),
+                    // A full title is tens of gigabytes. Holding the container
+                    // while its members are decrypted can fill the device.
+                    true,
+                )
+            }
+        });
+        let extracted = loop {
+            if unpacking.is_finished() {
+                break unpacking.await.unwrap_or(ExitCode::FAILURE);
+            }
+            tokio::time::sleep(Duration::from_millis(700)).await;
+            let total = meter.all();
+            if total == 0 {
+                continue;
+            }
+            let mut done = meter.done();
+            // A bundle member is one file, so its bytes are only visible on disk.
+            if meter.written.load(std::sync::atomic::Ordering::Relaxed) == 0 {
+                let on_disk = crate::commands::extract_eappx::tree_size(&destination).saturating_sub(baseline);
+                done = done.max(on_disk);
+            }
+            // Deleting the container takes bytes off the disk, so the reported
+            // figure only ever moves forward.
+            high = high.max(done.min(total));
+            progress.bytes(high, total);
+        };
+        if extracted != ExitCode::SUCCESS {
+            return fail("extract-failed", "Could not unpack the package; the download is kept for a retry");
+        }
+        // Drop each container as soon as it is unpacked: a full title is tens of
+        // gigabytes, and holding the archive and its contents at once can fill
+        // the device mid-install.
+        tokio::fs::remove_file(container).await.ok();
+    }
+
+    // A bundle extracts each member into its own directory, so the manifest ends
+    // up one level down. The launcher resolves executables relative to the game
+    // folder and requires the manifest at its root, so lift a lone member up.
+    if let Err(error) = hoist(&destination) {
+        return fail("hoist-failed", &error);
+    }
+
+    tokio::fs::remove_dir_all(&store).await.ok();
+
+    // An installed package gets its frameworks from the package graph. Nothing
+    // puts them there for an unpacked folder, and a title that needs one refuses
+    // to load without it, so they are fetched and unpacked beside the title.
+    progress.phase("frameworks");
+    if let Err(error) = ensure_frameworks(&delivery_client, &destination, &region).await {
+        progress.phase("frameworks");
+        eprintln!("NEXUS_LEGACY_INSTALL_DETAIL_V1 dependency skipped: {}", plain(&error));
+    }
+
+    tokio::fs::remove_dir_all(&keys).await.ok();
+    progress.complete(true);
+    ExitCode::SUCCESS
+}
+
+/// Installs every framework the title declares that is not there yet.
+///
+/// Reports the first failure rather than stopping: a title whose framework is
+/// missing still installs, and the launch tries again.
+pub(crate) async fn ensure_frameworks(
+    delivery: &reqwest::Client,
+    destination: &Path,
+    region: &str,
+) -> Result<(), String> {
+    let mut failure = None;
+    for dependency in dependencies(destination) {
+        let marker = destination.join(FRAMEWORK_DIR).join(&dependency).join(INSTALLED);
+        if marker.is_file() {
+            continue;
+        }
+        match install_framework(delivery, destination, &dependency, region).await {
+            Ok(()) => eprintln!("NEXUS_LEGACY_INSTALL_DETAIL_V1 framework {dependency} installed"),
+            Err(error) => {
+                eprintln!("NEXUS_LEGACY_INSTALL_DETAIL_V1 framework {dependency} skipped {}", plain(&error));
+                failure.get_or_insert(format!("{dependency}: {error}"));
+            }
+        }
+    }
+    match failure {
+        Some(error) => Err(error),
+        None => Ok(()),
+    }
+}
+/// Framework packages the manifest asks for, in declaration order.
+///
+/// Reading the attribute rather than parsing XML keeps this off a new dependency;
+/// the manifest is small and the element has one shape.
+pub(crate) fn dependencies(destination: &Path) -> Vec<String> {
+    let Some(manifest) = [LEGACY_MANIFEST, MANIFEST]
+        .iter()
+        .map(|name| destination.join(name))
+        .find(|path| path.is_file())
+    else {
+        return Vec::new();
+    };
+    let Ok(text) = std::fs::read_to_string(manifest) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = Vec::new();
+    for chunk in text.split("<PackageDependency").skip(1) {
+        let Some(tag) = chunk.split('>').next() else { continue };
+        let Some(start) = tag.find("Name=\"") else { continue };
+        let rest = &tag[start + "Name=\"".len()..];
+        let Some(end) = rest.find('"') else { continue };
+        let name = rest[..end].trim();
+        if !name.is_empty() && !names.iter().any(|seen| seen == name) {
+            names.push(name.to_string());
+        }
+    }
+    names
+}
+
+/// The COM class the manifest names as the application's entry point.
+///
+/// A packaged Win32 program names `Windows.FullTrustApplication` and starts like
+/// any other executable. A UWP application names its own class instead and expects
+/// the app model to create it, which no Win32 loader does.
+pub(crate) fn entry_point(destination: &Path) -> Option<String> {
+    let manifest = [LEGACY_MANIFEST, MANIFEST]
+        .iter()
+        .map(|name| destination.join(name))
+        .find(|path| path.is_file())?;
+    let text = std::fs::read_to_string(manifest).ok()?;
+    let application = text.split("<Application ").nth(1)?;
+    let tag = application.split('>').next()?;
+    let start = tag.find("EntryPoint=\"")? + "EntryPoint=\"".len();
+    let rest = &tag[start..];
+    let end = rest.find('"')?;
+    let entry = rest[..end].trim();
+    (!entry.is_empty()).then(|| entry.to_string())
+}
+
+/// Downloads one framework package and lays its DLLs beside the title.
+///
+/// Windows resolves a packaged title's frameworks through the package graph. An
+/// unpacked folder has no graph, and the loader searches the executable's own
+/// directory, so the framework's libraries go there.
+///
+/// The catalogue names the product but not a package the Xbox Live content
+/// service serves, so the bytes come from the same Windows Update category the
+/// Store client would use, and they arrive as a plain zip rather than EAppx.
+async fn install_framework(
+    delivery: &reqwest::Client,
+    destination: &Path,
+    name: &str,
+    region: &str,
+) -> Result<(), String> {
+    // Framework products from Microsoft publish under this publisher hash; any
+    // other publisher cannot be located by family name alone.
+    let family = format!("{name}_8wekyb3d8bbwe");
+    let lookup = format!(
+        "https://displaycatalog.mp.microsoft.com/v7.0/products/lookup?alternateId=PackageFamilyName&value={family}&market={region}&languages=en-US&fieldsTemplate=Details"
+    );
+    let response = delivery
+        .get(lookup)
+        .timeout(Duration::from_secs(20))
+        .send()
+        .await
+        .map_err(|_| "catalogue unreachable".to_string())?;
+    if !response.status().is_success() {
+        return Err(format!("catalogue answered {}", response.status().as_u16()));
+    }
+    let document: serde_json::Value = response.json().await.map_err(|_| "catalogue answer unreadable".to_string())?;
+    let category = framework_category(&document).ok_or_else(|| "no update category was listed".to_string())?;
+
+    let published = crate::commands::store_delivery::resolve_frameworks(delivery, &category).await?;
+    if published.files.is_empty() {
+        return Err("the category listed no files".to_string());
+    }
+
+    let staging = destination.join(CONTAINER_DIR);
+    tokio::fs::create_dir_all(&staging).await.map_err(|error| format!("staging folder failed: {error}"))?;
+    let unpacked = destination.join(FRAMEWORK_DIR).join(name);
+    if let Some(parent) = unpacked.parent() {
+        tokio::fs::create_dir_all(parent).await.map_err(|error| format!("framework folder failed: {error}"))?;
+    }
+    let trial = staging.join("framework-trial");
+    // The category lists one package per architecture under names that are only
+    // identifiers, so each is unpacked until one declares x64 in its manifest.
+    if unpacked.is_dir() {
+        withdraw_libraries(&unpacked, destination);
+    }
+    let mut reasons: Vec<String> = Vec::new();
+    for file in published.files.iter().take(8) {
+        let Some(file_name) = Path::new(&file.name).file_name() else { continue };
+        let container = staging.join(file_name);
+        let response = match delivery.get(&file.url).send().await {
+            Ok(response) if response.status().is_success() => response,
+            Ok(response) => {
+                reasons.push(format!("file refused with {}", response.status().as_u16()));
+                continue;
+            }
+            Err(_) => {
+                reasons.push("file unreachable".to_string());
+                continue;
+            }
+        };
+        let written = tokio::fs::File::create(&container)
+            .await
+            .map_err(|error| format!("download write failed: {error}"))?;
+        let mut written = written;
+        let mut stream = response.bytes_stream();
+        let mut failed = None;
+        while let Some(chunk) = stream.next().await {
+            match chunk {
+                Ok(chunk) => {
+                    if let Err(error) = written.write_all(&chunk).await {
+                        failed = Some(format!("download write failed: {error}"));
+                        break;
+                    }
+                }
+                Err(_) => {
+                    failed = Some("download interrupted".to_string());
+                    break;
+                }
+            }
+        }
+        written.flush().await.ok();
+        drop(written);
+        if let Some(error) = failed {
+            tokio::fs::remove_file(&container).await.ok();
+            reasons.push(error);
+            continue;
+        }
+
+        let attempt = trial.join("a");
+        tokio::fs::remove_dir_all(&attempt).await.ok();
+        let unpacked_ok = crate::commands::unzip::extract(&container, &attempt);
+        tokio::fs::remove_file(&container).await.ok();
+        if let Err(error) = unpacked_ok {
+            reasons.push(plain(&error));
+            continue;
+        }
+        let Some(chosen) = x64_package(&attempt) else {
+            reasons.push("not x64".to_string());
+            continue;
+        };
+        tokio::fs::remove_dir_all(&unpacked).await.ok();
+        tokio::fs::rename(&chosen, &unpacked).await.map_err(|error| format!("framework move failed: {error}"))?;
+        copy_libraries(&unpacked, destination)?;
+        std::fs::write(unpacked.join(INSTALLED), name.as_bytes()).map_err(|error| format!("framework mark failed: {error}"))?;
+        tokio::fs::remove_dir_all(&trial).await.ok();
+        return Ok(());
+    }
+    tokio::fs::remove_dir_all(&trial).await.ok();
+    Err(plain(&format!("no x64 package among {} listed {}", published.files.len(), reasons.join(" "))))
+}
+
+/// The folder holding the package that declares x64, however deep a bundle wraps it.
+fn x64_package(root: &Path) -> Option<std::path::PathBuf> {
+    let mut level = vec![root.to_path_buf()];
+    for _ in 0..3 {
+        let mut next = Vec::new();
+        for folder in level {
+            let manifest = folder.join(LEGACY_MANIFEST);
+            if manifest.is_file() {
+                let text = std::fs::read_to_string(&manifest).unwrap_or_default().to_ascii_lowercase();
+                if text.contains("processorarchitecture=\"x64\"") {
+                    return Some(folder);
+                }
+            }
+            if let Ok(entries) = std::fs::read_dir(&folder) {
+                next.extend(entries.filter_map(Result::ok).map(|entry| entry.path()).filter(|path| path.is_dir()));
+            }
+        }
+        if next.is_empty() {
+            break;
+        }
+        level = next;
+    }
+    None
+}
+
+/// The Windows Update category of the framework's x64 package, or of whichever
+/// package the product lists first when no package names an architecture.
+fn framework_category(document: &serde_json::Value) -> Option<String> {
+    let mut fallback: Option<String> = None;
+    for product in document["Products"].as_array()? {
+        for sku in product["DisplaySkuAvailabilities"].as_array().into_iter().flatten() {
+            for package in sku["Sku"]["Properties"]["Packages"].as_array().into_iter().flatten() {
+                let Some(category) = package["FulfillmentData"]["WuCategoryId"].as_str() else { continue };
+                if category.is_empty() {
+                    continue;
+                }
+                let x64 = package["Architectures"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .any(|arch| arch.as_str() == Some("x64"));
+                if x64 {
+                    return Some(category.to_string());
+                }
+                fallback.get_or_insert_with(|| category.to_string());
+            }
+        }
+    }
+    fallback
+}
+
+/// Removes the libraries an earlier attempt copied, so a replaced framework does
+/// not leave the old architecture's files beside the title.
+///
+/// Only names this code recorded as copied are removed. A title can ship a DLL of
+/// the same name, and `copy_libraries` leaves such a file alone; deleting by
+/// basename would then remove the title's own library.
+fn withdraw_libraries(from: &Path, to: &Path) {
+    let Ok(list) = std::fs::read_to_string(from.join(COPIED)) else { return };
+    for name in list.lines().filter(|line| !line.trim().is_empty()) {
+        if Path::new(name).components().count() != 1 {
+            continue;
+        }
+        let _ = std::fs::remove_file(to.join(name));
+    }
+}
+
+/// Copies the framework's libraries next to the title, never over its own files,
+/// and records what it copied so a later attempt can take exactly that back.
+fn copy_libraries(from: &Path, to: &Path) -> Result<(), String> {
+    let mut copied: Vec<String> = Vec::new();
+    copy_libraries_into(from, to, &mut copied)?;
+    std::fs::write(from.join(COPIED), copied.join("\n")).map_err(|error| format!("framework copy list failed: {error}"))?;
+    Ok(())
+}
+
+fn copy_libraries_into(from: &Path, to: &Path, copied: &mut Vec<String>) -> Result<(), String> {
+    let entries = std::fs::read_dir(from).map_err(|error| format!("framework read failed: {error}"))?;
+    for entry in entries.filter_map(Result::ok) {
+        let path = entry.path();
+        if path.is_dir() {
+            copy_libraries_into(&path, to, copied)?;
+            continue;
+        }
+        let named = path.extension().is_some_and(|extension| extension.eq_ignore_ascii_case("dll"));
+        if !named {
+            continue;
+        }
+        let Some(file_name) = path.file_name() else { continue };
+        let target = to.join(file_name);
+        if target.exists() {
+            continue;
+        }
+        std::fs::copy(&path, &target).map_err(|error| format!("framework copy failed: {error}"))?;
+        copied.push(file_name.to_string_lossy().into_owned());
+    }
+    Ok(())
+}
+
+fn has_manifest(folder: &Path) -> bool {    std::fs::read_dir(folder).is_ok_and(|entries| {
+        entries.filter_map(Result::ok).any(|entry| {
+            let name = entry.file_name();
+            let named = name.eq_ignore_ascii_case(MANIFEST) || name.eq_ignore_ascii_case(LEGACY_MANIFEST);
+            named && entry.file_type().is_ok_and(|kind| kind.is_file())
+        })
+    })
+}
+
+/// Lifts the contents of a single nested package directory to the game folder.
+/// Add-on content is stored without a manifest, so nothing to lift is not an
+/// error; anything other than exactly one candidate is, because a wrong guess
+/// here would move game files.
+///
+/// An install over a folder that already holds a manifest is an update: the new
+/// package is lifted over the old one file by file, since leaving it nested would
+/// report success while the previous version stayed in place.
+fn hoist(destination: &Path) -> Result<(), String> {
+    let updating = has_manifest(destination);
+    let mut candidates = nested_packages(destination);
+    if candidates.is_empty() {
+        return Ok(());
+    }
+    if candidates.len() != 1 {
+        return Err(format!(
+            "Extraction left {} package folders; expected exactly one",
+            candidates.len()
+        ));
+    }
+    let inner = candidates.remove(0);
+    for entry in std::fs::read_dir(&inner)
+        .map_err(|error| format!("Could not list the package folder: {error}"))?
+        .filter_map(Result::ok)
+    {
+        let target = destination.join(entry.file_name());
+        if target.exists() {
+            if !updating {
+                return Err(format!("Extraction would overwrite {}", target.display()));
+            }
+            let replaced = if target.is_dir() {
+                std::fs::remove_dir_all(&target)
+            } else {
+                std::fs::remove_file(&target)
+            };
+            replaced.map_err(|error| format!("Could not replace an installed file: {error}"))?;
+        }
+        std::fs::rename(entry.path(), &target)
+            .map_err(|error| format!("Could not move an extracted file: {error}"))?;
+    }
+    std::fs::remove_dir(&inner).map_err(|error| format!("Could not remove the package folder: {error}"))?;
+    Ok(())
+}
+
+/// Folders below [root] that carry a manifest, at the depth a nested bundle can
+/// write one. A bundle of a bundle is the deepest the extractor produces.
+fn nested_packages(root: &Path) -> Vec<PathBuf> {
+    let mut found = Vec::new();
+    let mut level = vec![root.to_path_buf()];
+    for _ in 0..3 {
+        let mut next = Vec::new();
+        for folder in level {
+            let Ok(entries) = std::fs::read_dir(&folder) else { continue };
+            for entry in entries.filter_map(Result::ok) {
+                let path = entry.path();
+                if !path.is_dir() || path.ends_with(CONTAINER_DIR) || path.ends_with(KEYS_DIR) || path.ends_with(FRAMEWORK_DIR) {
+                    continue;
+                }
+                if has_manifest(&path) {
+                    found.push(path);
+                } else {
+                    next.push(path);
+                }
+            }
+        }
+        if next.is_empty() {
+            break;
+        }
+        level = next;
+    }
+    found
+}
