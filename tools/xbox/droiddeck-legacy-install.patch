+//! Windows Update delivery for Store packages.
+//!
+//! The Xbox content service (`GetBasePackage`) serves MSIXVC titles but answers a
+//! legacy desktop bundle with `PackageFound: true` and an empty file list, on every
+//! request shape. Measured on Forza Horizon 4: its EAppxBundle (85.2 GB) is never
+//! served that way, while the same product's console XVC is served normally as
+//! `.xsp` chunks.
+//!
+//! Those bytes are delivered through Windows Update instead, which is what the
+//! Store client itself uses for legacy packages and which needs no Xbox Live auth.
+//! Three SOAP calls do it: an anonymous cookie, a sync scoped to the product's
+//! `WuCategoryId`, then a signed URL for each file whose digest matches.
+//!
+//! Two details cost time to learn and are relied on below:
+//!   * the update fragments inside `<Xml>` are escaped twice, so they have to be
+//!     decoded twice before they contain any tags;
+//!   * a file's content digest, not its id, is what ties it to a return URL.
+
+use std::path::Path;
+use std::time::Duration;
+
+/// The service the Store client talks to. `fe3cr` and `fe3` are both live.
+const BASE: &str = "https://fe3cr.delivery.mp.microsoft.com/ClientWebService/client.asmx";
+const SECURED: &str = "https://fe3cr.delivery.mp.microsoft.com/ClientWebService/client.asmx/secured";
+const NAMESPACE: &str = "http://www.microsoft.com/SoftwareDistribution/Server/ClientWebService";
+const AGENT: &str = "Windows-Update-Agent/10.0.10011.16384 Client-Protocol/2.1";
+
+/// The update service is issued from Microsoft's Windows Update PKI, whose root is
+/// distributed by Windows Update itself rather than by Mozilla, so neither this
+/// device's bundle nor a normal Linux install trusts it and every handshake ends
+/// with "unable to get local issuer certificate". Only the roots those hosts chain
+/// to are added, on a client used for this path alone.
+///
+/// `wu-root.pem` is Microsoft ECC Product Root Certificate Authority 2018, fetched
+/// from the issuer URL in the server's own authority-information extension
+/// (`www.microsoft.com/pkiops/certs/...`). Its serial 14982666DC7CCD8F4053677BB999EC85
+/// and SHA-1 06F1AA330B927B753A40E68CDF22E34BCBEF3352 match the copy Windows ships
+/// in its own root store, and 2043-02-27 20:50:46 GMT is its expiry.
+const UPDATE_ROOT: &str = include_str!("wu-root.pem");
+
+/// A client for the update service and its download hosts: the system trust store
+/// plus the one root above.
+pub fn client() -> Result<reqwest::Client, String> {
+    let root = reqwest::Certificate::from_pem(UPDATE_ROOT.as_bytes())
+        .map_err(|error| format!("the pinned update root could not be read: {error}"))?;
+    reqwest::Client::builder()
+        .user_agent(AGENT)
+        .add_root_certificate(root)
+        .build()
+        .map_err(|error| format!("the update client could not be created: {error}"))
+}
+
+/// Timestamps are not validated by the service, so fixed values keep this free of
+/// a date dependency, as the working reference implementations do.
+const CREATED: &str = "2017-08-05T02:03:05.038Z";
+const EXPIRES: &str = "2044-08-02T20:09:03Z";
+
+/// The device reports itself as a retail Windows desktop: the catalogue serves the
+/// desktop package for this shape, and `App=WU_STORE` is what exposes app categories.
+const ATTRIBUTES: &str = concat!(
+    "BranchReadinessLevel=CB;CurrentBranch=;OEMModel=Virtual Machine;FlightRing=Retail;",
+    "AttrDataVer=21;SystemManufacturer=Microsoft Corporation;InstallLanguage=en-US;",
+    "OSUILocale=en-US;InstallationType=Client;FlightingBranchName=;",
+    "FirmwareVersion=Hyper-V UEFI Release v2.5;SystemProductName=Virtual Machine;OSSkuId=48;",
+    "FlightContent=Mainline;App=WU_STORE;OEMName_Uncleaned=Microsoft Corporation;",
+    "AppVer=0.0.0.0;OSArchitecture=AMD64;SystemSKU=None;UpdateManagementGroup=2;",
+    "IsFlightingEnabled=0;IsDeviceRetailDemo=0;TelemetryLevel=3;OSVersion=10.0.22621.1;",
+    "DeviceFamily=Windows.Desktop;"
+);
+
+/// Baseline category ids a Windows client always claims to have installed. The
+/// service silently expects them; without them the sync returns no metadata.
+const BASELINE: &[u32] = &[
+    1, 2, 3, 10, 11, 17, 19, 2359974, 2359977, 5143990, 5169043, 5169044, 5169047, 8788830, 8806526,
+    9125350, 9154769, 10809856, 23110993, 23110994, 23110995, 23110996, 23110999, 23111000,
+    23111001, 23111002, 23111003, 23111004, 24513870, 28880263, 30077688, 30486944, 59830006,
+    59830007, 59830008, 60484010, 62450018, 62450019, 62450020, 98959022, 98959023, 98959024,
+    98959025, 98959026, 105939029, 105995585, 106017178, 107825194, 117765322, 129905029,
+    130040030, 130040031, 130040032, 130040033, 133399034, 138372035, 138372036, 139536037,
+    139536038, 139536039, 139536040, 142045136, 158941041, 158941042, 158941043, 158941044,
+    159776047, 160733048, 160733049, 160733050, 160733051, 160733055, 160733056, 161870057,
+    161870058, 161870059,
+];
+
+/// One downloadable package file.
+pub struct DeliveryFile {
+    pub name: String,
+    pub url: String,
+    pub size: u64,
+}
+
+/// A product's installable files, plus the content ids its keys may be licensed
+/// under, best candidate first.
+pub struct Delivery {
+    pub content_ids: Vec<String>,
+    pub files: Vec<DeliveryFile>,
+}
+
+fn unescape(text: &str) -> String {
+    // Fragments are escaped twice, so a single pass leaves `&lt;Files&gt;` behind.
+    let mut current = text.to_string();
+    for _ in 0..3 {
+        let next = current
+            .replace("&lt;", "<")
+            .replace("&gt;", ">")
+            .replace("&quot;", "\"")
+            .replace("&apos;", "'")
+            .replace("&amp;", "&");
+        if next == current {
+            break;
+        }
+        current = next;
+    }
+    current
+}
+
+fn element(text: &str, tag: &str) -> Option<String> {
+    let open = format!("<{tag}>");
+    let close = format!("</{tag}>");
+    let start = text.find(&open)? + open.len();
+    let end = start + text[start..].find(&close)?;
+    Some(text[start..end].to_string())
+}
+
+fn blocks(text: &str, tag: &str) -> Vec<String> {
+    let open = format!("<{tag}>");
+    let close = format!("</{tag}>");
+    let mut found = Vec::new();
+    let mut rest = text;
+    while let Some(start) = rest.find(&open) {
+        let after = start + open.len();
+        let Some(length) = rest[after..].find(&close) else { break };
+        found.push(rest[after..after + length].to_string());
+        rest = &rest[after + length + close.len()..];
+    }
+    found
+}
+
+fn attribute(text: &str, name: &str) -> Option<String> {
+    let needle = format!("{name}=\"");
+    let start = text.find(&needle)? + needle.len();
+    let end = start + text[start..].find('"')?;
+    Some(text[start..end].to_string())
+}
+
+async fn soap(client: &reqwest::Client, url: &str, body: &str) -> Result<String, String> {
+    let response = client
+        .post(url)
+        .header("Content-Type", "application/soap+xml; charset=utf-8")
+        .header("User-Agent", AGENT)
+        .timeout(Duration::from_secs(60))
+        .body(body.to_string())
+        .send()
+        .await
+        .map_err(|error| format!("update service unreachable: {error}"))?;
+    if !response.status().is_success() {
+        return Err(format!("update service returned HTTP {}", response.status().as_u16()));
+    }
+    let text = response.text().await.map_err(|_| "update service reply unreadable".to_string())?;
+    Ok(unescape(&text))
+}
+
+fn envelope(action: &str, to: &str, body: &str) -> String {
+    format!(
+        r#"<s:Envelope xmlns:a="http://www.w3.org/2005/08/addressing" xmlns:s="http://www.w3.org/2003/05/soap-envelope"><s:Header><a:Action s:mustUnderstand="1">http://www.microsoft.com/SoftwareDistribution/Server/ClientWebService/{action}</a:Action><a:MessageID>urn:uuid:{message}</a:MessageID><a:To s:mustUnderstand="1">{to}</a:To><o:Security s:mustUnderstand="1" xmlns:o="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"><Timestamp xmlns="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"><Created>{CREATED}</Created><Expires>{EXPIRES}</Expires></Timestamp><wuws:WindowsUpdateTicketsToken wsu:id="ClientMSA" xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd" xmlns:wuws="http://schemas.microsoft.com/msus/2014/10/WindowsUpdateAuthorization"></wuws:WindowsUpdateTicketsToken></o:Security></s:Header>{body}</s:Envelope>"#,
+        action = action,
+        to = to,
+        message = uuid::Uuid::new_v4(),
+        body = body,
+    )
+}
+
+/// Reads the `WuCategoryId` the catalogue carries for the product's packages.
+async fn category(client: &reqwest::Client, product: &str, market: &str) -> Result<String, String> {
+    let url = format!(
+        "https://displaycatalog.mp.microsoft.com/v7.0/products/{product}?market={market}&languages=en,neutral"
+    );
+    let text = client
+        .get(url)
+        .timeout(Duration::from_secs(30))
+        .send()
+        .await
+        .map_err(|_| "Store metadata request failed".to_string())?
+        .text()
+        .await
+        .map_err(|_| "Store metadata reply unreadable".to_string())?;
+    let start = text
+        .find("\"WuCategoryId\":\"")
+        .ok_or("This product has no Windows Update category, so it has no legacy package")?;
+    let rest = &text[start + "\"WuCategoryId\":\"".len()..];
+    let end = rest.find('"').ok_or("Unreadable Windows Update category")?;
+    Ok(rest[..end].to_string())
+}
+
+async fn cookie(client: &reqwest::Client) -> Result<(String, String), String> {
+    let body = format!(
+        r#"<s:Body><GetCookie xmlns="{NAMESPACE}"><oldCookie><Expiration>2016-07-27T07:18:09Z</Expiration></oldCookie><lastChange>2015-10-21T17:01:07.1472913Z</lastChange><currentTime>{CREATED}</currentTime><protocolVersion>2.50</protocolVersion></GetCookie></s:Body>"#
+    );
+    let reply = soap(client, BASE, &envelope("GetCookie", BASE, &body)).await?;
+    let encrypted = element(&reply, "EncryptedData").ok_or("Update service issued no session cookie")?;
+    let expiration = element(&reply, "Expiration").unwrap_or_else(|| EXPIRES.to_string());
+    Ok((encrypted, expiration))
+}
+
+struct Revision {
+    update_id: String,
+    revision: String,
+    digest: String,
+    name: String,
+    size: u64,
+    /// The content id of the update this file belongs to. A reply can carry
+    /// several updates, and each names its own package, so this has to travel
+    /// with the file rather than be picked once for the whole reply.
+    content_id: String,
+}
+
+/// One packager per file: the revision identity and the digest are what the
+/// download URL is issued against.
+async fn revisions(
+    client: &reqwest::Client,
+    cookie: &str,
+    expiration: &str,
+    content_id: &str,
+) -> Result<Vec<Revision>, String> {
+    let baseline: String = BASELINE.iter().map(|id| format!("<int>{id}</int>")).collect();
+    let body = format!(
+        r#"<s:Body><SyncUpdates xmlns="{NAMESPACE}"><cookie><Expiration>{expiration}</Expiration><EncryptedData>{cookie}</EncryptedData></cookie><parameters><ExpressQuery>false</ExpressQuery><InstalledNonLeafUpdateIDs>{baseline}</InstalledNonLeafUpdateIDs><OtherCachedUpdateIDs></OtherCachedUpdateIDs><SkipSoftwareSync>false</SkipSoftwareSync><NeedTwoGroupOutOfScopeUpdates>true</NeedTwoGroupOutOfScopeUpdates><FilterAppCategoryIds><CategoryIdentifier><Id>{content_id}</Id></CategoryIdentifier></FilterAppCategoryIds><TreatAppCategoryIdsAsInstalled>true</TreatAppCategoryIdsAsInstalled><AlsoPerformRegularSync>false</AlsoPerformRegularSync><ComputerSpec /><ExtendedUpdateInfoParameters><XmlUpdateFragmentTypes><XmlUpdateFragmentType>Extended</XmlUpdateFragmentType></XmlUpdateFragmentTypes><Locales><string>en-US</string><string>en</string></Locales></ExtendedUpdateInfoParameters><ClientPreferredLanguages><string>en-US</string></ClientPreferredLanguages><ProductsParameters><SyncCurrentVersionOnly>false</SyncCurrentVersionOnly><DeviceAttributes>{ATTRIBUTES}</DeviceAttributes><CallerAttributes>Interactive=1;IsSeeker=0;</CallerAttributes><Products /></ProductsParameters></parameters></SyncUpdates></s:Body>"#
+    );
+    let reply = soap(client, BASE, &envelope("SyncUpdates", BASE, &body)).await?;
+
+    let core = blocks(&reply, "UpdateInfo");
+    let extended = blocks(&reply, "ExtendedUpdateInfo");
+    let Some(extended) = extended.first() else {
+        return Err("Update service returned no package metadata for this category".into());
+    };
+    let mut core_by_id: Vec<(String, String)> = Vec::new();
+    for entries in &core {
+        if let (Some(id), Some(xml)) = (element(entries, "ID"), element(entries, "Xml")) {
+            core_by_id.push((id, xml));
+        }
+    }
+
+    let mut found = Vec::new();
+    for entries in blocks(extended, "Update") {
+        let (Some(id), Some(xml)) = (element(&entries, "ID"), element(&entries, "Xml")) else { continue };
+        // The file list lives in one fragment and the identity the URL is issued
+        // against in the other, so both are needed for the same revision.
+        let Some((_, core_xml)) = core_by_id.iter().find(|(key, _)| *key == id) else { continue };
+        let combined = format!("{xml}{core_xml}");
+        if !combined.contains("<Files") || !combined.contains("SecuredFragment") {
+            continue;
+        }
+        let (Some(update_id), Some(revision)) =
+            (attribute(&combined, "UpdateID"), attribute(&combined, "RevisionNumber"))
+        else {
+            continue;
+        };
+        let package_content_id = attribute(&combined, "PackageContentId").unwrap_or_default();
+        for attributes in file_attributes(&combined) {
+            let Some(name) = attribute(&attributes, "FileName") else { continue };
+            // The differential map is not content, and a cab is update plumbing.
+            if attribute(&attributes, "PatchingType").as_deref() == Some("DynamicMetadata")
+                || name.starts_with("Abm_")
+                || name.to_ascii_lowercase().ends_with(".cab")
+            {
+                continue;
+            }
+            // Only EAppx containers can be unpacked and decrypted here. The plain
+            // `.appx` framework packages delivered alongside one are kept out: they
+            // are a different container format and would fail the whole install.
+            let lower = name.to_ascii_lowercase();
+            if !(lower.ends_with(".eappx") || lower.ends_with(".eappxbundle")) {
+                continue;
+            }
+            found.push(Revision {
+                update_id: update_id.clone(),
+                revision: revision.clone(),
+                digest: attribute(&attributes, "Digest").unwrap_or_default(),
+                name,
+                size: attribute(&attributes, "Size").and_then(|size| size.parse().ok()).unwrap_or(0),
+                content_id: package_content_id.clone(),
+            });
+        }
+    }
+    Ok(found)
+}
+
+/// Collects the attribute text of every `<File ... />` node.
+fn file_attributes(text: &str) -> Vec<String> {
+    let mut found = Vec::new();
+    let mut rest = text;
+    while let Some(start) = rest.find("<File ") {
+        let after = &rest[start + "<File ".len()..];
+        let Some(end) = after.find('>') else { break };
+        found.push(after[..end].trim_end_matches('/').to_string());
+        rest = &after[end..];
+    }
+    found
+}
+
+async fn download_url(
+    client: &reqwest::Client,
+    cookie: &str,
+    expiration: &str,
+    revision: &Revision,
+) -> Result<String, String> {
+    let body = format!(
+        r#"<s:Body><GetExtendedUpdateInfo2 xmlns="{NAMESPACE}"><cookie><Expiration>{expiration}</Expiration><EncryptedData>{cookie}</EncryptedData></cookie><updateIDs><UpdateIdentity><UpdateID>{update}</UpdateID><RevisionNumber>{number}</RevisionNumber></UpdateIdentity></updateIDs><infoTypes><XmlUpdateFragmentType>FileUrl</XmlUpdateFragmentType><XmlUpdateFragmentType>FileDecryption</XmlUpdateFragmentType></infoTypes><deviceAttributes>{ATTRIBUTES}</deviceAttributes></GetExtendedUpdateInfo2></s:Body>"#,
+        update = revision.update_id,
+        number = revision.revision
+    );
+    let reply = soap(client, SECURED, &envelope("GetExtendedUpdateInfo2", SECURED, &body)).await?;
+    for location in blocks(&reply, "FileLocation") {
+        if element(&location, "FileDigest").as_deref() != Some(revision.digest.as_str()) {
+            continue;
+        }
+        if let Some(url) = element(&location, "Url") {
+            return Ok(url);
+        }
+    }
+    Err(format!("No download location was issued for {}", revision.name))
+}
+
+/// Resolves the legacy packages of a Store product through Windows Update.
+pub async fn resolve(
+    client: &reqwest::Client,
+    product: &str,
+    market: &str,
+) -> Result<Delivery, String> {
+    let category = category(client, product, market).await?;
+    let (cookie, expiration) = cookie(client).await?;
+    let revisions = revisions(client, &cookie, &expiration, &category).await?;
+    if revisions.is_empty() {
+        return Err("Windows Update lists no package files for this product".into());
+    }
+    let mut files = Vec::new();
+    for revision in &revisions {
+        let url = download_url(client, &cookie, &expiration, revision).await?;
+        files.push(DeliveryFile { name: revision.name.clone(), url, size: revision.size });
+    }
+    // A bundle's own name is its content id, so that update is the one to licence
+    // first: the others in the same reply belong to different packages and the
+    // licence service rejects their ids. Larger files come first after that,
+    // because the base game is what the licence has to unlock.
+    let mut ordered: Vec<&Revision> = revisions.iter().collect();
+    ordered.sort_by_key(|revision| {
+        let own = Path::new(&revision.name)
+            .file_stem()
+            .is_some_and(|stem| stem.to_string_lossy().eq_ignore_ascii_case(&revision.content_id));
+        (std::cmp::Reverse(own), std::cmp::Reverse(revision.size))
+    });
+    let mut content_ids: Vec<String> = Vec::new();
+    for revision in ordered {
+        if !revision.content_id.is_empty() && !content_ids.contains(&revision.content_id) {
+            content_ids.push(revision.content_id.clone());
+        }
+    }
+    if content_ids.is_empty() {
+        return Err("Windows Update did not name the package's content id".into());
+    }
+    Ok(Delivery { content_ids, files })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_pinned_root_is_the_expected_microsoft_update_authority() {
+        // The PEM travels with the patch, so a swapped or truncated file must fail
+        // here rather than silently widening what the update client trusts.
+        assert_eq!(UPDATE_ROOT.matches("BEGIN CERTIFICATE").count(), 1);
+        let der = UPDATE_ROOT
+            .lines()
+            .filter(|line| !line.starts_with("-----"))
+            .collect::<String>();
+        use base64::{Engine, engine::general_purpose::STANDARD};
+        let der = STANDARD.decode(der).expect("the pinned root is not valid base64");
+        assert!(der.len() > 500 && der[0] == 0x30, "the pinned root is not a DER SEQUENCE");
+        // Serial number and subject live verbatim in the DER for this certificate.
+        assert!(der.windows(4).any(|w| w == [0x14, 0x98, 0x26, 0x66]), "unexpected serial");
+        let subject = b"Microsoft ECC Product Root Certificate Authority 2018";
+        assert!(
+            der.windows(subject.len()).any(|window| window == subject),
+            "unexpected subject"
+        );
+        assert!(client().is_ok());
+    }
+
+    #[test]
+    fn fragments_escaped_twice_are_decoded_until_stable() {
+        assert_eq!(unescape("&amp;lt;Files&amp;gt;"), "<Files>");
+        assert_eq!(unescape("&lt;File FileName=&quot;a.eappxbundle&quot;/&gt;"), "<File FileName=\"a.eappxbundle\"/>");
+        assert_eq!(unescape("plain text"), "plain text");
+    }
+
+    #[test]
+    fn self_closing_file_nodes_yield_their_attributes() {
+        let text = r#"<Files><File FileName="x.eappxbundle" Digest="abc" Size="99"/><File FileName="Abm_1.cab" Digest="def"/></Files>"#;
+        let attributes = file_attributes(text);
+        assert_eq!(attributes.len(), 2);
+        assert_eq!(attribute(&attributes[0], "FileName").as_deref(), Some("x.eappxbundle"));
+        assert_eq!(attribute(&attributes[0], "Size").as_deref(), Some("99"));
+        assert_eq!(attribute(&attributes[1], "FileName").as_deref(), Some("Abm_1.cab"));
+    }
+
+    #[test]
+    fn blocks_stop_at_the_matching_close_tag() {
+        let text = "<Updates><Update><ID>1</ID></Update><Update><ID>2</ID></Update></Updates>";
+        let updates = blocks(text, "Update");
+        assert_eq!(updates.len(), 2);
+        assert_eq!(element(&updates[1], "ID").as_deref(), Some("2"));
+    }
+
+    #[test]
+    fn element_returns_none_when_absent() {
+        assert!(element("<A>1</A>", "B").is_none());
+        assert_eq!(element("<A></A>", "A").as_deref(), Some(""));
+    }
+}
