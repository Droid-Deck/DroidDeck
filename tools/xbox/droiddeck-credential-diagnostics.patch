+
+/// Letters and dashes only: DroidDeck passes `NEXUS_CREDENTIAL_ERROR_V1 [a-z-]{1,48}` lines to its
+/// log. Unlisted errno values are spelled with letters, a = 0 ... j = 9 (`os-dh` = errno 37).
+pub(crate) fn io_reason(error: &std::io::Error) -> String {
+    let known = match error.raw_os_error() {
+        Some(111) => "refused",
+        Some(13) => "denied",
+        Some(1) => "not-permitted",
+        Some(2) => "missing",
+        Some(110) => "timed-out",
+        Some(38) => "unsupported",
+        Some(97) => "family-unsupported",
+        Some(22) => "invalid",
+        Some(104) => "reset",
+        Some(32) => "broken-pipe",
+        Some(4) => "interrupted",
+        Some(11) => "would-block",
+        Some(17) => "exists",
+        Some(20) => "not-directory",
+        Some(21) => "is-directory",
+        Some(28) => "no-space",
+        Some(30) => "read-only",
+        Some(37) => "no-locks",
+        Some(40) => "symlink-loop",
+        Some(95) => "not-supported",
+        Some(code) => {
+            let letters: String = code.unsigned_abs().to_string().bytes().map(|b| (b - b'0' + b'a') as char).collect();
+            return format!("os-{letters}");
+        }
+        None => match error.kind() {
+            std::io::ErrorKind::TimedOut | std::io::ErrorKind::WouldBlock => "timed-out",
+            std::io::ErrorKind::UnexpectedEof => "closed",
+            _ => "other",
+        },
+    };
+    known.to_string()
+}
+
+#[cfg(test)]
+mod io_reason_tests {
+    #[test]
+    fn io_reason_is_letters_and_dashes() {
+        for (code, expected) in [(37, "no-locks"), (13, "denied"), (99, "os-jj"), (125, "os-bcf")] {
+            assert_eq!(super::io_reason(&std::io::Error::from_raw_os_error(code)), expected);
+        }
+        assert_eq!(super::io_reason(&std::io::Error::other("x")), "other");
+    }
+}
