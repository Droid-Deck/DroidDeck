+#[test]
+fn credential_xbox_ticket_compact_jwe_uses_bare_wire_format_without_changing_store_conversion() {
+    for raw in [
+        jwe(json!({"alg":"dir","enc":"A128CBC-HS256"}), ""),
+        jwe(json!({"alg":"RSA-OAEP-256","enc":"A256GCM"}), "a2V5"),
+    ] {
+        let Token::Compact(original) = delegation(&raw) else { panic!("fixture"); };
+        assert_eq!(original, format!("d={raw}"));
+        assert_eq!(store_ticket(original.clone()), format!("t={raw}"));
+        assert_eq!(xbox_ticket(original), raw);
+        assert_eq!(xbox_ticket(raw.clone()), raw);
+        assert_eq!(xbox_ticket(format!("t={raw}")), format!("t={raw}"));
+    }
+}
+
+#[test]
+fn credential_xbox_ticket_opaque_and_malformed_tokens_are_preserved() {
+    let valid = jwe(json!({"alg":"dir","enc":"A256GCM"}), "");
+    let mut cases = vec!["d=opaque".to_string(), "opaque".into(), "".into(), "d=".into(),
+        "d=opaque..iv.ciphertext.tag".into(), "d=eyJ..a.b.c".into(),
+        format!("d={valid}.extra"), format!("d={}", valid.replace("..", ".+.")),
+        format!("d={}", jwe(json!({"alg":"dir"}), "")),
+        format!("d={}", jwe(json!({"alg":"dir","enc":""}), "")),
+        format!("d={}", jwe(json!({"alg":"dir","enc":"A256GCM","kid":"a".repeat(9000)}), ""))];
+    let mut parts: Vec<_> = valid.split('.').map(str::to_string).collect();
+    for index in [2, 3, 4] {
+        let old = parts[index].clone(); parts[index].clear();
+        cases.push(format!("d={}", parts.join("."))); parts[index] = old;
+    }
+    for ticket in cases { assert_eq!(xbox_ticket(ticket.clone()), ticket); }
+}
