+// Xbox accepts compact JWE tickets without the delegation prefix; opaque
+// delegation tickets keep their original wire representation.
+pub fn xbox_ticket(ticket: String) -> String {
+    match ticket.strip_prefix("d=") {
+        Some(raw) if is_compact_jwe(raw) => raw.to_owned(),
+        _ => ticket,
+    }
+}
