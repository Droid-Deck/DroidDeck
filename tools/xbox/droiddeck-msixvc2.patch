+
+    fn sealed(plain: &[u8], segment_key: &[u8; 32]) -> (Segment, Vec<u8>) {
+        let hash = Sha384::digest(plain).to_vec();
+        let mut padded = plain.to_vec();
+        padded.resize(plain.len().div_ceil(16) * 16, 0);
+        let mut iv = [0u8; 16];
+        iv.copy_from_slice(&hash[..16]);
+        let stored = encrypt(segment_key, &iv, &padded);
+        let segment = Segment {
+            hash,
+            length: plain.len() as u64,
+            compression: 0,
+            stored: plain.len() as u64,
+            key: Some(segment_key.to_vec()),
+            wrapped: None,
+            wrap_iv: [0; 16],
+            box_hash: Some(Sha384::digest(&stored).to_vec()),
+            box_index: 0,
+            offset: 0,
+            span: stored.len() as u64,
+        };
+        (segment, stored)
+    }
+
+    #[test]
+    fn a_segment_opens_only_with_its_key_and_hashes() {
+        let (segment, stored) = sealed(b"game data that is not block aligned", &[7; 32]);
+        assert_eq!(open(&segment, &stored, &[0; 32]).unwrap(), b"game data that is not block aligned");
+        let mut tampered = stored.clone();
+        tampered[3] ^= 1;
+        assert!(open(&segment, &tampered, &[0; 32]).is_err());
+        let wrong = Segment { key: Some(vec![8; 32]), box_hash: None, ..segment };
+        assert!(open(&wrong, &stored, &[0; 32]).is_err());
+    }
+
+    #[test]
+    fn a_wrapped_segment_key_is_unwrapped_with_the_package_key() {
+        let package_key = [3u8; 32];
+        let segment_key = [9u8; 32];
+        let wrap_iv = [5u8; 16];
+        let (segment, stored) = sealed(b"wrapped", &segment_key);
+        let wrapped = Segment { key: None, wrapped: Some(encrypt(&package_key, &wrap_iv, &segment_key)), wrap_iv, ..segment };
+        assert_eq!(open(&wrapped, &stored, &package_key).unwrap(), b"wrapped");
+    }
+
+    #[test]
+    fn adjacent_segments_in_one_box_share_a_request() {
+        let (segment, _) = sealed(b"x", &[1; 32]);
+        let at = |box_index: usize, offset: u64| Segment { box_index, offset, span: 16, ..segment.clone() };
+        let parts = [at(0, 0), at(0, 16), at(0, 48), at(1, 64)];
+        let shape: Vec<(usize, u64, u64, usize)> =
+            requests(&parts).iter().map(|r| (r.box_index, r.offset, r.length, r.segments.len())).collect();
+        assert_eq!(shape, [(0, 0, 32, 2), (0, 48, 16, 1), (1, 64, 16, 1)]);
+    }
+
+    #[test]
+    fn the_rolling_wrap_iv_advances_per_segment_and_an_explicit_one_wins() {
+        let item = |explicit: bool| {
+            let mut map = vec![
+                (Value::Integer(1.into()), Value::Bytes(vec![0; 48])),
+                (Value::Integer(2.into()), Value::Integer(4.into())),
+            ];
+            if explicit {
+                map.push((Value::Integer(7.into()), Value::Bytes(vec![0xee; 16])));
+            }
+            Value::Map(map)
+        };
+        let mut rolling = [0u8; 16];
+        rolling[15] = 0xff;
+        let found = segments(&[item(false), item(true), item(false)], &mut rolling).unwrap();
+        assert_eq!(found[0].wrap_iv[14..], [0x00, 0xff]);
+        assert_eq!(found[1].wrap_iv, [0xee; 16]);
+        assert_eq!(found[2].wrap_iv[14..], [0x01, 0x01]);
+    }
+
+    #[test]
+    fn only_files_not_yet_complete_count_toward_the_space_needed() {
+        let root = tempfile::tempdir().unwrap();
+        let (segment, _) = sealed(b"x", &[1; 32]);
+        let entry = |path: &str, size: u64| Entry { path: PathBuf::from(path), size, hash: None, segments: vec![segment.clone()] };
+        let plan = Plan { entries: vec![entry("done.bin", 4), entry("partial.bin", 10), entry("missing.bin", 7)], boxes: vec![], package_key: [0; 32] };
+        std::fs::write(root.path().join("done.bin"), b"abcd").unwrap();
+        std::fs::write(root.path().join("partial.bin"), b"abc").unwrap();
+        assert_eq!(plan.total(), 21);
+        assert_eq!(plan.remaining(root.path()), 17);
+    }
+
+    #[test]
+    fn package_paths_stay_inside_the_install_folder() {
+        assert_eq!(relative("EmuMenu\\EmuMenu.exe").unwrap(), PathBuf::from("EmuMenu/EmuMenu.exe"));
+        for bad in ["", "..\\x", "/abs", "a\\..\\..\\b", "C:\\x"] {
