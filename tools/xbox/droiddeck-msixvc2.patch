+    fn sealed(plain: &[u8], segment_key: &[u8; 32]) -> (Segment, Vec<u8>) {
+        let hash = Sha384::digest(plain).to_vec();
+        let mut padded = plain.to_vec();
+        padded.resize(plain.len().div_ceil(16) * 16, 0);
+        let mut iv = [0u8; 16];
+        iv.copy_from_slice(&hash[..16]);
+        let stored = encrypt(segment_key, &iv, &padded);
+        let segment = Segment {
+            hash,
+            length: plain.len() as u64,
+            compression: 0,
+            stored: plain.len() as u64,
+            key: Some(segment_key.to_vec()),
+            wrapped: None,
+            wrap_iv: [0; 16],
+            box_hash: Some(Sha384::digest(&stored).to_vec()),
+            box_index: 0,
+            offset: 0,
