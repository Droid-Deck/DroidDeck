+    #[test]
+    fn the_key_derivation_matches_sp800_108_counter_mode() {
+        let derived = derive(&[0x42; 32], b"ctx");
+        let mut message = 1u32.to_be_bytes().to_vec();
+        message.extend_from_slice(KDF_LABEL);
+        message.push(0);
+        message.extend_from_slice(b"ctx");
+        message.extend_from_slice(&256u32.to_be_bytes());
+        let mut mac = <Hmac<Sha256> as hmac::KeyInit>::new_from_slice(&[0x42; 32]).unwrap();
+        mac.update(&message);
+        assert_eq!(derived.as_slice(), mac.finalize().into_bytes().as_slice());
+    }
