+    fn encrypt(key: &[u8; 32], iv: &[u8; 16], data: &[u8]) -> Vec<u8> {
+        let mut out = data.to_vec();
+        cbc::Encryptor::<aes::Aes256>::new(key.into(), iv.into()).encrypt_padded::<NoPadding>(&mut out, data.len()).unwrap();
+        out
