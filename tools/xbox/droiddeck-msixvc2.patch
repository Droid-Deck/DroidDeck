+async fn boxed_package(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    out: &Path,
+    market: Option<String>,
+    tx: &Sender<ProgressEvent>,
+) -> ExitCode {
+    let fail = |message: &str| {
+        eprintln!("NEXUS_TRANSFER_DIAGNOSTIC_V1 boxed-package-failed 0");
+        eprintln!("{message}");
+        ExitCode::FAILURE
+    };
+    let content_id = match crate::commands::msixvc2::content_id(out) {
+        Ok(id) => id,
+        Err(error) => return fail(&error),
+    };
+    let (device_key, license) = match get_license(client, tokens, content_id, market.unwrap_or("neutral".to_string()), None, false).await {
+        Ok(found) => found,
+        Err(error) => {
+            eprintln!("{error}");
+            return ExitCode::FAILURE;
+        }
+    };
+    let mut keys = HashMap::new();
+    for (id, packed) in license.content_keys {
+        let Ok(key) = packed.unpack(&device_key) else {
+            return fail("The content key could not be authenticated. Retry the installation or sign in again.");
+        };
+        if let Ok(key) = <[u8; 32]>::try_from(&key[..]) {
+            keys.insert(id.to_bytes_le(), key);
+        }
+    }
+    tx.send(ProgressEvent::UpdateStatus { name: "Preparing".to_owned() }).await.ok();
+    let plan = match crate::commands::msixvc2::plan(client, out, &keys).await {
+        Ok(plan) => plan,
+        Err(error) => return fail(&error),
+    };
+    let total = plan.total();
+    let needed = plan.remaining(out);
+    if let Ok(free) = available_space(out)
+        && free < needed
+    {
+        eprintln!("NEXUS_LEGACY_INSTALL_DIAGNOSTIC_V1 insufficient-space");
+        eprintln!(
+            "NEXUS_LEGACY_INSTALL_DETAIL_V1 an install this size needs about {} GB free, and {} GB is available",
+            needed.div_ceil(1_000_000_000),
+            free / 1_000_000_000
+        );
+        return ExitCode::FAILURE;
+    }
+    tx.send(ProgressEvent::UpdateRemaining { name: "Downloading".to_owned(), total }).await.ok();
+    tx.send(ProgressEvent::Started { id: 0, name: "Game files".to_owned(), total }).await.ok();
+    let pending = std::sync::atomic::AtomicU64::new(0);
+    let report = |written: u64| {
+        let delta = pending.fetch_add(written, std::sync::atomic::Ordering::Relaxed) + written;
+        if tx.try_send(ProgressEvent::Advanced { id: 0, delta }).is_ok() {
+            pending.fetch_sub(delta, std::sync::atomic::Ordering::Relaxed);
+        }
+    };
+    let installed = crate::commands::msixvc2::install(client, &plan, out, &report).await;
+    let rest = pending.swap(0, std::sync::atomic::Ordering::Relaxed);
+    if rest > 0 {
+        tx.send(ProgressEvent::Advanced { id: 0, delta: rest }).await.ok();
+    }
+    match installed {
+        Ok(()) => {
+            tx.send(ProgressEvent::Finished { id: 0 }).await.ok();
+            ExitCode::SUCCESS
+        }
+        Err(error) => fail(&error),
+    }
+}
