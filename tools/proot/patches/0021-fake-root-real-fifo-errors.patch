From 4486efde6200dc8a8df4097a868b65e449d20e82 Mon Sep 17 00:00:00 2001
From: maxjivi05 <maxjividen@gmail.com>
Date: Wed, 28 Oct 2026 14:12:47 -0400
Subject: [PATCH] fake_id0: report real errors for FIFO and socket mknod

---
 src/extension/fake_id0/fake_id0.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/extension/fake_id0/fake_id0.c b/src/extension/fake_id0/fake_id0.c
index 5c8a8cd..dc28529 100644
--- a/src/extension/fake_id0/fake_id0.c
+++ b/src/extension/fake_id0/fake_id0.c
@@ -940,7 +940,12 @@ static int handle_sysexit_end(Tracee *tracee, Config *config)
 	case PR_setgroups32:
 #endif
 	case PR_mknod:
-	case PR_mknodat:
+	case PR_mknodat: {
+		mode_t mode = peek_reg(tracee, ORIGINAL, sysnum == PR_mknod ? SYSARG_2 : SYSARG_3);
+		if (S_ISFIFO(mode) || S_ISSOCK(mode) || S_ISREG(mode) || (mode & S_IFMT) == 0)
+			return 0;
+		return handle_perm_err_exit_end(tracee, config, false);
+	}
 	case PR_capset:
 	case PR_chmod:
 	case PR_chown:
-- 
2.43.0

