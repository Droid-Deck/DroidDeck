+static void
+fit_root_to_focus_window( xwayland_ctx_t *ctx )
+{
+	steamcompmgr_win_t *w = ctx->focus.focusWindow;
+	if ( !w || window_is_steam( w ) )
+		return;
+
+	const XWindowAttributes &a = w->xwayland().a;
+	const size_t uServer = ctx->xwayland_server->get_index();
+	const bool bCoversRoot = a.x == 0 && a.y == 0 && a.width >= ctx->root_width && a.height >= ctx->root_height;
+	const bool bPlausible = a.width <= 8192 && a.height <= 8192;
+
+	int nWidth = 0;
+	int nHeight = 0;
+	if ( bCoversRoot && bPlausible && ( a.width > ctx->root_width || a.height > ctx->root_height ) )
+	{
+		if ( !ctx->nFitRestoreWidth )
+		{
+			ctx->nFitRestoreWidth = ctx->root_width;
+			ctx->nFitRestoreHeight = ctx->root_height;
+		}
+		nWidth = a.width;
+		nHeight = a.height;
+	}
+	else if ( ctx->nFitRestoreWidth && a.width <= ctx->nFitRestoreWidth && a.height <= ctx->nFitRestoreHeight )
+	{
+		nWidth = ctx->nFitRestoreWidth;
+		nHeight = ctx->nFitRestoreHeight;
+		ctx->nFitRestoreWidth = 0;
+		ctx->nFitRestoreHeight = 0;
+	}
+
+	if ( !nWidth )
+		return;
+
+	wlserver_lock();
+	wlserver_set_xwayland_server_mode( uServer, nWidth, nHeight, g_nOutputRefresh );
+	wlserver_unlock();
+}
