+static void
+fit_root_to_focus_window( xwayland_ctx_t *ctx )
+{
+	steamcompmgr_win_t *w = ctx->focus.focusWindow;
+	const bool bGame = w && !window_is_steam( w );
+	const int nWindowX = bGame ? w->xwayland().a.x : 0;
+	const int nWindowY = bGame ? w->xwayland().a.y : 0;
+	const int nWindowWidth = bGame ? w->xwayland().a.width : 0;
+	const int nWindowHeight = bGame ? w->xwayland().a.height : 0;
+	const bool bCoversRoot = nWindowX == 0 && nWindowY == 0 && nWindowWidth >= ctx->root_width && nWindowHeight >= ctx->root_height;
+	const bool bPlausible = nWindowWidth <= 8192 && nWindowHeight <= 8192;
+
+	int nWidth = 0;
+	int nHeight = 0;
+	if ( bGame && bCoversRoot && bPlausible && ( nWindowWidth > ctx->root_width || nWindowHeight > ctx->root_height ) )
+	{
+		if ( !ctx->nFitRestoreWidth )
+		{
+			ctx->nFitRestoreWidth = ctx->root_width;
+			ctx->nFitRestoreHeight = ctx->root_height;
+		}
+		nWidth = nWindowWidth;
+		nHeight = nWindowHeight;
+	}
+	else if ( ctx->nFitRestoreWidth && nWindowWidth <= ctx->nFitRestoreWidth && nWindowHeight <= ctx->nFitRestoreHeight )
+	{
+		nWidth = ctx->nFitRestoreWidth;
+		nHeight = ctx->nFitRestoreHeight;
+		ctx->nFitRestoreWidth = 0;
+		ctx->nFitRestoreHeight = 0;
+	}
+
+	if ( !nWidth )
+		return;
+
+	wlserver_lock();
+	wlserver_set_xwayland_server_mode( ctx->xwayland_server->get_index(), nWidth, nHeight, g_nOutputRefresh );
+	wlserver_unlock();
+}
