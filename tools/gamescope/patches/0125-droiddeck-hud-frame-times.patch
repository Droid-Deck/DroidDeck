+// DroidDeck's own HUD reads the frame times DroidDeck's mangoapp shows from a shared file named by
+// DROIDDECK_HUD_FRAMES, also while no mangoapp runs. That mangoapp (Valve's 20260902.1 build) reads the
+// field at byte 16 of each message as its frame time, which is app_frametime_ns here: one time per
+// signalled commit of the connector's windows (mangoapp_nudge_app_frame). The file gets the same commits
+// of connector 0. Little-endian: 0 magic, 4 version, 8 capacity, 12 pid, 16 frames written (u64),
+// 24 info sequence (odd while the info is written), 28 output width, 32 height, 36 refresh mHz, 40 Steam
+// focused, 44 engine (40 bytes), then from 128 one { frametime ns, monotonic time ns } pair per frame,
+// a ring of capacity.
+static constexpr uint32_t k_uDroidDeckHudFramesMagic = 0x46484444;
+static constexpr uint32_t k_uDroidDeckHudFramesVersion = 1;
+static constexpr uint32_t k_uDroidDeckHudFramesCapacity = 1024;
+static constexpr size_t k_zDroidDeckHudFramesHeader = 128;
+static constexpr size_t k_zDroidDeckHudFramesSize = k_zDroidDeckHudFramesHeader + k_uDroidDeckHudFramesCapacity * 16;
+static std::mutex s_DroidDeckHudFramesMutex;
+
+static uint8_t *droiddeck_hud_frames_map()
+{
+	static uint8_t *s_pMap = nullptr;
+	static bool s_bTried = false;
+	if ( s_bTried )
+		return s_pMap;
+	s_bTried = true;
+
+	const char *pszPath = getenv( "DROIDDECK_HUD_FRAMES" );
+	if ( !pszPath || !*pszPath )
+		return nullptr;
+	int fd = open( pszPath, O_RDWR | O_CREAT | O_CLOEXEC, 0644 );
+	if ( fd < 0 )
+	{
+		xwm_log.errorf_errno( "DroidDeck HUD frames: open %s", pszPath );
+		return nullptr;
+	}
+	void *pMap = MAP_FAILED;
+	if ( ftruncate( fd, k_zDroidDeckHudFramesSize ) == 0 )
+		pMap = mmap( nullptr, k_zDroidDeckHudFramesSize, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 );
+	close( fd );
+	if ( pMap == MAP_FAILED )
+	{
+		xwm_log.errorf_errno( "DroidDeck HUD frames: map %s", pszPath );
+		return nullptr;
+	}
+	uint8_t *pBytes = static_cast<uint8_t *>( pMap );
+	__atomic_store_n( reinterpret_cast<uint32_t *>( pBytes ), 0u, __ATOMIC_RELEASE );
+	memset( pBytes + 4, 0, k_zDroidDeckHudFramesSize - 4 );
+	memcpy( pBytes + 4, &k_uDroidDeckHudFramesVersion, 4 );
+	memcpy( pBytes + 8, &k_uDroidDeckHudFramesCapacity, 4 );
+	__atomic_store_n( reinterpret_cast<uint32_t *>( pBytes ), k_uDroidDeckHudFramesMagic, __ATOMIC_RELEASE );
+	xwm_log.infof( "DroidDeck HUD frames: %s", pszPath );
+	s_pMap = pBytes;
+	return s_pMap;
+}
+
+static bool droiddeck_hud_frames_wanted()
+{
+	std::unique_lock lock( s_DroidDeckHudFramesMutex );
+	return droiddeck_hud_frames_map() != nullptr;
+}
+
+// Signal() runs on the image waiter thread or, for a frame finished at import, on steamcompmgr's.
+void droiddeck_hud_app_frame( uint64_t ulNow )
+{
+	std::unique_lock lock( s_DroidDeckHudFramesMutex );
+	uint8_t *pMap = droiddeck_hud_frames_map();
+	if ( !pMap )
+		return;
+	static uint64_t s_ulLastFrame = 0;
+	uint64_t ulLast = s_ulLastFrame;
+	s_ulLastFrame = ulNow;
+	if ( !ulLast || ulNow <= ulLast )
+		return;
+	uint64_t *pCount = reinterpret_cast<uint64_t *>( pMap + 16 );
+	uint64_t ulCount = __atomic_load_n( pCount, __ATOMIC_RELAXED );
+	uint64_t ulFrame[2] = { ulNow - ulLast, ulNow };
+	memcpy( pMap + k_zDroidDeckHudFramesHeader + ( ulCount % k_uDroidDeckHudFramesCapacity ) * 16, ulFrame, sizeof( ulFrame ) );
+	__atomic_store_n( pCount, ulCount + 1, __ATOMIC_RELEASE );
+}
+
+static void publish_droiddeck_hud_info()
+{
+	std::unique_lock lock( s_DroidDeckHudFramesMutex );
+	uint8_t *pMap = droiddeck_hud_frames_map();
+	if ( !pMap )
+		return;
+	auto focusIter = g_VirtualConnectorFocuses.find( 0 );
+	global_focus_t *pFocus = focusIter != g_VirtualConnectorFocuses.end() ? &focusIter->second : GetCurrentFocus();
+	if ( !pFocus )
+		return;
+
+	uint32_t *pSeq = reinterpret_cast<uint32_t *>( pMap + 24 );
+	uint32_t uSeq = __atomic_load_n( pSeq, __ATOMIC_RELAXED );
+	__atomic_store_n( pSeq, uSeq + 1, __ATOMIC_RELAXED );
+	__atomic_thread_fence( __ATOMIC_RELEASE );
+	uint32_t uPid = uint32_t( pFocus->nFocusWindowPid );
+	uint32_t uOutput[4] = { g_nOutputWidth, g_nOutputHeight, uint32_t( g_nOutputRefresh ), window_is_steam( pFocus->inputFocusWindow ) ? 1u : 0u };
+	char szEngine[40] = {};
+	if ( pFocus->pFocusWindowEngine )
+		pFocus->pFocusWindowEngine->copy( szEngine, sizeof( szEngine ) - 1 );
+	memcpy( pMap + 12, &uPid, 4 );
+	memcpy( pMap + 28, uOutput, sizeof( uOutput ) );
+	memcpy( pMap + 44, szEngine, sizeof( szEngine ) );
+	__atomic_store_n( pSeq, uSeq + 2, __ATOMIC_RELEASE );
+}
