 				check_new_xwayland_res(server->ctx.get());
+
+			// Commits marked done at import: handle them now rather than on the next wake. FIFO commits still wait for a vblank.
+			if ( s_bXwaylandCommitsDoneAtImport )
+			{
+				s_bXwaylandCommitsDoneAtImport = false;
+				for (size_t i = 0; (server = wlserver_get_xwayland_server(i)); i++)
+					handle_done_commits_xwayland(server->ctx.get(), false, vblank_idx);
+			}
 		}
 
 
