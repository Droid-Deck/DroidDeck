+static bool
+window_offers_frame_controls( xwayland_ctx_t *ctx, steamcompmgr_win_t *w )
+{
+	static constexpr unsigned long k_ulMotifFunctions = 1ul << 0;
+	static constexpr unsigned long k_ulMotifMinimize = 1ul << 3;
+	static constexpr unsigned long k_ulMotifMaximize = 1ul << 4;
+
+	Atom type;
+	int format;
+	unsigned long nitems;
+	unsigned long bytesAfter;
+	unsigned char *data = nullptr;
+	if ( XGetWindowProperty( ctx->dpy, w->xwayland().id, ctx->atoms.motifWMHintsAtom, 0, 2, false,
+			AnyPropertyType, &type, &format, &nitems, &bytesAfter, &data ) != Success )
+		return false;
+
+	bool bControls = false;
+	if ( data && format == 32 && nitems >= 2 )
+	{
+		const long *hints = (const long *)data;
+		bControls = ( hints[0] & k_ulMotifFunctions ) && ( hints[1] & ( k_ulMotifMinimize | k_ulMotifMaximize ) );
+	}
+	if ( data )
+		XFree( data );
+	return bControls;
+}
+
+static void
+apply_game_window_mode( global_focus_t *pFocus )
+{
+	static constexpr int k_nSmallestFollowedWindow = 64;
+
+	steamcompmgr_win_t *w = pFocus->focusWindow;
+	if ( !g_bFollowGameWindowMode || !pFocus->GetNestedHints() || !w || w->type != steamcompmgr_win_type_t::XWAYLAND )
+		return;
+
+	xwayland_ctx_t *ctx = w->xwayland().ctx;
+	const XWindowAttributes &a = w->xwayland().a;
+	if ( a.width < k_nSmallestFollowedWindow || a.height < k_nSmallestFollowedWindow )
+		return;
+
+	const bool bCoversScreen = a.x == 0 && a.y == 0 && a.width >= ctx->root_width && a.height >= ctx->root_height;
+	const bool bFullscreen = w->isFullscreen || ( w->appID && bCoversScreen && !window_offers_frame_controls( ctx, w ) );
+	pFocus->GetNestedHints()->SetWindowMode( bFullscreen, a.width, a.height );
+}
