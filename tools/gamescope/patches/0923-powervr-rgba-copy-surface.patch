diff --git a/src/nested_surface_format.hpp b/src/nested_surface_format.hpp
new file mode 100644
--- /dev/null
+++ b/src/nested_surface_format.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <vulkan/vulkan_core.h>
+
+namespace gamescope
+{
+// The SDR composition shader declares rgba8, which requires an R8G8B8A8_UNORM
+// storage view. Binding a BGRA view is a format mismatch; a same-format copy
+// cannot correct it. Keep the workaround scoped to the PowerVR SDR copy path
+// where the channel reversal was reproduced, not game-facing texture formats.
+// On success, formatCount means the existing selector should choose the format.
+// On failure, no matching RGBA SDR surface was advertised for this scoped path.
+inline bool ChooseNestedSDRCopySurfaceFormat( uint32_t vendorId, bool copy, bool hdr,
+    const VkSurfaceFormatKHR *formats, uint32_t formatCount, uint32_t &surfaceFormat )
+{
+    surfaceFormat = formatCount;
+    if ( vendorId != 0x1010 || !copy || hdr )
+        return true;
+
+    for ( uint32_t i = 0; i < formatCount; ++i )
+    {
+        if ( formats[i].format == VK_FORMAT_R8G8B8A8_UNORM &&
+             formats[i].colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR )
+        {
+            surfaceFormat = i;
+            return true;
+        }
+    }
+    return false;
+}
+}
