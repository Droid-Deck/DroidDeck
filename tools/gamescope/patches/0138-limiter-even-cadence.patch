+static uint64_t limiter_latch_target( uint64_t ulPreviousTarget, uint64_t ulLatched, uint64_t ulLimitedCycle, uint64_t ulRefreshCycle )
+{
+	const uint64_t ulTarget = ulPreviousTarget + ulLimitedCycle;
+	const bool bLate = ulTarget + ulRefreshCycle * 3 / 4 < ulLatched;
+	const bool bEarly = ulTarget > ulLatched + ulRefreshCycle;
+	return ( bLate || bEarly ) ? ulLatched : ulTarget;
+}
+
+static bool limiter_holds_vblank( uint64_t ulTarget, uint64_t ulNow, uint64_t ulLimitedCycle, uint64_t ulRefreshCycle )
+{
+	return ulNow + ulRefreshCycle / 2 < ulTarget + ulLimitedCycle;
+}
