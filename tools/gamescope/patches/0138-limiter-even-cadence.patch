-				if ( now + g_SteamCompMgrAppRefreshCycle / 2 < schedule )
+				if ( limiter_holds_vblank( w->limiter_latch_target_time, now, g_SteamCompMgrLimitedAppRefreshCycle, g_SteamCompMgrAppRefreshCycle ) )
 					bSendCallback = false;
 			}
 			else
@@ -11047,9 +11062,7 @@ steamcompmgr_main(int argc, char **argv)
 				}
 				else
 				{
-					int nVblankDivisor = nRealRefreshHz / nTargetFPS;
-
-					g_SteamCompMgrLimitedAppRefreshCycle = g_SteamCompMgrAppRefreshCycle * nVblankDivisor;
+					g_SteamCompMgrLimitedAppRefreshCycle = g_SteamCompMgrAppRefreshCycle * nRealRefreshHz / nTargetFPS;
