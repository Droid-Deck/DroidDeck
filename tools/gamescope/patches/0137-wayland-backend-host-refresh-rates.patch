+    std::span<const uint32_t> CWaylandBackend::GetHostRefreshRates() const
+    {
+        const uint32_t uCount = m_uHostRefreshRateCount;
+        if ( uCount < 2 )
+            return std::span<const uint32_t>{};
+        return std::span<const uint32_t>{ m_HostRefreshRates.data(), uCount };
+    }
+
+    bool CWaylandBackend::HackTemporarySetDynamicRefresh( int nRefresh )
+    {
+        if ( !m_pHostRefresh )
+            return false;
+        SyncHostRefreshTarget();
+        return true;
+    }
+
+    void CWaylandBackend::SyncHostRefreshTarget()
+    {
+        if ( !m_pHostRefresh )
+            return;
+        const int nFrameRate = steamcompmgr_get_app_target_fps();
+        const int nRefresh = steamcompmgr_get_app_dynamic_refresh();
+        if ( nRefresh == m_nSentHostRefresh && nFrameRate == m_nSentHostFrameRate )
+            return;
+        xdg_log.infof( "Asking the host for %dhz at %dfps", nRefresh, nFrameRate );
+        droiddeck_refresh_v1_set_target( m_pHostRefresh, nRefresh, nFrameRate );
+        m_nSentHostRefresh = nRefresh;
+        m_nSentHostFrameRate = nFrameRate;
+    }
+
+    void CWaylandBackend::Wayland_Refresh_Rate( droiddeck_refresh_v1 *pRefresh, uint32_t uRefresh )
+    {
+        m_PendingHostRefreshRates.push_back( uRefresh );
+    }
+    void CWaylandBackend::Wayland_Refresh_Done( droiddeck_refresh_v1 *pRefresh )
+    {
+        std::sort( m_PendingHostRefreshRates.begin(), m_PendingHostRefreshRates.end() );
+        const uint32_t uCount = std::min<size_t>( m_PendingHostRefreshRates.size(), m_HostRefreshRates.size() );
+        m_uHostRefreshRateCount = 0;
+        std::copy_n( m_PendingHostRefreshRates.begin(), uCount, m_HostRefreshRates.begin() );
+        m_uHostRefreshRateCount = uCount;
+        m_PendingHostRefreshRates.clear();
+        steamcompmgr_display_rates_changed();
+        force_repaint();
+    }
