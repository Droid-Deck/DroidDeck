+// DroidDeck: banner_ahb_v1, Android buffers behind dma-buf wl_buffers. A bionic game can allocate its swapchain
+// images as AHardwareBuffers and hand each one over once per wl_buffer (a socket the handle was written to).
+// gamescope never reads it: when it creates the host wl_buffer for the same dma-buf it passes the socket on to the
+// host compositor (CWaylandBackend::ImportDmabufToBackend), which can then show the buffer on a display layer
+// without a copy. Whether clients should allocate such buffers is the host's mode, relayed here.
+// GAMESCOPE_BANNER_AHB=0 leaves the global out.
+struct banner_ahb_pending
+{
+	int sock = -1;
+	uint32_t width = 0, height = 0, stride = 0, mod_hi = 0, mod_lo = 0, image_count = 0;
+	ino_t ino = 0;
+	bool queued = false;
+	wl_listener destroy;
+};
+
+static std::mutex g_BannerAhbMutex;
+static std::unordered_map<ino_t, banner_ahb_pending *> g_BannerAhbPending;
+static std::vector<wl_resource *> g_BannerAhbResources;
+static std::atomic<int> g_nBannerAhbMode{ 0 };
+
+static void banner_ahb_buffer_destroyed( wl_listener *pListener, void * )
+{
+	banner_ahb_pending *pPending = wl_container_of( pListener, pPending, destroy );
+	{
+		std::scoped_lock lock( g_BannerAhbMutex );
+		if ( pPending->queued )
+		{
+			auto iter = g_BannerAhbPending.find( pPending->ino );
+			if ( iter != g_BannerAhbPending.end() && iter->second == pPending )
+				g_BannerAhbPending.erase( iter );
+		}
+		if ( pPending->sock >= 0 )
+			close( pPending->sock );
+	}
+	wl_list_remove( &pPending->destroy.link );
+	delete pPending;
+}
+
+static void banner_ahb_handle_destroy( wl_client *, wl_resource *pResource )
+{
+	wl_resource_destroy( pResource );
+}
+
+static void banner_ahb_handle_attach( wl_client *, wl_resource *, wl_resource *pBuffer, int32_t nSocket,
+	uint32_t uWidth, uint32_t uHeight, uint32_t uStride, uint32_t uModHi, uint32_t uModLo, uint32_t uImageCount )
+{
+	wlr_dmabuf_v1_buffer *pDmabuf = wlr_dmabuf_v1_buffer_try_from_buffer_resource( pBuffer );
+	struct stat st;
+	if ( !pDmabuf || pDmabuf->attributes.n_planes < 1 || fstat( pDmabuf->attributes.fd[0], &st ) != 0 )
+	{
+		wl_log.errorf( "banner_ahb_v1: attach to a wl_buffer that is not a dma-buf, ignored" );
+		close( nSocket );
+		return;
+	}
+
+	banner_ahb_pending *pPending = new banner_ahb_pending;
+	pPending->sock = nSocket;
+	pPending->width = uWidth;
+	pPending->height = uHeight;
+	pPending->stride = uStride;
+	pPending->mod_hi = uModHi;
+	pPending->mod_lo = uModLo;
+	pPending->image_count = uImageCount;
+	pPending->ino = st.st_ino;
+	pPending->queued = true;
+	pPending->destroy.notify = banner_ahb_buffer_destroyed;
+	wl_resource_add_destroy_listener( pBuffer, &pPending->destroy );
+
+	std::scoped_lock lock( g_BannerAhbMutex );
+	auto iter = g_BannerAhbPending.find( st.st_ino );
+	if ( iter != g_BannerAhbPending.end() )
+	{
+		iter->second->queued = false;
+		if ( iter->second->sock >= 0 )
+		{
+			close( iter->second->sock );
+			iter->second->sock = -1;
+		}
+	}
+	g_BannerAhbPending[ st.st_ino ] = pPending;
+}
+
+static const struct banner_ahb_v1_interface banner_ahb_impl =
+{
+	.destroy = banner_ahb_handle_destroy,
+	.attach = banner_ahb_handle_attach,
+};
+
+static void banner_ahb_resource_destroyed( wl_resource *pResource )
+{
+	std::erase( g_BannerAhbResources, pResource );
+}
+
+static void banner_ahb_bind( wl_client *pClient, void *, uint32_t uVersion, uint32_t uId )
+{
+	wl_resource *pResource = wl_resource_create( pClient, &banner_ahb_v1_interface, std::min( uVersion, 2u ), uId );
+	if ( !pResource )
+	{
+		wl_client_post_no_memory( pClient );
+		return;
+	}
+	wl_resource_set_implementation( pResource, &banner_ahb_impl, nullptr, banner_ahb_resource_destroyed );
+	g_BannerAhbResources.push_back( pResource );
+	if ( wl_resource_get_version( pResource ) >= BANNER_AHB_V1_MODE_SINCE_VERSION )
+		banner_ahb_v1_send_mode( pResource, g_nBannerAhbMode.load() ? 1u : 0u );
+}
+
+static void create_banner_ahb( void )
+{
+	const char *pszEnv = getenv( "GAMESCOPE_BANNER_AHB" );
+	if ( pszEnv && pszEnv[0] == '0' )
+		return;
+	wl_global_create( wlserver.display, &banner_ahb_v1_interface, 2, nullptr, banner_ahb_bind );
+}
+
+void wlserver_banner_ahb_set_mode( bool bEnabled )
+{
+	if ( g_nBannerAhbMode.exchange( bEnabled ? 1 : 0 ) == ( bEnabled ? 1 : 0 ) )
+		return;
+	wl_log.infof( "banner_ahb_v1: host compositor %s Android swapchain buffers", bEnabled ? "wants" : "does not want" );
+	if ( !wlserver.display )
+		return;
+	wlserver_lock();
+	for ( wl_resource *pResource : g_BannerAhbResources )
+	{
+		if ( wl_resource_get_version( pResource ) >= BANNER_AHB_V1_MODE_SINCE_VERSION )
+			banner_ahb_v1_send_mode( pResource, bEnabled ? 1u : 0u );
+	}
+	wlserver_unlock();
+}
+
+bool wlserver_banner_ahb_take( int nDmabufFd, wlserver_banner_ahb_attach *pOut )
+{
+	struct stat st;
+	if ( fstat( nDmabufFd, &st ) != 0 )
+		return false;
+	std::scoped_lock lock( g_BannerAhbMutex );
+	auto iter = g_BannerAhbPending.find( st.st_ino );
+	if ( iter == g_BannerAhbPending.end() )
+		return false;
+	banner_ahb_pending *pPending = iter->second;
+	g_BannerAhbPending.erase( iter );
+	pPending->queued = false;
+	if ( pPending->sock < 0 )
+		return false;
+	*pOut = wlserver_banner_ahb_attach
+	{
+		.sock = pPending->sock,
+		.width = pPending->width,
+		.height = pPending->height,
+		.stride = pPending->stride,
+		.mod_hi = pPending->mod_hi,
+		.mod_lo = pPending->mod_lo,
+		.image_count = pPending->image_count,
+	};
+	pPending->sock = -1;
+	return true;
+}
+
 static void create_gamescope_swapchain_factory_v2( void )
 {
 	uint32_t version = 1;
@@ -2255,6 +2421,7 @@ bool wlserver_init( void ) {
 	create_gamescope_xwayland();
 
 	create_gamescope_swapchain_factory_v2();
+	create_banner_ahb();
 
 	new gamescope::WaylandServer::CGamescopeLimiterProtocol( wlserver.display );
 
