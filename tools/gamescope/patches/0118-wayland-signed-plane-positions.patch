diff --git a/src/Utils/WaylandScaling.h b/src/Utils/WaylandScaling.h
new file mode 100644
index 0000000..d488e39
--- /dev/null
+++ b/src/Utils/WaylandScaling.h
@@ -0,0 +1,12 @@
+#pragma once
+
+#include <cstdint>
+
+namespace gamescope
+{
+    constexpr int32_t WaylandPositionToLogical( int32_t nValue, uint32_t uFactor )
+    {
+        const int64_t nScaled = int64_t( nValue ) * 120;
+        return int32_t( nScaled / uFactor + ( nScaled % uFactor > 0 ) );
+    }
+}
