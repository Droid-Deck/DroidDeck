diff --git a/tests/test_wayland_scaling.cpp b/tests/test_wayland_scaling.cpp
new file mode 100644
index 0000000..498f55b
--- /dev/null
+++ b/tests/test_wayland_scaling.cpp
@@ -0,0 +1,38 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "Utils/WaylandScaling.h"
+
+#include <cmath>
+#include <limits>
+
+using namespace gamescope;
+
+TEST_CASE("cropped Wayland planes retain negative positions", "[wayland_scaling]")
+{
+    REQUIRE( WaylandPositionToLogical( -120, 120 ) == -120 );
+    REQUIRE( WaylandPositionToLogical( -640, 120 ) == -640 );
+    REQUIRE( WaylandPositionToLogical( -360, 120 ) == -360 );
+    REQUIRE( WaylandPositionToLogical( 0, 120 ) == 0 );
+    REQUIRE( WaylandPositionToLogical( 160, 120 ) == 160 );
+}
+
+TEST_CASE("Wayland positions round up at fractional host scales", "[wayland_scaling]")
+{
+    const int32_t positions[] = { -100000000, -1000000, -640, -120, -1, 0, 1, 120, 640, 1000000, 100000000 };
+    const uint32_t scales[] = { 120, 150, 180, 240, 360, 480 };
+    for ( uint32_t uScale : scales )
+    {
+        for ( int32_t nPosition : positions )
+        {
+            CAPTURE( nPosition, uScale );
+            const int32_t nExpected = int32_t( std::ceil( (long double)( nPosition ) * 120 / uScale ) );
+            REQUIRE( WaylandPositionToLogical( nPosition, uScale ) == nExpected );
+        }
+    }
+}
+
+TEST_CASE("Wayland position conversion widens before multiplying", "[wayland_scaling]")
+{
+    REQUIRE( WaylandPositionToLogical( std::numeric_limits<int32_t>::min(), 120 ) == std::numeric_limits<int32_t>::min() );
+    REQUIRE( WaylandPositionToLogical( std::numeric_limits<int32_t>::max(), 120 ) == std::numeric_limits<int32_t>::max() );
+}
