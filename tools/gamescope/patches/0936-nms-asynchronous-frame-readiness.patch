diff --git a/layer/present_ready.hpp b/layer/present_ready.hpp
new file mode 100644
--- /dev/null
+++ b/layer/present_ready.hpp
@@ -0,0 +1,222 @@
+#pragma once
+
+#include <vulkan/vulkan.h>
+
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <vector>
+#include <pthread.h>
+#include <sys/eventfd.h>
+#include <unistd.h>
+
+namespace GamescopeWSILayer {
+
+struct PresentReadyApi {
+  PFN_vkCreateFence create;
+  PFN_vkResetFences reset;
+  PFN_vkWaitForFences wait;
+  PFN_vkDestroyFence destroy;
+};
+
+class PresentReady {
+ public:
+  PresentReady(VkDevice device, uint32_t imageCount, PresentReadyApi api)
+      : device_(device), api_(api), images_(imageCount), jobs_(imageCount),
+        statsTime_(Clock::now()) {}
+
+  PresentReady(const PresentReady &) = delete;
+  PresentReady &operator=(const PresentReady &) = delete;
+
+  ~PresentReady() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stopping_ = true;
+    }
+    changed_.notify_all();
+    if (workerStarted_) pthread_join(worker_, nullptr);
+    for (auto &image : images_) {
+      CloseEvent(image);
+      if (!image.fence) continue;
+      bool safe = !image.pending && !image.unsafe;
+      if (!safe) {
+        VkResult result = api_.wait(device_, 1, &image.fence, VK_TRUE, 0);
+        safe = result == VK_SUCCESS || result == VK_ERROR_DEVICE_LOST;
+      }
+      if (safe) api_.destroy(device_, image.fence, nullptr);
+      else std::fprintf(stderr, "[Gamescope WSI] Present-ready: retaining a GPU-pending fence until device teardown.\n");
+    }
+  }
+
+  bool Prepare(uint32_t index) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (index >= images_.size() || stopping_ || failed_) return false;
+    auto &image = images_[index];
+    if (image.pending) {
+      ++reuseWaits_;
+      changed_.wait(lock, [&] { return !image.pending || stopping_ || failed_; });
+    }
+    if (stopping_ || failed_ || image.prepared) return false;
+    if (image.unsafe) {
+      VkResult result = api_.wait(device_, 1, &image.fence, VK_TRUE, 0);
+      if (result != VK_SUCCESS) return false;
+      image.unsafe = false;
+    }
+    if (!image.fence) {
+      const VkFenceCreateInfo info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, nullptr, 0};
+      if (api_.create(device_, &info, nullptr, &image.fence) != VK_SUCCESS) return false;
+    }
+    int fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+    if (fd < 0) return false;
+    if (api_.reset(device_, 1, &image.fence) != VK_SUCCESS) {
+      close(fd);
+      return false;
+    }
+    if (!workerStarted_) {
+      if (pthread_create(&worker_, nullptr, WorkerEntry, this) != 0) {
+        close(fd);
+        return false;
+      }
+      workerStarted_ = true;
+    }
+    image.event = fd;
+    image.prepared = true;
+    return true;
+  }
+
+  VkFence GetFence(uint32_t index) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return index < images_.size() ? images_[index].fence : VK_NULL_HANDLE;
+  }
+
+  int GetEventFd(uint32_t index) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return index < images_.size() ? images_[index].event : -1;
+  }
+
+  void Complete(uint32_t index, VkResult nativeResult) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (index >= images_.size()) return;
+    auto &image = images_[index];
+    if (!image.prepared) return;
+    image.prepared = false;
+    if (nativeResult != VK_SUCCESS && nativeResult != VK_SUBOPTIMAL_KHR) {
+      image.unsafe = nativeResult != VK_ERROR_OUT_OF_HOST_MEMORY &&
+                     nativeResult != VK_ERROR_OUT_OF_DEVICE_MEMORY &&
+                     nativeResult != VK_ERROR_DEVICE_LOST;
+      CloseEvent(image);
+      std::fprintf(stderr, "[Gamescope WSI] Present-ready: native present failed (%d); readiness remains unsignaled.\n", nativeResult);
+      return;
+    }
+    image.pending = true;
+    jobs_[(jobHead_ + jobCount_) % jobs_.size()] = index;
+    ++jobCount_;
+    changed_.notify_all();
+  }
+
+  void Cancel(uint32_t index) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (index >= images_.size() || !images_[index].prepared) return;
+    images_[index].prepared = false;
+    CloseEvent(images_[index]);
+  }
+
+ private:
+  using Clock = std::chrono::steady_clock;
+  struct Image {
+    VkFence fence = VK_NULL_HANDLE;
+    int event = -1;
+    bool prepared = false;
+    bool pending = false;
+    bool unsafe = false;
+  };
+
+  static void CloseEvent(Image &image) {
+    if (image.event >= 0) close(image.event);
+    image.event = -1;
+  }
+
+  static void *WorkerEntry(void *data) {
+    static_cast<PresentReady *>(data)->Run();
+    return nullptr;
+  }
+
+  void Run() {
+    for (;;) {
+      uint32_t index;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        changed_.wait(lock, [&] { return stopping_ || jobCount_ != 0; });
+        if (jobCount_ == 0) return;
+        index = jobs_[jobHead_];
+        jobHead_ = (jobHead_ + 1) % jobs_.size();
+        --jobCount_;
+      }
+
+      const auto start = Clock::now();
+      VkResult result;
+      for (;;) {
+        result = api_.wait(device_, 1, &images_[index].fence, VK_TRUE, 100000000);
+        if (result != VK_TIMEOUT) break;
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (stopping_) break;
+      }
+
+      std::lock_guard<std::mutex> lock(mutex_);
+      auto &image = images_[index];
+      if (result == VK_SUCCESS) {
+        const uint64_t ready = 1;
+        ssize_t written;
+        do { written = write(image.event, &ready, sizeof(ready)); }
+        while (written < 0 && errno == EINTR);
+        if (written != sizeof(ready)) {
+          std::fprintf(stderr, "[Gamescope WSI] Present-ready: eventfd signal failed (%d).\n", errno);
+          failed_ = true;
+        }
+        ++completed_;
+        waitNanoseconds_ += std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
+      } else {
+        image.unsafe = result != VK_ERROR_DEVICE_LOST;
+        failed_ = true;
+        std::fprintf(stderr, "[Gamescope WSI] Present-ready: fence wait stopped (%d); readiness remains unsignaled.\n", result);
+      }
+      CloseEvent(image);
+      image.pending = false;
+      changed_.notify_all();
+
+      if (Clock::now() - statsTime_ >= std::chrono::seconds(10)) {
+        std::fprintf(stderr, "[Gamescope WSI] Present-ready: frames=%llu worker_wait_avg=%.2fms main_reuse_waits=%llu\n",
+                     static_cast<unsigned long long>(completed_),
+                     completed_ ? double(waitNanoseconds_) / double(completed_) / 1000000.0 : 0.0,
+                     static_cast<unsigned long long>(reuseWaits_));
+        completed_ = 0;
+        waitNanoseconds_ = 0;
+        reuseWaits_ = 0;
+        statsTime_ = Clock::now();
+      }
+      if (stopping_ && result != VK_SUCCESS) return;
+    }
+  }
+
+  VkDevice device_;
+  PresentReadyApi api_;
+  std::vector<Image> images_;
+  std::vector<uint32_t> jobs_;
+  uint32_t jobHead_ = 0;
+  uint32_t jobCount_ = 0;
+  std::mutex mutex_;
+  std::condition_variable changed_;
+  pthread_t worker_{};
+  bool workerStarted_ = false;
+  bool stopping_ = false;
+  bool failed_ = false;
+  Clock::time_point statsTime_;
+  uint64_t completed_ = 0;
+  uint64_t waitNanoseconds_ = 0;
+  uint64_t reuseWaits_ = 0;
+};
+
+}
