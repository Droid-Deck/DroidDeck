@@ -0,0 +1,213 @@
+#include "../layer/present_ready.hpp"
+
+#include <atomic>
+#include <cassert>
+#include <future>
+#include <poll.h>
+
+using GamescopeWSILayer::PresentReady;
+using GamescopeWSILayer::PresentReadyApi;
+using namespace std::chrono_literals;
+
+struct FakeFence {
+  std::mutex mutex;
+  std::condition_variable changed;
+  bool signaled = false;
+  bool entered = false;
+  VkResult error = VK_SUCCESS;
+};
+
+static std::atomic<unsigned> creates{0}, destroys{0}, waits{0};
+static bool failCreate = false;
+
+static FakeFence *Cast(VkFence fence) { return reinterpret_cast<FakeFence *>(fence); }
+
+static VKAPI_ATTR VkResult VKAPI_CALL Create(VkDevice, const VkFenceCreateInfo *,
+                                            const VkAllocationCallbacks *, VkFence *fence) {
+  if (failCreate) return VK_ERROR_OUT_OF_HOST_MEMORY;
+  *fence = reinterpret_cast<VkFence>(new FakeFence);
+  ++creates;
+  return VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL Reset(VkDevice, uint32_t count, const VkFence *fences) {
+  assert(count == 1);
+  auto &fence = *Cast(fences[0]);
+  std::lock_guard<std::mutex> lock(fence.mutex);
+  fence.signaled = false;
+  fence.entered = false;
+  return VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL Wait(VkDevice, uint32_t count, const VkFence *fences,
+                                          VkBool32 waitAll, uint64_t timeout) {
+  assert(count == 1 && waitAll);
+  ++waits;
+  auto &fence = *Cast(fences[0]);
+  std::unique_lock<std::mutex> lock(fence.mutex);
+  fence.entered = true;
+  fence.changed.notify_all();
+  if (!fence.changed.wait_for(lock, std::chrono::nanoseconds(timeout),
+                             [&] { return fence.signaled || fence.error != VK_SUCCESS; }))
+    return VK_TIMEOUT;
+  return fence.error;
+}
+
+static VKAPI_ATTR void VKAPI_CALL Destroy(VkDevice, VkFence fence, const VkAllocationCallbacks *) {
+  ++destroys;
+  delete Cast(fence);
+}
+
+static const PresentReadyApi api{Create, Reset, Wait, Destroy};
+
+static void Signal(VkFence handle, VkResult result = VK_SUCCESS) {
+  auto &fence = *Cast(handle);
+  std::lock_guard<std::mutex> lock(fence.mutex);
+  fence.signaled = result == VK_SUCCESS;
+  fence.error = result;
+  fence.changed.notify_all();
+}
+
+static void WaitEntered(VkFence handle) {
+  auto &fence = *Cast(handle);
+  std::unique_lock<std::mutex> lock(fence.mutex);
+  assert(fence.changed.wait_for(lock, 1s, [&] { return fence.entered; }));
+}
+
+static bool Ready(int fd, int timeout = 0) {
+  struct pollfd event{fd, POLLIN, 0};
+  int result = poll(&event, 1, timeout);
+  assert(result >= 0);
+  return result == 1 && (event.revents & POLLIN);
+}
+
+static void TestNoEarlySignalAndReuse() {
+  PresentReady ready(VK_NULL_HANDLE, 2, api);
+  assert(!ready.Prepare(2));
+  assert(ready.Prepare(0));
+  VkFence firstFence = ready.GetFence(0);
+  int firstEvent = dup(ready.GetEventFd(0));
+  assert(firstEvent >= 0 && !Ready(firstEvent));
+  ready.Complete(0, VK_SUCCESS);
+  WaitEntered(firstFence);
+  assert(!Ready(firstEvent));
+
+  auto prepare = std::async(std::launch::async, [&] { return ready.Prepare(0); });
+  assert(prepare.wait_for(10ms) == std::future_status::timeout);
+  Signal(firstFence);
+  assert(Ready(firstEvent, 1000));
+  assert(prepare.get());
+  assert(ready.GetFence(0) == firstFence);
+  assert(!Ready(ready.GetEventFd(0)));
+  ready.Cancel(0);
+  close(firstEvent);
+}
+
+static void TestNativeOomDoesNotEnqueueOrSignal() {
+  unsigned beforeWait = waits;
+  unsigned beforeDestroy = destroys;
+  int event;
+  {
+    PresentReady ready(VK_NULL_HANDLE, 1, api);
+    assert(ready.Prepare(0));
+    event = dup(ready.GetEventFd(0));
+    ready.Complete(0, VK_ERROR_OUT_OF_HOST_MEMORY);
+    assert(waits == beforeWait);
+    assert(!Ready(event));
+    assert(ready.GetEventFd(0) == -1);
+    assert(ready.Prepare(0));
+    ready.Cancel(0);
+  }
+  assert(destroys == beforeDestroy + 1);
+  assert(!Ready(event));
+  close(event);
+}
+
+static void TestNativeErrorDoesNotReusePendingFence() {
+  PresentReady ready(VK_NULL_HANDLE, 1, api);
+  assert(ready.Prepare(0));
+  VkFence fence = ready.GetFence(0);
+  int event = dup(ready.GetEventFd(0));
+  ready.Complete(0, VK_ERROR_OUT_OF_DATE_KHR);
+  assert(!ready.Prepare(0));
+  assert(!Ready(event));
+  Signal(fence);
+  assert(ready.Prepare(0));
+  ready.Cancel(0);
+  assert(!Ready(event));
+  close(event);
+}
+
+static void TestDeviceLostDoesNotSignal() {
+  int event;
+  {
+    PresentReady ready(VK_NULL_HANDLE, 1, api);
+    assert(ready.Prepare(0));
+    VkFence fence = ready.GetFence(0);
+    event = dup(ready.GetEventFd(0));
+    ready.Complete(0, VK_SUCCESS);
+    WaitEntered(fence);
+    Signal(fence, VK_ERROR_DEVICE_LOST);
+  }
+  assert(!Ready(event));
+  close(event);
+}
+
+static void TestShutdownDrainsReadyImages() {
+  unsigned beforeDestroy = destroys;
+  int events[2];
+  {
+    PresentReady ready(VK_NULL_HANDLE, 2, api);
+    for (uint32_t i = 0; i < 2; ++i) {
+      assert(ready.Prepare(i));
+      events[i] = dup(ready.GetEventFd(i));
+      ready.Complete(i, VK_SUBOPTIMAL_KHR);
+      Signal(ready.GetFence(i));
+    }
+  }
+  assert(destroys == beforeDestroy + 2);
+  for (int event : events) {
+    assert(Ready(event));
+    close(event);
+  }
+}
+
+static void TestShutdownDoesNotDestroyGpuPendingFence() {
+  unsigned beforeDestroy = destroys;
+  VkFence fence;
+  int event;
+  auto start = std::chrono::steady_clock::now();
+  {
+    PresentReady ready(VK_NULL_HANDLE, 1, api);
+    assert(ready.Prepare(0));
+    fence = ready.GetFence(0);
+    event = dup(ready.GetEventFd(0));
+    ready.Complete(0, VK_SUCCESS);
+    WaitEntered(fence);
+  }
+  assert(std::chrono::steady_clock::now() - start < 1s);
+  assert(destroys == beforeDestroy);
+  assert(!Ready(event));
+  close(event);
+  delete Cast(fence);
+}
+
+static void TestAllocationFailureFallsBack() {
+  PresentReady ready(VK_NULL_HANDLE, 1, api);
+  failCreate = true;
+  assert(!ready.Prepare(0));
+  failCreate = false;
+  assert(ready.Prepare(0));
+  ready.Cancel(0);
+}
+
+int main() {
+  TestNoEarlySignalAndReuse();
+  TestNativeOomDoesNotEnqueueOrSignal();
+  TestNativeErrorDoesNotReusePendingFence();
+  TestDeviceLostDoesNotSignal();
+  TestShutdownDrainsReadyImages();
+  TestShutdownDoesNotDestroyGpuPendingFence();
+  TestAllocationFailureFallsBack();
+  std::puts("present-ready tests passed");
+}
