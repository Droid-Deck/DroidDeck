diff --git a/src/Utils/AcquireFence.h b/src/Utils/AcquireFence.h
new file mode 100644
--- /dev/null
+++ b/src/Utils/AcquireFence.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <utility>
+#include <unistd.h>
+
+class GamescopeAcquireFence
+{
+public:
+	explicit GamescopeAcquireFence( int nFd ) : m_nFd( nFd ) {}
+	~GamescopeAcquireFence() { if ( m_nFd >= 0 ) close( m_nFd ); }
+	GamescopeAcquireFence( const GamescopeAcquireFence& ) = delete;
+	GamescopeAcquireFence& operator=( const GamescopeAcquireFence& ) = delete;
+	int Take() { return std::exchange( m_nFd, -1 ); }
+
+private:
+	int m_nFd;
+};
