@@ -2309,7 +2309,10 @@
 
     bool CWaylandBackend::SupportsExplicitSync() const
     {
-        return true;
+        // GAMESCOPE_DISABLE_EXPLICIT_SYNC=1: a kernel without DRM_IOCTL_SYNCOBJ_EVENTFD (before
