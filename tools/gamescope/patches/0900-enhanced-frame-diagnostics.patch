diff --git a/src/droiddeck_frame_trace.hpp b/src/droiddeck_frame_trace.hpp
new file mode 100644
index 0000000..2c57f65
--- /dev/null
+++ b/src/droiddeck_frame_trace.hpp
@@ -0,0 +1,191 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#ifndef DROIDDECK_FRAME_TRACE_FAST_INTERVAL_MS
+#define DROIDDECK_FRAME_TRACE_FAST_INTERVAL_MS 2000
+#endif
+#ifndef DROIDDECK_FRAME_TRACE_SLOW_INTERVAL_MS
+#define DROIDDECK_FRAME_TRACE_SLOW_INTERVAL_MS 15000
+#endif
+#ifndef DROIDDECK_FRAME_TRACE_FAST_DURATION_MS
+#define DROIDDECK_FRAME_TRACE_FAST_DURATION_MS 120000
+#endif
+#ifndef DROIDDECK_FRAME_TRACE_DURATION_MS
+#define DROIDDECK_FRAME_TRACE_DURATION_MS 86400000
+#endif
+
+namespace droiddeck::frame_trace
+{
+
+enum class Event : uint32_t
+{
+	X11Damage,
+	X11DamageCurrent,
+	X11DamageOther,
+	SurfaceCommit,
+	SurfaceCommitBuffer,
+	SurfaceCommitNoBuffer,
+	CommitDequeued,
+	CommitDequeuedCurrent,
+	CommitDequeuedOther,
+	ImportSucceeded,
+	ImportSucceededCurrent,
+	ImportSucceededOther,
+	ImportFailed,
+	ImportFailedCurrent,
+	ImportFailedOther,
+	FenceReady,
+	FenceWaited,
+	CommitDone,
+	CommitDoneCurrent,
+	CommitDoneOther,
+	BaseLatched,
+	BaseLatchedCurrent,
+	BaseLatchedOther,
+	OutputPresent,
+	OutputAttach,
+	OutputDetach,
+	OutputCommit,
+	OutputRelease,
+	Count,
+};
+
+class State
+{
+public:
+	State()
+		: m_enabled( EnabledByEnvironment() )
+	{
+	}
+
+	void Start()
+	{
+		if ( !m_enabled || m_started.exchange( true, std::memory_order_relaxed ) )
+			return;
+
+		m_startedAt = std::chrono::steady_clock::now();
+		m_nextSummaryMs = kFastIntervalMs;
+		std::fprintf( stderr,
+			"DROIDDECK_FRAME_TRACE schema=1 fast_interval_ms=%ld slow_interval_ms=%ld "
+			"fast_duration_ms=%ld duration_ms=%ld\n",
+			kFastIntervalMs, kSlowIntervalMs, kFastDurationMs, kDurationMs );
+		PrintSummary( 0 );
+	}
+
+	void Record( Event event )
+	{
+		if ( !m_enabled || !m_started.load( std::memory_order_relaxed ) ||
+			!m_active.load( std::memory_order_relaxed ) )
+			return;
+		m_counts[static_cast<uint32_t>( event )].fetch_add( 1, std::memory_order_relaxed );
+	}
+
+	void Tick()
+	{
+		if ( !m_enabled || !m_started.load( std::memory_order_relaxed ) ||
+			!m_active.load( std::memory_order_relaxed ) )
+			return;
+
+		const int64_t elapsed = ElapsedMs();
+		if ( elapsed >= kDurationMs )
+		{
+			PrintSummary( kDurationMs );
+			m_active.store( false, std::memory_order_relaxed );
+			return;
+		}
+		if ( elapsed < m_nextSummaryMs )
+			return;
+
+		PrintSummary( elapsed );
+		m_nextSummaryMs = elapsed + ( elapsed < kFastDurationMs ? kFastIntervalMs : kSlowIntervalMs );
+	}
+
+private:
+	static constexpr int64_t kFastIntervalMs = DROIDDECK_FRAME_TRACE_FAST_INTERVAL_MS;
+	static constexpr int64_t kSlowIntervalMs = DROIDDECK_FRAME_TRACE_SLOW_INTERVAL_MS;
+	static constexpr int64_t kFastDurationMs = DROIDDECK_FRAME_TRACE_FAST_DURATION_MS;
+	static constexpr int64_t kDurationMs = DROIDDECK_FRAME_TRACE_DURATION_MS;
+
+	static bool EnabledByEnvironment()
+	{
+		const char *value = std::getenv( "DROIDDECK_ENHANCED_DIAGNOSTICS" );
+		return value != nullptr && std::strcmp( value, "1" ) == 0;
+	}
+
+	int64_t ElapsedMs() const
+	{
+		return std::chrono::duration_cast<std::chrono::milliseconds>(
+			std::chrono::steady_clock::now() - m_startedAt ).count();
+	}
+
+	uint64_t Count( Event event ) const
+	{
+		return m_counts[static_cast<uint32_t>( event )].load( std::memory_order_relaxed );
+	}
+
+	void PrintSummary( int64_t elapsed ) const
+	{
+		std::fprintf( stderr,
+			"DROIDDECK_FRAME_TRACE t_ms=%ld x11_damage=%lu x11_damage_current=%lu x11_damage_other=%lu "
+			"surface_commit=%lu surface_buffer=%lu surface_no_buffer=%lu dequeued=%lu dequeued_current=%lu "
+			"dequeued_other=%lu import_ok=%lu import_ok_current=%lu import_ok_other=%lu import_failed=%lu "
+			"import_failed_current=%lu import_failed_other=%lu fence_ready=%lu fence_waited=%lu commit_done=%lu "
+			"commit_done_current=%lu commit_done_other=%lu base_latched=%lu base_latched_current=%lu "
+			"base_latched_other=%lu output_present=%lu output_attach=%lu "
+			"output_detach=%lu output_commit=%lu output_release=%lu\n",
+			elapsed,
+			Count( Event::X11Damage ), Count( Event::X11DamageCurrent ), Count( Event::X11DamageOther ),
+			Count( Event::SurfaceCommit ), Count( Event::SurfaceCommitBuffer ), Count( Event::SurfaceCommitNoBuffer ),
+			Count( Event::CommitDequeued ), Count( Event::CommitDequeuedCurrent ), Count( Event::CommitDequeuedOther ),
+			Count( Event::ImportSucceeded ), Count( Event::ImportSucceededCurrent ), Count( Event::ImportSucceededOther ),
+			Count( Event::ImportFailed ), Count( Event::ImportFailedCurrent ), Count( Event::ImportFailedOther ),
+			Count( Event::FenceReady ), Count( Event::FenceWaited ), Count( Event::CommitDone ),
+			Count( Event::CommitDoneCurrent ), Count( Event::CommitDoneOther ), Count( Event::BaseLatched ),
+			Count( Event::BaseLatchedCurrent ), Count( Event::BaseLatchedOther ), Count( Event::OutputPresent ),
+			Count( Event::OutputAttach ), Count( Event::OutputDetach ), Count( Event::OutputCommit ),
+			Count( Event::OutputRelease ) );
+		std::fflush( stderr );
+	}
+
+	bool m_enabled;
+	std::atomic<bool> m_started{ false };
+	std::atomic<bool> m_active{ true };
+	std::chrono::steady_clock::time_point m_startedAt{};
+	int64_t m_nextSummaryMs = 0;
+	std::atomic<uint64_t> m_counts[static_cast<uint32_t>( Event::Count )]{};
+};
+
+inline State &GetState()
+{
+	static State state;
+	return state;
+}
+
+inline void Start()
+{
+	GetState().Start();
+}
+
+inline void Record( Event event )
+{
+	GetState().Record( event );
+}
+
+inline void RecordWindow( Event total, Event focused, Event other, bool isFocused )
+{
+	Record( total );
+	Record( isFocused ? focused : other );
+}
+
+inline void Tick()
+{
+	GetState().Tick();
+}
+
+}
