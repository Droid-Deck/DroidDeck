diff --git a/src/rendervulkan.cpp b/src/rendervulkan.cpp
index 103baee..d344a99 100644
--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -319,6 +319,33 @@ bool CVulkanDevice::BInit(VkInstance instance, VkSurfaceKHR surface)
 		return false;
 	if (!createShaders())
 		return false;
+	{
+		// One composite pipeline up front: a driver that refuses it with the immutable YCbCr
+		// samplers gets the layout without them (NV12 textures then sample without conversion).
+		if ( getenv( "GAMESCOPE_NO_YCBCR_SAMPLERS" ) && *getenv( "GAMESCOPE_NO_YCBCR_SAMPLERS" ) == '1' )
+		{
+			vk_log.infof( "GAMESCOPE_NO_YCBCR_SAMPLERS=1: composite layout without immutable YCbCr samplers" );
+			vk.DestroyPipelineLayout( device(), m_pipelineLayout, nullptr );
+			vk.DestroyDescriptorSetLayout( device(), m_descriptorSetLayout, nullptr );
+			m_bYcbcrImmutableSamplers = false;
+			if ( !createLayouts() )
+				return false;
+		}
+		VkPipeline probe = compilePipeline( 1, 0, SHADER_TYPE_BLIT, 1, 0, 0, 0, false );
+		if ( probe == VK_NULL_HANDLE && m_bYcbcrImmutableSamplers )
+		{
+			vk_log.errorf( "composite pipeline refused; retrying without immutable YCbCr samplers" );
+			vk.DestroyPipelineLayout( device(), m_pipelineLayout, nullptr );
+			vk.DestroyDescriptorSetLayout( device(), m_descriptorSetLayout, nullptr );
+			m_bYcbcrImmutableSamplers = false;
+			if ( !createLayouts() )
+				return false;
+			probe = compilePipeline( 1, 0, SHADER_TYPE_BLIT, 1, 0, 0, 0, false );
+			vk_log.infof( "composite pipeline without immutable YCbCr samplers: %s", probe ? "accepted" : "STILL refused" );
+		}
+		if ( probe != VK_NULL_HANDLE )
+			vk.DestroyPipeline( device(), probe, nullptr );
+	}
 	if (!createScratchResources())
 		return false;
 
@@ -869,7 +896,7 @@ bool CVulkanDevice::createLayouts()
 			.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
 			.descriptorCount = VKR_SAMPLER_SLOTS,
 			.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
-			.pImmutableSamplers = ycbcrSamplers.data(),
+			.pImmutableSamplers = m_bYcbcrImmutableSamplers ? ycbcrSamplers.data() : nullptr,
 		},
 		VkDescriptorSetLayoutBinding {
 			.binding = 5,
@@ -1870,6 +1897,8 @@ void CVulkanCmdBuffer::dispatch(uint32_t x, uint32_t y, uint32_t z)
 		imageDescriptors[i].sampler = m_device->sampler(m_samplerState[i]);
 		imageDescriptors[i].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
 		ycbcrImageDescriptors[i].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+		if ( !m_device->ycbcrImmutableSamplers() )
+			ycbcrImageDescriptors[i].sampler = imageDescriptors[i].sampler;
 		if (m_boundTextures[i] == nullptr)
 			continue;
 
diff --git a/src/rendervulkan.hpp b/src/rendervulkan.hpp
