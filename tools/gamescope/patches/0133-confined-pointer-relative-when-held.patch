+struct ConfinedPointerHold
+{
+	int nAwayFrames = 0;
+	int nFreeFrames = 0;
+	uint64_t ulLastAway = 0;
+	bool bHeld = false;
+};
+
+static bool confined_pointer_hold_step( ConfinedPointerHold &state, bool bConfined, bool bMoved, double flDX, double flDY, uint64_t ulNow )
+{
+	if ( !bConfined )
+	{
+		state = ConfinedPointerHold{};
+		return false;
+	}
+
+	if ( !bMoved )
+		return state.bHeld;
+
+	if ( std::abs( flDX ) > 48.0 || std::abs( flDY ) > 48.0 )
+	{
+		if ( ulNow - state.ulLastAway > 500'000'000ul )
+			state.nAwayFrames = 0;
+		state.ulLastAway = ulNow;
+		state.nFreeFrames = 0;
+		if ( ++state.nAwayFrames >= 3 )
+			state.bHeld = true;
+	}
+	else if ( state.bHeld && ++state.nFreeFrames >= 60 )
+	{
+		state = ConfinedPointerHold{};
+	}
+
+	return state.bHeld;
+}
+
+static bool game_holds_pointer( bool bHasConstraint, bool bConfined, bool bConfinedPointerHeld )
+{
+	return bHasConstraint && ( !bConfined || bConfinedPointerHeld );
+}
+
+static bool s_bConfinedPointerHeld = false;
+
+static bool pointer_constraint_confines()
+{
+	wlserver_lock();
+	struct wlr_pointer_constraint_v1 *pConstraint = wlserver.GetCursorConstraint();
+	const bool bConfines = pConstraint && pConstraint->type == WLR_POINTER_CONSTRAINT_V1_CONFINED;
+	wlserver_unlock();
+	return bConfines;
+}
+
+static void update_confined_pointer_hold( global_focus_t *pFocus, bool bConfined )
+{
+	static ConfinedPointerHold s_Hold;
+	static double s_flLastX = 0.0;
+	static double s_flLastY = 0.0;
+
+	wlserver_lock();
+	const double flX = wlserver.mouse_surface_cursorx;
+	const double flY = wlserver.mouse_surface_cursory;
+	wlserver_unlock();
+
+	bConfined = bConfined && pFocus->cursor;
+	const bool bMoved = flX != s_flLastX || flY != s_flLastY;
+	s_flLastX = flX;
+	s_flLastY = flY;
+
+	int nRootX = (int) flX;
+	int nRootY = (int) flY;
+	if ( bConfined && bMoved )
+		pFocus->cursor->QueryRootPosition( &nRootX, &nRootY );
+
+	s_bConfinedPointerHeld = confined_pointer_hold_step( s_Hold, bConfined, bMoved, nRootX - flX, nRootY - flY, get_time_in_nanos() );
+}
