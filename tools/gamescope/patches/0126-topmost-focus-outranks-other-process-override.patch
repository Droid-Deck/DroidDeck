+// Windows keeps a topmost window above every window that is neither topmost nor owned by it,
+// so another process's splash cannot cover a topmost sign-in (the EA app's, over its Steam launcher).
+static bool is_stacked_below_focus( steamcompmgr_win_t *candidate, steamcompmgr_win_t *focus )
+{
+	if ( candidate->pid == focus->pid || !candidate->hasHwndStyleEx || !focus->hasHwndStyleEx )
+		return false;
+
+	if ( candidate->type == steamcompmgr_win_type_t::XWAYLAND && focus->type == steamcompmgr_win_type_t::XWAYLAND &&
+		 candidate->xwayland().transientFor == focus->xwayland().id )
+		return false;
+
+	return ( focus->hwndStyleEx & WS_EX_TOPMOST ) && !( candidate->hwndStyleEx & WS_EX_TOPMOST );
+}
