diff --git a/src/swapchain_remake.hpp b/src/swapchain_remake.hpp
new file mode 100644
index 0000000..99d688b
--- /dev/null
+++ b/src/swapchain_remake.hpp
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstdint>
+
+namespace gamescope
+{
+constexpr uint32_t k_unSwapchainRemakeAttempts = 10;
+constexpr uint32_t k_unSwapchainRemakeDelayMs = 100;
+
+template <typename Make, typename Release, typename Wait>
+inline uint32_t RemakeSwapchainWithRetries( Make make, Release release, Wait wait )
+{
+    for ( uint32_t attempt = 1; attempt <= k_unSwapchainRemakeAttempts; ++attempt )
+    {
+        if ( make() )
+            return attempt;
+        release();
+        if ( attempt < k_unSwapchainRemakeAttempts )
+            wait( k_unSwapchainRemakeDelayMs );
+    }
+    return 0;
+}
+}
