+static void update_client_pointer_follow( global_focus_t *pFocus, bool bAllowed )
+{
+	static int s_nAwayFrames = 0;
+	static int s_nQuietFrames = 0;
+	static uint64_t s_ulLastAway = 0;
+	static double s_flLastX = 0.0;
+	static double s_flLastY = 0.0;
+
+	int nRootX = 0;
+	int nRootY = 0;
+	if ( bAllowed && pFocus->cursor )
+		pFocus->cursor->QueryRootPosition( &nRootX, &nRootY );
+	else
+		bAllowed = false;
+
+	wlserver_lock();
+	const double flX = wlserver.mouse_surface_cursorx;
+	const double flY = wlserver.mouse_surface_cursory;
+	if ( !bAllowed )
+	{
+		s_nAwayFrames = 0;
+		s_bFollowClientPointer = false;
+		wlserver.bFollowClientPointer = false;
+	}
+	else if ( !s_bFollowClientPointer )
+	{
+		const bool bMoved = flX != s_flLastX || flY != s_flLastY;
+		if ( bMoved && ( std::abs( nRootX - flX ) > 48.0 || std::abs( nRootY - flY ) > 48.0 ) )
+		{
+			const uint64_t ulNow = get_time_in_nanos();
+			if ( ulNow - s_ulLastAway > 500'000'000ul )
+				s_nAwayFrames = 0;
+			s_ulLastAway = ulNow;
+			s_nAwayFrames++;
+		}
+
+		if ( s_nAwayFrames >= 3 )
+		{
+			s_nAwayFrames = 0;
+			s_nQuietFrames = 0;
+			s_bFollowClientPointer = true;
+			wlserver.bFollowClientPointer = true;
+			wlserver.flFollowDX = 0.0;
+			wlserver.flFollowDY = 0.0;
+			wlserver_mousewarp( nRootX, nRootY, 0, true );
+		}
+	}
+	else
+	{
+		const bool bWarped = std::abs( nRootX - flX ) > 2.0 || std::abs( nRootY - flY ) > 2.0;
+		const double flDX = std::trunc( wlserver.flFollowDX );
+		const double flDY = std::trunc( wlserver.flFollowDY );
+		if ( bWarped )
+			s_nQuietFrames = 0;
+		else if ( flDX != 0.0 || flDY != 0.0 )
+			s_nQuietFrames++;
+
+		if ( flDX != 0.0 || flDY != 0.0 || bWarped )
+		{
+			wlserver.flFollowDX -= flDX;
+			wlserver.flFollowDY -= flDY;
+			wlserver_mousewarp( nRootX, nRootY, 0, true );
+			if ( flDX != 0.0 || flDY != 0.0 )
+				wlserver_mousewarp( nRootX + flDX, nRootY + flDY, 0, true );
+		}
+
+		if ( s_nQuietFrames >= 60 )
+		{
+			s_bFollowClientPointer = false;
+			wlserver.bFollowClientPointer = false;
+		}
+	}
+	s_flLastX = wlserver.mouse_surface_cursorx;
+	s_flLastY = wlserver.mouse_surface_cursory;
+	wlserver_unlock();
 }
 
