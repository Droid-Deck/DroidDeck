@@ -1698,6 +1698,46 @@ namespace gamescope
         }
     }
 
+    static bool NestedRefreshFollowsHost()
+    {
+        static const bool s_bFollow = []
+        {
+            const char *pszFollow = getenv( "GAMESCOPE_NESTED_REFRESH_FOLLOWS_HOST" );
+            return pszFollow && atoi( pszFollow ) != 0;
+        }();
+        return s_bFollow;
+    }
+
+    static bool HostRefreshChanged( int32_t nRefreshmHz, uint64_t ulPresentedNs )
+    {
+        static int32_t s_nPendingmHz = 0;
+        static uint64_t s_ulPendingSinceNs = 0;
+        if ( !nRefreshmHz || nRefreshmHz == g_nOutputRefresh )
+        {
+            s_nPendingmHz = 0;
+            return false;
+        }
+        if ( !NestedRefreshFollowsHost() )
+            return true;
+        if ( nRefreshmHz != s_nPendingmHz )
+        {
+            s_nPendingmHz = nRefreshmHz;
+            s_ulPendingSinceNs = ulPresentedNs;
+        }
+        if ( ulPresentedNs - s_ulPendingSinceNs >= 300'000'000ul )
+            return true;
+        force_repaint();
+        return false;
+    }
+
+    static void FollowHostRefresh( int32_t nRefreshmHz )
+    {
+        if ( !NestedRefreshFollowsHost() || !g_nNestedRefresh || g_nNestedRefresh == nRefreshmHz )
+            return;
+        xdg_log.infof( "Nested refresh follows the host: %.3fhz", ConvertmHzToHz( (float) nRefreshmHz ) );
+        g_nNestedRefresh = nRefreshmHz;
+    }
+
