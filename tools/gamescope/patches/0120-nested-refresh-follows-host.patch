             xdg_log.infof( "Changed refresh to: %.3fhz", ConvertmHzToHz( (float) nLargestRefreshRateMhz ) );
             g_nOutputRefresh = nLargestRefreshRateMhz;
+            FollowHostRefresh( nLargestRefreshRateMhz );
         }
     }
 
