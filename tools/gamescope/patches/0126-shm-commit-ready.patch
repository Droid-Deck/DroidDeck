diff --git a/src/buffer_commit_sync.hpp b/src/buffer_commit_sync.hpp
new file mode 100644
--- /dev/null
+++ b/src/buffer_commit_sync.hpp
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <optional>
+
+namespace gamescope
+{
+enum class BufferCommitSyncSource
+{
+	ExplicitAcquire,
+	DmaBuf,
+	SynchronousUpload,
+};
+
+struct BufferCommitSync
+{
+	int fence = -1;
+	bool knownReady = false;
+	BufferCommitSyncSource source = BufferCommitSyncSource::SynchronousUpload;
+
+	static constexpr BufferCommitSync ExplicitAcquire( int fence, bool knownReady )
+	{
+		return { fence, knownReady, BufferCommitSyncSource::ExplicitAcquire };
+	}
+
+	static constexpr BufferCommitSync DmaBuf( int fence, bool knownReady = false )
+	{
+		return { fence, knownReady, BufferCommitSyncSource::DmaBuf };
+	}
+
+	static constexpr BufferCommitSync SynchronousUpload()
+	{
+		return { -1, true, BufferCommitSyncSource::SynchronousUpload };
+	}
+};
+
+template <typename GetDmaBufFence>
+BufferCommitSync SelectBufferCommitSync( bool hasExplicitAcquire, int explicitFence,
+	bool explicitKnownReady, GetDmaBufFence &&getDmaBufFence )
+{
+	if ( hasExplicitAcquire )
+		return BufferCommitSync::ExplicitAcquire( explicitFence, explicitKnownReady );
+
+	if ( std::optional<BufferCommitSync> dmaBuf = getDmaBufFence() )
+		return *dmaBuf;
+
+	return BufferCommitSync::SynchronousUpload();
+}
+
+constexpr const char *BufferCommitSyncSourceName( BufferCommitSyncSource source )
+{
+	switch ( source )
+	{
+		case BufferCommitSyncSource::ExplicitAcquire:
+			return "explicit acquire";
+		case BufferCommitSyncSource::DmaBuf:
+			return "DMA-BUF";
+		case BufferCommitSyncSource::SynchronousUpload:
+			return "synchronous upload";
+	}
+
+	return "unknown";
+}
+
+template <typename Commit, typename Waiter, typename DoneCommits>
+bool DispatchBufferCommitSync( Commit *commit, Waiter &waiter, const BufferCommitSync &sync,
+	bool mangoNudge, unsigned int mangoMsgType, const DoneCommits &doneCommits, bool hudFrame )
+{
+	commit->SetFence( sync.fence, mangoNudge, mangoMsgType, doneCommits, hudFrame );
+	if ( !sync.knownReady && sync.fence < 0 )
+		return false;
+	if ( sync.knownReady )
+	{
+		commit->Signal();
+		return true;
+	}
+
+	return waiter.AddWaitable( commit );
+}
+}
