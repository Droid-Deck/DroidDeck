new file mode 100644
index 0000000..06fc987
--- /dev/null
+++ b/src/nested_swapchain.hpp
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <algorithm>
+#include <vulkan/vulkan_core.h>
+
+namespace gamescope
+{
+struct NestedSwapchainConfig
+{
+    bool copy = false;
+    uint32_t imageCount = 0;
+    VkImageUsageFlags usage = 0;
+    VkCompositeAlphaFlagBitsKHR alpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    VkExtent2D extent = {};
+};
+
+inline bool ChooseNestedSwapchainConfig( const VkSurfaceCapabilitiesKHR &caps,
+    bool mutableFormat, uint32_t width, uint32_t height, NestedSwapchainConfig &config )
+{
+    constexpr VkImageUsageFlags direct = VK_IMAGE_USAGE_SAMPLED_BIT |
+        VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    config.copy = !mutableFormat || ( caps.supportedUsageFlags & direct ) != direct;
+    config.usage = config.copy ? VkImageUsageFlags{VK_IMAGE_USAGE_TRANSFER_DST_BIT} : direct;
+    if ( ( caps.supportedUsageFlags & config.usage ) != config.usage )
+        return false;
+
+    bool foundAlpha = false;
+    for ( auto alpha : { VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR, VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR,
+                        VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR, VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR } )
+    {
+        if ( caps.supportedCompositeAlpha & alpha )
+        {
+            config.alpha = alpha;
+            foundAlpha = true;
+            break;
+        }
+    }
+    if ( !foundAlpha || caps.maxImageExtent.width < caps.minImageExtent.width ||
+         caps.maxImageExtent.height < caps.minImageExtent.height )
+        return false;
+
+    config.imageCount = caps.minImageCount + ( caps.minImageCount != UINT32_MAX );
+    if ( caps.maxImageCount )
+        config.imageCount = std::min( config.imageCount, caps.maxImageCount );
+    if ( config.imageCount < caps.minImageCount )
+        return false;
+    config.extent = caps.currentExtent.width == UINT32_MAX
+        ? VkExtent2D{ std::clamp( width, caps.minImageExtent.width, caps.maxImageExtent.width ),
+                      std::clamp( height, caps.minImageExtent.height, caps.maxImageExtent.height ) }
+        : caps.currentExtent;
+    return config.extent.width && config.extent.height;
+}
+}
