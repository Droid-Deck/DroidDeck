+static void remove_optional_device_extensions(const util::extension_list &available,
+                                              util::extension_list &required)
+{
+   /* Without DRM format modifiers, Wayland swapchains export driver-allocated LINEAR images instead. */
+   if (!available.contains(VK_EXT_IMAGE_DRM_FORMAT_MODIFIER_EXTENSION_NAME))
+   {
+      required.remove(VK_EXT_IMAGE_DRM_FORMAT_MODIFIER_EXTENSION_NAME);
+   }
+   /* Only VK_EXT_present_timing uses calibrated timestamps, and it checks its own dependencies. */
+   if (!available.contains(VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME))
+   {
+      required.remove(VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME);
+   }
+}
+
+bool device_supports_surface_platform(VkPhysicalDevice phys_dev, surface_properties &props,
+                                      const uint32_t api_version)
+{
+   util::allocator allocator{ layer::instance_private_data::get(phys_dev).get_allocator(),
+                              VK_SYSTEM_ALLOCATION_SCOPE_COMMAND };
+   util::extension_list available{ allocator };
+   util::extension_list required{ allocator };
+   if (get_available_device_extensions(phys_dev, available) != VK_SUCCESS ||
+       props.get_required_device_extensions(required, api_version) != VK_SUCCESS)
+   {
+      return false;
+   }
+   remove_optional_device_extensions(available, required);
+   return available.contains(required);
+}
