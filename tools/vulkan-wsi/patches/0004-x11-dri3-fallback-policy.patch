diff --git a/wsi/dri3_fallback_policy.hpp b/wsi/dri3_fallback_policy.hpp
new file mode 100644
index 0000000..0f2e2f1
--- /dev/null
+++ b/wsi/dri3_fallback_policy.hpp
@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) 2026 DroidDeck contributors.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+namespace wsi::x11
+{
+
+/**
+ * A DRI3 allocation cannot require dedicated memory because a swapchain image
+ * may later be aliased through VkBindImageMemorySwapchainInfoKHR.
+ */
+constexpr bool preserves_swapchain_aliasing(bool dedicated_only, bool requires_dedicated)
+{
+   return !dedicated_only && !requires_dedicated;
+}
+
+/**
+ * The driver-export fallback is only valid for an ordinary, single-plane image
+ * whose selected modifier can be exported without a dedicated allocation.
+ */
+constexpr bool can_use_no_heap_driver_export(bool fallback_enabled, bool exportable, bool dedicated_only,
+                                             bool protected_image, bool single_plane)
+{
+   return fallback_enabled && exportable && preserves_swapchain_aliasing(dedicated_only, false) &&
+          !protected_image && single_plane;
+}
+
+/**
+ * A late allocator failure may use the already-approved driver-export path.
+ */
+constexpr bool should_allocate_from_driver_after_heap_failure(bool fallback_enabled)
+{
+   return fallback_enabled;
+}
+
+} // namespace wsi::x11
