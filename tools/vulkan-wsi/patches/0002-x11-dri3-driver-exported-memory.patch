+VkResult external_memory::allocate_exported_and_bind(const VkImage &image)
+{
+   auto &device_data = layer::device_private_data::get(m_device);
+   assert(m_memories[0] == VK_NULL_HANDLE && m_buffer_fds[0] < 0);
+
+   VkMemoryRequirements requirements = {};
+   device_data.disp.GetImageMemoryRequirements(m_device, image, &requirements);
+   if (requirements.memoryTypeBits == 0)
+   {
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+   VkPhysicalDeviceMemoryProperties2 memory_props = {};
+   memory_props.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2;
+   device_data.instance_data.disp.GetPhysicalDeviceMemoryProperties2KHR(device_data.physical_device, &memory_props);
+   uint32_t memory_type = UINT32_MAX;
+   for (uint32_t i = 0; i < memory_props.memoryProperties.memoryTypeCount; i++)
+   {
+      if (!(requirements.memoryTypeBits & (1u << i)))
+      {
+         continue;
+      }
+      if (memory_type == UINT32_MAX ||
+          (memory_props.memoryProperties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+      {
+         memory_type = i;
+      }
+      if (memory_props.memoryProperties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)
+      {
+         break;
+      }
+   }
+   if (memory_type == UINT32_MAX)
+   {
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+
+   /* shortcut: always dedicated (export commonly requires it), so an app image bound to swapchain memory through
+    * VkBindImageMemorySwapchainInfoKHR would break the dedicated-allocation rules; query
+    * VkMemoryDedicatedRequirements if such an app turns up. */
+   VkMemoryDedicatedAllocateInfo dedicated = {};
+   dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+   dedicated.image = image;
+   VkExportMemoryAllocateInfo export_info = {};
+   export_info.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO;
+   export_info.pNext = &dedicated;
+   export_info.handleTypes = m_handle_type;
+   VkMemoryAllocateInfo alloc_info = {};
+   alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+   alloc_info.pNext = &export_info;
+   alloc_info.allocationSize = requirements.size;
+   alloc_info.memoryTypeIndex = memory_type;
+   TRY_LOG(device_data.disp.AllocateMemory(m_device, &alloc_info, m_allocator.get_original_callbacks(), &m_memories[0]),
+           "Failed to allocate exportable device memory");
+   TRY_LOG(device_data.disp.BindImageMemory(m_device, image, m_memories[0], 0), "Failed to bind exportable memory");
+
+   VkMemoryGetFdInfoKHR get_fd_info = {};
+   get_fd_info.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR;
+   get_fd_info.memory = m_memories[0];
+   get_fd_info.handleType = m_handle_type;
+   TRY_LOG(device_data.disp.GetMemoryFdKHR(m_device, &get_fd_info, &m_buffer_fds[0]), "Failed to export memory fd");
+   m_owns_exported_fds = true;
+   return VK_SUCCESS;
+}
+
+void external_memory::release_buffer_fds()
+{
+   for (uint32_t plane = 0; plane < MAX_PLANES; plane++)
+   {
+      auto it = std::find(std::begin(m_buffer_fds), std::end(m_buffer_fds), m_buffer_fds[plane]);
+      if (m_buffer_fds[plane] >= 0 && std::distance(std::begin(m_buffer_fds), it) == static_cast<int>(plane))
+      {
+         close(m_buffer_fds[plane]);
+      }
+   }
+   m_buffer_fds.fill(-1);
+}
