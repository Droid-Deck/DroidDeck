+VkResult image_backing_memory_external::allocate(VkImage image)
+{
+   const VkResult allocation_result = allocate();
+   if (allocation_result == VK_SUCCESS)
+   {
+      return VK_SUCCESS;
+   }
+   if (!m_driver_export_fallback_allowed)
+   {
+      return allocation_result;
+   }
+
+   /* The image was created with the WSI allocator's layout for the selected format; ask it for that layout again
+    * without memory, then let the driver provide (and export) memory in that layout. */
+   allocation_params params = { false, m_create_info.extent, &m_create_info.selected_format, 1,
+                                m_create_info.explicit_compression, true };
+   wsialloc_allocate_result layout = { {}, { 0 }, { 0 }, { -1 }, false };
+   if ((m_create_info.flags & VK_IMAGE_CREATE_PROTECTED_BIT) != 0 ||
+       util::drm::drm_fourcc_format_get_num_planes(m_create_info.selected_format.fourcc) != 1 ||
+       m_wsialloc_allocator.allocate(params, &layout) != VK_SUCCESS)
+   {
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   m_external_mem.set_strides(layout.average_row_strides);
+   m_external_mem.set_offsets(layout.offsets);
+   m_external_mem.set_num_memories(1);
+   m_external_mem.set_format_info(false, 1);
+   m_external_mem.set_memory_handle_type(VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT);
+   TRY_LOG(m_external_mem.allocate_exported_and_bind(image), "Failed to allocate exportable swapchain image memory");
+   m_driver_allocated = true;
+   return VK_SUCCESS;
+}
