+   {
+      /* Bound at allocation; the window system holds its own duplicates of the fds by now. */
+      m_external_mem.release_buffer_fds();
+      return VK_SUCCESS;
+   }
+
    TRY_LOG(m_external_mem.import_memory_and_bind_swapchain_image(image),
            "Failed to import memory and bind swapchain image");
 
