+/**
+ * @brief Whether gamescope's frame limiter (Steam's Frame Limit) is on.
+ *
+ * The limiter holds back the frame callbacks of a capped window, which only slows presents that wait for
+ * the next vblank. While it is on, gamescope's own WSI layer presents every swapchain as FIFO; this layer
+ * does the same, so IMMEDIATE and MAILBOX games are capped too. gamescope publishes the state in the file
+ * named by GAMESCOPE_LIMITER_FILE (a uint32, 1 while limiting) and rewrites it in place, so one descriptor
+ * stays valid. Read on every present: the limiter changes while a game runs.
+ */
+static bool gamescope_limiter_forces_fifo()
+{
+   static const char *const path = std::getenv("GAMESCOPE_LIMITER_FILE");
+   if (path == nullptr)
+   {
+      return false;
+   }
+
+   static std::mutex lock;
+   static int fd = -1;
+   static std::chrono::steady_clock::time_point next_open{};
+   std::lock_guard<std::mutex> guard(lock);
+   if (fd < 0)
+   {
+      /* The file may not exist yet: retry at most once a second, not on every present. */
+      const auto now = std::chrono::steady_clock::now();
+      if (now < next_open)
+      {
+         return false;
+      }
+      next_open = now + std::chrono::seconds(1);
+      fd = open(path, O_RDONLY | O_CLOEXEC);
+      if (fd < 0)
+      {
+         return false;
+      }
+   }
+
+   uint32_t value = 0;
+   return pread(fd, &value, sizeof(value), 0) == static_cast<ssize_t>(sizeof(value)) && value == 1;
+}
