<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only. Android grants DUMP to adb shell; release APKs have no bridge. -->
        <activity
            android:name=".agent.AgentStartActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/SessionTheme" />
        <provider
            android:name=".agent.AgentBridgeProvider"
            android:authorities="${applicationId}.agent"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:grantUriPermissions="false" />
    </application>
</manifest>
